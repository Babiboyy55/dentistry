@model List<Nhakhoa.Models.HolidayDate>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý ngày nghỉ lễ";
}

<div class="d-flex align-items-center justify-content-between gap-3 mb-4">
    <div>
        <a href="/Schedule" class="btn btn-outline-secondary btn-sm rounded-pill px-3 mb-2"><i class="bi bi-arrow-left"></i> Quay lại Lịch</a>
        <h4 class="fw-bold mb-0" style="color:#0b1f35"><i class="bi bi-calendar-x text-danger me-2"></i>Quản lý ngày nghỉ lễ</h4>
        <div class="text-muted small mt-1">Cấu hình các ngày nghỉ cố định hoặc đột xuất của hệ thống.</div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 rounded-4 py-2 px-3 mb-3"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 rounded-4 py-2 px-3 mb-3"><i class="bi bi-x-circle me-2"></i>@TempData["Error"]</div>
}

<div class="row g-4">
    <!-- Form thêm mới -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h6 class="fw-bold mb-3"><i class="bi bi-plus-circle text-primary me-2"></i>Thêm ngày nghỉ mới</h6>
            <form id="addHolidayForm" method="post" action="/Schedule/AddHoliday">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Confirmed" id="confirmedInput" value="false" />
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Tên ngày nghỉ <span class="text-danger">*</span></label>
                    <input type="text" name="Name" class="form-control rounded-3" placeholder="Ví dụ: Tết Dương Lịch" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Ngày nghỉ <span class="text-danger">*</span></label>
                    <input type="date" name="Date" class="form-control rounded-3" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Loại ngày nghỉ</label>
                    <select name="HolidayType" class="form-select rounded-3">
                        <option value="Cố định">Cố định (Nghỉ lễ quốc gia)</option>
                        <option value="Đột xuất">Đột xuất (Nghỉ nội bộ clinic)</option>
                    </select>
                </div>
                <div class="mb-3 form-check">
                    <input type="checkbox" name="RepeatYearly" class="form-check-input" id="repeatCheck" value="true" />
                    <label class="form-check-label small fw-semibold" for="repeatCheck">Lặp lại hàng năm</label>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Ghi chú</label>
                    <textarea name="Notes" class="form-control rounded-3" rows="2" placeholder="Chi tiết thêm..."></textarea>
                </div>
                <div id="confirmAlert" class="alert alert-warning border-0 rounded-3 py-2 small" style="display:none;"></div>
                <button type="submit" id="submitBtn" class="btn btn-primary w-100 rounded-3 fw-semibold" style="background:#1b75d0; border-color:#1b75d0;">
                    <i class="bi bi-check2 me-1"></i> Lưu ngày nghỉ
                </button>
            </form>
        </div>
    </div>

    <!-- Danh sách ngày nghỉ -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-0">
                @if (!Model.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-calendar2-x display-4 opacity-25 d-block mb-3"></i>
                        Chưa cấu hình ngày nghỉ nào.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0" style="font-size:0.9rem;">
                            <thead style="background:#f8faff; border-bottom:2px solid #e8edf5;">
                                <tr>
                                    <th class="px-4 py-3 text-muted fw-semibold">Tên ngày nghỉ</th>
                                    <th class="py-3 text-muted fw-semibold">Ngày</th>
                                    <th class="py-3 text-muted fw-semibold">Loại</th>
                                    <th class="py-3 text-muted fw-semibold">Lặp hàng năm</th>
                                    <th class="py-3 text-muted fw-semibold">Người tạo</th>
                                    <th class="py-3 text-muted fw-semibold pe-4 text-center">Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var h in Model)
                                {
                                    <tr class="border-bottom">
                                        <td class="px-4">
                                            <div class="fw-semibold text-dark">@h.Name</div>
                                            @if (!string.IsNullOrEmpty(h.Notes))
                                            {
                                                <div class="text-muted small">@h.Notes</div>
                                            }
                                        </td>
                                        <td class="fw-semibold">@h.Date.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <span class="badge @(h.HolidayType == "Cố định" ? "bg-primary-subtle text-primary" : "bg-warning-subtle text-warning") rounded-pill px-2">@h.HolidayType</span>
                                        </td>
                                        <td>
                                            @if (h.RepeatYearly)
                                            {
                                                <span class="text-success fw-semibold"><i class="bi bi-check-circle-fill me-1"></i>Có</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Không</span>
                                            }
                                        </td>
                                        <td class="text-muted small">@h.CreatedBy</td>
                                        <td class="text-center pe-4">
                                            <form action="/Schedule/DeleteHoliday/@h.Id" method="post" class="d-inline" onsubmit="return confirm('Xác nhận xóa ngày nghỉ này?')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill">
                                                    <i class="bi bi-trash"></i> Xóa
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const form = document.getElementById('addHolidayForm');
    const confirmedInput = document.getElementById('confirmedInput');
    const confirmAlert = document.getElementById('confirmAlert');
    const submitBtn = document.getElementById('submitBtn');

    form.addEventListener('submit', async function (e) {
        if (confirmedInput.value === 'true') {
            return; // Tiến hành submit bình thường
        }
        e.preventDefault();

        const formData = new FormData(form);
        const res = await fetch(form.action, {
            method: 'POST',
            body: formData
        });

        // Nếu server trả về kết quả yêu cầu confirm (do có ca trực bị ảnh hưởng)
        if (res.headers.get('content-type')?.includes('application/json')) {
            const data = await res.json();
            if (data.requireConfirm) {
                confirmAlert.innerHTML = `
                    <div class="fw-bold text-danger mb-1">Cảnh báo ảnh hưởng lịch trực!</div>
                    Có <strong>${data.affectedCount} ca trực</strong> của các bác sĩ sau đã đăng ký vào ngày này: <br/>
                    <span class="fw-semibold">${data.affectedDoctors.join(', ')}</span>.<br/>
                    Bạn có chắc chắn muốn thiết lập ngày nghỉ và hủy các ca này không?
                `;
                confirmAlert.style.display = 'block';
                confirmedInput.value = 'true'; // Set thành true để lần bấm sau sẽ lưu trực tiếp
                submitBtn.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> Xác nhận lưu & Hủy ca trực';
                submitBtn.className = 'btn btn-danger w-100 rounded-3 fw-semibold';
            }
        } else {
            // Không cần confirm hoặc submit thành công (redirected)
            window.location.reload();
        }
    });
</script>
}
