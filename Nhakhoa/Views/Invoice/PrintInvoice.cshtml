@model Nhakhoa.Models.Invoice

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>In Hóa Đơn - @Model.InvoiceCode</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #fff;
            color: #333;
            font-size: 14px;
            padding: 20px;
        }
        .invoice-print-container {
            max-width: 800px;
            margin: auto;
            border: 1px solid #dee2e6;
            padding: 40px;
            background: #fff;
        }
        .clinic-logo {
            font-size: 24px;
            font-weight: 700;
            color: #0d6efd;
        }
        .invoice-title {
            font-size: 22px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .signature-section {
            margin-top: 60px;
        }
        .signature-box {
            text-align: center;
            height: 120px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        @@media print {
            body {
                padding: 0;
            }
            .invoice-print-container {
                border: none;
                padding: 0;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    <div class="text-center mb-4 no-print">
        <button onclick="window.print()" class="btn btn-primary rounded-pill px-4 fw-bold shadow">
            <i class="bi bi-printer"></i> Click để In Hóa Đơn
        </button>
    </div>

    <div class="invoice-print-container shadow-sm">
        <!-- Logo & Header info -->
        <div class="row align-items-center mb-4">
            <div class="col-6">
                <div class="clinic-logo">NHA KHOA HỒNG PHONG</div>
                <div class="text-muted text-xs">Địa chỉ: Khu đô thị Bách Khoa, Hà Nội</div>
                <div class="text-muted text-xs">Hotline: 1900 6000</div>
            </div>
            <div class="col-6 text-end">
                <div class="invoice-title text-primary mb-1">Hóa Đơn Thanh Toán</div>
                <div class="text-muted text-sm font-monospace">Số: <strong>@Model.InvoiceCode</strong></div>
                <div class="text-muted text-xs">Ngày lập: @Model.IssuedAt.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>

        <hr class="my-3" />

        <!-- Customer details -->
        <div class="row mb-4">
            <div class="col-6">
                <span class="text-secondary text-xs d-block uppercase fw-semibold">Bệnh nhân</span>
                <strong>@Model.Patient?.FullName</strong>
                <div class="text-muted text-sm">Mã bệnh nhân: @Model.Patient?.PatientCode</div>
                <div class="text-muted text-sm">Điện thoại: @Model.Patient?.PhoneNumber</div>
            </div>
            <div class="col-6 text-end">
                <span class="text-secondary text-xs d-block uppercase fw-semibold">Thông tin thanh toán</span>
                <div class="text-dark">Phương thức: <strong>@Model.PaymentMethodCode</strong></div>
                <div class="text-dark">Trạng thái: <strong>@Model.Status</strong></div>
                @if (Model.PaidAt.HasValue)
                {
                    <div class="text-muted text-xs">Thời gian thu: @Model.PaidAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                }
            </div>
        </div>

        <!-- Table items -->
        <table class="table table-bordered align-middle text-sm mb-4">
            <thead class="table-light text-center">
                <tr>
                    <th style="width: 50px;">STT</th>
                    <th>Dịch vụ điều trị</th>
                    <th style="width: 80px;">SL</th>
                    <th style="width: 130px;" class="text-end">Đơn giá</th>
                    <th style="width: 140px;" class="text-end">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @{ int idx = 1; }
                @foreach (var d in Model.InvoiceDetails)
                {
                    <tr>
                        <td class="text-center">@(idx++)</td>
                        <td>
                            <strong>@d.MedicalService?.Name</strong>
                            @if (!string.IsNullOrEmpty(d.Description))
                            {
                                <div class="text-muted text-xs">@d.Description</div>
                            }
                        </td>
                        <td class="text-center">@d.Quantity</td>
                        <td class="text-end">@d.UnitPrice.ToString("N0") đ</td>
                        <td class="text-end fw-semibold">@d.Amount.ToString("N0") đ</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Summary -->
        <div class="row justify-content-end mb-5">
            <div class="col-5">
                <div class="d-flex justify-content-between mb-1 text-sm">
                    <span class="text-secondary">Tạm tính:</span>
                    <span>@Model.SubTotal.ToString("N0") đ</span>
                </div>
                <div class="d-flex justify-content-between mb-1 text-sm">
                    <span class="text-secondary">Thuế VAT (10%):</span>
                    <span>@Model.VATAmount.ToString("N0") đ</span>
                </div>
                <div class="d-flex justify-content-between mb-1 text-sm text-danger">
                    <span>Giảm giá:</span>
                    <span>-@Model.DiscountAmount.ToString("N0") đ</span>
                </div>
                <hr class="my-2" />
                <div class="d-flex justify-content-between text-dark fw-bold">
                    <span>Tổng cộng:</span>
                    <span class="text-primary fs-5">@Model.TotalAmount.ToString("N0") đ</span>
                </div>
            </div>
        </div>

        <!-- Footnote / Signatures -->
        <div class="row signature-section">
            <div class="col-6">
                <div class="signature-box">
                    <span class="fw-semibold text-secondary">Khách hàng ký nhận</span>
                    <span class="text-muted text-xs">(Ký và ghi rõ họ tên)</span>
                </div>
            </div>
            <div class="col-6 text-end">
                <div class="signature-box">
                    <span class="fw-semibold text-secondary">Người lập hóa đơn</span>
                    <strong class="text-dark">@Model.CreatedBy</strong>
                </div>
            </div>
        </div>

        <div class="text-center mt-5 text-secondary text-xs pt-4 border-top">
            Cảm ơn quý khách đã tin tưởng dịch vụ chăm sóc răng miệng tại phòng khám của chúng tôi!
        </div>
    </div>

</body>
</html>
