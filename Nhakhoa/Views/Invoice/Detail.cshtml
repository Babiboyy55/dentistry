@model Nhakhoa.Models.Invoice

@{
    ViewData["Title"] = $"Hóa đơn {Model.InvoiceCode}";
    Layout = "_AdminLayout";
    var paymentMethods = ViewBag.PaymentMethods as List<Nhakhoa.Models.PaymentMethod> ?? new List<Nhakhoa.Models.PaymentMethod>();
}

<div class="container-fluid py-4" style="max-width: 900px;">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Hóa đơn & Thanh toán</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chi tiết hóa đơn</li>
        </ol>
    </nav>

    <!-- Header Page Actions -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 text-dark fw-bold mb-1" style="font-family: 'Inter', sans-serif;">Hóa đơn: <span class="font-monospace">@Model.InvoiceCode</span></h1>
            <p class="text-muted small mb-0">Thời gian tạo: @Model.IssuedAt.ToString("dd/MM/yyyy HH:mm") | Lập bởi: @Model.CreatedBy</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="PrintInvoice" asp-route-id="@Model.Id" target="_blank" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-semibold shadow-none">
                <i class="bi bi-printer me-1"></i> In hóa đơn
            </a>
            <a asp-action="Index" class="btn btn-light btn-sm rounded-pill px-3 fw-semibold border shadow-none">
                <i class="bi bi-arrow-left me-1"></i> Trở lại
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left: Invoice Details Card -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <!-- Customer Info -->
                <div class="row mb-4">
                    <div class="col-12 col-md-6 mb-3 mb-md-0">
                        <span class="text-muted text-xs d-block uppercase fw-semibold mb-1">Khách hàng</span>
                        <strong class="text-dark">@Model.Patient?.FullName</strong>
                        <span class="text-secondary text-sm d-block">SĐT: @Model.Patient?.PhoneNumber</span>
                        <span class="text-secondary text-sm d-block">Mã: @Model.Patient?.PatientCode</span>
                    </div>
                    <div class="col-12 col-md-6">
                        <span class="text-muted text-xs d-block uppercase fw-semibold mb-1">Bác sĩ phụ trách EMR</span>
                        <strong class="text-dark">@Model.ExaminationSession?.Doctor?.User?.FullName</strong>
                        <span class="text-secondary text-sm d-block">Phòng: @Model.ExaminationSession?.Doctor?.PrimaryClinic</span>
                    </div>
                </div>

                <!-- Performed Services Table -->
                <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Dịch vụ nha khoa chỉ định</h6>
                <div class="table-responsive mb-4">
                    <table class="table align-middle mb-0 text-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Tên dịch vụ</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model.InvoiceDetails)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">@d.MedicalService?.Name</div>
                                        <small class="text-muted">@d.MedicalService?.Department</small>
                                    </td>
                                    <td class="text-center">@d.Quantity</td>
                                    <td class="text-end">@d.UnitPrice.ToString("N0") đ</td>
                                    <td class="text-end fw-semibold">@d.Amount.ToString("N0") đ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Financial Breakdown -->
                <div class="row justify-content-end">
                    <div class="col-12 col-md-6">
                        <div class="p-3 bg-light rounded-4">
                            <div class="d-flex justify-content-between mb-2 text-xs text-secondary">
                                <span>Tạm tính:</span>
                                <span class="fw-semibold">@Model.SubTotal.ToString("N0") đ</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2 text-xs text-secondary">
                                <span>VAT (10%):</span>
                                <span class="fw-semibold">@Model.VATAmount.ToString("N0") đ</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2 text-xs text-secondary">
                                <span>Giảm giá:</span>
                                <span class="fw-semibold text-danger">-@Model.DiscountAmount.ToString("N0") đ</span>
                            </div>
                            <hr class="my-2 border-secondary-subtle" />
                            <div class="d-flex justify-content-between text-dark">
                                <span class="fw-bold text-sm">Tổng cộng:</span>
                                <span class="fw-bold text-primary">@Model.TotalAmount.ToString("N0") đ</span>
                            </div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="mt-4 p-3 bg-warning-subtle rounded-4 text-xs text-warning-emphasis">
                        <strong><i class="bi bi-info-circle me-1"></i> Ghi chú hóa đơn:</strong> @Model.Notes
                    </div>
                }
            </div>
        </div>

        <!-- Right: Status / Payment Processing -->
        <div class="col-12 col-lg-4">
            <!-- Status Card -->
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4 text-center">
                <span class="text-muted text-xs d-block uppercase fw-semibold mb-2">Trạng thái thanh toán</span>
                @{
                    var statusClass = Model.Status == "Đã thanh toán" ? "bg-success-subtle text-success" :
                                      Model.Status == "Chờ thanh toán" ? "bg-warning-subtle text-warning-emphasis" :
                                      Model.Status == "Đã hoàn tiền" ? "bg-info-subtle text-info-emphasis" :
                                      "bg-danger-subtle text-danger";
                }
                <div class="fs-4 fw-bold py-2 px-4 rounded-pill d-inline-block mx-auto mb-3 @statusClass">
                    @Model.Status
                </div>

                @if (Model.Status == "Đã thanh toán" && Model.PaidAt.HasValue)
                {
                    <div class="text-muted text-xs">
                        <i class="bi bi-calendar-check me-1"></i> Thu ngày: @Model.PaidAt.Value.ToString("dd/MM/yyyy HH:mm")
                    </div>
                    <div class="text-muted text-xs mt-1">
                        <i class="bi bi-tag me-1"></i> Mã GD: @Model.Payments.FirstOrDefault(p => p.Status == "Đã thanh toán")?.TransactionCode
                    </div>
                }
            </div>

            <!-- Payment Action Card (Only if Pending) -->
            @if (Model.Status == "Chờ thanh toán")
            {
                <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                    <h6 class="fw-bold mb-3 text-dark"><i class="bi bi-credit-card me-1 text-primary"></i> Tiến hành thu tiền</h6>
                    <div class="mb-3">
                        <label class="form-label text-sm fw-bold">Chọn phương thức</label>
                        <select id="checkoutPaymentMethod" class="form-select rounded-3 border-secondary-subtle shadow-none">
                            @foreach (var pm in paymentMethods)
                            {
                                <option value="@pm.Code" data-digital="@(pm.IsDigitalGateway ? "true" : "false")">@pm.Name</option>
                            }
                        </select>
                    </div>

                    <button onclick="processInvoicePayment()" class="btn btn-primary w-100 py-2 rounded-pill fw-bold shadow-sm">
                        <i class="bi bi-wallet2 me-1"></i> Xác nhận Thanh toán
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- MODAL CHECKOUT CỔNG THANH TOÁN ONLINE (MOMO/VNPAY MOCK GATEWAY SIMULATOR) -->
<div class="modal fade" id="gatewayModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content rounded-4 border-0 shadow-lg bg-dark text-white overflow-hidden">
            <div class="p-4 text-center" style="background: linear-gradient(135deg, #1f1f2e 0%, #0d0d1a 100%);">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="badge bg-danger rounded-pill px-3 py-1 text-xxs font-monospace">SANDBOX GATEWAY</span>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                
                <h4 class="fw-bold mb-1" id="gatewayTitle">Cổng Thanh Toán</h4>
                <p class="text-secondary text-xs">Mã hóa đơn: <strong class="text-light">@Model.InvoiceCode</strong></p>

                <!-- QR CODE SIMULATOR -->
                <div class="bg-white p-3 rounded-4 d-inline-block my-3 shadow-sm">
                    <!-- Draw a simulated QR Code using basic CSS grid -->
                    <div class="d-grid gap-1 bg-white" style="grid-template-columns: repeat(6, 25px); padding: 5px;">
                        <div class="bg-dark" style="width:25px; height:25px;"></div>
                        <div class="bg-dark" style="width:25px; height:25px;"></div>
                        <div class="bg-white" style="width:25px; height:25px;"></div>
                        <div class="bg-dark" style="width:25px; height:25px;"></div>
                        <div class="bg-dark" style="width:25px; height:25px;"></div>
                        <div class="bg-dark" style="width:25px; height:25px;"></div>
                        <div class="bg-dark" style="width:25px; height:25px;"></div>
                        <div class="bg-white" style="width:25px; height:25px;"></div>
                        <div class="bg-dark" style="width:25px; height:25px;"></div>
                        <div class="bg-white" style="width:25px; height:25px;"></div>
                        <div class="bg-white" style="width:25px; height:25px;"></div>
                        <div class="bg-dark" style="width:25px; height:25px;"></div>
                        <div class="bg-white" style="width:25px; height:25px;"></div>
                        <div class="bg-dark" style="width:25px; height:25px;"></div>
                        <div class="bg-white" style="width:25px; height:25px;"></div>
                        <div class="bg-dark" style="width:25px; height:25px;"></div>
                        <div class="bg-dark" style="width:25px; height:25px;"></div>
                        <div class="bg-white" style="width:25px; height:25px;"></div>
                        <div class="bg-dark" style="width:25px; height:25px;"></div>
                        <div class="bg-white" style="width:25px; height:25px;"></div>
                        <div class="bg-dark" style="width:25px; height:25px;"></div>
                        <div class="bg-white" style="width:25px; height:25px;"></div>
                        <div class="bg-white" style="width:25px; height:25px;"></div>
                        <div class="bg-dark" style="width:25px; height:25px;"></div>
                        <div class="bg-dark" style="width:25px; height:25px;"></div>
                        <div class="bg-white" style="width:25px; height:25px;"></div>
                        <div class="bg-white" style="width:25px; height:25px;"></div>
                        <div class="bg-dark" style="width:25px; height:25px;"></div>
                        <div class="bg-dark" style="width:25px; height:25px;"></div>
                        <div class="bg-white" style="width:25px; height:25px;"></div>
                        <div class="bg-dark" style="width:25px; height:25px;"></div>
                        <div class="bg-dark" style="width:25px; height:25px;"></div>
                        <div class="bg-white" style="width:25px; height:25px;"></div>
                        <div class="bg-dark" style="width:25px; height:25px;"></div>
                        <div class="bg-white" style="width:25px; height:25px;"></div>
                        <div class="bg-dark" style="width:25px; height:25px;"></div>
                    </div>
                </div>

                <div class="text-light fs-5 fw-bold font-monospace">@Model.TotalAmount.ToString("N0") VND</div>
                <p class="text-secondary text-xs mt-1">Vui lòng chọn mô phỏng kết quả giao dịch online:</p>

                <!-- GATEWAY INTERACTION BUTTONS (EX-5.2.2) -->
                <div class="d-flex flex-column gap-2 mt-4">
                    <button onclick="simulateOnlinePayment('success')" class="btn btn-success rounded-pill py-2.5 fw-bold shadow-sm">
                        <i class="bi bi-check-circle me-1"></i> Mô phỏng Thành Công
                    </button>
                    <button onclick="simulateOnlinePayment('failure')" class="btn btn-outline-danger rounded-pill py-2.5 fw-bold">
                        <i class="bi bi-x-circle me-1"></i> Mô phỏng Thất Bại / Timeout
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function processInvoicePayment() {
        const pmSelect = document.getElementById("checkoutPaymentMethod");
        const methodCode = pmSelect.value;
        const option = pmSelect.options[pmSelect.selectedIndex];
        const isDigital = option.getAttribute("data-digital") === "true";

        if (isDigital) {
            // Open mock gateway checkout popup (MoMo/VNPay simulation)
            document.getElementById("gatewayTitle").innerText = `Thanh toán qua ${option.text}`;
            const modal = new bootstrap.Modal(document.getElementById("gatewayModal"));
            modal.show();
        } else {
            // Process cash/bank immediately
            submitPaymentRequest(methodCode, null, null);
        }
    }

    function simulateOnlinePayment(status) {
        const pmSelect = document.getElementById("checkoutPaymentMethod");
        const methodCode = pmSelect.value;
        
        // Hide gateway modal
        bootstrap.Modal.getInstance(document.getElementById("gatewayModal")).hide();

        if (status === 'success') {
            submitPaymentRequest(methodCode, 'success', null);
        } else {
            // Simulate error callback (EX-5.2.2)
            submitPaymentRequest(methodCode, 'failure', 'Mô phỏng: Người dùng hủy thanh toán hoặc giao dịch bị hết hạn (timeout) tại cổng thanh toán.');
        }
    }

    function submitPaymentRequest(methodCode, status, errorMsg) {
        let body = `invoiceId=${@Model.Id}&paymentMethodCode=${methodCode}`;
        if (status) body += `&gatewayStatus=${status}`;
        if (errorMsg) body += `&gatewayError=${encodeURIComponent(errorMsg)}`;

        fetch('/Invoice/ProcessPayment', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                alert(data.message);
                location.reload();
            } else {
                // Show failure alert in UI and don't deduct patient account (EX-5.2.2)
                alert("Thất bại: " + data.message);
            }
        })
        .catch(err => {
            console.error(err);
            alert("Lỗi kết nối máy chủ thanh toán.");
        });
    }
</script>
}
