// ─── UC4.3 — Complex sessions ─────────────────────────────────────
async function loadComplexSessions() {
    const doctorId = document.getElementById('cxDoctor').value;
    const month = document.getElementById('cxMonth').value;
    const year = document.getElementById('cxYear').value;
    const res = await fetch(`/Payroll/GetComplexSessions?doctorId=${doctorId}&month=${month}&year=${year}`);
    const sessions = await res.json();

    if (!sessions.length) {
        document.getElementById('cxTable').innerHTML = '<div class="text-muted small p-3">Không có ca khám nào trong tháng này.</div>';
        return;
    }

    let html = `<table class="pr-table">
        <thead><tr><th>#</th><th>Ngày</th><th>Bệnh nhân</th><th>Chẩn đoán</th><th>Hệ số BN (0.0–0.5)</th><th></th></tr></thead><tbody>`;
    sessions.forEach((s, i) => {
        html += `<tr>
            <td>${i + 1}</td>
            <td>${new Date(s.createdAt).toLocaleDateString('vi-VN')}</td>
            <td>${s.patientName}</td>
            <td>${s.diagnosis || '—'}</td>
            <td><input type="number" class="form-control form-control-sm w-auto" id="coeff_${s.id}"
                min="0" max="0.5" step="0.1" value="${s.patientCoefficient}" style="width:90px!important;" /></td>
            <td><button class="btn btn-outline-primary btn-sm rounded-pill" onclick="saveCoeff(${s.id})">
                <i class="bi bi-check2"></i> Lưu
            </button></td>
        </tr>`;
    });
    html += '</tbody></table>';
    document.getElementById('cxTable').innerHTML = html;
}

async function saveCoeff(sessionId) {
    const val = parseFloat(document.getElementById(`coeff_${sessionId}`).value);
    const res = await fetch('/Payroll/SaveComplexSessionCoefficient', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sessionId, coefficient: val })
    });
    if (res.ok) showToast('Đã lưu hệ số bệnh nhân!', 'success');
    else { const d = await res.json(); showToast(d.error || 'Lỗi.', 'danger'); }
}

