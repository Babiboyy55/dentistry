    document.getElementById('slipMonth').value = month;
    document.getElementById('slipYear').value = year;

    // Cập nhật trạng thái active trên danh sách bác sĩ (chips)
    const list = document.getElementById('slipDoctorList');
    if (list) {
        list.querySelectorAll('.doctor-badge-item').forEach(item => {
            if (item.getAttribute('data-id') == doctorId) {
                item.classList.add('active');
            } else {
                item.classList.remove('active');
            }
        });
    }

    const slipLink = document.querySelector('.pr-item[data-section="sec-slip"]');
    if (slipLink) slipLink.click();
    loadSlip();
}

