                <div class="mb-3" id="reviewCoeffGroup">
                    <label class="form-label fw-semibold small">Hệ số phê duyệt <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-plus-slash-minus"></i></span>
                        <input type="number" class="form-control" id="reviewApprovedCoeff"
                               min="0.10" max="0.50" step="0.05" placeholder="0.10 – 0.50" />
                    </div>
                    <small class="text-muted">Bạn có thể điều chỉnh hệ số so với đề xuất của bác sĩ.</small>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Ghi chú admin (tuỳ chọn)</label>
                    <textarea class="form-control rounded-3" id="reviewAdminNote" rows="3"
                              placeholder="Lý do duyệt/từ chối, điều kiện kèm theo..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-success rounded-pill px-4 fw-semibold" id="btnConfirmReview" onclick="submitReview()">
                    <i class="bi bi-check-circle-fill me-1"></i>Xác nhận
                </button>
            </div>
        </div>
    </div>
</div>
