// ─── UC4.3 NEW — Complex approval ─────────────────────────────────
let allComplexSessions = [];
let currentFilter = 'Pending';

async function loadPendingCount() {
    try {
        const res = await fetch('/Payroll/GetPendingComplexCount');
        const data = await res.json();
        const badge = document.getElementById('pendingBadge');
        const cntBadge = document.getElementById('cntPending');
        if (badge) {
            if (data.count > 0) {
                badge.textContent = data.count;
                badge.style.display = 'inline';
            } else {
                badge.style.display = 'none';
            }
        }
        if (cntBadge) cntBadge.textContent = data.count;
    } catch(e) {}
}

async function loadPendingComplexSessions() {
    document.getElementById('approveTable').innerHTML = '<div class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Đang tải...</div>';
    try {
        const res = await fetch('/Payroll/GetAllComplexSessions');
        allComplexSessions = await res.json();
        renderApproveTable(currentFilter);
        loadPendingCount();
    } catch(e) {
        document.getElementById('approveTable').innerHTML = '<div class="alert alert-danger">Lỗi tải dữ liệu.</div>';
    }
}

function filterApproveTable(status) {
    currentFilter = status;
    ['Pending', 'Approved', 'Rejected'].forEach(s => {
        const btn = document.getElementById('filter' + s);
        if (btn) btn.classList.toggle('btn-outline-secondary', s !== status);
    });
    renderApproveTable(status);
}

function renderApproveTable(status) {
    const sessions = allComplexSessions.filter(s => s.complexStatus === status);

    if (!sessions.length) {
        document.getElementById('approveTable').innerHTML = `<div class="text-center py-5 text-muted"><i class="bi bi-inbox display-4 opacity-25 d-block mb-2"></i>Không có ca nào ở trạng thái "${status === 'Pending' ? 'Chờ duyệt' : status === 'Approved' ? 'Đã duyệt' : 'Đã từ chối'}".</div>`;
        return;
    }

    let html = `<table class="pr-table">
        <thead><tr>
            <th>#</th><th>Ngày</th><th>Bác sĩ</th><th>Bệnh nhân</th>
            <th>Chẩn đoán</th><th>Lý do báo</th>
            <th>HệSố đề xuất</th>
            ${status === 'Pending' ? '<th>Hành động</th>' : '<th>Kết quả</th>'}
        </tr></thead><tbody>`;

    sessions.forEach((s, i) => {
        const date = new Date(s.createdAt).toLocaleDateString('vi-VN');
        const reason = s.complexReason ? `<span title="${s.complexReason}">${s.complexReason.substring(0, 60)}${s.complexReason.length > 60 ? '...' : ''}</span>` : '—';

        let actionCell = '';
        if (status === 'Pending') {
            actionCell = `<td class="d-flex gap-1">
                <button class="btn btn-success btn-sm rounded-pill px-2" onclick="openReviewModal(${s.id}, 'Approved', ${s.requestedCoefficient ?? 0.20}, \`${s.doctorName}\`, \`${s.patientName}\`)">
                    <i class="bi bi-check-lg"></i> Duyệt
                </button>
                <button class="btn btn-danger btn-sm rounded-pill px-2" onclick="openReviewModal(${s.id}, 'Rejected', ${s.requestedCoefficient ?? 0.20}, \`${s.doctorName}\`, \`${s.patientName}\`)">
                    <i class="bi bi-x-lg"></i> Từ chối
                </button>
            </td>`;
        } else if (status === 'Approved') {
            actionCell = `<td><span class="badge rounded-pill px-3 py-2" style="background:#d1fae5;color:#065f46;border:1px solid #6ee7b7;">✅ Hệ số: ${s.patientCoefficient?.toFixed(2)}</span>
                ${s.adminNote ? `<div class="text-muted small mt-1">${s.adminNote}</div>` : ''}</td>`;
        } else {
            actionCell = `<td><span class="badge rounded-pill px-3 py-2" style="background:#fee2e2;color:#991b1b;border:1px solid #fca5a5;">❌ Từ chối</span>
                ${s.adminNote ? `<div class="text-muted small mt-1">${s.adminNote}</div>` : ''}</td>`;
        }

        html += `<tr>
            <td>${i + 1}</td>
            <td>${date}</td>
            <td class="fw-semibold">${s.doctorName}</td>
            <td>${s.patientName}</td>
            <td>${s.diagnosis || '—'}</td>
            <td class="small text-secondary">${reason}</td>
            <td><span class="badge bg-primary rounded-pill">${(s.requestedCoefficient ?? 0).toFixed(2)}</span></td>
            ${actionCell}
        </tr>`;
    });

    html += '</tbody></table>';
    document.getElementById('approveTable').innerHTML = html;
}

// Modal duyệt/từ chối
let reviewSessionId = null;
let reviewAction = null;

function openReviewModal(sessionId, action, defaultCoeff, doctorName, patientName) {
    reviewSessionId = sessionId;
    reviewAction = action;
    document.getElementById('reviewModalTitle').textContent = action === 'Approved' ? '✅ Duyệt ca phức tạp' : '❌ Từ chối ca phức tạp';
    document.getElementById('reviewModalContext').textContent = `Bác sĩ: ${doctorName} | Bệnh nhân: ${patientName}`;
    document.getElementById('reviewApprovedCoeff').value = defaultCoeff.toFixed(2);
    document.getElementById('reviewAdminNote').value = '';

    const coeffGroup = document.getElementById('reviewCoeffGroup');
    if (action === 'Approved') {
        coeffGroup.style.display = 'block';
        document.getElementById('btnConfirmReview').className = 'btn btn-success rounded-pill px-4 fw-semibold';
        document.getElementById('btnConfirmReview').innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>Xác nhận duyệt';
    } else {
        coeffGroup.style.display = 'none';
        document.getElementById('btnConfirmReview').className = 'btn btn-danger rounded-pill px-4 fw-semibold';
        document.getElementById('btnConfirmReview').innerHTML = '<i class="bi bi-x-circle-fill me-1"></i>Xác nhận từ chối';
    }
    reviewModal.show();
}

async function submitReview() {
    const btn = document.getElementById('btnConfirmReview');
    const coeff = reviewAction === 'Approved' ? parseFloat(document.getElementById('reviewApprovedCoeff').value) : 0.1;
    const note = document.getElementById('reviewAdminNote').value.trim();

    if (reviewAction === 'Approved' && (isNaN(coeff) || coeff < 0.1 || coeff > 0.5)) {
        alert('Hệ số duyệt phải từ 0.10 đến 0.50.');
        return;
    }

    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang xử lý...';

    try {
        const res = await fetch('/Payroll/ReviewComplexSession', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sessionId: reviewSessionId, action: reviewAction, approvedCoefficient: coeff, adminNote: note })
        });
        const data = await res.json();

        if (res.ok && data.success) {
            reviewModal.hide();
            showToast(reviewAction === 'Approved' ? '✅ Đã duyệt và ghi nhận hệ số thành công!' : '❌ Đã từ chối yêu cầu.', reviewAction === 'Approved' ? 'success' : 'warning');
            await loadPendingComplexSessions();
        } else {
            alert(data.error || 'Có lỗi xảy ra.');
        }
    } catch(e) {
        alert('Lỗi kết nối.');
    } finally {
        btn.disabled = false;
    }
}
</script>
}

<!-- Modal Duyệt/Từ chối ca phức tạp -->
<div class="modal fade" id="reviewComplexModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-2">
                <h5 class="modal-title fw-bold" id="reviewModalTitle">Duyệt ca phức tạp</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4">
