@section Scripts {
    <script>
        var originalPrice = 0;
        var originalName = "";
        var offcanvasInstance;
        var constraintModalInstance;
        var deleteConfirmModalInstance;
        var viewDetailsModalInstance;

        $(document).ready(function () {
            offcanvasInstance = new bootstrap.Offcanvas(document.getElementById('serviceEditOffcanvas'));
            constraintModalInstance = new bootstrap.Modal(document.getElementById('constraintModal'));
            deleteConfirmModalInstance = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
            viewDetailsModalInstance = new bootstrap.Modal(document.getElementById('viewDetailsModal'));

            // Live Change Comparison Logic
            $('#inputPrice, #inputName').on('input', function() {
                updateCompareBox();
            });
        });

        function formatCurrency(number) {
            return new Intl.NumberFormat('vi-VN').format(number) + 'đ';
        }

        function updateCompareBox() {
            var currentId = parseInt($('#serviceId').val());
            if (currentId === 0) {
                // Creating new - no compare box needed
                $('#compareBox').addClass('d-none');
                return;
            }

            var currentPrice = parseFloat($('#inputPrice').val()) || 0;
            var currentName = $('#inputName').val().trim();

            var priceChanged = currentPrice !== originalPrice;
            var nameChanged = currentName !== originalName && currentName !== "";

            if (priceChanged || nameChanged) {
                $('#compareBox').removeClass('d-none');
                
                // Price row toggle
                if (priceChanged) {
                    $('#comparePriceRow').removeClass('d-none');
                    $('#origPrice').text(formatCurrency(originalPrice));
                    $('#newPrice').text(formatCurrency(currentPrice));
                } else {
                    $('#comparePriceRow').addClass('d-none');
                }

                // Name row toggle
                if (nameChanged) {
                    $('#compareNameRow').removeClass('d-none');
                    $('#origName').text(originalName).attr('title', originalName);
                    $('#newName').text(currentName).attr('title', currentName);
                } else {
                    $('#compareNameRow').addClass('d-none');
                }
            } else {
                $('#compareBox').addClass('d-none');
            }
        }

        function openCreatePanel() {
            $('#offcanvasTitle').text('Thêm dịch vụ mới');
            $('#serviceId').val(0);
            $('#inputName').val('');
            $('#inputDescription').val('');
            $('#inputPrice').val('');
            $('#inputDepartment').val('Nội tổng quát');
            $('#inputIsActive').prop('checked', true);
            
            originalPrice = 0;
            originalName = "";
            $('#compareBox').addClass('d-none');
            
            offcanvasInstance.show();
        }

        function openEditPanel(id) {
            $('#offcanvasTitle').text('Chỉnh sửa dịch vụ y tế');
            
            $.get('/MedicalService/DetailsJson/' + id, function (data) {
                $('#serviceId').val(data.id);
                $('#inputName').val(data.name);
                $('#inputDescription').val(data.description);
                $('#inputPrice').val(data.price);
                $('#inputDepartment').val(data.department);
                $('#inputIsActive').prop('checked', data.isActive);

                originalPrice = data.price;
                originalName = data.name;
                
                $('#compareBox').addClass('d-none'); // Hide initially until user types
                offcanvasInstance.show();
            }).fail(function() {
                alert('Có lỗi xảy ra khi lấy thông tin dịch vụ.');
            });
        }

        function viewDetails(id) {
            $.get('/MedicalService/DetailsJson/' + id, function (data) {
                $('#detailName').text(data.name);
                $('#detailDescription').text(data.description || 'Không có mô tả.');
                $('#detailPrice').text(formatCurrency(data.price));
                $('#detailDepartment').text(data.department);
                
                var statusHtml = data.isActive 
                    ? '<span class="badge bg-success-subtle text-success px-2.5 py-1.5 rounded-pill fw-semibold d-inline-flex align-items-center gap-1"><span class="status-indicator bg-success"></span> Kích hoạt</span>'
                    : '<span class="badge bg-secondary-subtle text-secondary px-2.5 py-1.5 rounded-pill fw-semibold d-inline-flex align-items-center gap-1"><span class="status-indicator bg-secondary"></span> Ẩn</span>';
                
                $('#detailStatus').html(statusHtml);
                $('#detailUpdatedAt').text(data.updatedAt);
                
                viewDetailsModalInstance.show();
            }).fail(function() {
                alert('Có lỗi xảy ra khi lấy thông tin dịch vụ.');
            });
        }

        function confirmDelete(id) {
            $.get('/MedicalService/GetDeleteConstraints/' + id, function (data) {
                if (data.hasConstraints) {
                    // Show block constraint modal
                    $('#constraintServiceName').text('"' + data.serviceName + '"');
                    $('#countAppointments').text(String(data.upcomingAppointments).padStart(2, '0'));
                    $('#countBills').text(String(data.unpaidBills).padStart(2, '0'));
                    $('#hideServiceId').val(id);
                    
                    constraintModalInstance.show();
                } else {
                    // Show standard delete confirm modal
                    $('#deleteServiceName').text('"' + data.serviceName + '"');
                    $('#deleteServiceId').val(id);
                    
                    deleteConfirmModalInstance.show();
                }
            }).fail(function() {
                alert('Có lỗi xảy ra khi kiểm tra ràng buộc.');
            });
        }

        function exportExcel() {
            alert('Chức năng xuất excel đang được chuẩn bị.');
        }
    </script>
}
