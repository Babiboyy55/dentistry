@model List<Nhakhoa.Models.Patient>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý hồ sơ bệnh nhân";
    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int total = ViewBag.Total ?? 0;
    var lastAppts = ViewBag.LastAppts as Dictionary<int, DateTime> ?? new Dictionary<int, DateTime>();
}

<!-- Header -->
<div class="d-flex align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-0" style="color:#0b1f35">
            Quản lý bệnh nhân và hồ sơ
        </h4>
        <div class="text-muted small mt-1">Tra cứu và tạo hồ sơ bệnh nhân trong hệ thống phòng khám.</div>
    </div>
    <div>
        <a href="/Patient/Create" class="btn btn-primary btn-sm px-3 py-2 fw-semibold d-flex align-items-center gap-2 rounded-2" style="background:#1b75d0; border-color:#1b75d0;">
            <i class="bi bi-plus-lg"></i> Tạo hồ sơ mới
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 rounded-3 py-2 px-3 mb-3"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]</div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning border-0 rounded-3 py-2 px-3 mb-3"><i class="bi bi-exclamation-circle me-2"></i>@TempData["Warning"]</div>
}

<!-- Dashboard Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border h-100 bg-white rounded-3 shadow-sm">
            <div class="card-body p-3">
                <div class="text-muted small text-uppercase fw-semibold" style="font-size:0.75rem; letter-spacing: 0.05em;">Tổng bệnh nhân</div>
                <div class="d-flex align-items-center justify-content-between mt-2">
                    <h3 class="fw-bold mb-0 text-dark">@ViewBag.StatTotal</h3>
                    <i class="bi bi-people text-primary fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border h-100 bg-white rounded-3 shadow-sm">
            <div class="card-body p-3">
                <div class="text-muted small text-uppercase fw-semibold" style="font-size:0.75rem; letter-spacing: 0.05em;">Hôm nay</div>
                <div class="d-flex align-items-center justify-content-between mt-2">
                    <h3 class="fw-bold mb-0 text-dark">+@ViewBag.StatToday</h3>
                    <i class="bi bi-person-plus text-success fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border h-100 bg-white rounded-3 shadow-sm">
            <div class="card-body p-3">
                <div class="text-muted small text-uppercase fw-semibold" style="font-size:0.75rem; letter-spacing: 0.05em;">Dị ứng nặng</div>
                <div class="d-flex align-items-center justify-content-between mt-2">
                    <h3 class="fw-bold mb-0 text-dark">@ViewBag.StatAllergies</h3>
                    <i class="bi bi-exclamation-triangle text-danger fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border h-100 bg-white rounded-3 shadow-sm">
            <div class="card-body p-3">
                <div class="text-muted small text-uppercase fw-semibold" style="font-size:0.75rem; letter-spacing: 0.05em;">Lượt khám tháng</div>
                <div class="d-flex align-items-center justify-content-between mt-2">
                    <h3 class="fw-bold mb-0 text-dark">@ViewBag.StatAppointments</h3>
                    <i class="bi bi-calendar-check text-warning fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Search, Tabs & Filters -->
<div class="card border rounded-3 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" id="filterForm" class="row g-3 align-items-center">
            <!-- Search field -->
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control"
                           placeholder="Tìm theo tên, SĐT hoặc mã bệnh nhân..." />
                </div>
            </div>

            <!-- Tab Filters (Gender/Allergy) -->
            <div class="col-md-5">
                <input type="hidden" name="gender" id="genderInput" value="@ViewBag.Gender" />
                <input type="hidden" name="allergy" id="allergyInput" value="@ViewBag.Allergy" />

                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn @(string.IsNullOrEmpty(ViewBag.Gender) && string.IsNullOrEmpty(ViewBag.Allergy) ? "btn-primary" : "btn-outline-secondary")"
                            onclick="setFilters('', '')">Tất cả</button>
                    <button type="button" class="btn @(ViewBag.Gender == "Nam" ? "btn-primary" : "btn-outline-secondary")"
                            onclick="setFilters('Nam', '')">Nam</button>
                    <button type="button" class="btn @(ViewBag.Gender == "Nữ" ? "btn-primary" : "btn-outline-secondary")"
                            onclick="setFilters('Nữ', '')">Nữ</button>
                    <button type="button" class="btn @(ViewBag.Allergy == "true" ? "btn-primary" : "btn-outline-secondary")"
                            onclick="setFilters('', 'true')">Có dị ứng</button>
                </div>
            </div>

            <!-- Sort option -->
            <div class="col-md-3 d-flex justify-content-md-end align-items-center gap-2">
                <span class="text-muted small text-nowrap">Sắp xếp:</span>
                <select name="sortBy" class="form-select form-select-sm rounded-2 w-auto" onchange="document.getElementById('filterForm').submit()">
                    <!option value="newest" @(ViewBag.SortBy == "newest" ? "selected" : "")>Ngày tạo mới nhất</!option>
                    <!option value="last_appt" @(ViewBag.SortBy == "last_appt" ? "selected" : "")>Lần khám gần nhất</!option>
                </select>
            </div>
        </form>
    </div>
</div>

<!-- Patient List Table -->
<div class="card border rounded-3 shadow-sm">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-person-x display-4 opacity-25 d-block mb-3"></i>
                Không tìm thấy bệnh nhân nào khớp với tiêu chí tìm kiếm.
                <div class="mt-2">
                    <a href="/Patient/Create@(ViewBag.Search != null ? "?phone=" + ViewBag.Search : "")" class="btn btn-primary btn-sm rounded-2 px-3">Tạo hồ sơ bệnh nhân mới</a>
                </div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0" style="font-size:0.9rem;">
                    <thead style="background:#f8faff; border-bottom:2px solid #e8edf5;">
                        <tr>
                            <th class="px-4 py-3 text-muted fw-semibold text-nowrap">Mã BN</th>
                            <th class="py-3 text-muted fw-semibold text-nowrap">Họ và tên</th>
                            <th class="py-3 text-muted fw-semibold text-nowrap">Ngày sinh / Giới tính</th>
                            <th class="py-3 text-muted fw-semibold text-nowrap">Số điện thoại</th>
                            <th class="py-3 text-muted fw-semibold">Dị ứng cơ bản</th>
                            <th class="py-3 text-muted fw-semibold text-nowrap">Lần khám cuối</th>
                            <th class="py-3 text-muted fw-semibold pe-4 text-center text-nowrap">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr class="border-bottom">
                                <td class="px-4 text-nowrap">
                                    <span class="fw-bold text-primary">@p.PatientCode</span>
                                </td>
                                <td>
                                    <div>
                                        <div class="fw-semibold text-dark">@p.FullName</div>
                                        @if (!string.IsNullOrEmpty(p.Email))
                                        {
                                            <div class="text-muted small" style="font-size: 0.8rem;">@p.Email</div>
                                        }
                                    </div>
                                </td>
                                <td class="text-nowrap">
                                    <div>@(p.DateOfBirth.HasValue ? p.DateOfBirth.Value.ToString("dd/MM/yyyy") : "—")</div>
                                    @if (!string.IsNullOrEmpty(p.Gender))
                                    {
                                        <div class="text-muted small text-capitalize">@p.Gender</div>
                                    }
                                </td>
                                <td class="text-nowrap"><span class="fw-semibold">@p.PhoneNumber</span></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(p.AllergyHistory))
                                    {
                                        <span class="text-danger small d-inline-block" style="max-width: 250px; line-height: 1.3;"><i class="bi bi-exclamation-triangle-fill me-1"></i>@p.AllergyHistory</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    @if (lastAppts.ContainsKey(p.Id))
                                    {
                                        <span class="fw-semibold text-secondary">@lastAppts[p.Id].ToString("dd/MM/yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Chưa khám</span>
                                    }
                                </td>
                                <td class="text-center pe-4 text-nowrap">
                                    <div class="d-flex gap-2 justify-content-center text-nowrap">
                                        <a href="/Patient/Details/@p.Id" class="btn btn-outline-primary btn-sm rounded-2 px-3 fw-semibold">
                                            <i class="bi bi-eye"></i> Hồ sơ
                                        </a>
                                        <a href="/Appointment/Create?patientId=@p.Id" class="btn btn-outline-success btn-sm rounded-2 px-3 fw-semibold">
                                            <i class="bi bi-calendar-plus"></i> Đặt lịch
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <nav aria-label="Page navigation" class="d-flex justify-content-center py-3">
                    <ul class="pagination pagination-sm mb-0">
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == page ? "active" : "")">
                                <a class="page-link" href="?search=@ViewBag.Search&gender=@ViewBag.Gender&allergy=@ViewBag.Allergy&sortBy=@ViewBag.SortBy&page=@i">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        function setFilters(gender, allergy) {
            document.getElementById('genderInput').value = gender;
            document.getElementById('allergyInput').value = allergy;
            document.getElementById('filterForm').submit();
        }
    </script>
}
