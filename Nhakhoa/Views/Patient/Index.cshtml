@model List<Nhakhoa.Models.Patient>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý hồ sơ bệnh nhân";
    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int total = ViewBag.Total ?? 0;
    var lastAppts = ViewBag.LastAppts as Dictionary<int, DateTime> ?? new Dictionary<int, DateTime>();
}

<!-- Header -->
<div class="d-flex align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-0" style="color:#0b1f35">
            <i class="bi bi-journal-medical text-primary me-2"></i>Quản lý bệnh nhân và hồ sơ
        </h4>
        <div class="text-muted small mt-1">Tra cứu và tạo hồ sơ bệnh nhân trong hệ thống quản lý lâm sàng.</div>
    </div>
    <div>
        <a href="/Patient/Create" class="btn btn-primary rounded-pill px-4 fw-semibold d-flex align-items-center gap-2" style="background:#1b75d0; border-color:#1b75d0;">
            <i class="bi bi-person-plus-fill"></i> Tạo hồ sơ mới
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 rounded-4 py-2 px-3 mb-3"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]</div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning border-0 rounded-4 py-2 px-3 mb-3"><i class="bi bi-exclamation-circle me-2"></i>@TempData["Warning"]</div>
}

<!-- Dashboard Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="bg-primary-subtle text-primary rounded-4 d-grid place-items-center" style="width: 48px; height: 48px; flex-shrink: 0;">
                    <i class="bi bi-people-fill fs-5"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold" style="font-size:0.75rem;">Tổng bệnh nhân</div>
                    <h4 class="fw-bold mb-0 text-dark">@ViewBag.StatTotal</h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="bg-success-subtle text-success rounded-4 d-grid place-items-center" style="width: 48px; height: 48px; flex-shrink: 0;">
                    <i class="bi bi-person-plus-fill fs-5"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold" style="font-size:0.75rem;">Hôm nay</div>
                    <h4 class="fw-bold mb-0 text-dark">+@ViewBag.StatToday <span class="text-muted fs-6 font-normal">hồ sơ</span></h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="bg-danger-subtle text-danger rounded-4 d-grid place-items-center" style="width: 48px; height: 48px; flex-shrink: 0;">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold" style="font-size:0.75rem;">Dị ứng nặng</div>
                    <h4 class="fw-bold mb-0 text-dark">@ViewBag.StatAllergies <span class="text-muted fs-6 font-normal">cases</span></h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="bg-warning-subtle text-warning rounded-4 d-grid place-items-center" style="width: 48px; height: 48px; flex-shrink: 0;">
                    <i class="bi bi-calendar2-check-fill fs-5"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold" style="font-size:0.75rem;">Lượt khám tháng</div>
                    <h4 class="fw-bold mb-0 text-dark">@ViewBag.StatAppointments</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Search, Tabs & Filters -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" id="filterForm" class="row g-3 align-items-center">
            <!-- Search field -->
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 rounded-start-pill">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control bg-light border-start-0 rounded-end-pill"
                           placeholder="Tìm theo tên, SĐT hoặc mã bệnh nhân..." />
                </div>
            </div>

            <!-- Tab Filters (Gender/Allergy) -->
            <div class="col-md-5 d-flex gap-2">
                <input type="hidden" name="gender" id="genderInput" value="@ViewBag.Gender" />
                <input type="hidden" name="allergy" id="allergyInput" value="@ViewBag.Allergy" />

                <button type="button" class="btn btn-sm rounded-pill px-3 filter-tab @(string.IsNullOrEmpty(ViewBag.Gender) && string.IsNullOrEmpty(ViewBag.Allergy) ? "btn-primary" : "btn-outline-secondary")"
                        onclick="setFilters('', '')">Tất cả</button>
                <button type="button" class="btn btn-sm rounded-pill px-3 filter-tab @(ViewBag.Gender == "Nam" ? "btn-primary" : "btn-outline-secondary")"
                        onclick="setFilters('Nam', '')">Nam</button>
                <button type="button" class="btn btn-sm rounded-pill px-3 filter-tab @(ViewBag.Gender == "Nữ" ? "btn-primary" : "btn-outline-secondary")"
                        onclick="setFilters('Nữ', '')">Nữ</button>
                <button type="button" class="btn btn-sm rounded-pill px-3 filter-tab @(ViewBag.Allergy == "true" ? "btn-primary" : "btn-outline-secondary")"
                        onclick="setFilters('', 'true')">Có dị ứng</button>
            </div>

            <!-- Sort option -->
            <div class="col-md-3 d-flex justify-content-end align-items-center gap-2">
                <span class="text-muted small text-nowrap">Sắp xếp:</span>
                <select name="sortBy" class="form-select form-select-sm rounded-pill w-auto" onchange="document.getElementById('filterForm').submit()">
                    <!option value="newest" @(ViewBag.SortBy == "newest" ? "selected" : "")>Ngày tạo mới nhất</!option>
                    <!option value="last_appt" @(ViewBag.SortBy == "last_appt" ? "selected" : "")>Lần khám gần nhất</!option>
                </select>
            </div>
        </form>
    </div>
</div>

<!-- Patient List Table -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-person-x display-4 opacity-25 d-block mb-3"></i>
                Không tìm thấy bệnh nhân nào khớp với tiêu chí tìm kiếm.
                <div class="mt-2">
                    <a href="/Patient/Create@(ViewBag.Search != null ? "?phone=" + ViewBag.Search : "")" class="btn btn-primary btn-sm rounded-pill px-3">Tạo hồ sơ bệnh nhân mới</a>
                </div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0" style="font-size:0.9rem;">
                    <thead style="background:#f8faff; border-bottom:2px solid #e8edf5;">
                        <tr>
                            <th class="px-4 py-3 text-muted fw-semibold">Mã BN</th>
                            <th class="py-3 text-muted fw-semibold">Họ và tên</th>
                            <th class="py-3 text-muted fw-semibold">Ngày sinh / Giới tính</th>
                            <th class="py-3 text-muted fw-semibold">Số điện thoại</th>
                            <th class="py-3 text-muted fw-semibold">Dị ứng cơ bản</th>
                            <th class="py-3 text-muted fw-semibold">Lần khám cuối</th>
                            <th class="py-3 text-muted fw-semibold pe-4 text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr class="border-bottom">
                                <td class="px-4">
                                    <span class="badge bg-primary-subtle text-primary fw-semibold rounded-pill px-3">@p.PatientCode</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-secondary-subtle text-secondary fw-bold d-grid place-items-center" style="width:36px; height:36px; flex-shrink: 0;">
                                            @(p.FullName.Substring(0,1).ToUpper())
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-dark">@p.FullName</div>
                                            @if (!string.IsNullOrEmpty(p.Email))
                                            {
                                                <div class="text-muted small">@p.Email</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div>@(p.DateOfBirth.HasValue ? p.DateOfBirth.Value.ToString("dd/MM/yyyy") : "—")</div>
                                    @if (!string.IsNullOrEmpty(p.Gender))
                                    {
                                        <div class="text-muted small">@p.Gender</div>
                                    }
                                </td>
                                <td><span class="fw-semibold">@p.PhoneNumber</span></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(p.AllergyHistory))
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2 small">@p.AllergyHistory</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted rounded-pill px-2 small">Không có</span>
                                    }
                                </td>
                                <td>
                                    @if (lastAppts.ContainsKey(p.Id))
                                    {
                                        <span class="fw-semibold text-secondary">@lastAppts[p.Id].ToString("dd/MM/yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Chưa khám</span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <div class="d-flex gap-2 justify-content-center">
                                        <a href="/Patient/Details/@p.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                            <i class="bi bi-eye"></i> Hồ sơ
                                        </a>
                                        <a href="/Appointment/Create?patientId=@p.Id" class="btn btn-success btn-sm rounded-pill px-3">
                                            <i class="bi bi-calendar-plus"></i> Đặt lịch
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="d-flex justify-content-center py-3 gap-2">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <a href="?search=@ViewBag.Search&gender=@ViewBag.Gender&allergy=@ViewBag.Allergy&sortBy=@ViewBag.SortBy&page=@i"
                           class="btn btn-sm @(i == page ? "btn-primary" : "btn-outline-secondary") rounded-pill px-3">@i</a>
                    }
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        function setFilters(gender, allergy) {
            document.getElementById('genderInput').value = gender;
            document.getElementById('allergyInput').value = allergy;
            document.getElementById('filterForm').submit();
        }
    </script>
}
