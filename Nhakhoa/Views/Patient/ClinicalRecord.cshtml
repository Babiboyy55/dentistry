@model Nhakhoa.Models.Patient
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Hồ sơ lâm sàng - " + Model.FullName;

    // Phân quyền: Chỉ cho phép Admin hoặc Bác sĩ điều trị chính được chỉnh sửa (EX4.3-01)
    bool isDoctor = User.IsInRole("Doctor");
    bool isAdmin = User.IsInRole("Admin");
    bool isReceptionist = User.IsInRole("Receptionist");
    bool canEdit = isAdmin || (isDoctor && (Model.PrimaryDoctorId == null || Model.PrimaryDoctorId == ViewBag.CurrentDoctor?.Id));

    var activeSession = ((List<Nhakhoa.Models.ExaminationSession>)ViewBag.ExaminationSessions).FirstOrDefault(s => !s.IsCompleted);
}

<style>
    /* Premium styling for clinical workspace */
    :root {
        --normal-color: #22c55e;
        --caries-color: #eab308;
        --filling-color: #3b82f6;
        --rct-color: #14b8a6;
        --extraction-color: #ef4444;
        --implant-color: #6366f1;
        --crown-color: #a855f7;
        --bridge-color: #f97316;
    }

    .tooth-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 50px;
        margin: 5px;
        position: relative;
    }

    .tooth-label {
        font-size: 0.75rem;
        font-weight: 700;
        color: #64748b;
        margin-top: 4px;
        text-align: center;
    }

    .tooth-svg-wrapper {
        position: relative;
        width: 44px;
        height: 52px;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
    }

    .tooth-svg-wrapper:hover {
        transform: translateY(-4px) scale(1.08);
        filter: drop-shadow(0 10px 8px rgba(0, 0, 0, 0.08));
    }

    .tooth-path {
        fill: #f1f5f9;
        stroke: #cbd5e1;
        stroke-width: 2.5;
        transition: fill 0.3s ease, stroke 0.3s ease;
    }

    /* Status coloring */
    .tooth-path.status-normal { fill: var(--normal-color); stroke: #16a34a; }
    .tooth-path.status-caries { fill: var(--caries-color); stroke: #ca8a04; }
    .tooth-path.status-filling { fill: var(--filling-color); stroke: #2563eb; }
    .tooth-path.status-rct { fill: var(--rct-color); stroke: #0d9488; }
    .tooth-path.status-extraction { fill: var(--extraction-color); stroke: #dc2626; }
    .tooth-path.status-implant { fill: var(--implant-color); stroke: #4f46e5; }
    .tooth-path.status-crown { fill: var(--crown-color); stroke: #9333ea; }
    .tooth-path.status-bridge { fill: var(--bridge-color); stroke: #ea580c; }

    /* Selection & Preview States */
    .tooth-svg-wrapper.selected {
        filter: drop-shadow(0 0 8px rgba(59, 130, 246, 0.6));
    }
    .tooth-svg-wrapper.selected .tooth-path {
        stroke: #1e3a8a !important;
        stroke-width: 3.5 !important;
    }

    .tooth-svg-wrapper.pending-change::after {
        content: '';
        position: absolute;
        top: -4px;
        left: -4px;
        right: -4px;
        bottom: -4px;
        border: 2px dashed #f59e0b;
        border-radius: 50%;
        animation: rotate 8s linear infinite;
        pointer-events: none;
    }

    @@keyframes rotate {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    /* Custom tab navigation styling */
    .nav-pills-custom .nav-link {
        color: #475569;
        font-weight: 600;
        border-radius: 30px;
        padding: 8px 20px;
        transition: all 0.2s ease;
        border: 1px solid transparent;
    }
    .nav-pills-custom .nav-link.active {
        background-color: #1e293b !important;
        color: #ffffff !important;
    }
    .nav-pills-custom .nav-link:hover:not(.active) {
        background-color: #f1f5f9;
        border-color: #cbd5e1;
    }

    /* Legend colors */
    .legend-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 6px;
    }

    /* Fixed bottom actions bar */
    .action-bar {
        position: fixed;
        bottom: 24px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(15, 23, 42, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 16px 28px;
        border-radius: 20px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.3);
        display: flex;
        align-items: center;
        gap: 20px;
        z-index: 1050;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .action-bar.show {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(0);
    }

    /* Sidebar history timeline */
    .tooth-timeline {
        border-left: 2px solid #e2e8f0;
        padding-left: 16px;
        margin-left: 8px;
    }
    .tooth-timeline-item {
        position: relative;
        margin-bottom: 20px;
    }
    .tooth-timeline-item::before {
        content: '';
        position: absolute;
        left: -23px;
        top: 4px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #cbd5e1;
        border: 2px solid #ffffff;
    }
    .tooth-timeline-item.active-item::before {
        background: var(--normal-color);
        box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.2);
    }

    /* Custom scrollbar */
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }
</style>

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-0" style="color:#0b1f35">
            <i class="bi bi-file-medical-fill text-danger me-2"></i>Hồ sơ bệnh án điện tử (EMR)
        </h4>
        <div class="text-muted small mt-1">Quản lý phiên khám, phác đồ, sơ đồ răng, đơn thuốc và bảo hành</div>
    </div>
    <div class="d-flex gap-2">
        <a href="/Patient/Details/@Model.Id" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left"></i> Quay lại chi tiết bệnh nhân
        </a>
    </div>
</div>

<!-- Alert notifications -->
<div id="alert-zone"></div>

<!-- Patient Info Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4" style="background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3 border-bottom pb-3">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary-subtle text-primary rounded-circle d-grid place-items-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-person-badge fs-4"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-0">@Model.FullName</h5>
                    <span class="badge bg-danger-subtle text-danger rounded-pill px-3 mt-1">Mã HS: @Model.PatientCode</span>
                </div>
            </div>
            
            <div class="d-flex align-items-center gap-2">
                @if (Model.PrimaryDoctorId != null)
                {
                    <div class="bg-dark text-white rounded-pill px-3 py-2 d-flex align-items-center gap-2 shadow-sm small">
                        <i class="bi bi-person-heart text-danger"></i>
                        <span>Bác sĩ điều trị chính: <strong>@Model.PrimaryDoctor?.User?.FullName</strong></span>
                    </div>
                    @if (isAdmin)
                    {
                        <button class="btn btn-light btn-sm rounded-circle shadow-sm" data-bs-toggle="modal" data-bs-target="#assignDoctorModal" title="Chuyển giao bác sĩ">
                            <i class="bi bi-arrow-left-right text-primary"></i>
                        </button>
                    }
                }
                else
                {
                    <div class="bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-2 d-flex align-items-center gap-2 small">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>Chưa có bác sĩ điều trị chính</span>
                    </div>
                    @if (canEdit)
                    {
                        <button class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#assignDoctorModal">
                            <i class="bi bi-plus-circle me-1"></i> Nhận điều trị chính
                        </button>
                    }
                }
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="text-muted small">Ngày sinh</div>
                <div class="fw-semibold">@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "—")</div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="text-muted small">Giới tính</div>
                <div class="fw-semibold">@(Model.Gender ?? "—")</div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="text-muted small">Số điện thoại</div>
                <div class="fw-semibold">@Model.PhoneNumber</div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="text-muted small">Tiền sử dị ứng</div>
                <div class="fw-semibold text-danger" id="lbl-patient-allergy-history">@(Model.AllergyHistory ?? "Không có")</div>
            </div>
        </div>
    </div>
</div>

<!-- Tabs Navigation -->
<div class="mb-4">
    <ul class="nav nav-pills nav-pills-custom gap-2" id="clinicalRecordTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="timeline-tab" data-bs-toggle="tab" data-bs-target="#timeline-content" type="button" role="tab" aria-selected="true">
                <i class="bi bi-journal-text me-2"></i>Nhật ký khám EMR
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="odontogram-tab" data-bs-toggle="tab" data-bs-target="#odontogram-content" type="button" role="tab" aria-selected="false">
                <i class="bi bi-diagram-3 me-2"></i>Sơ đồ răng tương tác
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="plans-tab" data-bs-toggle="tab" data-bs-target="#plans-content" type="button" role="tab" aria-selected="false">
                <i class="bi bi-calendar-range me-2"></i>Phác đồ điều trị
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="prescription-tab" data-bs-toggle="tab" data-bs-target="#prescription-content" type="button" role="tab" aria-selected="false">
                <i class="bi bi-capsule me-2"></i>Kê đơn & Phát thuốc
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="warranty-tab" data-bs-toggle="tab" data-bs-target="#warranty-content" type="button" role="tab" aria-selected="false">
                <i class="bi bi-shield-check me-2"></i>Bảo hành công trình
            </button>
        </li>
    </ul>
</div>

<!-- Tabs Content -->
<div class="tab-content" id="clinicalRecordTabsContent">
    
    <!-- TAB 1: TIMELINE LÂM SÀNG & GHI NHẬN KHÁM (EMR) -->
    <div class="tab-pane fade show active" id="timeline-content" role="tabpanel" aria-labelledby="timeline-tab">
        <div class="row g-4">
            
            <!-- Left Side: Timeline of EMR Sessions -->
            <div class="col-lg-8">
                @if (canEdit)
                {
                    <!-- Active Session Editor -->
                    <div class="card border-primary shadow-sm rounded-4 mb-4" id="active-session-card">
                        <div class="card-header bg-primary-subtle border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                            <h6 class="fw-bold mb-0 text-primary">
                                <i class="bi bi-pencil-fill me-2"></i>
                                <span id="session-editor-title">@(activeSession != null ? "Phiên Khám Lâm Sàng Hiện Tại (Đang ghi)" : "Phiên Khám Lâm Sàng")</span>
                            </h6>
                            @if (activeSession != null)
                            {
                                <span class="badge bg-warning text-dark px-3 py-1.5 rounded-pill">Nháp - Chưa chốt</span>
                            }
                        </div>
                        <div class="card-body p-4">
                            <input type="hidden" id="emr-session-id" value="@(activeSession?.Id ?? 0)" />
                            <input type="hidden" id="emr-concurrency-stamp" value="@(activeSession?.ConcurrencyStamp.ToString() ?? "")" />
                            <input type="hidden" id="emr-appointment-id" value="@(ViewBag.ActiveAppointment?.Id?.ToString() ?? activeSession?.AppointmentId?.ToString() ?? "")" />

                            @if (ViewBag.ActiveAppointment != null)
                            {
                                <div class="alert alert-info border-0 rounded-4 py-2 px-3 mb-3 small d-flex align-items-center justify-content-between">
                                    <span>
                                        <i class="bi bi-info-circle-fill me-2"></i>
                                        Liên kết ca hẹn hôm nay lúc <strong>@ViewBag.ActiveAppointment.TimeSlot</strong>.
                                    </span>
                                    <span class="badge bg-primary">Liên kết tự động</span>
                                </div>
                            }

                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label fw-bold small text-secondary">Chẩn đoán (Diagnosis) <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control rounded-3" id="emr-diagnosis" value="@(activeSession?.Diagnosis ?? "")" placeholder="Nhập chẩn đoán lâm sàng..." required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-secondary">Ghi chú lâm sàng</label>
                                    <textarea class="form-control rounded-3" id="emr-notes" rows="3" placeholder="Triệu chứng, tiền sử răng miệng phát sinh...">@(activeSession?.ClinicalNotes ?? "")</textarea>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-secondary">Tóm tắt phác đồ đề xuất</label>
                                    <textarea class="form-control rounded-3" id="emr-plan" rows="3" placeholder="Định hướng điều trị buổi tiếp theo...">@(activeSession?.TreatmentPlanSummary ?? "")</textarea>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-secondary">Dặn dò sau khám</label>
                                    <textarea class="form-control rounded-3" id="emr-care" rows="2" placeholder="Vệ sinh răng miệng, súc miệng, ăn đồ mềm...">@(activeSession?.HomeCareInstructions ?? "")</textarea>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-secondary">Hệ số bệnh nhân (Patient Coefficient)</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="bi bi-calculator"></i></span>
                                        <input type="number" step="0.01" min="0" max="0.5" class="form-control bg-light" id="emr-coefficient" value="@(activeSession?.PatientCoefficient.ToString("F2") ?? "0.00")" readonly />
                                    </div>
                                    <small class="text-muted">Mặc định 0.00. Chỉ ca phức tạp được Admin duyệt mới tăng hệ số.</small>
                                </div>
                                
                                <div class="col-12 border-top pt-3 mt-3">
                                    <label class="form-label fw-bold small text-primary"><i class="bi bi-check2-square me-1"></i>Chọn dịch vụ đã thực hiện (Tính hóa đơn nháp)</label>
                                    <div class="row g-2">
                                        @foreach (var svc in (List<Nhakhoa.Models.MedicalService>)ViewBag.MedicalServices)
                                        {
                                            <div class="col-md-6">
                                                <div class="form-check p-2 border rounded-3 bg-white">
                                                    <input class="form-check-input ms-1" type="checkbox" name="performedServices" value="@svc.Id" id="svc-@svc.Id">
                                                    <label class="form-check-label ms-2 small fw-semibold text-dark" for="svc-@svc.Id">
                                                        @svc.Name — <span class="text-danger fw-bold">@svc.Price.ToString("N0") đ</span>
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between gap-2 mt-4 border-top pt-3">
                                <div class="text-muted small my-auto" id="emr-draft-status">
                                    <i class="bi bi-cloud-check-fill text-success"></i> Đang tự động lưu nháp cục bộ.
                                </div>
                                <div class="d-flex gap-2">
                                    @if (activeSession != null)
                                    {
                                        var hasFlaggedComplex = activeSession.ComplexStatus == "Pending" || activeSession.ComplexStatus == "Approved";
                                        <button type="button"
                                                id="activeFlagComplexBtn"
                                                class="btn @(hasFlaggedComplex ? "btn-danger" : "btn-outline-danger") rounded-pill px-4 fw-semibold"
                                                onclick="openFlagComplexModal(@activeSession.Id, '@(activeSession.Diagnosis?.Replace("'","\\'")??"")')"
                                                @(hasFlaggedComplex ? "disabled" : "")>
                                            <i class="bi bi-flag-fill me-1"></i> @(hasFlaggedComplex ? "Đã báo ca phức tạp" : "Báo ca phức tạp")
                                        </button>
                                    }
                                    <button type="button" class="btn btn-outline-primary rounded-pill px-4" onclick="saveEMR(false)">
                                        <i class="bi bi-save me-1"></i> Lưu nháp bệnh án
                                    </button>
                                    @if (activeSession != null)
                                    {
                                        <button type="button" class="btn btn-success rounded-pill px-4 fw-semibold" onclick="finishSession()">
                                            <i class="bi bi-check-circle-fill me-1"></i> Kết thúc ca khám
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Historical Timeline -->
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                        <h5 class="fw-bold mb-0"><i class="bi bi-clock-history text-primary me-2"></i>Nhật ký điều trị lâm sàng (EMR)</h5>
                    </div>
                    <div class="card-body px-4 pb-4">
                        <div class="timeline mt-3" id="emr-timeline-list">
                            @if (!((List<Nhakhoa.Models.ExaminationSession>)ViewBag.ExaminationSessions).Any())
                            {
                                <div class="text-center py-5 text-muted">
                                    <i class="bi bi-journal-x display-4 opacity-25 d-block mb-2"></i>
                                    Chưa có bệnh án lâm sàng nào được ghi nhận cho bệnh nhân này.
                                </div>
                            }
                            else
                            {
                                @foreach (var sess in (List<Nhakhoa.Models.ExaminationSession>)ViewBag.ExaminationSessions)
                                {
                                    <div class="d-flex gap-3 mb-4 position-relative border-bottom pb-3" id="sess-row-@sess.Id">
                                        <div class="text-end" style="min-width: 100px;">
                                            <div class="fw-bold">@sess.CreatedAt.ToString("dd/MM/yyyy")</div>
                                            <div class="text-muted small">@sess.CreatedAt.ToString("HH:mm")</div>
                                        </div>
                                        <div class="bg-primary rounded-circle shadow-sm" style="width:14px; height:14px; margin-top: 5px; flex-shrink: 0; z-index:1;"></div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                                <h6 class="fw-bold text-dark mb-0">Chẩn đoán: @sess.Diagnosis</h6>
                                                <div class="d-flex gap-2 align-items-center flex-wrap">
                                                    @if (sess.IsCompleted)
                                                    {
                                                        <span class="badge bg-success-subtle text-success rounded-pill px-2">Đã kết thúc</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2">Bản nháp</span>
                                                    }

                                                    @* Badge trạng thái ca phức tạp *@
                                                    @if (sess.ComplexStatus == "Pending")
                                                    {
                                                        <span class="badge rounded-pill px-2 py-1" style="background:#fff3cd; color:#856404; border:1px solid #ffc107;">
                                                            <i class="bi bi-hourglass-split me-1"></i>Chờ duyệt phức tạp
                                                        </span>
                                                    }
                                                    else if (sess.ComplexStatus == "Approved")
                                                    {
                                                        <span class="badge rounded-pill px-2 py-1" style="background:#d1fae5; color:#065f46; border:1px solid #6ee7b7;" title="Hệ số được duyệt: @sess.PatientCoefficient">
                                                            <i class="bi bi-check-circle-fill me-1"></i>Phức tạp — Hệ số @sess.PatientCoefficient.ToString("F2")
                                                        </span>
                                                    }
                                                    else if (sess.ComplexStatus == "Rejected")
                                                    {
                                                        <span class="badge rounded-pill px-2 py-1" style="background:#fee2e2; color:#991b1b; border:1px solid #fca5a5;" title="Lý do từ chối: @sess.AdminNote">
                                                            <i class="bi bi-x-circle-fill me-1"></i>Đã từ chối
                                                        </span>
                                                    }

                                                    @* Nút báo ca phức tạp — chỉ hiện cho bác sĩ khi ca đã kết thúc và chưa báo hoặc bị từ chối *@
                                                    @if ((isDoctor || isAdmin) && sess.IsCompleted && (sess.ComplexStatus == null || sess.ComplexStatus == "Rejected"))
                                                    {
                                                        <button class="btn btn-sm rounded-pill px-2 py-1 fw-semibold"
                                                                style="background:#fee2e2; color:#991b1b; border:1px solid #fca5a5; font-size:0.75rem;"
                                                                onclick="openFlagComplexModal(@sess.Id, '@(sess.Diagnosis?.Replace("'","\\'")??"")') "
                                                                title="Báo ca này là ca phức tạp để yêu cầu tăng hệ số">
                                                            <i class="bi bi-flag-fill me-1"></i>Báo phức tạp
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                            <div class="text-muted small mt-1">
                                                Bác sĩ thực hiện: <strong>@sess.Doctor?.User?.FullName</strong>
                                                @if (sess.ComplexStatus == "Approved")
                                                {
                                                    <span class="ms-2 text-success fw-semibold">| Hệ số phức tạp: <strong>@sess.PatientCoefficient.ToString("F2")</strong></span>
                                                }
                                                else
                                                {
                                                    <span class="ms-2 text-muted">| Hệ số: <strong>@sess.PatientCoefficient.ToString("F2")</strong></span>
                                                }
                                            </div>

                                            @* Hiển thị lý do báo phức tạp nếu có *@
                                            @if (!string.IsNullOrEmpty(sess.ComplexReason))
                                            {
                                                <div class="mt-2 p-2 rounded-3 small" style="background:#fff8e1; border-left: 3px solid #ffc107;">
                                                    <i class="bi bi-chat-quote-fill text-warning me-1"></i>
                                                    <strong>Lý do báo phức tạp:</strong> @sess.ComplexReason
                                                    @if (!string.IsNullOrEmpty(sess.AdminNote))
                                                    {
                                                        <span class="text-muted"> | Ghi chú admin: @sess.AdminNote</span>
                                                    }
                                                </div>
                                            }

                                            @if (!string.IsNullOrEmpty(sess.ClinicalNotes))
                                            {
                                                <p class="mt-2 text-secondary mb-1 small"><strong>Ghi chú lâm sàng:</strong> @sess.ClinicalNotes</p>
                                            }
                                            @if (!string.IsNullOrEmpty(sess.TreatmentPlanSummary))
                                            {
                                                <p class="text-secondary mb-1 small"><strong>Tóm tắt phác đồ:</strong> @sess.TreatmentPlanSummary</p>
                                            }
                                            @if (!string.IsNullOrEmpty(sess.HomeCareInstructions))
                                            {
                                                <p class="text-secondary mb-0 small text-danger"><i class="bi bi-info-circle me-1"></i><strong>Dặn dò sau điều trị:</strong> @sess.HomeCareInstructions</p>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Side: Sidebar details -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                        <h5 class="fw-bold mb-0"><i class="bi bi-journal-medical text-primary me-2"></i>Tình trạng chung</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="p-3 bg-danger-subtle text-danger rounded-4 mb-3">
                            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                            <strong>Tiền sử dị ứng:</strong> <span id="sidebar-allergy-history">@(Model.AllergyHistory ?? "Không có")</span>
                        </div>
                        <div class="p-3 bg-light rounded-4 small">
                            <h6 class="fw-bold mb-2"><i class="bi bi-info-circle-fill text-secondary me-1"></i>Hướng dẫn quy trình:</h6>
                            <ol class="mb-0 ps-3">
                                <li>Bấm <strong>Bắt đầu ca khám</strong> hoặc chỉnh sửa EMR nháp.</li>
                                <li>Cập nhật tình trạng răng trên sơ đồ răng tương tác.</li>
                                <li>Lập phác đồ điều trị đa buổi nếu có điều trị phức tạp.</li>
                                <li>Kê đơn thuốc (Hệ thống sẽ đối chiếu dị ứng).</li>
                                <li>Nhập hệ số tính lương (0.00-0.50) và chọn dịch vụ đã làm.</li>
                                <li>Nhấn <strong>Kết thúc ca khám</strong> để chốt bệnh án và tạo hóa đơn nháp.</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- TAB 2: SƠ ĐỒ RĂNG TƯƠNG TÁC -->
    <div class="tab-pane fade" id="odontogram-content" role="tabpanel" aria-labelledby="odontogram-tab">
        <div class="row g-4">
            
            <!-- Left Side: Interactive Odontogram Chart -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                            <div>
                                <h5 class="fw-bold mb-1">Sơ đồ răng khám nha khoa</h5>
                                <div class="text-muted small">Nhấp chọn một răng bất kỳ để xem lịch sử và cập nhật trạng thái</div>
                            </div>
                            
                            <div class="btn-group rounded-pill p-1 bg-light border" role="group">
                                <button type="button" class="btn btn-sm btn-dark rounded-pill px-3 shadow-none border-0" id="btn-adult" onclick="toggleDentition('adult')">Người lớn (32)</button>
                                <button type="button" class="btn btn-sm text-dark rounded-pill px-3 shadow-none border-0" id="btn-child" onclick="toggleDentition('child')">Trẻ em (20)</button>
                            </div>
                        </div>

                        <!-- Status Color Legends -->
                        <div class="d-flex flex-wrap gap-3 p-3 bg-light rounded-4 mb-4 small justify-content-center">
                            <div><span class="legend-dot" style="background:var(--normal-color)"></span>Bình thường</div>
                            <div><span class="legend-dot" style="background:var(--caries-color)"></span>Sâu răng</div>
                            <div><span class="legend-dot" style="background:var(--filling-color)"></span>Răng trám</div>
                            <div><span class="legend-dot" style="background:var(--rct-color)"></span>Điều trị tủy (RCT)</div>
                            <div><span class="legend-dot" style="background:var(--extraction-color)"></span>Nhổ răng</div>
                            <div><span class="legend-dot" style="background:var(--implant-color)"></span>Cấy ghép Implant</div>
                            <div><span class="legend-dot" style="background:var(--crown-color)"></span>Bọc mão sứ</div>
                            <div><span class="legend-dot" style="background:var(--bridge-color)"></span>Cầu răng</div>
                        </div>

                        <!-- Odontogram Chart Arches -->
                        <div class="text-center overflow-x-auto py-3 custom-scrollbar">
                            <!-- ADULT VIEW -->
                            <div id="adult-odontogram">
                                <h6 class="text-muted text-uppercase fw-bold small mb-3 letter-spacing-1">Cung hàm trên (Maxillary Arch)</h6>
                                <div class="d-flex justify-content-center align-items-center mb-5 px-3">
                                    <div class="d-flex align-items-center flex-row-reverse border-end pe-3 border-secondary border-opacity-25">
                                        @for (int i = 18; i >= 11; i--)
                                        {
                                            @Html.Raw(RenderToothSvgHtml(i))
                                        }
                                    </div>
                                    <div class="d-flex align-items-center ps-3">
                                        @for (int i = 21; i <= 28; i++)
                                        {
                                            @Html.Raw(RenderToothSvgHtml(i))
                                        }
                                    </div>
                                </div>

                                <hr class="my-4 border-secondary border-opacity-25" style="border-style: dashed;">

                                <h6 class="text-muted text-uppercase fw-bold small mb-3 letter-spacing-1 mt-4">Cung hàm dưới (Mandibular Arch)</h6>
                                <div class="d-flex justify-content-center align-items-center mb-3 px-3">
                                    <div class="d-flex align-items-center flex-row-reverse border-end pe-3 border-secondary border-opacity-25">
                                        @for (int i = 48; i >= 41; i--)
                                        {
                                            @Html.Raw(RenderToothSvgHtml(i))
                                        }
                                    </div>
                                    <div class="d-flex align-items-center ps-3">
                                        @for (int i = 31; i <= 38; i++)
                                        {
                                            @Html.Raw(RenderToothSvgHtml(i))
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- CHILD VIEW -->
                            <div id="child-odontogram" class="d-none">
                                <h6 class="text-muted text-uppercase fw-bold small mb-3 letter-spacing-1">Cung răng sữa hàm trên</h6>
                                <div class="d-flex justify-content-center align-items-center mb-5 px-3">
                                    <div class="d-flex align-items-center flex-row-reverse border-end pe-3 border-secondary border-opacity-25">
                                        @for (int i = 55; i >= 51; i--)
                                        {
                                            @Html.Raw(RenderToothSvgHtml(i))
                                        }
                                    </div>
                                    <div class="d-flex align-items-center ps-3">
                                        @for (int i = 61; i <= 65; i++)
                                        {
                                            @Html.Raw(RenderToothSvgHtml(i))
                                        }
                                    </div>
                                </div>

                                <hr class="my-4 border-secondary border-opacity-25" style="border-style: dashed;">

                                <h6 class="text-muted text-uppercase fw-bold small mb-3 letter-spacing-1 mt-4">Cung răng sữa hàm dưới</h6>
                                <div class="d-flex justify-content-center align-items-center mb-3 px-3">
                                    <div class="d-flex align-items-center flex-row-reverse border-end pe-3 border-secondary border-opacity-25">
                                        @for (int i = 85; i >= 81; i--)
                                        {
                                            @Html.Raw(RenderToothSvgHtml(i))
                                        }
                                    </div>
                                    <div class="d-flex align-items-center ps-3">
                                        @for (int i = 71; i <= 75; i++)
                                        {
                                            @Html.Raw(RenderToothSvgHtml(i))
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mt-4 text-muted small border-top pt-3">
                            <div><i class="bi bi-clock-history me-1"></i>Phiên bản sơ đồ: <strong>V.<span id="version-label">@Model.ToothChartVersion</span></strong></div>
                            <div><i class="bi bi-info-circle me-1"></i>Click trực tiếp vào răng để ghi nhận tình trạng lâm sàng</div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Right Side: Tooth Details Panel -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 h-100" style="min-height: 500px;">
                    <div class="card-body p-4 d-flex flex-column" id="tooth-detail-panel">
                        
                        <div class="my-auto text-center py-5 text-muted" id="panel-placeholder">
                            <i class="bi bi-heart-pulse display-3 opacity-25 d-block mb-3"></i>
                            <h6 class="fw-bold mb-1">Chưa chọn vị trí răng</h6>
                            <p class="small text-secondary px-4">Bác sĩ hãy chọn một răng trên sơ đồ để xem thông tin chi tiết và cập nhật tiến trình điều trị.</p>
                        </div>
                        
                        <div id="panel-content" class="d-none flex-grow-1 d-flex flex-column">
                            <div class="d-flex align-items-start gap-3 border-bottom pb-3 mb-3">
                                <div id="selected-tooth-svg-icon" class="p-2 bg-light rounded-3"></div>
                                <div class="flex-grow-1">
                                    <h5 class="fw-bold mb-0 text-dark">Răng <span id="lbl-tooth-number">#16</span></h5>
                                    <div class="text-muted small mt-1" id="lbl-tooth-name">Răng cối lớn thứ nhất</div>
                                    <span class="badge rounded-pill px-3 py-1 mt-2 small" id="lbl-tooth-status-badge" style="font-size:0.8rem">Bình thường</span>
                                </div>
                            </div>

                            <div class="row g-2 mb-3 bg-light p-3 rounded-4 small">
                                <div class="col-6">
                                    <div class="text-muted">Bác sĩ ghi nhận:</div>
                                    <div class="fw-bold text-dark mt-1" id="lbl-doctor-name">BS. Nguyễn Văn Đạt</div>
                                </div>
                                <div class="col-6">
                                    <div class="text-muted">Ngày ghi:</div>
                                    <div class="fw-bold text-dark mt-1" id="lbl-last-visit">12/05/2026</div>
                                </div>
                            </div>

                            <h6 class="fw-bold mb-2 small text-muted"><i class="bi bi-clock-history me-1"></i>Lịch sử điều trị (Append-Only)</h6>
                            <div class="custom-scrollbar overflow-y-auto mb-3 pe-1 flex-grow-1" style="max-height: 180px;" id="lbl-tooth-history-list"></div>

                            <div class="border-top pt-3 mt-auto">
                                <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-plus-circle-fill me-1"></i>Ghi nhận tình trạng mới</h6>
                                @if (canEdit)
                                {
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Tình trạng răng</label>
                                        <select class="form-select rounded-3 shadow-none border-secondary-subtle" id="form-tooth-status">
                                            <option value="Normal">Normal — Bình thường</option>
                                            <option value="Caries">Caries — Sâu răng</option>
                                            <option value="Filling">Filling — Răng trám</option>
                                            <option value="RCT">RCT — Điều trị tủy</option>
                                            <option value="Extraction">Extraction — Nhổ răng</option>
                                            <option value="Implant">Implant — Cấy ghép Implant</option>
                                            <option value="Crown">Crown — Bọc mão sứ</option>
                                            <option value="Bridge">Bridge — Cầu răng</option>
                                        </select>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Ghi chú lâm sàng</label>
                                        <textarea class="form-control rounded-3 shadow-none border-secondary-subtle small" rows="2" id="form-tooth-notes" placeholder="Nhập ghi chú lâm sàng cụ thể..."></textarea>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Chỉ định điều trị & Đơn thuốc</label>
                                        <textarea class="form-control rounded-3 shadow-none border-secondary-subtle small" rows="2" id="form-tooth-prescription" placeholder="Kê đơn thuốc hoặc ghi chú chỉ định điều trị..."></textarea>
                                    </div>

                                    <div class="d-grid gap-2">
                                        <button class="btn btn-primary rounded-pill fw-semibold py-2 shadow-sm" type="button" onclick="applyPendingChange()">
                                            <i class="bi bi-eye me-1"></i> Xem trước thay đổi
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-warning border-0 rounded-4 p-3 small mb-0">
                                        <i class="bi bi-shield-lock-fill me-2 fs-5 text-warning align-middle"></i>
                                        <span class="align-middle"><strong>Chế độ Xem:</strong> Bạn không có quyền chỉnh sửa. Sơ đồ này thuộc quản lý của <strong>@Model.PrimaryDoctor?.User?.FullName</strong>.</span>
                                    </div>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- TAB 3: PHÁC ĐỒ ĐIỀU TRỊ ĐA BUỔI -->
    <div class="tab-pane fade" id="plans-content" role="tabpanel" aria-labelledby="plans-tab">
        <div class="row g-4">
            <!-- Left: Active Plans Timeline -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                        <h5 class="fw-bold mb-0"><i class="bi bi-calendar-range text-primary me-2"></i>Phác đồ điều trị đa buổi của bệnh nhân</h5>
                    </div>
                    <div class="card-body p-4">
                        @if (!((List<Nhakhoa.Models.TreatmentPlan>)ViewBag.TreatmentPlans).Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x display-4 opacity-25 d-block mb-2"></i>
                                Bệnh nhân chưa có phác đồ điều trị đa buổi nào.
                            </div>
                        }
                        else
                        {
                            @foreach (var plan in (List<Nhakhoa.Models.TreatmentPlan>)ViewBag.TreatmentPlans)
                            {
                                <div class="border rounded-4 p-4 mb-4 @(plan.Status == "Completed" ? "bg-light border-success-subtle" : plan.Status == "Cancelled" ? "bg-light border-danger-subtle" : "bg-white")">
                                    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0">@plan.Title</h6>
                                            <small class="text-muted">Dịch vụ: <strong>@plan.MedicalService?.Name</strong> | Bác sĩ: @plan.Doctor?.User?.FullName</small>
                                        </div>
                                        <div>
                                            @if (plan.Status == "Active")
                                            {
                                                <span class="badge bg-primary rounded-pill px-3 py-2">Đang điều trị (@plan.Sessions.Count(s => s.Status == "Completed")/@plan.TotalSessions buổi)</span>
                                            }
                                            else if (plan.Status == "Completed")
                                            {
                                                <span class="badge bg-success rounded-pill px-3 py-2">Đã hoàn thành</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger rounded-pill px-3 py-2" title="Lý do: @plan.CancellationReason">Đã hủy</span>
                                            }
                                        </div>
                                    </div>

                                    <!-- Session Timeline -->
                                    <div class="row g-2 mb-3">
                                        @foreach (var sess in plan.Sessions.OrderBy(s => s.SessionNumber))
                                        {
                                            <div class="col-md-6 col-lg-4">
                                                <div class="p-3 border rounded-3 small d-flex justify-content-between align-items-center @(sess.Status == "Completed" ? "bg-success-subtle text-success border-success" : sess.Status == "Postponed" ? "bg-warning-subtle text-warning border-warning" : "bg-light")">
                                                    <div>
                                                        <div class="fw-bold">Buổi #@sess.SessionNumber</div>
                                                        <div class="text-muted text-xs">@sess.Notes</div>
                                                    </div>
                                                    <div>
                                                        @if (sess.Status == "Scheduled" && canEdit && plan.Status == "Active")
                                                        {
                                                            <div class="dropdown">
                                                                <button class="btn btn-light btn-sm rounded-pill py-0 px-2 border" type="button" data-bs-toggle="dropdown">
                                                                    <i class="bi bi-three-dots"></i>
                                                                </button>
                                                                <ul class="dropdown-menu">
                                                                    <li><a class="dropdown-item small" href="javascript:void(0)" onclick="updateSessionStatus(@sess.Id, 'Completed')"><i class="bi bi-check-circle text-success me-2"></i>Hoàn thành</a></li>
                                                                    <li><a class="dropdown-item small" href="javascript:void(0)" onclick="updateSessionStatus(@sess.Id, 'Postponed')"><i class="bi bi-x-circle text-warning me-2"></i>Hoãn buổi</a></li>
                                                                </ul>
                                                            </div>
                                                        }
                                                        else if (sess.Status == "Completed")
                                                        {
                                                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    @if (plan.Status == "Active" && canEdit)
                                    {
                                        <div class="d-flex justify-content-end gap-2 border-top pt-2">
                                            <button class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="cancelPlan(@plan.Id)">
                                                <i class="bi bi-trash"></i> Hủy phác đồ
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Right: Create Plan Form -->
            <div class="col-lg-4">
                @if (canEdit)
                {
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                            <h5 class="fw-bold mb-0"><i class="bi bi-plus-circle text-primary me-2"></i>Lập phác đồ điều trị mới</h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Chọn dịch vụ nha khoa</label>
                                <select class="form-select rounded-3" id="plan-svc-id" onchange="autoFillPlanTitle()">
                                    <option value="">-- Chọn dịch vụ --</option>
                                    @foreach (var svc in (List<Nhakhoa.Models.MedicalService>)ViewBag.MedicalServices)
                                    {
                                        <option value="@svc.Id" data-name="@svc.Name">@svc.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Tên phác đồ</label>
                                <input type="text" class="form-control rounded-3" id="plan-title" placeholder="Ví dụ: Phác đồ phục hình răng sứ..." />
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Tổng số buổi dự kiến</label>
                                <input type="number" min="2" max="15" value="3" class="form-control rounded-3" id="plan-total-sessions" />
                            </div>
                            <div class="d-grid mt-4">
                                <button type="button" class="btn btn-primary rounded-pill py-2" onclick="createTreatmentPlan()">
                                    <i class="bi bi-check2-circle me-1"></i> Tạo phác đồ & Gợi ý lịch tái hẹn
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- TAB 4: KÊ ĐƠN & PHÁT THUỐC -->
    <div class="tab-pane fade" id="prescription-content" role="tabpanel" aria-labelledby="prescription-tab">
        <div class="row g-4">
            
            <!-- Left: Historical Prescriptions & Dispensing -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                        <h5 class="fw-bold mb-0"><i class="bi bi-prescription text-primary me-2"></i>Danh sách đơn thuốc</h5>
                    </div>
                    <div class="card-body p-4">
                        @if (!((List<Nhakhoa.Models.Prescription>)ViewBag.Prescriptions).Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-capsule display-4 opacity-25 d-block mb-2"></i>
                                Chưa có đơn thuốc nào được kê.
                            </div>
                        }
                        else
                        {
                            @foreach (var rx in (List<Nhakhoa.Models.Prescription>)ViewBag.Prescriptions)
                            {
                                <div class="border rounded-4 p-4 mb-4 bg-white shadow-sm">
                                    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                                        <div>
                                            <h6 class="fw-bold mb-0">Đơn thuốc kê ngày @rx.CreatedAt.ToString("dd/MM/yyyy HH:mm")</h6>
                                            <small class="text-muted">Bác sĩ kê: <strong>@rx.Doctor?.User?.FullName</strong></small>
                                        </div>
                                        <div>
                                            @if (rx.Status == "Prescribed")
                                            {
                                                <span class="badge bg-warning text-dark px-3 py-1.5 rounded-pill"><i class="bi bi-clock-history me-1"></i>Chờ phát thuốc</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success text-white px-3 py-1.5 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i>Đã phát thuốc</span>
                                            }
                                        </div>
                                    </div>

                                    <table class="table table-sm table-borderless small mb-3">
                                        <thead>
                                            <tr class="text-secondary border-bottom">
                                                <th>Tên thuốc</th>
                                                <th>Số lượng</th>
                                                <th>Hướng dẫn liều lượng</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in rx.Items)
                                            {
                                                <tr>
                                                    <td class="fw-bold">@item.Medicine?.MedicineName</td>
                                                    <td>@item.Quantity @item.Medicine?.Unit (uống trong @item.DurationDays ngày)</td>
                                                    <td>@item.Dosage</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>

                                    @if (rx.IsAllergyWarningBypassed)
                                    {
                                        <div class="alert alert-danger border-0 py-2 px-3 rounded-3 small mb-3">
                                            <i class="bi bi-exclamation-triangle-fill"></i> Kê vượt qua cảnh báo dị ứng: <em>"@rx.AllergyBypassReason"</em>
                                        </div>
                                    }

                                    @if (rx.Status == "Prescribed" && (isReceptionist || isAdmin))
                                    {
                                        <div class="d-flex justify-content-end gap-2 border-top pt-2">
                                            <button class="btn btn-primary btn-sm rounded-pill px-4 fw-semibold" onclick="dispensePrescription(@rx.Id)">
                                                <i class="bi bi-capsule me-1"></i> Phát thuốc & In đơn thuốc (Trừ kho)
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Right: Create Prescription Form -->
            <div class="col-lg-4">
                @if (canEdit)
                {
                    <div class="card border-0 shadow-sm rounded-4">
                        <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                            <h5 class="fw-bold mb-0"><i class="bi bi-plus-circle text-primary me-2"></i>Kê đơn thuốc mới</h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Chọn thuốc trong kho</label>
                                <select class="form-select rounded-3" id="rx-med-id">
                                    <option value="">-- Chọn thuốc --</option>
                                    @foreach (var med in (List<Nhakhoa.Models.MedicineInventory>)ViewBag.Medicines)
                                    {
                                        <option value="@med.Id" data-name="@med.MedicineName" data-stock="@med.StockQuantity" data-unit="@med.Unit">@med.MedicineName (Tồn: @med.StockQuantity @med.Unit)</option>
                                    }
                                </select>
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label small fw-bold">Số lượng</label>
                                    <input type="number" min="1" value="10" class="form-control rounded-3" id="rx-med-qty" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small fw-bold">Số ngày uống</label>
                                    <input type="number" min="1" value="5" class="form-control rounded-3" id="rx-med-days" />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Cách dùng</label>
                                <input type="text" class="form-control rounded-3" id="rx-med-dosage" placeholder="Ví dụ: Ngày uống 2 lần, mỗi lần 1 viên sau ăn..." />
                            </div>
                            
                            <button type="button" class="btn btn-outline-primary rounded-pill w-100 mb-4" onclick="addMedicineToPrescription()">
                                <i class="bi bi-plus"></i> Thêm thuốc vào đơn
                            </button>

                            <div class="border-top pt-3">
                                <h6 class="fw-bold text-secondary mb-2 small">ĐƠN THUỐC TẠM THỜI</h6>
                                <div id="temp-rx-list" class="small text-muted py-2 border rounded-3 p-2 bg-light mb-3">
                                    Chưa có thuốc nào trong đơn tạm thời.
                                </div>
                                <button type="button" class="btn btn-primary rounded-pill w-100 py-2" onclick="checkAllergyAndSubmitRx()">
                                    <i class="bi bi-send-check me-1"></i> Lưu và gửi đơn thuốc
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- TAB 5: BẢO HÀNH CÔNG TRÌNH NHA KHOA -->
    <div class="tab-pane fade" id="warranty-content" role="tabpanel" aria-labelledby="warranty-tab">
        <div class="row g-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                        <h5 class="fw-bold mb-0"><i class="bi bi-shield-check text-primary me-2"></i>Quản lý bảo hành công trình nha khoa</h5>
                    </div>
                    <div class="card-body p-4">
                        @if (!((List<Nhakhoa.Models.DentalWarranty>)ViewBag.Warranties).Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-shield-slash display-4 opacity-25 d-block mb-2"></i>
                                Bệnh nhân chưa có công trình nha khoa nào đang bảo hành.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle">
                                    <thead class="table-light small">
                                        <tr>
                                            <th>Mã thẻ bảo hành</th>
                                            <th>Dịch vụ điều trị</th>
                                            <th>Bác sĩ thực hiện</th>
                                            <th>Ngày bắt đầu</th>
                                            <th>Ngày hết hạn</th>
                                            <th>Trạng thái</th>
                                            <th>Điều khoản bảo hành</th>
                                            <th class="text-end">Hành động</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var w in (List<Nhakhoa.Models.DentalWarranty>)ViewBag.Warranties)
                                        {
                                            bool isExpired = w.EndDate < DateTime.Today;
                                            int daysLeft = (w.EndDate - DateTime.Today).Days;

                                            <tr>
                                                <td class="fw-bold text-primary">@w.WarrantyCode</td>
                                                <td class="fw-semibold">@w.MedicalService?.Name</td>
                                                <td>@w.Doctor?.User?.FullName</td>
                                                <td>@w.StartDate.ToString("dd/MM/yyyy")</td>
                                                <td>
                                                    <span class="@(isExpired ? "text-danger fw-bold" : daysLeft <= 30 ? "text-warning fw-bold" : "text-dark")">
                                                        @w.EndDate.ToString("dd/MM/yyyy")
                                                    </span>
                                                    @if (!isExpired && daysLeft <= 30)
                                                    {
                                                        <span class="badge bg-warning text-dark text-xs ms-1">Còn @daysLeft ngày</span>
                                                    }
                                                    else if (isExpired)
                                                    {
                                                        <span class="badge bg-danger text-xs ms-1">Hết hạn</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (w.Status == "Active" && !isExpired)
                                                    {
                                                        <span class="badge bg-success-subtle text-success rounded-pill px-2">Còn hiệu lực</span>
                                                    }
                                                    else if (w.Status == "Expired" || isExpired)
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2">Hết hạn</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2">@w.Status</span>
                                                    }
                                                </td>
                                                <td class="small text-secondary text-truncate" style="max-width: 200px;" title="@w.Terms">@w.Terms</td>
                                                <td class="text-end">
                                                    @if (w.Status == "Active" && !isExpired && (isReceptionist || isAdmin))
                                                    {
                                                        <button class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="claimWarranty(@w.Id)">
                                                            Tiếp nhận BH
                                                        </button>
                                                    }
                                                    @if (isAdmin)
                                                    {
                                                        <button class="btn btn-dark btn-sm rounded-pill px-3" onclick="openOverrideWarrantyModal(@w.Id, '@w.WarrantyCode')">
                                                            Ghi đè (Admin)
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Modal: Assign Primary Doctor (EX4.3-01) -->
