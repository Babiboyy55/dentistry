    function claimWarranty(warrantyId) {
        fetch('/Patient/ClaimWarranty', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ warrantyId: warrantyId })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                showToast(data.message, "success");
            } 
            else if (data.expired) {
                // Expired warranty (EX4.5-03)
                alert(data.message);
            } 
            else {
                showToast("Lỗi: " + data.message, "danger");
            }
        });
    }

    function openOverrideWarrantyModal(warrantyId, warrantyCode) {
        document.getElementById("override-warranty-id").value = warrantyId;
        document.getElementById("override-warranty-code-lbl").innerText = warrantyCode;
        
        const modal = new bootstrap.Modal(document.getElementById('overrideWarrantyModal'));
        modal.show();
    }

    function submitWarrantyOverride() {
        const warrantyId = parseInt(document.getElementById("override-warranty-id").value);
        const reason = document.getElementById("override-warranty-reason").value.trim();
        const extend = parseInt(document.getElementById("override-extend-months").value) || 0;

        if (!reason) {
            alert("Vui lòng nhập lý do ghi đè bảo hành.");
            return;
        }

        fetch('/Patient/OverrideWarranty', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                warrantyId: warrantyId,
                reason: reason,
                extendMonths: extend
            })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                bootstrap.Modal.getInstance(document.getElementById('overrideWarrantyModal')).hide();
                showToast("Đã ghi đè bảo hành thành công!", "success");
                setTimeout(() => location.reload(), 1000);
            } else {
                showToast(data.message, "danger");
            }
        });
    }

    // ==========================================
    // COMMON WORKSPACE UTILS
    // ==========================================

    function showToast(msg, type = "success") {
        const alertZone = document.getElementById("alert-zone");
        const alert = document.createElement("div");
        alert.className = `alert alert-${type} border-0 rounded-4 py-2 px-3 mb-3 shadow-sm alert-dismissible fade show`;
        alert.role = "alert";
        alert.innerHTML = `
            <i class="bi bi-${type === 'success' ? 'check-circle' : type === 'danger' ? 'exclamation-octagon' : 'info-circle'} me-2"></i>
            ${msg}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        alertZone.appendChild(alert);
        setTimeout(() => alert.remove(), 4000);
    }
</script>

<!-- ==================== MODAL BÁO CA PHỨC TẠP ==================== -->
<div class="modal fade" id="flagComplexModal" tabindex="-1" aria-labelledby="flagComplexModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0" style="background: linear-gradient(135deg, #fee2e2, #fef2f2);">
                <h5 class="modal-title fw-bold text-danger" id="flagComplexModalLabel">
                    <i class="bi bi-flag-fill me-2"></i>Báo ca phức tạp
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="flagSessionId" />

                <div class="alert alert-warning border-0 rounded-3 py-2 px-3 small mb-4">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    Yêu cầu này sẽ được gửi đến <strong>Admin</strong> để xem xét và duyệt hệ số.
                    Ca sẽ được đánh dấu <strong>"Chờ duyệt"</strong> cho đến khi Admin xử lý.
                </div>

                <div class="mb-3 p-3 bg-light rounded-3 small">
                    <div class="text-muted">Ca khám:</div>
                    <div class="fw-bold text-dark" id="flagSessionDiagnosis">—</div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Lý do báo ca phức tạp <span class="text-danger">*</span></label>
                    <textarea class="form-control rounded-3" id="flagReason" rows="4"
                              placeholder="Mô tả chi tiết tại sao ca này phức tạp: tình trạng bệnh nhân đặc biệt, kỹ thuật khó, thời gian xử lý lâu hơn bình thường..."></textarea>
                    <div class="text-muted small mt-1" id="flagReasonCount">0/1000 ký tự</div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">Hệ số đề xuất <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-plus-slash-minus"></i></span>
                        <input type="number" class="form-control" id="flagCoefficient"
                               min="0.10" max="0.50" step="0.05" value="0.20"
                               placeholder="0.10 – 0.50" />
                    </div>
                    <div class="d-flex gap-2 mt-2 flex-wrap" id="flagCoeffPresets">
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="setFlagCoeff(0.10)">+0.10</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="setFlagCoeff(0.20)">+0.20</button>
                        <button type="button" class="btn btn-sm btn-outline-warning rounded-pill px-3" onclick="setFlagCoeff(0.30)">+0.30</button>
                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="setFlagCoeff(0.40)">+0.40</button>
                        <button type="button" class="btn btn-sm btn-danger rounded-pill px-3" onclick="setFlagCoeff(0.50)">+0.50 (Tối đa)</button>
                    </div>
                    <small class="text-muted">Hệ số tăng thêm cho ca: từ 0.10 đến 0.50</small>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 px-4 pb-4">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger rounded-pill px-4 fw-semibold" id="btnSubmitFlag" onclick="submitFlagComplex()">
                    <i class="bi bi-send-fill me-1"></i>Gửi yêu cầu
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // ── Modal Báo Ca Phức Tạp ───────────────────────────────────────
    const flagComplexModal = new bootstrap.Modal(document.getElementById('flagComplexModal'));

    function openFlagComplexModal(sessionId, diagnosis) {
        if (!confirm('Bạn có chắc muốn báo cáo ca này là ca phức tạp không?\nYêu cầu sau khi gửi sẽ chuyển sang trang Payroll để Admin duyệt hệ số.')) {
            return;
        }
        document.getElementById('flagSessionId').value = sessionId;
        document.getElementById('flagSessionDiagnosis').textContent = diagnosis || '—';
        document.getElementById('flagReason').value = '';
        document.getElementById('flagCoefficient').value = '0.20';
        document.getElementById('flagReasonCount').textContent = '0/1000 ký tự';
        flagComplexModal.show();
    }

    function setFlagCoeff(val) {
        document.getElementById('flagCoefficient').value = val.toFixed(2);
    }

    document.getElementById('flagReason').addEventListener('input', function () {
        document.getElementById('flagReasonCount').textContent = this.value.length + '/1000 ký tự';
    });

    async function submitFlagComplex() {
        const sessionId = parseInt(document.getElementById('flagSessionId').value);
        const reason = document.getElementById('flagReason').value.trim();
        const coeff = parseFloat(document.getElementById('flagCoefficient').value);
        const btn = document.getElementById('btnSubmitFlag');

        if (!reason) {
            alert('Vui lòng nhập lý do báo ca phức tạp.');
            return;
        }
        if (isNaN(coeff) || coeff < 0.10 || coeff > 0.50) {
            alert('Hệ số đề xuất phải từ 0.10 đến 0.50.');
            return;
        }
        if (!confirm(`Xác nhận gửi báo cáo ca phức tạp với hệ số đề xuất ${coeff.toFixed(2)}?\nYêu cầu sẽ được gửi lên Admin để xem xét và duyệt.`)) {
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang gửi...';

        try {
            const res = await fetch('/Patient/FlagComplexSession', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ sessionId, requestedCoefficient: coeff, reason })
            });
            if (!res.ok) {
                alert(res.status === 403 ? 'Bạn không có quyền báo ca phức tạp cho ca khám này.' : 'Không gửi được yêu cầu. Vui lòng thử lại.');
                return;
            }
            const data = await res.json();

            if (data.success) {
                flagComplexModal.hide();
                showAlert('success', '<i class="bi bi-check-circle-fill me-2"></i>' + data.message + ' <a href="/Payroll" class="alert-link">Mở Payroll để duyệt</a>.');

                // Cập nhật badge trong row mà không cần reload
                const row = document.getElementById('sess-row-' + sessionId);
                if (row) {
                    // Xoá nút báo phức tạp và thêm badge Chờ duyệt
                    const flagBtn = row.querySelector('[onclick^="openFlagComplexModal"]');
                    if (flagBtn) flagBtn.remove();

                    const badgeContainer = row.querySelector('.d-flex.gap-2.align-items-center');
                    if (badgeContainer) {
                        const pendingBadge = document.createElement('span');
                        pendingBadge.className = 'badge rounded-pill px-2 py-1';
                        pendingBadge.style.cssText = 'background:#fff3cd; color:#856404; border:1px solid #ffc107;';
                        pendingBadge.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Chờ duyệt phức tạp';
                        badgeContainer.appendChild(pendingBadge);
                    }
                }

                const activeFlagBtn = document.getElementById('activeFlagComplexBtn');
                if (activeFlagBtn && parseInt(document.getElementById('flagSessionId').value) === sessionId) {
                    activeFlagBtn.className = 'btn btn-danger rounded-pill px-4 fw-semibold';
                    activeFlagBtn.disabled = true;
                    activeFlagBtn.innerHTML = '<i class="bi bi-flag-fill me-1"></i> Đã báo ca phức tạp';
                }
            } else {
                alert(data.message || 'Có lỗi xảy ra.');
            }
        } catch (e) {
            alert('Lỗi kết nối. Vui lòng thử lại.');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-send-fill me-1"></i>Gửi yêu cầu';
        }
    }
</script>
