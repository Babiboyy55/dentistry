                                            <option value="Extraction">Extraction — Nhổ răng</option>
                                            <option value="Implant">Implant — Cấy ghép Implant</option>
                                            <option value="Crown">Crown — Bọc mão sứ</option>
                                            <option value="Bridge">Bridge — Cầu răng</option>
                                        </select>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Ghi chú lâm sàng</label>
                                        <textarea class="form-control rounded-3 shadow-none border-secondary-subtle small" rows="2" id="form-tooth-notes" placeholder="Nhập ghi chú lâm sàng cụ thể..."></textarea>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Chỉ định điều trị & Đơn thuốc</label>
                                        <textarea class="form-control rounded-3 shadow-none border-secondary-subtle small" rows="2" id="form-tooth-prescription" placeholder="Kê đơn thuốc hoặc ghi chú chỉ định điều trị..."></textarea>
                                    </div>

                                    <div class="d-grid gap-2">
                                        <button class="btn btn-primary rounded-pill fw-semibold py-2 shadow-sm" type="button" onclick="applyPendingChange()">
                                            <i class="bi bi-eye me-1"></i> Xem trước thay đổi
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-warning border-0 rounded-4 p-3 small mb-0">
                                        <i class="bi bi-shield-lock-fill me-2 fs-5 text-warning align-middle"></i>
                                        <span class="align-middle"><strong>Chế độ Xem:</strong> Bạn không có quyền chỉnh sửa. Sơ đồ này thuộc quản lý của <strong>@Model.PrimaryDoctor?.User?.FullName</strong>.</span>
                                    </div>
                                }

                            </div>

                        </div>

                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Floating Action Bar for batch save -->
<div class="action-bar" id="save-action-bar">
    <div class="text-white d-flex align-items-center gap-2">
        <div class="spinner-grow spinner-grow-sm text-warning" role="status"></div>
        <span>Bạn có <strong><span id="unsaved-changes-count">0</span></strong> thay đổi chưa lưu trên sơ đồ răng.</span>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-light btn-sm rounded-pill px-3 fw-semibold text-dark shadow-sm" onclick="cancelChanges()">
            <i class="bi bi-x-circle me-1"></i> Hủy bỏ
        </button>
        <button class="btn btn-success btn-sm rounded-pill px-3 fw-semibold shadow-sm" onclick="saveToothChanges()">
            <i class="bi bi-save me-1"></i> Lưu sơ đồ răng
        </button>
    </div>
</div>

<!-- Modal: Assign Primary Doctor (EX4.3-01) -->
<div class="modal fade" id="assignDoctorModal" tabindex="-1" aria-labelledby="assignDoctorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold" id="assignDoctorModalLabel"><i class="bi bi-person-check-fill text-primary me-2"></i>Gán Bác sĩ Phụ trách</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
