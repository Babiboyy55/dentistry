<!-- Helper Functions in Razor to render Tooth SVG wrapper -->
@functions {
    public string RenderToothSvgHtml(int num)
    {
        return $@"
        <div class='tooth-container' id='tooth-container-{num}'>
            <div class='tooth-svg-wrapper' id='tooth-svg-wrapper-{num}' onclick='selectTooth({num})'>
                <svg viewBox='0 0 100 100' style='width:100%; height:100%;'>
                    <path class='tooth-path status-normal' id='tooth-path-{num}' d='M 25,35 C 25,22 32,15 42,15 C 46,15 48,22 50,22 C 52,22 54,15 58,15 C 68,15 75,22 75,35 C 75,48 72,55 70,60 C 68,75 68,90 62,90 C 60,90 58,85 55,75 C 52,65 48,65 45,75 C 42,85 40,90 38,90 C 32,90 32,75 30,60 C 28,55 25,48 25,35 Z'></path>
                    <path d='M 30,30 C 30,22 35,18 45,18' fill='none' stroke='#ffffff' stroke-width='2.5' stroke-linecap='round' opacity='0.4'></path>
                </svg>
            </div>
            <div class='tooth-label'>#{num}</div>
        </div>";
    }
}

