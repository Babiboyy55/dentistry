<!-- Helper Functions in Razor to render Tooth SVG wrapper -->
@functions {
    public string RenderToothSvgHtml(int num)
    {
        return $@"
        <div class='tooth-container' id='tooth-container-{num}'>
            <div class='tooth-svg-wrapper' id='tooth-svg-wrapper-{num}' onclick='selectTooth({num})'>
                <svg viewBox='0 0 100 100' style='width:100%; height:100%;'>
                    <path class='tooth-path status-normal' id='tooth-path-{num}' d='M 25,30 C 25,15 35,10 50,10 C 65,10 75,15 75,30 C 75,45 70,55 65,65 C 60,75 58,85 58,90 C 58,93 56,95 53,95 C 50,95 48,93 48,90 C 48,85 45,75 40,65 C 35,55 25,45 25,30 Z'></path>
                    <path d='M 35,30 C 35,22 42,18 50,18 C 58,18 65,22 65,30 C 65,35 62,40 59,45 C 56,50 54,55 54,60 C 52,60 48,60 46,60 C 46,55 44,50 41,45 C 38,40 35,35 35,30 Z' fill='#ffffff' opacity='0.15'></path>
                </svg>
            </div>
            <div class='tooth-label'>#{num}</div>
        </div>";
    }
}

<!-- JavaScript for Interactive Tooth Chart Logic -->
<script>
    // Seeding current data from C# Model to JS Memory
    let toothData = {};
    const patientId = @Model.Id;
    let toothChartVersion = @Model.ToothChartVersion;
    const canEdit = @(canEdit ? "true" : "false");
    
    // Status color mapping object
    const statusTextMapping = {
        "Normal": { text: "Bình thường", class: "bg-success-subtle text-success", hex: "var(--normal-color)" },
        "Caries": { text: "Sâu răng", class: "bg-warning-subtle text-warning-emphasis", hex: "var(--caries-color)" },
        "Filling": { text: "Răng trám", class: "bg-primary-subtle text-primary", hex: "var(--filling-color)" },
        "RCT": { text: "Điều trị tủy (RCT)", class: "bg-info-subtle text-info-emphasis", hex: "var(--rct-color)" },
        "Extraction": { text: "Đã nhổ", class: "bg-danger-subtle text-danger", hex: "var(--extraction-color)" },
        "Implant": { text: "Cấy ghép Implant", class: "bg-indigo-subtle text-indigo", hex: "var(--implant-color)" },
        "Crown": { text: "Bọc mão sứ", class: "bg-purple-subtle text-purple", hex: "var(--crown-color)" },
        "Bridge": { text: "Cầu răng", class: "bg-orange-subtle text-orange", hex: "var(--bridge-color)" }
    };

    // Tooth names helper mapping
    const toothNames = {
        // Upper right
        18: "Răng khôn hàm trên bên phải",
        17: "Răng cối lớn thứ hai hàm trên bên phải",
        16: "Răng cối lớn thứ nhất hàm trên bên phải",
        15: "Răng cối nhỏ thứ hai hàm trên bên phải",
        14: "Răng cối nhỏ thứ nhất hàm trên bên phải",
        13: "Răng nanh hàm trên bên phải",
        12: "Răng cửa bên hàm trên bên phải",
        11: "Răng cửa giữa hàm trên bên phải",
        // Upper left
        21: "Răng cửa giữa hàm trên bên trái",
        22: "Răng cửa bên hàm trên bên trái",
        23: "Răng nanh hàm trên bên trái",
        24: "Răng cối nhỏ thứ nhất hàm trên bên trái",
        25: "Răng cối nhỏ thứ hai hàm trên bên trái",
        26: "Răng cối lớn thứ nhất hàm trên bên trái",
        27: "Răng cối lớn thứ hai hàm trên bên trái",
        28: "Răng khôn hàm trên bên trái",
        // Lower left
        38: "Răng khôn hàm dưới bên trái",
        37: "Răng cối lớn thứ hai hàm dưới bên trái",
        36: "Răng cối lớn thứ nhất hàm dưới bên trái",
        35: "Răng cối nhỏ thứ hai hàm dưới bên trái",
        34: "Răng cối nhỏ thứ nhất hàm dưới bên trái",
        33: "Răng nanh hàm dưới bên trái",
        32: "Răng cửa bên hàm dưới bên trái",
        31: "Răng cửa giữa hàm dưới bên trái",
        // Lower right
        41: "Răng cửa giữa hàm dưới bên phải",
        42: "Răng cửa bên hàm dưới bên phải",
        43: "Răng nanh hàm dưới bên phải",
        44: "Răng cối nhỏ thứ nhất hàm dưới bên phải",
        45: "Răng cối nhỏ thứ hai hàm dưới bên phải",
        46: "Răng cối lớn thứ nhất hàm dưới bên phải",
        47: "Răng cối lớn thứ hai hàm dưới bên phải",
        48: "Răng khôn hàm dưới bên phải",
        
        // Deciduous Teeth (Children)
        55: "Răng cối sữa thứ hai hàm trên bên phải",
        54: "Răng cối sữa thứ nhất hàm trên bên phải",
        53: "Răng nanh sữa hàm trên bên phải",
        52: "Răng cửa bên sữa hàm trên bên phải",
        51: "Răng cửa giữa sữa hàm trên bên phải",
        61: "Răng cửa giữa sữa hàm trên bên trái",
        62: "Răng cửa bên sữa hàm trên bên trái",
        63: "Răng nanh sữa hàm trên bên trái",
        64: "Răng cối sữa thứ nhất hàm trên bên trái",
        65: "Răng cối sữa thứ hai hàm trên bên trái",
        75: "Răng cối sữa thứ hai hàm dưới bên trái",
        74: "Răng cối sữa thứ nhất hàm dưới bên trái",
        73: "Răng nanh sữa hàm dưới bên trái",
        72: "Răng cửa bên sữa hàm dưới bên trái",
        71: "Răng cửa giữa sữa hàm dưới bên trái",
        81: "Răng cửa giữa sữa hàm dưới bên phải",
        82: "Răng cửa bên sữa hàm dưới bên phải",
        83: "Răng nanh sữa hàm dưới bên phải",
        84: "Răng cối sữa thứ nhất hàm dưới bên phải",
        85: "Răng cối sữa thứ hai hàm dưới bên phải"
    };

    let selectedTooth = null;
    let pendingChanges = {}; // stores local updates: { toothNumber: { status, notes, prescription } }

    document.addEventListener("DOMContentLoaded", function () {
        // Initialize memory with initial state from DB
        @foreach (var toothNum in new int[] {
            18, 17, 16, 15, 14, 13, 12, 11, 21, 22, 23, 24, 25, 26, 27, 28,
            48, 47, 46, 45, 44, 43, 42, 41, 31, 32, 33, 34, 35, 36, 37, 38,
            55, 54, 53, 52, 51, 61, 62, 63, 64, 65,
            85, 84, 83, 82, 81, 71, 72, 73, 74, 75
        })
        {
            var latestRecord = Model.ToothRecords
                .Where(r => r.ToothNumber == toothNum)
                .OrderByDescending(r => r.Timestamp)
                .FirstOrDefault();
            var status = latestRecord?.Status ?? "Normal";
            var notes = latestRecord?.Notes ?? "";
            var rx = latestRecord?.Prescription ?? "";
            var doc = latestRecord?.Doctor?.User?.FullName ?? "Hệ thống";
            var date = latestRecord?.Timestamp.ToString("dd/MM/yyyy HH:mm") ?? "—";

            <text>
            toothData["@toothNum"] = {
                status: "@status",
                notes: `@Html.Raw(notes.Replace("`", "\\`").Replace("\r\n", " ").Replace("\n", " "))`,
                prescription: `@Html.Raw(rx.Replace("`", "\\`").Replace("\r\n", " ").Replace("\n", " "))`,
                doctorName: "@doc",
                date: "@date"
            };
            </text>
        }


        // Draw the initial colors on the odontogram
        drawAllTeethColors();
    });

    // Color the SVGs based on current data
    function drawAllTeethColors() {
        for (const num in toothData) {
            const data = toothData[num];
            setToothColor(num, data.status);
        }
    }

    function setToothColor(num, status) {
        const path = document.getElementById("tooth-path-" + num);
        if (path) {
            // Remove previous statuses
            path.className.baseVal = "tooth-path";
            path.classList.add("status-" + status.toLowerCase());
        }
    }

    // Toggle between Adult and Child dentition views
    function toggleDentition(type) {
        const btnAdult = document.getElementById("btn-adult");
        const btnChild = document.getElementById("btn-child");
        const adultChart = document.getElementById("adult-odontogram");
        const childChart = document.getElementById("child-odontogram");

        if (type === "adult") {
            btnAdult.className = "btn btn-sm btn-dark rounded-pill px-3 shadow-none border-0";
            btnChild.className = "btn btn-sm text-dark rounded-pill px-3 shadow-none border-0";
            adultChart.classList.remove("d-none");
            childChart.classList.add("d-none");
        } else {
            btnChild.className = "btn btn-sm btn-dark rounded-pill px-3 shadow-none border-0";
            btnAdult.className = "btn btn-sm text-dark rounded-pill px-3 shadow-none border-0";
            childChart.classList.remove("d-none");
            adultChart.classList.add("d-none");
        }
        
        // Reset selected tooth since the active view changed
        resetSelectedTooth();
    }

    function resetSelectedTooth() {
        if (selectedTooth) {
            const el = document.getElementById("tooth-svg-wrapper-" + selectedTooth);
            if (el) el.classList.remove("selected");
        }
        selectedTooth = null;
        document.getElementById("panel-placeholder").classList.remove("d-none");
        document.getElementById("panel-content").classList.add("d-none");
    }

    // Select a tooth and update the panel
    function selectTooth(num) {
        // Toggle selection state
        if (selectedTooth) {
            const prevEl = document.getElementById("tooth-svg-wrapper-" + selectedTooth);
            if (prevEl) prevEl.classList.remove("selected");
        }

        selectedTooth = num;
        const newEl = document.getElementById("tooth-svg-wrapper-" + num);
        if (newEl) newEl.classList.add("selected");

        // Show panel
        document.getElementById("panel-placeholder").classList.add("d-none");
        const panel = document.getElementById("panel-content");
        panel.classList.remove("d-none");

        // Get details
        const info = toothData[num];
        const pending = pendingChanges[num];
        const status = pending ? pending.status : info.status;
        const notes = pending ? pending.notes : info.notes;
        const rx = pending ? pending.prescription : info.prescription;

        // Render header
        document.getElementById("lbl-tooth-number").innerText = "#" + num;
        document.getElementById("lbl-tooth-name").innerText = toothNames[num] || "Răng";
        
        // Render badge
        const badge = document.getElementById("lbl-tooth-status-badge");
        const badgeConfig = statusTextMapping[status] || { text: status, class: "bg-secondary text-white" };
        badge.innerText = badgeConfig.text;
        badge.className = "badge rounded-pill px-3 py-1 mt-2 small " + badgeConfig.class;

        // Render large SVG icon in sidebar
        const largeIconContainer = document.getElementById("selected-tooth-svg-icon");
        largeIconContainer.innerHTML = `
            <svg viewBox="0 0 100 100" style="width: 50px; height: 60px;">
                <path class="tooth-path status-${status.toLowerCase()}" style="stroke-width:3" d="M 25,30 C 25,15 35,10 50,10 C 65,10 75,15 75,30 C 75,45 70,55 65,65 C 60,75 58,85 58,90 C 58,93 56,95 53,95 C 50,95 48,93 48,90 C 48,85 45,75 40,65 C 35,55 25,45 25,30 Z"></path>
            </svg>
        `;

        // Render attending info
        document.getElementById("lbl-doctor-name").innerText = pending ? "Nháp (chưa lưu)" : (info.doctorName || "Hệ thống");
        document.getElementById("lbl-last-visit").innerText = pending ? "Hôm nay (chờ lưu)" : (info.date || "—");

        // Load input fields (if can edit)
        const selectEl = document.getElementById("form-tooth-status");
        if (selectEl) {
            selectEl.value = status;
            document.getElementById("form-tooth-notes").value = notes || "";
            document.getElementById("form-tooth-prescription").value = rx || "";
        }

        // Fetch and render single tooth timeline history from DB (Luồng 5.2)
        fetch(`/Patient/GetToothHistory?patientId=${patientId}&toothNumber=${num}`)
            .then(res => {
                if (res.status === 403) {
                    throw new Error("Bạn không có quyền truy cập.");
                }
                return res.json();
            })
            .then(history => {
                const list = document.getElementById("lbl-tooth-history-list");
                list.innerHTML = "";

                if (history.length === 0) {
                    list.innerHTML = `<div class="text-muted small py-2">Chưa có lịch sử điều trị tại vị trí này.</div>`;
                    return;
                }

                // Render Progress Visualization flow
                let timelineHtml = `<div class="tooth-timeline">`;
                history.forEach((h, idx) => {
                    const statusConfig = statusTextMapping[h.status] || { text: h.status, class: "bg-secondary text-white" };
                    const isActive = idx === 0; // Latest is active
                    
                    timelineHtml += `
                        <div class="tooth-timeline-item ${isActive ? 'active-item' : ''}">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge ${statusConfig.class} rounded-pill px-2 py-0.5" style="font-size: 0.72rem;">${statusConfig.text}</span>
                                <span class="text-muted text-xs font-monospace" style="font-size: 0.72rem;">${h.timestamp}</span>
                            </div>
                            <div class="fw-semibold text-dark text-xs" style="font-size: 0.75rem;">BS. ${h.doctorName}</div>
                            ${h.notes ? `<p class="mb-1 text-secondary mt-1 small" style="font-size: 0.75rem; line-height:1.3">${h.notes}</p>` : ''}
                            ${h.prescription ? `<div class="bg-light p-1.5 rounded-2 text-danger mt-1 small" style="font-size: 0.72rem;"><i class="bi bi-capsule me-1"></i>Chỉ định: ${h.prescription}</div>` : ''}
                        </div>
                    `;
                });
                timelineHtml += "</div>";
                list.innerHTML = timelineHtml;
            })
            .catch(err => {
                console.error(err);
                document.getElementById("lbl-tooth-history-list").innerHTML = `<div class="text-danger small py-2"><i class="bi bi-exclamation-octagon me-1"></i>Lỗi tải lịch sử hoặc bị chặn quyền truy cập.</div>`;
            });
    }

    // Apply change locally to preview (Luồng 5.1 - Bước 4)
    function applyPendingChange() {
        if (!selectedTooth || !canEdit) return;

        const status = document.getElementById("form-tooth-status").value;
        const notes = document.getElementById("form-tooth-notes").value;
        const prescription = document.getElementById("form-tooth-prescription").value;

        // Save into pendingChanges
        pendingChanges[selectedTooth] = {
            toothNumber: selectedTooth,
            status: status,
            notes: notes,
            prescription: prescription
        };

        // Mark on UI
        const wrapper = document.getElementById("tooth-svg-wrapper-" + selectedTooth);
        if (wrapper) wrapper.classList.add("pending-change");

        // Preview status color
        setToothColor(selectedTooth, status);

        // Update the details panel header badge
        const badge = document.getElementById("lbl-tooth-status-badge");
        const badgeConfig = statusTextMapping[status] || { text: status, class: "bg-secondary" };
        badge.innerText = badgeConfig.text;
        badge.className = "badge rounded-pill px-3 py-1 mt-2 small " + badgeConfig.class;
        
        // Render large SVG icon in sidebar
        const largeIconContainer = document.getElementById("selected-tooth-svg-icon");
        largeIconContainer.innerHTML = `
            <svg viewBox="0 0 100 100" style="width: 50px; height: 60px;">
                <path class="tooth-path status-${status.toLowerCase()}" style="stroke-width:3" d="M 25,30 C 25,15 35,10 50,10 C 65,10 75,15 75,30 C 75,45 70,55 65,65 C 60,75 58,85 58,90 C 58,93 56,95 53,95 C 50,95 48,93 48,90 C 48,85 45,75 40,65 C 35,55 25,45 25,30 Z"></path>
            </svg>
        `;

        // Update bottom action bar count
        const count = Object.keys(pendingChanges).length;
        document.getElementById("unsaved-changes-count").innerText = count;
        
        const actionBar = document.getElementById("save-action-bar");
        if (count > 0) {
            actionBar.classList.add("show");
        } else {
            actionBar.classList.remove("show");
        }
    }

    // Cancel all changes locally
    function cancelChanges() {
        // Clear pending wrapper classes
        for (const num in pendingChanges) {
            const wrapper = document.getElementById("tooth-svg-wrapper-" + num);
            if (wrapper) wrapper.classList.remove("pending-change");
        }

        pendingChanges = {};
        
        // Reset colors
        drawAllTeethColors();

        // Hide action bar
        document.getElementById("save-action-bar").classList.remove("show");

        // Reload current selected tooth if any
        if (selectedTooth) {
            selectTooth(selectedTooth);
        }
    }

    // AJAX POST to save all changes to server (Luồng 5.1 - Bước 5,6,7)
    function saveToothChanges() {
        const changesArray = Object.values(pendingChanges);
        if (changesArray.length === 0) return;

        const payload = {
            patientId: patientId,
            version: toothChartVersion,
            changes: changesArray
        };

        const saveButton = document.querySelector(".action-bar .btn-success");
        const originalHtml = saveButton.innerHTML;
        saveButton.disabled = true;
        saveButton.innerHTML = `<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Đang lưu...`;

        fetch('/Patient/SaveToothChart', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
        })
        .then(res => res.json())
        .then(data => {
            saveButton.disabled = false;
            saveButton.innerHTML = originalHtml;

            if (data.success) {
                // Success: update version and local dataset
                toothChartVersion = data.newVersion;
                document.getElementById("version-label").innerText = toothChartVersion;

                // Update local dataset memory
                for (const change of changesArray) {
                    const num = change.toothNumber;
                    toothData[num].status = change.status;
                    toothData[num].notes = change.notes;
                    toothData[num].prescription = change.prescription;
                    toothData[num].doctorName = "@(ViewBag.CurrentDoctor?.User?.FullName ?? "Bác sĩ")";
                    toothData[num].date = new Date().toLocaleDateString("vi-VN") + " " + new Date().toLocaleTimeString("vi-VN", { hour: '2-digit', minute: '2-digit' });

                    const wrapper = document.getElementById("tooth-svg-wrapper-" + num);
                    if (wrapper) wrapper.classList.remove("pending-change");
                }

                pendingChanges = {};
                document.getElementById("save-action-bar").classList.remove("show");
                
                // Alert user
                const alertContainer = document.createElement("div");
                alertContainer.className = "alert alert-success border-0 rounded-4 py-2 px-3 mb-3 shadow-sm alert-dismissible fade show";
                alertContainer.role = "alert";
                alertContainer.innerHTML = `<i class="bi bi-check-circle me-2"></i>Đã lưu sơ đồ răng thành công! (Phiên bản mới: V.${toothChartVersion})<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>`;
                document.querySelector(".container-fluid, .d-flex.align-items-center").before(alertContainer);
                
                // Reload selected tooth to show new history
                if (selectedTooth) {
                    selectTooth(selectedTooth);
                }
            } 
            else if (data.conflict) {
                // EX4.3-02: Concurrency collision
                const conflictModal = new bootstrap.Modal(document.getElementById('conflictModal'));
                conflictModal.show();
            } 
            else {
                alert("Lỗi khi lưu sơ đồ răng: " + data.message);
            }
        })
        .catch(err => {
            saveButton.disabled = false;
            saveButton.innerHTML = originalHtml;
            console.error(err);
            alert("Đã xảy ra lỗi mạng. Vui lòng kiểm tra kết nối.");
        });
    }
</script>
