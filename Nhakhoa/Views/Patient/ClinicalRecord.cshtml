@model Nhakhoa.Models.Patient
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Hồ sơ lâm sàng - " + Model.FullName;

    // Phân quyền: Chỉ cho phép Admin hoặc Bác sĩ điều trị chính được chỉnh sửa (EX4.3-01)
    bool isDoctor = User.IsInRole("Doctor");
    bool isAdmin = User.IsInRole("Admin");
    bool canEdit = isAdmin || (isDoctor && (Model.PrimaryDoctorId == null || Model.PrimaryDoctorId == ViewBag.CurrentDoctor?.Id));
}

<style>
    /* Premium styling for interactive tooth chart */
    :root {
        --normal-color: #22c55e;
        --caries-color: #eab308;
        --filling-color: #3b82f6;
        --rct-color: #14b8a6;
        --extraction-color: #ef4444;
        --implant-color: #6366f1;
        --crown-color: #a855f7;
        --bridge-color: #f97316;
    }

    .tooth-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 50px;
        margin: 5px;
        position: relative;
    }

    .tooth-label {
        font-size: 0.75rem;
        font-weight: 700;
        color: #64748b;
        margin-top: 4px;
        text-align: center;
    }

    .tooth-svg-wrapper {
        position: relative;
        width: 44px;
        height: 52px;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .tooth-svg-wrapper:hover {
        transform: translateY(-4px) scale(1.08);
        filter: drop-shadow(0 10px 8px rgba(0, 0, 0, 0.08));
    }

    .tooth-path {
        fill: #f1f5f9;
        stroke: #cbd5e1;
        stroke-width: 2.5;
        transition: fill 0.3s ease, stroke 0.3s ease;
    }

    /* Status coloring */
    .tooth-path.status-normal { fill: var(--normal-color); stroke: #16a34a; }
    .tooth-path.status-caries { fill: var(--caries-color); stroke: #ca8a04; }
    .tooth-path.status-filling { fill: var(--filling-color); stroke: #2563eb; }
    .tooth-path.status-rct { fill: var(--rct-color); stroke: #0d9488; }
    .tooth-path.status-extraction { fill: var(--extraction-color); stroke: #dc2626; }
    .tooth-path.status-implant { fill: var(--implant-color); stroke: #4f46e5; }
    .tooth-path.status-crown { fill: var(--crown-color); stroke: #9333ea; }
    .tooth-path.status-bridge { fill: var(--bridge-color); stroke: #ea580c; }

    /* Selection & Preview States */
    .tooth-svg-wrapper.selected {
        filter: drop-shadow(0 0 8px rgba(59, 130, 246, 0.6));
    }
    .tooth-svg-wrapper.selected .tooth-path {
        stroke: #1e3a8a !important;
        stroke-width: 3.5 !important;
    }

    .tooth-svg-wrapper.pending-change::after {
        content: '';
        position: absolute;
        top: -4px;
        left: -4px;
        right: -4px;
        bottom: -4px;
        border: 2px dashed #f59e0b;
        border-radius: 50%;
        animation: rotate 8s linear infinite;
        pointer-events: none;
    }

    @@keyframes rotate {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    /* Custom tab navigation styling */
    .nav-pills-custom .nav-link {
        color: #475569;
        font-weight: 600;
        border-radius: 30px;
        padding: 8px 20px;
        transition: all 0.2s ease;
        border: 1px solid transparent;
    }
    .nav-pills-custom .nav-link.active {
        background-color: #1e293b !important;
        color: #ffffff !important;
    }
    .nav-pills-custom .nav-link:hover:not(.active) {
        background-color: #f1f5f9;
        border-color: #cbd5e1;
    }

    /* Legend colors */
    .legend-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 6px;
    }

    /* Fixed bottom actions bar */
    .action-bar {
        position: fixed;
        bottom: 24px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(15, 23, 42, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 16px 28px;
        border-radius: 20px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.3);
        display: flex;
        align-items: center;
        gap: 20px;
        z-index: 1050;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .action-bar.show {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(0);
    }

    /* Sidebar history timeline */
    .tooth-timeline {
        border-left: 2px solid #e2e8f0;
        padding-left: 16px;
        margin-left: 8px;
    }
    .tooth-timeline-item {
        position: relative;
        margin-bottom: 20px;
    }
    .tooth-timeline-item::before {
        content: '';
        position: absolute;
        left: -23px;
        top: 4px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #cbd5e1;
        border: 2px solid #ffffff;
    }
    .tooth-timeline-item.active-item::before {
        background: var(--normal-color);
        box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.2);
    }

    /* Custom scrollbar */
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }
</style>

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-0" style="color:#0b1f35">
            <i class="bi bi-file-medical-fill text-danger me-2"></i>Hồ sơ bệnh án điện tử (EMR)
        </h4>
        <div class="text-muted small mt-1">Ghi nhận tình trạng lâm sàng và sơ đồ răng của bệnh nhân</div>
    </div>
    <div class="d-flex gap-2">
        <a href="/Patient/Details/@Model.Id" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 rounded-4 py-2 px-3 mb-3 shadow-sm alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Patient Info Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4" style="background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3 border-bottom pb-3">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary-subtle text-primary rounded-circle d-grid place-items-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-person-badge fs-4"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-0">@Model.FullName</h5>
                    <span class="badge bg-danger-subtle text-danger rounded-pill px-3 mt-1">Mã HS: @Model.PatientCode</span>
                </div>
            </div>
            
            <!-- Doctor Assignment Status (EX4.3-01) -->
            <div class="d-flex align-items-center gap-2">
                @if (Model.PrimaryDoctorId != null)
                {
                    <div class="bg-dark text-white rounded-pill px-3 py-2 d-flex align-items-center gap-2 shadow-sm small">
                        <i class="bi bi-person-heart text-danger"></i>
                        <span>Bác sĩ điều trị chính: <strong>@Model.PrimaryDoctor?.User?.FullName</strong></span>
                    </div>
                    @if (isAdmin)
                    {
                        <!-- Admin can reassign -->
                        <button class="btn btn-light btn-sm rounded-circle shadow-sm" data-bs-toggle="modal" data-bs-target="#assignDoctorModal" title="Chuyển giao bác sĩ">
                            <i class="bi bi-arrow-left-right text-primary"></i>
                        </button>
                    }
                }
                else
                {
                    <div class="bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-2 d-flex align-items-center gap-2 small">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>Chưa có bác sĩ điều trị chính</span>
                    </div>
                    @if (canEdit)
                    {
                        <button class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#assignDoctorModal">
                            <i class="bi bi-plus-circle me-1"></i> Nhận điều trị chính
                        </button>
                    }
                }
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="text-muted small">Ngày sinh</div>
                <div class="fw-semibold">@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "—")</div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="text-muted small">Giới tính</div>
                <div class="fw-semibold">@(Model.Gender ?? "—")</div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="text-muted small">Số điện thoại</div>
                <div class="fw-semibold">@Model.PhoneNumber</div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="text-muted small">Tiền sử dị ứng</div>
                <div class="fw-semibold text-danger">@(Model.AllergyHistory ?? "Không có")</div>
            </div>
        </div>
    </div>
</div>

<!-- Tabs Navigation -->
<div class="mb-4">
    <ul class="nav nav-pills nav-pills-custom gap-2" id="clinicalRecordTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="timeline-tab" data-bs-toggle="tab" data-bs-target="#timeline-content" type="button" role="tab" aria-selected="true">
                <i class="bi bi-journal-text me-2"></i>Nhật ký điều trị lâm sàng
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="odontogram-tab" data-bs-toggle="tab" data-bs-target="#odontogram-content" type="button" role="tab" aria-selected="false">
                <i class="bi bi-diagram-3 me-2"></i>Sơ đồ răng tương tác
            </button>
        </li>
    </ul>
</div>

<!-- Tabs Content -->
<div class="tab-content" id="clinicalRecordTabsContent">
    
    <!-- Tab 1: Timeline điều trị lâm sàng -->
    <div class="tab-pane fade show active" id="timeline-content" role="tabpanel" aria-labelledby="timeline-tab">
        <div class="row g-4">
            <div class="col-md-8">
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                        <h5 class="fw-bold mb-0"><i class="bi bi-clock-history text-primary me-2"></i>Nhật ký điều trị lâm sàng</h5>
                    </div>
                    <div class="card-body px-4 pb-4">
                        <div class="timeline mt-3">
                            <div class="d-flex gap-3 mb-4 position-relative">
                                <div class="text-end" style="min-width: 90px;">
                                    <div class="fw-bold">12/05/2026</div>
                                    <div class="text-muted small">09:15</div>
                                </div>
                                <div class="bg-primary rounded-circle" style="width:12px; height:12px; margin-top: 6px; flex-shrink: 0; z-index:1;"></div>
                                <div>
                                    <div class="fw-bold">Khám tổng quát & Chẩn đoán hình ảnh</div>
                                    <div class="text-muted small mt-1">Bác sĩ thực hiện: BS. Nguyễn Văn Đạt</div>
                                    <p class="mt-2 text-secondary">Bệnh nhân đau răng số 36 âm ỉ, răng nhạy cảm với nhiệt độ nóng/lạnh. Tiến hành chụp X-quang răng cận chóp phát hiện sâu răng tiến triển sát tủy.</p>
                                    <div class="p-3 bg-light rounded-3">
                                        <strong>Chỉ định lâm sàng:</strong>
                                        <ul class="mb-0 mt-1">
                                            <li>Lấy tủy buồng, tạo hình ống tủy</li>
                                            <li>Trám kết thúc bằng composite thẩm mỹ</li>
                                            <li>Kê đơn thuốc giảm đau kháng viêm Hapacol 650mg</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                        <h5 class="fw-bold mb-0"><i class="bi bi-capsule text-danger me-2"></i>Đơn thuốc & Phác đồ</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="p-3 bg-danger-subtle text-danger rounded-3 mb-3">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong>Chú ý dị ứng:</strong> @(Model.AllergyHistory ?? "Không ghi nhận dị ứng đặc biệt.")
                        </div>
                        <div class="text-muted small mb-2">ĐƠN THUỐC GẦN NHẤT</div>
                        <div class="border rounded-3 p-3 mb-3 bg-light">
                            <div class="fw-bold">Hapacol 650mg</div>
                            <div class="text-muted small">Số lượng: 10 viên | Ngày uống 2 lần, mỗi lần 1 viên sau ăn.</div>
                            <hr class="my-2">
                            <div class="fw-bold">Amoxicillin 500mg</div>
                            <div class="text-muted small">Số lượng: 14 viên | Ngày uống 2 lần, mỗi lần 1 viên sau ăn.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Tab 2: Sơ đồ răng tương tác -->
    <div class="tab-pane fade" id="odontogram-content" role="tabpanel" aria-labelledby="odontogram-tab">
        <div class="row g-4">
            
            <!-- Left Side: Interactive Odontogram Chart -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                            <div>
                                <h5 class="fw-bold mb-1">Sơ đồ răng khám nha khoa</h5>
                                <div class="text-muted small">Nhấp chọn một răng bất kỳ để xem lịch sử và cập nhật trạng thái</div>
                            </div>
                            
                            <!-- Dentition Toggle -->
                            <div class="btn-group rounded-pill p-1 bg-light border" role="group">
                                <button type="button" class="btn btn-sm btn-dark rounded-pill px-3 shadow-none border-0" id="btn-adult" onclick="toggleDentition('adult')">Người lớn (32)</button>
                                <button type="button" class="btn btn-sm text-dark rounded-pill px-3 shadow-none border-0" id="btn-child" onclick="toggleDentition('child')">Trẻ em (20)</button>
                            </div>
                        </div>

                        <!-- Status Color Legends -->
                        <div class="d-flex flex-wrap gap-3 p-3 bg-light rounded-4 mb-4 small justify-content-center">
                            <div><span class="legend-dot" style="background:var(--normal-color)"></span>Bình thường</div>
                            <div><span class="legend-dot" style="background:var(--caries-color)"></span>Sâu răng</div>
                            <div><span class="legend-dot" style="background:var(--filling-color)"></span>Răng trám</div>
                            <div><span class="legend-dot" style="background:var(--rct-color)"></span>Điều trị tủy (RCT)</div>
                            <div><span class="legend-dot" style="background:var(--extraction-color)"></span>Nhổ răng</div>
                            <div><span class="legend-dot" style="background:var(--implant-color)"></span>Cấy ghép Implant</div>
                            <div><span class="legend-dot" style="background:var(--crown-color)"></span>Bọc mão sứ</div>
                            <div><span class="legend-dot" style="background:var(--bridge-color)"></span>Cầu răng</div>
                        </div>

                        <!-- Odontogram Chart Arches (Scrollable container for small screens) -->
                        <div class="text-center overflow-x-auto py-3 custom-scrollbar">
                            
                            <!-- ADULT VIEW -->
                            <div id="adult-odontogram">
                                <h6 class="text-muted text-uppercase fw-bold small mb-3 letter-spacing-1">Cung hàm trên (Maxillary Arch)</h6>
                                
                                <!-- Maxillary Row -->
                                <div class="d-flex justify-content-center align-items-center mb-5 px-3">
                                    <!-- Quadrant 1 (Right): 18 -> 11 -->
                                    <div class="d-flex align-items-center flex-row-reverse border-end pe-3 border-secondary border-opacity-25">
                                        @for (int i = 18; i >= 11; i--)
                                        {
                                            @Html.Raw(RenderToothSvgHtml(i))
                                        }
                                    </div>
                                    <!-- Quadrant 2 (Left): 21 -> 28 -->
                                    <div class="d-flex align-items-center ps-3">
                                        @for (int i = 21; i <= 28; i++)
                                        {
                                            @Html.Raw(RenderToothSvgHtml(i))
                                        }
                                    </div>
                                </div>

                                <hr class="my-4 border-secondary border-opacity-25" style="border-style: dashed;">

                                <h6 class="text-muted text-uppercase fw-bold small mb-3 letter-spacing-1 mt-4">Cung hàm dưới (Mandibular Arch)</h6>
                                <!-- Mandibular Row -->
                                <div class="d-flex justify-content-center align-items-center mb-3 px-3">
                                    <!-- Quadrant 4 (Right): 48 -> 41 -->
                                    <div class="d-flex align-items-center flex-row-reverse border-end pe-3 border-secondary border-opacity-25">
                                        @for (int i = 48; i >= 41; i--)
                                        {
                                            @Html.Raw(RenderToothSvgHtml(i))
                                        }
                                    </div>
                                    <!-- Quadrant 3 (Left): 31 -> 38 -->
                                    <div class="d-flex align-items-center ps-3">
                                        @for (int i = 31; i <= 38; i++)
                                        {
                                            @Html.Raw(RenderToothSvgHtml(i))
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- CHILD VIEW (Hidden by default) -->
                            <div id="child-odontogram" class="d-none">
                                <h6 class="text-muted text-uppercase fw-bold small mb-3 letter-spacing-1">Cung răng sữa hàm trên</h6>
                                <!-- Child Maxillary Row -->
                                <div class="d-flex justify-content-center align-items-center mb-5 px-3">
                                    <!-- Quadrant 5 (Right): 55 -> 51 -->
                                    <div class="d-flex align-items-center flex-row-reverse border-end pe-3 border-secondary border-opacity-25">
                                        @for (int i = 55; i >= 51; i--)
                                        {
                                            @Html.Raw(RenderToothSvgHtml(i))
                                        }
                                    </div>
                                    <!-- Quadrant 6 (Left): 61 -> 65 -->
                                    <div class="d-flex align-items-center ps-3">
                                        @for (int i = 61; i <= 65; i++)
                                        {
                                            @Html.Raw(RenderToothSvgHtml(i))
                                        }
                                    </div>
                                </div>

                                <hr class="my-4 border-secondary border-opacity-25" style="border-style: dashed;">

                                <h6 class="text-muted text-uppercase fw-bold small mb-3 letter-spacing-1 mt-4">Cung răng sữa hàm dưới</h6>
                                <!-- Child Mandibular Row -->
                                <div class="d-flex justify-content-center align-items-center mb-3 px-3">
                                    <!-- Quadrant 8 (Right): 85 -> 81 -->
                                    <div class="d-flex align-items-center flex-row-reverse border-end pe-3 border-secondary border-opacity-25">
                                        @for (int i = 85; i >= 81; i--)
                                        {
                                            @Html.Raw(RenderToothSvgHtml(i))
                                        }
                                    </div>
                                    <!-- Quadrant 7 (Left): 71 -> 75 -->
                                    <div class="d-flex align-items-center ps-3">
                                        @for (int i = 71; i <= 75; i++)
                                        {
                                            @Html.Raw(RenderToothSvgHtml(i))
                                        }
                                    </div>
                                </div>
                            </div>
                            
                        </div>

                        <div class="d-flex align-items-center justify-content-between mt-4 text-muted small border-top pt-3">
                            <div><i class="bi bi-clock-history me-1"></i>Phiên bản sơ đồ: <strong>V.<span id="version-label">@Model.ToothChartVersion</span></strong></div>
                            <div><i class="bi bi-info-circle me-1"></i>Click trực tiếp vào răng để ghi nhận tình trạng lâm sàng</div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Right Side: Tooth Information and Action Panel -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 h-100" style="min-height: 500px;">
                    <div class="card-body p-4 d-flex flex-column" id="tooth-detail-panel">
                        
                        <!-- Initial placeholder state -->
                        <div class="my-auto text-center py-5 text-muted" id="panel-placeholder">
                            <i class="bi bi-heart-pulse display-3 opacity-25 d-block mb-3"></i>
                            <h6 class="fw-bold mb-1">Chưa chọn vị trí răng</h6>
                            <p class="small text-secondary px-4">Bác sĩ hãy chọn một răng trên sơ đồ để xem thông tin chi tiết và cập nhật tiến trình điều trị.</p>
                        </div>
                        
                        <!-- Real detailed content (hidden by default) -->
                        <div id="panel-content" class="d-none flex-grow-1 d-flex flex-column">
                            
                            <!-- Tooth header -->
                            <div class="d-flex align-items-start gap-3 border-bottom pb-3 mb-3">
                                <div id="selected-tooth-svg-icon" class="p-2 bg-light rounded-3">
                                    <!-- Large tooth SVG will render here -->
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="fw-bold mb-0 text-dark">Răng <span id="lbl-tooth-number">#16</span></h5>
                                    <div class="text-muted small mt-1" id="lbl-tooth-name">Răng cối lớn thứ nhất</div>
                                    <span class="badge rounded-pill px-3 py-1 mt-2 small" id="lbl-tooth-status-badge" style="font-size:0.8rem">Bình thường</span>
                                </div>
                            </div>

                            <!-- Attending Info -->
                            <div class="row g-2 mb-3 bg-light p-3 rounded-4 small">
                                <div class="col-6">
                                    <div class="text-muted">Bác sĩ ghi nhận:</div>
