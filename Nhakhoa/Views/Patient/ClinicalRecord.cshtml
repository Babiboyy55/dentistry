                .OrderByDescending(r => r.Timestamp)
                .FirstOrDefault();
            var status = latestRecord?.Status ?? "Normal";
            var notes = latestRecord?.Notes ?? "";
            var rx = latestRecord?.Prescription ?? "";
            var doc = latestRecord?.Doctor?.User?.FullName ?? "Hệ thống";
            var date = latestRecord?.Timestamp.ToString("dd/MM/yyyy HH:mm") ?? "—";

            <text>
            toothData["@toothNum"] = {
                status: "@status",
                notes: `@Html.Raw(notes.Replace("`", "\\`").Replace("\r\n", " ").Replace("\n", " "))`,
                prescription: `@Html.Raw(rx.Replace("`", "\\`").Replace("\r\n", " ").Replace("\n", " "))`,
                doctorName: "@doc",
                date: "@date"
            };
            </text>
        }

        drawAllTeethColors();
        restoreEMRFromLocalStorage();

        // Listen for offline state auto-save (EX4.1-04)
        if (canEdit) {
            setInterval(autoSaveEMRToLocalStorage, 3000);
        }
    });

    function drawAllTeethColors() {
        for (const num in toothData) {
            setToothColor(num, toothData[num].status);
        }
    }

    function setToothColor(num, status) {
        const path = document.getElementById("tooth-path-" + num);
        if (path) {
            path.className.baseVal = "tooth-path";
            path.classList.add("status-" + status.toLowerCase());
        }
    }

    function toggleDentition(type) {
        const btnAdult = document.getElementById("btn-adult");
        const btnChild = document.getElementById("btn-child");
        const adultChart = document.getElementById("adult-odontogram");
        const childChart = document.getElementById("child-odontogram");

        if (type === "adult") {
            btnAdult.className = "btn btn-sm btn-dark rounded-pill px-3 shadow-none border-0";
            btnChild.className = "btn btn-sm text-dark rounded-pill px-3 shadow-none border-0";
            adultChart.classList.remove("d-none");
            childChart.classList.add("d-none");
        } else {
            btnChild.className = "btn btn-sm btn-dark rounded-pill px-3 shadow-none border-0";
            btnAdult.className = "btn btn-sm text-dark rounded-pill px-3 shadow-none border-0";
            childChart.classList.remove("d-none");
            adultChart.classList.add("d-none");
        }
        resetSelectedTooth();
    }

    function resetSelectedTooth() {
        if (selectedTooth) {
            const el = document.getElementById("tooth-svg-wrapper-" + selectedTooth);
            if (el) el.classList.remove("selected");
        }
        selectedTooth = null;
        document.getElementById("panel-placeholder").classList.remove("d-none");
        document.getElementById("panel-content").classList.add("d-none");
    }

    function selectTooth(num) {
        if (selectedTooth) {
            const prevEl = document.getElementById("tooth-svg-wrapper-" + selectedTooth);
            if (prevEl) prevEl.classList.remove("selected");
        }

        selectedTooth = num;
        const newEl = document.getElementById("tooth-svg-wrapper-" + num);
        if (newEl) newEl.classList.add("selected");

        document.getElementById("panel-placeholder").classList.add("d-none");
        const panel = document.getElementById("panel-content");
        panel.classList.remove("d-none");

        const info = toothData[num];
        const pending = pendingChanges[num];
        const status = pending ? pending.status : info.status;
        const notes = pending ? pending.notes : info.notes;
        const rx = pending ? pending.prescription : info.prescription;

        document.getElementById("lbl-tooth-number").innerText = "#" + num;
        document.getElementById("lbl-tooth-name").innerText = toothNames[num] || "Răng";
        
        const badge = document.getElementById("lbl-tooth-status-badge");
        const badgeConfig = statusTextMapping[status] || { text: status, class: "bg-secondary" };
        badge.innerText = badgeConfig.text;
        badge.className = "badge rounded-pill px-3 py-1 mt-2 small " + badgeConfig.class;

        const largeIconContainer = document.getElementById("selected-tooth-svg-icon");
        largeIconContainer.innerHTML = `
            <svg viewBox="0 0 100 100" style="width: 50px; height: 60px;">
                <path class="tooth-path status-${status.toLowerCase()}" style="stroke-width:3.5" d="M 25,35 C 25,22 32,15 42,15 C 46,15 48,22 50,22 C 52,22 54,15 58,15 C 68,15 75,22 75,35 C 75,48 72,55 70,60 C 68,75 68,90 62,90 C 60,90 58,85 55,75 C 52,65 48,65 45,75 C 42,85 40,90 38,90 C 32,90 32,75 30,60 C 28,55 25,48 25,35 Z"></path>
            </svg>
        `;

        document.getElementById("lbl-doctor-name").innerText = pending ? "Nháp (chưa lưu)" : (info.doctorName || "Hệ thống");
        document.getElementById("lbl-last-visit").innerText = pending ? "Hôm nay (chờ lưu)" : (info.date || "—");

        const selectEl = document.getElementById("form-tooth-status");
        if (selectEl) {
            selectEl.value = status;
            document.getElementById("form-tooth-notes").value = notes || "";
            document.getElementById("form-tooth-prescription").value = rx || "";
        }

        loadToothHistory(num);
    }

    function loadToothHistory(num) {
        fetch(`/Patient/GetToothHistory?patientId=${patientId}&toothNumber=${num}`)
            .then(res => {
                if (res.status === 403) throw new Error("Bạn không có quyền truy cập.");
                return res.json();
            })
            .then(history => {
                const list = document.getElementById("lbl-tooth-history-list");
                list.innerHTML = "";

                if (history.length === 0) {
                    list.innerHTML = `<div class="text-muted small py-2">Chưa có lịch sử điều trị tại răng này.</div>`;
                    return;
                }

                let timelineHtml = `<div class="tooth-timeline">`;
                history.forEach((h, idx) => {
                    const statusConfig = statusTextMapping[h.status] || { text: h.status, class: "bg-secondary text-white" };
                    const isActive = idx === 0;
                    
                    timelineHtml += `
                        <div class="tooth-timeline-item ${isActive ? 'active-item' : ''}">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge ${statusConfig.class} rounded-pill px-2 py-0.5" style="font-size: 0.72rem;">${statusConfig.text}</span>
                                <span class="text-muted text-xs font-monospace" style="font-size: 0.72rem;">${h.timestamp}</span>
                            </div>
                            <div class="fw-semibold text-dark text-xs" style="font-size: 0.75rem;">BS. ${h.doctorName}</div>
                            ${h.notes ? `<p class="mb-1 text-secondary mt-1 small" style="font-size: 0.75rem; line-height:1.3">${h.notes}</p>` : ''}
                            ${h.prescription ? `<div class="bg-light p-1.5 rounded-2 text-danger mt-1 small" style="font-size: 0.72rem;"><i class="bi bi-capsule me-1"></i>Chỉ định: ${h.prescription}</div>` : ''}
                        </div>
                    `;
                });
                timelineHtml += "</div>";
                list.innerHTML = timelineHtml;
            })
            .catch(err => {
                console.error(err);
                document.getElementById("lbl-tooth-history-list").innerHTML = `<div class="text-danger small py-2"><i class="bi bi-exclamation-octagon me-1"></i>Lỗi tải lịch sử hoặc bị chặn quyền truy cập.</div>`;
            });
    }

    function applyPendingChange() {
        if (!selectedTooth || !canEdit) return;

        const status = document.getElementById("form-tooth-status").value;
        const notes = document.getElementById("form-tooth-notes").value;
        const prescription = document.getElementById("form-tooth-prescription").value;

        pendingChanges[selectedTooth] = {
            toothNumber: selectedTooth,
            status: status,
            notes: notes,
            prescription: prescription
        };

        const wrapper = document.getElementById("tooth-svg-wrapper-" + selectedTooth);
        if (wrapper) wrapper.classList.add("pending-change");

        setToothColor(selectedTooth, status);
        selectTooth(selectedTooth);

        const count = Object.keys(pendingChanges).length;
        document.getElementById("unsaved-changes-count").innerText = count;
        
        const actionBar = document.getElementById("save-action-bar");
        if (count > 0) {
            actionBar.classList.add("show");
        } else {
            actionBar.classList.remove("show");
        }
    }

    function cancelChanges() {
        for (const num in pendingChanges) {
            const wrapper = document.getElementById("tooth-svg-wrapper-" + num);
            if (wrapper) wrapper.classList.remove("pending-change");
        }
        pendingChanges = {};
        drawAllTeethColors();
        document.getElementById("save-action-bar").classList.remove("show");
        if (selectedTooth) selectTooth(selectedTooth);
    }

    function saveToothChanges() {
        const changesArray = Object.values(pendingChanges);
        if (changesArray.length === 0) return;

        const payload = {
            patientId: patientId,
            version: toothChartVersion,
            changes: changesArray
        };

        const saveButton = document.querySelector(".action-bar .btn-success");
        const originalHtml = saveButton.innerHTML;
        saveButton.disabled = true;
        saveButton.innerHTML = `<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Đang lưu...`;

        fetch('/Patient/SaveToothChart', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(res => res.json())
        .then(data => {
            saveButton.disabled = false;
            saveButton.innerHTML = originalHtml;

            if (data.success) {
                toothChartVersion = data.newVersion;
                document.getElementById("version-label").innerText = toothChartVersion;

                for (const change of changesArray) {
                    const num = change.toothNumber;
                    toothData[num].status = change.status;
                    toothData[num].notes = change.notes;
                    toothData[num].prescription = change.prescription;
                    toothData[num].doctorName = "Bác sĩ";
                    toothData[num].date = "Hôm nay";

                    const wrapper = document.getElementById("tooth-svg-wrapper-" + num);
                    if (wrapper) wrapper.classList.remove("pending-change");
                }

                pendingChanges = {};
                document.getElementById("save-action-bar").classList.remove("show");
                showToast("Lưu sơ đồ răng thành công!", "success");
                if (selectedTooth) selectTooth(selectedTooth);
            } 
            else if (data.conflict) {
                const conflictModal = new bootstrap.Modal(document.getElementById('conflictModal'));
                conflictModal.show();
            } 
            else {
                alert("Lỗi khi lưu: " + data.message);
            }
        })
        .catch(err => {
            saveButton.disabled = false;
            saveButton.innerHTML = originalHtml;
            console.error(err);
            alert("Lỗi kết nối mạng.");
        });
    }

    // ==========================================
    // EMR SESSION LOGIC (UC4.1)
    // ==========================================

    function saveEMR(isSilent = false) {
        if (!canEdit) return Promise.resolve();

        const diag = document.getElementById("emr-diagnosis").value.trim();
        if (!diag) {
            if (!isSilent) showToast("Vui lòng nhập Chẩn đoán lâm sàng.", "danger");
            return Promise.reject("Chẩn đoán trống");
        }

        const payload = {
            id: parseInt(document.getElementById("emr-session-id").value) || 0,
            patientId: patientId,
            appointmentId: parseInt(document.getElementById("emr-appointment-id").value) || null,
            diagnosis: diag,
            clinicalNotes: document.getElementById("emr-notes").value,
            treatmentPlanSummary: document.getElementById("emr-plan").value,
            homeCareInstructions: document.getElementById("emr-care").value,
            patientCoefficient: 0.00,
            concurrencyStamp: document.getElementById("emr-concurrency-stamp").value || null
        };

        return fetch('/Patient/SaveEMRSession', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                document.getElementById("emr-session-id").value = data.sessionId;
                document.getElementById("emr-concurrency-stamp").value = data.concurrencyStamp;
                
                // Clear offline storage upon successful DB save
                localStorage.removeItem("emr_draft_" + patientId);

                if (!isSilent) {
                    showToast("Đã lưu bệnh án điện tử thành công!", "success");
                    setTimeout(() => location.reload(), 1000);
                }
                return data.sessionId;
            } else if (data.conflict) {
                const conflictModal = new bootstrap.Modal(document.getElementById('conflictModal'));
                conflictModal.show();
                throw new Error("Xung đột phiên bản");
            } else {
                if (!isSilent) showToast("Lỗi: " + data.message, "danger");
                throw new Error(data.message);
            }
        });
    }

    function finishSession() {
        const selectedServices = Array.from(document.querySelectorAll('input[name="performedServices"]:checked')).map(cb => parseInt(cb.value));

        // Save EMR first, then trigger finish
        saveEMR(true)
        .then(sessionId => {
            fetch('/Patient/FinishEMRSession', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    sessionId: sessionId,
                    performedServiceIds: selectedServices
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast("Đã kết thúc phiên khám! Hệ thống đã lập hóa đơn nháp và kích hoạt bảo hành.", "success");
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showToast("Lỗi khi kết thúc: " + data.message, "danger");
                }
            });
        })
        .catch(err => {
            console.error(err);
        });
    }

    // Auto-save EMR draft locally (EX4.1-04)
    function autoSaveEMRToLocalStorage() {
        const diag = document.getElementById("emr-diagnosis").value.trim();
        if (!diag) return;

        const draft = {
            diagnosis: diag,
            clinicalNotes: document.getElementById("emr-notes").value,
            treatmentPlanSummary: document.getElementById("emr-plan").value,
            homeCareInstructions: document.getElementById("emr-care").value,
            patientCoefficient: "0.00",
            timestamp: new Date().getTime()
        };
        localStorage.setItem("emr_draft_" + patientId, JSON.stringify(draft));
        document.getElementById("emr-draft-status").innerHTML = `<i class="bi bi-cloud-arrow-up-fill text-primary"></i> Bản nháp đã lưu cục bộ (${new Date().toLocaleTimeString()}).`;
    }

    function restoreEMRFromLocalStorage() {
        const local = localStorage.getItem("emr_draft_" + patientId);
        const currentSessionId = parseInt(document.getElementById("emr-session-id")?.value) || 0;
        
        // Restore only if there is no active server-side session
        if (local && currentSessionId === 0) {
            const draft = JSON.parse(local);
            document.getElementById("emr-diagnosis").value = draft.diagnosis;
            document.getElementById("emr-notes").value = draft.clinicalNotes;
            document.getElementById("emr-plan").value = draft.treatmentPlanSummary;
            document.getElementById("emr-care").value = draft.homeCareInstructions;
            document.getElementById("emr-coefficient").value = "0.00";
            
            showToast("Đã khôi phục bản nháp bệnh án chưa lưu trước đó.", "info");
        }
    }

    // ==========================================
    // TREATMENT PLAN LOGIC (UC4.2)
    // ==========================================

    function autoFillPlanTitle() {
        const select = document.getElementById("plan-svc-id");
        const selectedOption = select.options[select.selectedIndex];
        if (selectedOption && selectedOption.value) {
            const svcName = selectedOption.getAttribute("data-name");
            document.getElementById("plan-title").value = `Phác đồ điều trị ${svcName}`;
        }
    }

    function createTreatmentPlan() {
        const svcid = parseInt(document.getElementById("plan-svc-id").value);
        const title = document.getElementById("plan-title").value.trim();
        const total = parseInt(document.getElementById("plan-total-sessions").value);

        if (!svcid) {
            showToast("Vui lòng chọn dịch vụ nha khoa.", "danger");
            return;
        }

        fetch('/Patient/CreateTreatmentPlan', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                patientId: patientId,
                medicalServiceId: svcid,
                title: title,
                totalSessions: total
            })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                showToast("Lập phác đồ điều trị thành công!", "success");
                setTimeout(() => location.reload(), 1000);
            } else {
                showToast("Thất bại: " + data.message, "danger");
            }
        });
    }

    function updateSessionStatus(sessId, status) {
        const note = prompt("Nhập ghi chú kết quả buổi khám (nếu có):") || "";
        
        fetch('/Patient/UpdatePlanSession', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                sessionId: sessId,
                status: status,
                notes: note
            })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                showToast("Đã cập nhật trạng thái buổi khám!", "success");
                setTimeout(() => location.reload(), 1000);
            }
        });
    }

    function cancelPlan(planId) {
        const reason = prompt("Lý do hủy phác đồ (Bắt buộc):");
        if (!reason || !reason.trim()) {
            showToast("Phải nhập lý do hủy.", "danger");
            return;
        }

        fetch('/Patient/CancelTreatmentPlan', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                planId: planId,
                reason: reason
            })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                showToast("Đã hủy phác đồ điều trị.", "success");
                setTimeout(() => location.reload(), 1000);
            } else {
                showToast("Thất bại: " + data.message, "danger");
            }
        });
    }

    // ==========================================
    // PRESCRIPTION LOGIC (UC4.4)
    // ==========================================

    function addMedicineToPrescription() {
        const select = document.getElementById("rx-med-id");
        const option = select.options[select.selectedIndex];
        if (!option.value) {
            showToast("Vui lòng chọn thuốc.", "danger");
            return;
        }

        const medId = parseInt(option.value);
        const medName = option.getAttribute("data-name");
        const qty = parseInt(document.getElementById("rx-med-qty").value);
        const days = parseInt(document.getElementById("rx-med-days").value);
        const dosage = document.getElementById("rx-med-dosage").value.trim();

        if (isNaN(qty) || qty <= 0) {
            showToast("Số lượng không hợp lệ.", "danger");
            return;
        }

        // Add to temp list
        tempPrescriptionItems.push({
            medicineId: medId,
            medicineName: medName,
            quantity: qty,
            durationDays: days,
            dosage: dosage || "Theo chỉ dẫn bác sĩ"
        });

        renderTempPrescription();
        
        // Reset fields
        select.value = "";
        document.getElementById("rx-med-qty").value = 10;
        document.getElementById("rx-med-dosage").value = "";
    }

    function renderTempPrescription() {
        const container = document.getElementById("temp-rx-list");
        if (tempPrescriptionItems.length === 0) {
            container.innerHTML = "Chưa có thuốc nào trong đơn tạm thời.";
            return;
        }

        let html = `<ul class="list-group list-group-flush mb-0">`;
        tempPrescriptionItems.forEach((item, idx) => {
            html += `
                <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent py-2 border-bottom">
                    <div>
                        <strong>${item.medicineName}</strong> - SL: ${item.quantity} viên (${item.durationDays} ngày)
                        <div class="text-muted text-xs">${item.dosage}</div>
                    </div>
                    <button class="btn btn-outline-danger btn-xs border-0" onclick="removeTempRxItem(${idx})"><i class="bi bi-trash"></i></button>
                </li>
            `;
        });
        html += "</ul>";
        container.innerHTML = html;
    }

    function removeTempRxItem(idx) {
        tempPrescriptionItems.splice(idx, 1);
        renderTempPrescription();
    }

    function checkAllergyAndSubmitRx() {
        if (tempPrescriptionItems.length === 0) {
            showToast("Không có thuốc nào trong đơn.", "danger");
            return;
        }

        submitPrescription(false, "");
    }

    function submitPrescription(bypass, reason) {
        const sessionId = parseInt(document.getElementById("emr-session-id").value) || null;

        const payload = {
            patientId: patientId,
            examinationSessionId: sessionId,
            items: tempPrescriptionItems,
            bypassAllergy: bypass,
            bypassReason: reason
        };

        fetch('/Patient/SavePrescription', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                showToast("Đơn thuốc đã được kê thành công!", "success");
                tempPrescriptionItems = [];
                setTimeout(() => location.reload(), 1000);
            } 
            else if (data.allergyWarning) {
                // Allergy Warning Modal (EX4.4-01)
                document.getElementById("allergy-override-warning-text").innerText = data.message;
                const modal = new bootstrap.Modal(document.getElementById('allergyOverrideModal'));
                modal.show();
            } 
            else {
                showToast("Thất bại: " + data.message, "danger");
            }
        });
    }

    function bypassAllergyAndSubmit() {
        const reason = document.getElementById("allergy-override-reason").value.trim();
        if (!reason) {
            alert("Vui lòng nhập lý do ghi đè bắt buộc.");
            return;
        }

        // Close modal
        bootstrap.Modal.getInstance(document.getElementById('allergyOverrideModal')).hide();
        submitPrescription(true, reason);
    }

    function dispensePrescription(rxId) {
        fetch('/Patient/DispensePrescription', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ prescriptionId: rxId })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                showToast("Phát thuốc thành công! Hóa đơn in đơn thuốc đã sẵn sàng.", "success");
                setTimeout(() => location.reload(), 1500);
            } else {
                showToast(data.message, "danger");
            }
        });
    }

