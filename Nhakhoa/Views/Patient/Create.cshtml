@model Nhakhoa.Models.Patient
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thêm bệnh nhân mới";
}

<div class="mb-4">
    <a href="/Patient" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
    <h4 class="fw-bold mt-2" style="color:#0b1f35">Tạo hồ sơ bệnh nhân mới</h4>
    <div class="text-muted small">Nhập thông tin hành chính để đăng ký mã bệnh nhân mới vào hệ thống</div>
</div>

<div class="card border-0 shadow-sm rounded-4" style="max-width: 800px;">
    <div class="card-body p-4">
        <form asp-controller="Patient" asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger border-0 rounded-4 py-2 px-3 mb-4">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Vui lòng sửa các lỗi bên dưới.
                </div>
            }

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold text-secondary small">Họ và tên <span class="text-danger">*</span></label>
                    <input type="text" asp-for="FullName" class="form-control rounded-3" placeholder="Nhập họ và tên đầy đủ" required />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold text-secondary small">Số điện thoại <span class="text-danger">*</span></label>
                    <input type="tel" asp-for="PhoneNumber" value="@ViewBag.PhoneNumber" class="form-control rounded-3" placeholder="Nhập số điện thoại liên lạc" required />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold text-secondary small">Ngày sinh</label>
                    <input type="date" asp-for="DateOfBirth" class="form-control rounded-3" />
                    <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold text-secondary small">Giới tính</label>
                    <select asp-for="Gender" class="form-select rounded-3">
                        <option value="Nam">Nam</option>
                        <option value="Nữ">Nữ</option>
                        <option value="Khác">Khác</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-danger small"></span>
                </div>

                <div class="col-md-12">
                    <label class="form-label fw-semibold text-secondary small">Địa chỉ Email</label>
                    <input type="email" asp-for="Email" class="form-control rounded-3" placeholder="example@email.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-md-12">
                    <label class="form-label fw-semibold text-secondary small">Địa chỉ thường trú</label>
                    <input type="text" asp-for="Address" class="form-control rounded-3" placeholder="Nhập số nhà, tên đường, phường/xã, quận/huyện..." />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div class="col-md-12">
                    <label class="form-label fw-semibold text-danger small"><i class="bi bi-exclamation-triangle"></i> Tiền sử dị ứng (nếu có)</label>
                    <textarea asp-for="AllergyHistory" rows="3" class="form-control rounded-3" placeholder="Ghi chú thuốc, thức ăn hoặc các hoạt chất gây dị ứng cho bệnh nhân..."></textarea>
                    <span asp-validation-for="AllergyHistory" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a href="/Patient" class="btn btn-outline-secondary rounded-pill px-4">Hủy</a>
                <button type="submit" class="btn btn-primary rounded-pill px-4" style="background:#1b75d0; border-color:#1b75d0;">
                    Tạo hồ sơ bệnh nhân
                </button>
            </div>
        </form>
    </div>
</div>
