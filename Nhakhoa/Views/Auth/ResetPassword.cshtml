@model Nhakhoa.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    ViewData["UseFluid"] = true;
    ViewData["BodyClass"] = "auth-body";
}

<div class="auth-page">
    <div class="auth-shell">
        <section class="auth-hero">
            <div class="auth-hero__badge">CarePulse Pro</div>
            
            <div class="my-auto text-center">
                <img src="https://cdni.iconscout.com/illustration/premium/thumb/reset-password-illustration-download-in-svg-png-gif-formats--secure-confidential-privacy-security-pack-illustrations-5386004.png" 
                     alt="Đặt lại mật khẩu" class="img-fluid mb-4 rounded-4" style="max-height: 260px; object-fit: contain; background: rgba(255,255,255,0.8); padding: 10px;" />
                <h2 class="fw-bold mb-2">Mật khẩu mới</h2>
                <p class="mx-auto" style="max-width: 380px;">Thiết lập một mật khẩu mới đủ mạnh để bảo vệ an toàn cho thông tin tài khoản.</p>
            </div>

            <div class="auth-hero__dots justify-content-center mt-auto">
                <span class="active"></span>
                <span></span>
                <span></span>
            </div>
        </section>

        <section class="auth-form" style="padding: 32px 36px;">
            <h2>Khôi phục mật khẩu</h2>
            <p>Vui lòng cập nhật mật khẩu mới cho tài khoản của bạn</p>

            <form class="auth-form__body" method="post" asp-controller="Auth" asp-action="ResetPassword">
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                <input type="hidden" asp-for="Username" />
                <input type="hidden" asp-for="OtpCode" />

                <!-- Mật khẩu mới -->
                <label class="auth-label" asp-for="NewPassword">Mật khẩu mới</label>
                <div class="auth-input">
                    <span class="auth-input__icon">🔒</span>
                    <input asp-for="NewPassword" type="password" id="new-pass" placeholder="Nhập mật khẩu mới" />
                    <button type="button" class="auth-input__action toggle-password" data-target="new-pass">
                        <span class="eye-text">Hiện</span>
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>

                <!-- Trình đo độ mạnh mật khẩu -->
                <div class="strength-meter-container mt-1">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small fw-semibold text-muted" id="strength-label">Độ mạnh: Chưa nhập</span>
                    </div>
                    <div class="strength-bars d-flex gap-1" style="height: 6px;">
                        <div class="strength-bar flex-fill rounded" style="background-color: #e9ecef; transition: background-color 0.2s;"></div>
                        <div class="strength-bar flex-fill rounded" style="background-color: #e9ecef; transition: background-color 0.2s;"></div>
                        <div class="strength-bar flex-fill rounded" style="background-color: #e9ecef; transition: background-color 0.2s;"></div>
                        <div class="strength-bar flex-fill rounded" style="background-color: #e9ecef; transition: background-color 0.2s;"></div>
                    </div>
                </div>

                <!-- Xác nhận mật khẩu mới -->
                <label class="auth-label" asp-for="ConfirmPassword">Xác nhận mật khẩu mới</label>
                <div class="auth-input">
                    <span class="auth-input__icon">🛡️</span>
                    <input asp-for="ConfirmPassword" type="password" id="confirm-pass" placeholder="Xác nhận lại mật khẩu mới" />
                    <button type="button" class="auth-input__action toggle-password" data-target="confirm-pass">
                        <span class="eye-text">Hiện</span>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>

                <button type="submit" class="auth-submit mt-3">Đặt lại mật khẩu</button>
            </form>

            <div class="mt-4 pt-3 border-top text-center text-muted small">
                &copy; 2026 CarePulse Systems. HIPAA Compliant.
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        // Xử lý hiện/ẩn mật khẩu
        document.querySelectorAll('.toggle-password').forEach(button => {
            button.addEventListener('click', function() {
                const targetId = this.getAttribute('data-target');
                const input = document.getElementById(targetId);
                const textSpan = this.querySelector('.eye-text');
                if (input.type === 'password') {
                    input.type = 'text';
                    textSpan.textContent = 'Ẩn';
                } else {
                    input.type = 'password';
                    textSpan.textContent = 'Hiện';
                }
            });
        });

        // Xử lý đo độ mạnh mật khẩu
        const newPassInput = document.getElementById('new-pass');
        const strengthLabel = document.getElementById('strength-label');
        const strengthBars = document.querySelectorAll('.strength-bar');

        newPassInput.addEventListener('input', function() {
            const val = this.value;
            let score = 0;

            if (val.length === 0) {
                strengthLabel.textContent = 'Độ mạnh: Chưa nhập';
                strengthLabel.className = 'small fw-semibold text-muted';
                strengthBars.forEach(bar => bar.style.backgroundColor = '#e9ecef');
                return;
            }

            // Tiêu chuẩn độ mạnh
            if (val.length >= 8) score++;
            if (/[A-Z]/.test(val)) score++;
            if (/[0-9]/.test(val)) score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;

            // Cập nhật giao diện thanh độ mạnh
            strengthBars.forEach((bar, idx) => {
                if (idx < score) {
                    if (score <= 1) {
                        bar.style.backgroundColor = '#dc3545';
                    } else if (score <= 3) {
                        bar.style.backgroundColor = '#ffc107';
                    } else {
                        bar.style.backgroundColor = '#198754';
                    }
                } else {
                    bar.style.backgroundColor = '#e9ecef';
                }
            });

            // Cập nhật text label
            if (score <= 1) {
                strengthLabel.textContent = 'Độ mạnh: Yếu';
                strengthLabel.className = 'small fw-semibold text-danger';
            } else if (score <= 3) {
                strengthLabel.textContent = 'Độ mạnh: Trung bình';
                strengthLabel.className = 'small fw-semibold text-warning';
            } else {
                strengthLabel.textContent = 'Độ mạnh: Mạnh';
                strengthLabel.className = 'small fw-semibold text-success';
            }
        });
    </script>
}
