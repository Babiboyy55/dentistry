@model Nhakhoa.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    ViewData["UseFluid"] = true;
    ViewData["BodyClass"] = "auth-body";
}

<div class="auth-page">
    <div class="auth-shell">
        <section class="auth-hero">
            <div class="auth-hero__badge">CarePulse Pro</div>
            
            <div class="my-auto text-center">
                <img src="https://cdni.iconscout.com/illustration/premium/thumb/forgot-password-illustration-download-in-svg-png-gif-formats--security-mobile-key-shield-lock-system-pack-illustrations-5386008.png" 
                     alt="Quên mật khẩu" class="img-fluid mb-4 rounded-4" style="max-height: 260px; object-fit: contain; background: rgba(255,255,255,0.8); padding: 10px;" />
                <h2 class="fw-bold mb-2">Khôi phục mật khẩu</h2>
                <p class="mx-auto" style="max-width: 380px;">Chúng tôi sẽ hỗ trợ gửi mã xác minh OTP bảo mật để khôi phục mật khẩu truy cập của bạn.</p>
            </div>

            <div class="auth-hero__dots justify-content-center mt-auto">
                <span></span>
                <span class="active"></span>
                <span></span>
            </div>
        </section>

        <section class="auth-form" style="padding: 32px 36px;">
            <h2>Quên mật khẩu?</h2>
            <p>Nhập tên đăng nhập hoặc email đã đăng ký của bạn để nhận mã OTP.</p>

            <form class="auth-form__body" method="post" asp-controller="Auth" asp-action="ForgotPassword">
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                <label class="auth-label" asp-for="UsernameOrEmail">Tên đăng nhập hoặc Email</label>
                <div class="auth-input">
                    <span class="auth-input__icon">&#64;</span>
                    <input asp-for="UsernameOrEmail" type="text" placeholder="Nhập tên đăng nhập hoặc email" />
                </div>
                <span asp-validation-for="UsernameOrEmail" class="text-danger small"></span>

                <button type="submit" class="auth-submit mt-3">Gửi mã xác nhận (OTP)</button>
            </form>

            <div class="auth-note text-center mt-4">
                Bạn đã nhớ lại mật khẩu? <a class="auth-link" asp-controller="Auth" asp-action="Login">Đăng nhập ngay</a>
            </div>

            <div class="mt-4 pt-3 border-top text-center text-muted small">
                &copy; 2026 CarePulse Systems. HIPAA Compliant.
            </div>
        </section>
    </div>
</div>
