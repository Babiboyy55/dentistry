@model Nhakhoa.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    ViewData["UseFluid"] = true;
    ViewData["BodyClass"] = "auth-body";
}

<div class="auth-page">
    <div class="auth-shell">
        <section class="auth-hero">
            <div class="auth-hero__badge">CLINIC FLOW</div>
            <h1>Giải pháp y tế thông minh</h1>
            <p>Quản lý hồ sơ bệnh nhân, lịch hẹn và thanh toán trong một nền tảng chuyên nghiệp.</p>

            <div class="auth-hero__card">
                <div class="auth-hero__art">
                    <div class="auth-hero__title">Clinic Flow</div>
                    <div class="auth-hero__subtitle">LOGIN</div>
                    <div class="auth-hero__pulse"></div>
                </div>
                <div class="auth-hero__avatar">
                    <svg viewBox="0 0 120 140" role="img" aria-label="Bác sĩ" focusable="false">
                        <path d="M60 6c18 0 30 14 30 32 0 15-7 26-16 30v12h10c10 0 18 8 18 18v20H18v-20c0-10 8-18 18-18h10V68c-9-4-16-15-16-30C30 20 42 6 60 6z" fill="#d7ecff"/>
                        <path d="M60 12c12 0 20 9 20 20s-8 21-20 21-20-10-20-21S48 12 60 12z" fill="#ffe1c7"/>
                        <path d="M40 80h40l6 18H34l6-18z" fill="#4aa3ff"/>
                        <path d="M48 88h24v26H48z" fill="#ffffff"/>
                        <path d="M58 96h4v12h-4z" fill="#4aa3ff"/>
                        <path d="M52 102h16v4H52z" fill="#4aa3ff"/>
                    </svg>
                </div>
            </div>

            <div class="auth-hero__dots">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </section>

        <section class="auth-form">
            <div class="auth-brand">
                <span class="auth-brand__icon">+</span>
                MediClinic
            </div>
            <h2>Đăng nhập hệ thống quản lý phòng khám</h2>
            <p>Vui lòng nhập thông tin tài khoản của bạn.</p>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success border-0 rounded-3 small mb-4" style="background-color: rgba(40, 167, 69, 0.1); color: #1e7e34;">
                    @TempData["SuccessMessage"]
                </div>
            }

            <form class="auth-form__body" method="post" asp-controller="Auth" asp-action="Login">
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                <input type="hidden" asp-for="Role" id="login-role" />

                <!-- Role Selection Tabs -->
                <div class="d-flex p-1 bg-light rounded-3 mb-4" style="border: 1px solid rgba(0,0,0,0.06); font-size: 0.9rem;">
                    <button type="button" id="tab-staff" class="btn btn-sm flex-fill py-2 active" style="transition: all 0.3s ease; font-weight: 600;" onclick="switchRole('Staff')">
                        👨‍⚕️ Nhân sự phòng khám
                    </button>
                    <button type="button" id="tab-patient" class="btn btn-sm flex-fill py-2 text-muted" style="transition: all 0.3s ease; font-weight: 600;" onclick="switchRole('Patient')">
                        👤 Bệnh nhân
                    </button>
                </div>

                <label class="auth-label" id="username-label" asp-for="Username">Tên đăng nhập</label>
                <div class="auth-input">
                    <span class="auth-input__icon" id="username-icon">&#64;</span>
                    <input asp-for="Username" id="login-username" type="text" placeholder="Nhập tên đăng nhập" autocomplete="username" />
                </div>
                <span asp-validation-for="Username" class="text-danger small"></span>

                <label class="auth-label" asp-for="Password">Mật khẩu</label>
                <div class="auth-input">
                    <span class="auth-input__icon">*</span>
                    <input asp-for="Password" id="login-password" type="password" placeholder="••••••••" autocomplete="current-password" />
                    <button type="button" class="auth-input__action toggle-password" data-target="login-password">Hiện</button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>

                <div class="auth-row">
                    <label class="auth-check">
                        <input type="checkbox" asp-for="RememberMe" />
                        Ghi nhớ đăng nhập
                    </label>
                    <a class="auth-link" id="forgot-password-link" asp-controller="Auth" asp-action="ForgotPassword">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="auth-submit">Đăng nhập</button>
            </form>

            <div class="auth-note">Bạn chưa có tài khoản? <a class="auth-link" asp-controller="Auth" asp-action="Register">Đăng ký ngay</a></div>

            <div class="auth-meta">
                <span>🔒 Bảo mật SSL 256-bit</span>
                <span>Hỗ trợ 24/7</span>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        // Toggle password visibility
        document.querySelectorAll('.toggle-password').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const targetId = this.getAttribute('data-target');
                const input = document.getElementById(targetId);
                if (input.type === 'password') {
                    input.type = 'text';
                    this.textContent = 'Ẩn';
                } else {
                    input.type = 'password';
                    this.textContent = 'Hiện';
                }
            });
        });

        // Switch role dynamically
        function switchRole(role) {
            const roleInput = document.getElementById('login-role');
            const tabStaff = document.getElementById('tab-staff');
            const tabPatient = document.getElementById('tab-patient');
            const usernameLabel = document.getElementById('username-label');
            const usernameIcon = document.getElementById('username-icon');
            const usernameInput = document.getElementById('login-username');
            const forgotLink = document.getElementById('forgot-password-link');

            roleInput.value = role;

            if (role === 'Staff') {
                tabStaff.classList.add('active', 'btn-primary');
                tabStaff.classList.remove('text-muted');
                tabPatient.classList.remove('active', 'btn-primary');
                tabPatient.classList.add('text-muted');

                usernameLabel.innerText = "Tên đăng nhập";
                usernameIcon.innerHTML = "&#64;";
                usernameInput.placeholder = "Nhập tên đăng nhập";
                forgotLink.href = "/Auth/ForgotPassword";
            } else {
                tabPatient.classList.add('active', 'btn-primary');
                tabPatient.classList.remove('text-muted');
                tabStaff.classList.remove('active', 'btn-primary');
                tabStaff.classList.add('text-muted');

                usernameLabel.innerText = "Số điện thoại";
                usernameIcon.innerHTML = "📞";
                usernameInput.placeholder = "Nhập số điện thoại bệnh nhân";
                forgotLink.href = "/Auth/ForgotPatientPassword";
            }
        }

        // Initialize based on current model value
        window.addEventListener('DOMContentLoaded', () => {
            const currentRole = document.getElementById('login-role').value || "Staff";
            switchRole(currentRole);
        });
    </script>
    <style>
        .auth-form .btn-primary {
            background-color: #1b75d0 !important;
            border-color: #1b75d0 !important;
            color: #fff !important;
            box-shadow: 0 4px 12px rgba(27, 117, 208, 0.2);
        }
    </style>
}
