@model Nhakhoa.ViewModels.PatientForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu bệnh nhân";
    ViewData["UseFluid"] = true;
    ViewData["BodyClass"] = "auth-body";
}

<div class="auth-page">
    <div class="auth-shell">
        <section class="auth-hero">
            <div class="auth-hero__badge">PATIENT PORTAL</div>
            
            <div class="my-auto text-center">
                <img src="https://cdni.iconscout.com/illustration/premium/thumb/forgot-password-illustration-download-in-svg-png-gif-formats--security-mobile-key-shield-lock-system-pack-illustrations-5386008.png" 
                     alt="Quên mật khẩu" class="img-fluid mb-4 rounded-4" style="max-height: 260px; object-fit: contain; background: rgba(255,255,255,0.8); padding: 10px;" />
                <h2 class="fw-bold mb-2">Khôi phục mật khẩu</h2>
                <p class="mx-auto" style="max-width: 380px;">Nhập số điện thoại đã đăng ký để hệ thống gửi mã OTP xác minh khôi phục mật khẩu.</p>
            </div>

            <div class="auth-hero__dots justify-content-center mt-auto">
                <span></span>
                <span class="active"></span>
                <span></span>
            </div>
        </section>

        <section class="auth-form" style="padding: 32px 36px;">
            <h2>Khôi phục mật khẩu bệnh nhân</h2>
            <p>Vui lòng nhập số điện thoại của bạn.</p>

            <form class="auth-form__body" method="post" asp-controller="Auth" asp-action="ForgotPatientPassword">
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

                <label class="auth-label" asp-for="PhoneNumber">Số điện thoại</label>
                <div class="auth-input">
                    <span class="auth-input__icon">📞</span>
                    <input asp-for="PhoneNumber" type="tel" placeholder="Nhập số điện thoại của bạn" required />
                </div>
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>

                <button type="submit" class="auth-submit mt-3">Gửi mã xác nhận (OTP)</button>
            </form>

            <div class="auth-note text-center mt-4">
                Quay lại <a class="auth-link" asp-controller="Auth" asp-action="Login">Đăng nhập</a>
            </div>

            <div class="mt-4 pt-3 border-top text-center text-muted small">
                &copy; 2026 MediClinic Patient Portal. Bảo mật SSL.
            </div>
        </section>
    </div>
</div>
