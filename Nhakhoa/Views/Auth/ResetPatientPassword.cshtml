@model Nhakhoa.ViewModels.PatientResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu bệnh nhân";
    ViewData["UseFluid"] = true;
    ViewData["BodyClass"] = "auth-body";
}

<div class="auth-page">
    <div class="auth-shell">
        <section class="auth-hero">
            <div class="auth-hero__badge">PATIENT PORTAL</div>
            
            <div class="my-auto text-center">
                <img src="https://cdni.iconscout.com/illustration/premium/thumb/reset-password-illustration-download-in-svg-png-gif-formats--security-key-protection-shield-privacy-smartphone-pack-illustrations-5386004.png" 
                     alt="Đặt lại mật khẩu" class="img-fluid mb-4 rounded-4" style="max-height: 260px; object-fit: contain; background: rgba(255,255,255,0.8); padding: 10px;" />
                <h2 class="fw-bold mb-2">Đặt lại mật khẩu mới</h2>
                <p class="mx-auto" style="max-width: 380px;">Mật khẩu mới cần đáp ứng các tiêu chuẩn bảo mật (chữ hoa, chữ thường và chữ số).</p>
            </div>

            <div class="auth-hero__dots justify-content-center mt-auto">
                <span class="active"></span>
                <span></span>
                <span></span>
            </div>
        </section>

        <section class="auth-form" style="padding: 32px 36px;">
            <h2>Thiết lập mật khẩu mới</h2>
            <p>Vui lòng nhập mật khẩu mới của bạn.</p>

            <form class="auth-form__body" method="post" asp-controller="Auth" asp-action="ResetPatientPassword">
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                <input type="hidden" asp-for="PhoneNumber" />
                <input type="hidden" asp-for="OtpCode" />

                <label class="auth-label" asp-for="NewPassword">Mật khẩu mới</label>
                <div class="auth-input">
                    <span class="auth-input__icon">🔑</span>
                    <input asp-for="NewPassword" type="password" id="new-password" placeholder="••••••••" required />
                    <button type="button" class="auth-input__action toggle-password" data-target="new-password">Hiện</button>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>

                <label class="auth-label" asp-for="ConfirmNewPassword">Xác nhận mật khẩu mới</label>
                <div class="auth-input">
                    <span class="auth-input__icon">🔒</span>
                    <input asp-for="ConfirmNewPassword" type="password" id="confirm-new-password" placeholder="••••••••" required />
                    <button type="button" class="auth-input__action toggle-password" data-target="confirm-new-password">Hiện</button>
                </div>
                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>

                <button type="submit" class="auth-submit mt-3">Lưu mật khẩu mới</button>
            </form>

            <div class="mt-4 pt-3 border-top text-center text-muted small">
                &copy; 2026 MediClinic Patient Portal. Bảo mật SSL.
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        // Toggle password visibility
        document.querySelectorAll('.toggle-password').forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const targetId = this.getAttribute('data-target');
                const input = document.getElementById(targetId);
                if (input.type === 'password') {
                    input.type = 'text';
                    this.textContent = 'Ẩn';
                } else {
                    input.type = 'password';
                    this.textContent = 'Hiện';
                }
            });
        });
    </script>
}
