@model Nhakhoa.ViewModels.VerifyOtpViewModel
@{
    ViewData["Title"] = "Xác nhận OTP";
    ViewData["UseFluid"] = true;
    ViewData["BodyClass"] = "auth-body";
}

<div class="auth-page">
    <div class="auth-shell">
        <section class="auth-hero">
            <div class="auth-hero__badge">CarePulse Pro</div>
            
            <div class="my-auto text-center">
                <img src="https://cdni.iconscout.com/illustration/premium/thumb/one-time-password-illustration-download-in-svg-png-gif-formats--otp-pin-code-login-security-smartphone-pack-illustrations-5385973.png" 
                     alt="Xác thực OTP" class="img-fluid mb-4 rounded-4" style="max-height: 260px; object-fit: contain; background: rgba(255,255,255,0.8); padding: 10px;" />
                <h2 class="fw-bold mb-2">Nhập mã OTP</h2>
                <p class="mx-auto" style="max-width: 380px;">Chúng tôi đã gửi mã xác minh 6 số. Vui lòng kiểm tra và nhập mã vào form kế bên.</p>
            </div>

            <div class="auth-hero__dots justify-content-center mt-auto">
                <span></span>
                <span></span>
                <span class="active"></span>
            </div>
        </section>

        <section class="auth-form" style="padding: 32px 36px;">
            <h2>Xác thực tài khoản</h2>
            <p>Nhập mã xác thực để tiếp tục quá trình đặt lại mật khẩu.</p>

            @if (TempData["MockedOtp"] != null)
            {
                <div class="alert alert-info border-0 rounded-3 small mb-4" style="background-color: rgba(27, 117, 208, 0.1); color: #0b4c92;">
                    <strong>[MÔ PHỎNG]</strong> Mã OTP khôi phục mật khẩu gửi đến thiết bị của bạn là: <strong class="fs-5 text-primary">@TempData["MockedOtp"]</strong>
                </div>
            }

            <form class="auth-form__body" method="post" asp-controller="Auth" asp-action="VerifyOtp">
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                <input type="hidden" asp-for="Username" />

                <label class="auth-label" asp-for="OtpCode">Mã OTP (6 chữ số)</label>
                <div class="auth-input">
                    <span class="auth-input__icon">🔢</span>
                    <input asp-for="OtpCode" type="text" maxlength="6" placeholder="Nhập 6 chữ số" style="letter-spacing: 0.15em; font-weight: bold; font-size: 1.1rem; text-align: center;" />
                </div>
                <span asp-validation-for="OtpCode" class="text-danger small"></span>

                <button type="submit" class="auth-submit mt-3">Xác nhận mã OTP</button>
            </form>

            <div class="auth-note text-center mt-4">
                Chưa nhận được mã? <a class="auth-link" href="#" onclick="alert('Đã gửi lại OTP giả định trong nhật ký hệ thống.');">Gửi lại mã OTP</a>
            </div>

            <div class="mt-4 pt-3 border-top text-center text-muted small">
                &copy; 2026 CarePulse Systems. HIPAA Compliant.
            </div>
        </section>
    </div>
</div>
