@model List<Nhakhoa.Models.PatientAccount>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý tài khoản bệnh nhân";
    int page = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;
}

<!-- Page header -->
<div class="d-flex align-items-start justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-1" style="color:#0b1f35">Tài khoản bệnh nhân (Patient Portal)</h4>
        <p class="text-muted small mb-0">Quản lý tài khoản đăng nhập cổng thông tin bệnh nhân</p>
    </div>
</div>

<!-- Alerts -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 rounded-4 py-2 px-3 mb-3 d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill text-success"></i> @TempData["Success"]
    </div>
}
@if (TempData["PortalSuccess"] != null)
{
    <div class="alert alert-success border-0 rounded-4 py-2 px-3 mb-3 d-flex align-items-start gap-2">
        <i class="bi bi-key-fill text-success mt-1"></i>
        <div>@Html.Raw(TempData["PortalSuccess"]?.ToString())</div>
    </div>
}

<!-- Stats row -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="rounded-3 bg-primary-subtle d-flex align-items-center justify-content-center" style="width:44px;height:44px;flex-shrink:0">
                    <i class="bi bi-people fs-5 text-primary"></i>
                </div>
                <div>
                    <div class="text-muted small">Tổng tài khoản</div>
                    <div class="fw-bold fs-5">@ViewBag.StatTotal</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="rounded-3 bg-success-subtle d-flex align-items-center justify-content-center" style="width:44px;height:44px;flex-shrink:0">
                    <i class="bi bi-person-check fs-5 text-success"></i>
                </div>
                <div>
                    <div class="text-muted small">Đang hoạt động</div>
                    <div class="fw-bold fs-5 text-success">@ViewBag.StatActive</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="rounded-3 bg-danger-subtle d-flex align-items-center justify-content-center" style="width:44px;height:44px;flex-shrink:0">
                    <i class="bi bi-person-lock fs-5 text-danger"></i>
                </div>
                <div>
                    <div class="text-muted small">Đã khóa</div>
                    <div class="fw-bold fs-5 text-danger">@ViewBag.StatLocked</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="rounded-3 bg-info-subtle d-flex align-items-center justify-content-center" style="width:44px;height:44px;flex-shrink:0">
                    <i class="bi bi-link-45deg fs-5 text-info"></i>
                </div>
                <div>
                    <div class="text-muted small">Liên kết hồ sơ</div>
                    <div class="fw-bold fs-5 text-info">@ViewBag.StatLinked</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Table card -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <!-- Filters -->
        <form method="get" action="/PatientAccount" class="d-flex flex-wrap gap-2 mb-4">
            <div class="flex-grow-1" style="min-width:220px">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0" name="search" value="@ViewBag.Search" placeholder="Tìm theo tên, SĐT, email..." />
                </div>
            </div>
            <select class="form-select" name="status" style="max-width:180px">
                <option value="" selected="@(ViewBag.Status == null)">Tất cả trạng thái</option>
                <option value="active" selected="@(ViewBag.Status == "active")">Đang hoạt động</option>
                <option value="locked" selected="@(ViewBag.Status == "locked")">Đã khóa</option>
            </select>
            <button type="submit" class="btn btn-primary px-4">Lọc</button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string) || !string.IsNullOrEmpty(ViewBag.Status as string))
            {
                <a href="/PatientAccount" class="btn btn-outline-secondary px-3">
                    <i class="bi bi-x-circle"></i> Xóa lọc
                </a>
            }
        </form>

        <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="text-muted small">Tìm thấy <strong>@ViewBag.Total</strong> tài khoản</span>
        </div>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="table-light small">
                    <tr>
                        <th class="py-2">Bệnh nhân</th>
                        <th class="py-2">SĐT đăng nhập</th>
                        <th class="py-2">Email</th>
                        <th class="py-2">Hồ sơ liên kết</th>
                        <th class="py-2">Trạng thái</th>
                        <th class="py-2">Ngày tạo</th>
                        <th class="py-2 text-end">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-person-x display-4 d-block opacity-25 mb-3"></i>
                                Không tìm thấy tài khoản nào.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var acc in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                             style="width:36px;height:36px;flex-shrink:0;font-size:0.85rem">
                                            @acc.FullName.Substring(0, 1).ToUpper()
                                        </div>
                                        <span class="fw-semibold">@acc.FullName</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@acc.PhoneNumber</span>
                                </td>
                                <td class="text-muted small">@(acc.Email ?? "—")</td>
                                <td>
                                    @if (acc.Patient != null)
                                    {
                                        <a href="/Patient/Details/@acc.PatientId" class="text-decoration-none d-flex align-items-center gap-1">
                                            <i class="bi bi-journal-medical text-primary" style="font-size:0.8rem"></i>
                                            <span class="small fw-semibold text-primary">@acc.Patient.PatientCode</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Chưa liên kết</span>
                                    }
                                </td>
                                <td>
                                    @if (acc.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2">
                                            <i class="bi bi-circle-fill me-1" style="font-size:0.45rem;vertical-align:middle"></i>Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2">
                                            <i class="bi bi-lock-fill me-1" style="font-size:0.7rem"></i>Đã khóa
                                        </span>
                                    }
                                </td>
                                <td class="text-muted small">@acc.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <!-- View linked patient -->
                                        @if (acc.Patient != null)
                                        {
                                            <a href="/Patient/Details/@acc.PatientId" class="btn btn-outline-primary btn-sm" title="Xem hồ sơ bệnh nhân">
                                                <i class="bi bi-person-vcard"></i>
                                            </a>
                                        }

                                        <!-- Toggle lock -->
                                        <form method="post" action="/PatientAccount/Toggle" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@acc.Id" />
                                            <button type="submit" class="btn btn-sm @(acc.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                                    title="@(acc.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")"
                                                    onclick="return confirm('@(acc.IsActive ? "Khóa" : "Mở khóa") tài khoản của @acc.FullName?')">
                                                <i class="bi bi-@(acc.IsActive ? "lock" : "unlock")"></i>
                                            </button>
                                        </form>

                                        <!-- Reset password -->
                                        <form method="post" action="/PatientAccount/ResetPassword" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@acc.Id" />
                                            <button type="submit" class="btn btn-outline-warning btn-sm" title="Đặt lại mật khẩu về mặc định"
                                                    onclick="return confirm('Đặt lại mật khẩu về BN@MãBN cho @acc.FullName?')">
                                                <i class="bi bi-key"></i>
                                            </button>
                                        </form>

                                        <!-- Delete (Admin only) -->
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <form method="post" action="/PatientAccount/Delete" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@acc.Id" />
                                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Xóa tài khoản"
                                                        onclick="return confirm('Xóa vĩnh viễn tài khoản của @acc.FullName? Bệnh nhân sẽ không thể đăng nhập portal.')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <nav class="mt-3 d-flex justify-content-center">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(page <= 1 ? "disabled" : "")">
                        <a class="page-link" href="/PatientAccount?page=@(page-1)&search=@ViewBag.Search&status=@ViewBag.Status">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    @for (int i = Math.Max(1, page - 2); i <= Math.Min(totalPages, page + 2); i++)
                    {
                        <li class="page-item @(i == page ? "active" : "")">
                            <a class="page-link" href="/PatientAccount?page=@i&search=@ViewBag.Search&status=@ViewBag.Status">@i</a>
                        </li>
                    }
                    <li class="page-item @(page >= totalPages ? "disabled" : "")">
                        <a class="page-link" href="/PatientAccount?page=@(page+1)&search=@ViewBag.Search&status=@ViewBag.Status">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
