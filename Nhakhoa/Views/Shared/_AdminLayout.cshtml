<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <style>
        body { font-family: "Space Grotesk", sans-serif; background-color: #f4f7fe; }
        .admin-layout { display: flex; min-height: 100vh; }
        
        .admin-sidebar {
            width: 250px;
            background: #fff;
            border-right: 1px solid #eef0f7;
            padding: 24px 0;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }

        .admin-sidebar .brand { padding: 0 24px 32px; font-weight: 700; color: #1b75d0; font-size: 1.2rem; display: flex; align-items: center; gap: 10px; }
        .admin-sidebar .brand .icon { background: #1b75d0; color: #fff; width: 32px; height: 32px; border-radius: 8px; display: grid; place-items: center; }

        .sidebar-menu {
            display: flex;
            flex-direction: column;
            gap: 4px;
            padding: 0 12px 12px;
            flex: 1;
            min-height: 0;
            overflow-y: auto;
        }
        .sidebar-menu a {
            display: flex; align-items: center; gap: 12px; padding: 12px 16px; 
            text-decoration: none; color: #5b6b7a; border-radius: 12px; font-weight: 500; transition: all 0.2s;
        }
        .sidebar-menu a:hover { background: #f4f9ff; color: #1b75d0; }
        .sidebar-menu a.active { background: #1b75d0; color: #fff; }
        
        .admin-content { flex: 1; padding: 0; display: flex; flex-direction: column; height: 100vh; overflow-y: auto;}
        
        .admin-topbar {
            height: 70px; background: #fff; display: flex; align-items: center; justify-content: space-between;
            padding: 0 32px; border-bottom: 1px solid #eef0f7;
        }
        
        .topbar-search { background: #f4f7fe; border-radius: 99px; padding: 8px 16px; display: flex; align-items: center; gap: 8px; width: 300px; }
        .topbar-search input { border: none; background: transparent; outline: none; flex: 1; font-size: 0.9rem; }
        
        .topbar-right { display: flex; align-items: center; gap: 20px; }
        .topbar-avatar { width: 36px; height: 36px; border-radius: 50%; background: #cfe9ff; display: grid; place-items: center; color: #1b75d0; font-weight: 700; }

        .admin-main { padding: 32px; flex: 1; }

        .topbar-datetime { color: #5b6b7a; font-weight: 500; font-size: 0.95rem; }
        
        .bottom-actions { margin-top: auto; padding: 24px; display: flex; flex-direction: column; gap: 8px; border-top: 1px solid #eef0f7; }
        .bottom-actions-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-weight: 600;
            color: #5b6b7a;
            padding: 0 8px;
            cursor: pointer;
            user-select: none;
        }
        .bottom-actions-toggle {
            border: none;
            background: #f4f7fe;
            color: #5b6b7a;
            width: 28px;
            height: 28px;
            border-radius: 999px;
            display: grid;
            place-items: center;
            transition: transform 0.2s ease, background 0.2s ease;
        }
        .bottom-actions-toggle:hover { background: #e9f1ff; color: #1b75d0; }
        .bottom-actions-content { display: none; flex-direction: column; gap: 8px; margin-top: 8px; }
        .bottom-actions.open .bottom-actions-content { display: flex; }
        .bottom-actions.open .bottom-actions-toggle { transform: rotate(180deg); }
        .bottom-actions a, .bottom-actions button { 
             display: flex; align-items: center; gap: 12px; text-decoration: none; color: #5b6b7a; 
             background: none; border: none; width: 100%; text-align: left; padding: 8px; border-radius: 8px;
        }
        .bottom-actions a:hover { background: #f4f9ff; color: #1b75d0; }
        .bottom-actions button:hover { background: #ffe9e9; color: #d01b1b; }

        /* Avatar dropdown */
        .avatar-wrapper { position: relative; }
        .avatar-wrapper:hover .avatar-dropdown { display: block; }
        .avatar-dropdown {
            display: none; position: absolute; right: 0; top: calc(100% + 10px);
            background: #fff; border: 1px solid #eef0f7; border-radius: 14px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.12); min-width: 200px; z-index: 999; overflow: hidden;
        }
        .avatar-dropdown-header {
            padding: 14px 16px; border-bottom: 1px solid #eef0f7;
            font-size: 0.85rem; color: #5b6b7a;
        }
        .avatar-dropdown-header strong { display: block; color: #1a2332; font-size: 0.95rem; }
        .avatar-dropdown a {
            display: flex; align-items: center; gap: 10px; padding: 11px 16px;
            text-decoration: none; color: #3a4a5c; font-size: 0.9rem; font-weight: 500; transition: background 0.15s;
        }
        .avatar-dropdown a:hover { background: #f4f9ff; color: #1b75d0; }
        .avatar-dropdown .dropdown-danger:hover { background: #fff4f4; color: #d01b1b; }
        .avatar-dropdown form { margin: 0; }
        .avatar-dropdown form button {
            display: flex; align-items: center; gap: 10px; padding: 11px 16px; width: 100%;
            text-decoration: none; color: #3a4a5c; font-size: 0.9rem; font-weight: 500;
            background: none; border: none; cursor: pointer; transition: background 0.15s;
        }
        .avatar-dropdown form button:hover { background: #fff4f4; color: #d01b1b; }
    </style>
</head>
<body>
    <div class="admin-layout">
        <!-- Sidebar -->
        <aside class="admin-sidebar">
            <div class="brand">
                <div class="icon"><i class="bi bi-hospital"></i></div>
                St. Mary's Clinic<br/><small class="text-muted" style="font-size: 0.75rem; font-weight: 500;">Admin Portal</small>
            </div>
            
            @{
                var controller = ViewContext.RouteData.Values["controller"]?.ToString();
                var action = ViewContext.RouteData.Values["action"]?.ToString();
            }
            <nav class="sidebar-menu">
                <a asp-controller="Home" asp-action="Index" class="@(controller == "Home" && action == "Index" ? "active" : "")"><i class="bi bi-grid-1x2"></i> Tổng quan</a>

                <a asp-controller="Appointment" asp-action="Index" class="@(controller == "Appointment" && action != "Queue" ? "active" : "")"><i class="bi bi-calendar-check"></i> Lịch hẹn</a>
                <a asp-controller="Appointment" asp-action="Queue" class="@(controller == "Appointment" && action == "Queue" ? "active" : "")" style="padding-left:32px; font-size:0.88rem;"><i class="bi bi-clock-history"></i> Hàng chờ hôm nay</a>

                <a asp-controller="Patient" asp-action="Index" class="@(controller == "Patient" ? "active" : "")"><i class="bi bi-journal-medical"></i> Hồ sơ bệnh nhân</a>

                <a asp-controller="Schedule" asp-action="Index" class="@(controller == "Schedule" && action == "Index" ? "active" : "")"><i class="bi bi-calendar3"></i> Lịch làm việc</a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Schedule" asp-action="Holidays" class="@(controller == "Schedule" && action == "Holidays" ? "active" : "")" style="padding-left:32px; font-size:0.88rem;"><i class="bi bi-calendar-x"></i> Ngày nghỉ lễ</a>
                }

                <a asp-controller="MedicalService" asp-action="Index" class="@(controller == "MedicalService" ? "active" : "")"><i class="bi bi-activity"></i> Dịch vụ y tế</a>
                <a asp-controller="Specialty" asp-action="Index" class="@(controller == "Specialty" ? "active" : "")"><i class="bi bi-heart-pulse"></i> Chuyên khoa</a>
                <a asp-controller="Clinic" asp-action="Index" class="@(controller == "Clinic" ? "active" : "")"><i class="bi bi-building"></i> Phòng khám</a>
                <a href="#"><i class="bi bi-receipt"></i> Thanh toán</a>
                <a asp-controller="Staff" asp-action="Index" class="@(controller == "Staff" ? "active" : "")"><i class="bi bi-people"></i> Nhân sự</a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Staff" asp-action="SalaryList" class="@(action == "SalaryList" || action == "Salary" ? "active" : "")" style="padding-left:32px; font-size:0.88rem;">
                        <i class="bi bi-cash-stack"></i> Bảng lương
                    </a>
                    <a asp-controller="RolePermission" asp-action="Index" class="@(controller == "RolePermission" ? "active" : "")">
                        <i class="bi bi-shield-lock"></i> Phân quyền
                    </a>
                }
            </nav>
            
            <div class="bottom-actions" id="bottomActions">
                <div class="bottom-actions-header" id="bottomActionsToggle">
                    <span>Tài khoản</span>
                    <button class="bottom-actions-toggle" type="button" aria-label="Mo danh sach tai khoan">
                        <i class="bi bi-chevron-down"></i>
                    </button>
                </div>
                <div class="bottom-actions-content">
                    <a href="#"><i class="bi bi-question-circle"></i> Trung tam ho tro</a>
                    <a asp-controller="Auth" asp-action="ChangePassword" class="@(controller == "Auth" && action == "ChangePassword" ? "active" : "")">
                        <i class="bi bi-key"></i> Đổi mật khẩu
                    </a>
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0 p-0">
                        <button type="submit"><i class="bi bi-box-arrow-right"></i> Đăng xuất</button>
                    </form>
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <div class="admin-content">
            <!-- Topbar -->
            <header class="admin-topbar">
                <div class="d-flex align-items-center gap-4">
                    <span class="fw-bold" style="color: #1b75d0;">CarePulse Pro</span>
                    <div class="topbar-datetime" id="topbarDateTime"></div>
                </div>
                
                <div class="topbar-right">
                    <div class="topbar-search">
                        <i class="bi bi-search text-muted"></i>
                        <input type="text" placeholder="Tìm kiếm nhanh..." />
                    </div>
                    <i class="bi bi-bell text-muted fs-5"></i>
                    <div class="avatar-wrapper">
                        <div class="topbar-avatar" style="cursor:pointer;" title="Tài khoản">@(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")</div>
                        <div class="avatar-dropdown">
                            <div class="avatar-dropdown-header">
                                <strong>@User.Identity?.Name</strong>
                                @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                            </div>
                            <a asp-controller="Staff" asp-action="PersonalProfile">
                                <i class="bi bi-file-earmark-person"></i> Hồ sơ cá nhân
                            </a>
                            <a asp-controller="Auth" asp-action="ChangePassword">
                                <i class="bi bi-key"></i> Đổi mật khẩu
                            </a>
                            <form asp-controller="Auth" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-danger">
                                    <i class="bi bi-box-arrow-right"></i> Đăng xuất
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Inner Page Content -->
            <main class="admin-main">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        <div>@TempData["SuccessMessage"]</div>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var el = document.getElementById("topbarDateTime");
            if (!el) return;

            function pad2(value) {
                return value.toString().padStart(2, "0");
            }

            function updateDateTime() {
                var now = new Date();
                var time = pad2(now.getHours()) + ":" + pad2(now.getMinutes());
                var date = pad2(now.getDate()) + "/" + pad2(now.getMonth() + 1) + "/" + now.getFullYear();
                el.textContent = time + " " + date;
            }

            updateDateTime();
            setInterval(updateDateTime, 1000);
        })();

        (function () {
            var container = document.getElementById("bottomActions");
            var toggle = document.getElementById("bottomActionsToggle");
            if (!container || !toggle) return;

            toggle.addEventListener("click", function () {
                container.classList.toggle("open");
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>