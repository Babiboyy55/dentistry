    /* ──── PERMISSION TABLE ──── */
    .perm-table-wrapper {
        padding: 0 20px 20px 20px;
        overflow-x: auto;
    }
    .perm-table {
        width: 100%;
        border-collapse: collapse;
    }
    .perm-table thead th {
