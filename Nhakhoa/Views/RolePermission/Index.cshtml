    /* ──── AUDIT LOG SECTION ──── */
    .rbac-audit-card {
        background: #fff;
        border-radius: 4px;
        border: 1px solid #dee2e6;
        overflow: hidden;
    }
    .audit-card-header {
        padding: 16px 20px;
        border-bottom: 1px solid #dee2e6;
        display: flex;
