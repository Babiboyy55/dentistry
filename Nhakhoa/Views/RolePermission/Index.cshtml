</style>

<div class="rbac-page-wrapper">
    <!-- ========== LEFT SIDEBAR ========== -->
    <aside class="rbac-sidebar-nav">
        <div style="margin-bottom: 16px;">
            <a href="javascript:history.back()" class="sidebar-link" style="color: #0d6efd; font-weight: 600;">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
        </div>
        
        <nav>
            <div style="font-size: 0.72rem; font-weight: 700; color: #6c757d; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px; padding: 0 8px;">Quản lý hệ thống</div>
            <a href="/RolePermission" class="sidebar-link active">
                <i class="bi bi-shield-check"></i> Phân quyền
            </a>
            <a href="/RolePermission/ActivityLog" class="sidebar-link">
                <i class="bi bi-clock-history"></i> Nhật ký hoạt động
            </a>
            <a href="/RolePermission/SecurityAlerts" class="sidebar-link">
                <i class="bi bi-shield-exclamation"></i> Cảnh báo bảo mật
            </a>
        </nav>
    </aside>

    <!-- ========== MAIN CONTENT ========== -->
    <main class="rbac-main-content">
    <div class="rbac-header-section">
        <div class="rbac-header-left">
            <h1><i class="bi bi-shield-check me-2 text-primary"></i>Phân quyền hệ thống</h1>
            <p>Quản lý quyền truy cập của từng vai trò trong hệ thống.</p>
        </div>
        <div class="rbac-header-actions">
            <button class="btn-secondary" onclick="handleReset()" title="Khôi phục phân quyền mặc định cho vai trò hiện tại">
                <i class="bi bi-arrow-counterclockwise"></i> Khôi phục mặc định
            </button>
            <button class="btn-primary" onclick="handleSave()" title="Lưu các thay đổi phân quyền">
                <i class="bi bi-check-circle"></i> Lưu thay đổi
            </button>
        </div>
    </div>

    <!-- ========== STATISTICS CARDS ========== -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon blue">
                <i class="bi bi-diagram-3"></i>
            </div>
            <div class="stat-content">
                <h3>Tổng vai trò</h3>
                <div class="value">@totalRoles</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green">
                <i class="bi bi-layers"></i>
            </div>
            <div class="stat-content">
                <h3>Tổng module</h3>
                <div class="value">@totalModules</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon orange">
                <i class="bi bi-clock-history"></i>
            </div>
            <div class="stat-content">
                <h3>Thay đổi gần đây</h3>
                <div class="value">@auditLogs.Count</div>
            </div>
        </div>
    </div>

    <!-- ========== MAIN CONTENT: PERMISSIONS ========== -->
    <div class="rbac-main-card">
        <div class="rbac-main-card-header">
            <h2>
                <i class="bi bi-lock-fill me-2" style="color: #1b75d0;"></i>Quản lý quyền truy cập
            </h2>
        </div>

        <!-- Role tabs -->
        <div class="role-tabs">
            @foreach (var r in roles)
            {
                <button class="role-tab @(r.Key == "Admin" ? "active" : "")"
                        onclick="switchRole('@r.Key', this)"
                        title="Bấm để xem quyền hạn của vai trò '@r.Label'">
                    <i class="bi @r.Icon"></i> @r.Label
                </button>
            }
        </div>

        <!-- Permission table -->
        <div class="perm-table-wrapper">
            <table class="perm-table">
                <thead>
                    <tr>
                        <th>Module / Chức năng</th>
                        @foreach (var r in roles)
                        {
                            <th>@r.Label</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var mod in modules)
                    {
                        <tr>
                            <td>
                                <div class="module-cell">
                                    <div class="module-icon-wrap"><i class="bi @mod.ModuleIcon"></i></div>
                                    <span class="module-name">@mod.ModuleName</span>
                                </div>
                            </td>
                            @foreach (var r in roles)
                            {
                                var perm = allPerms.FirstOrDefault(p => p.Role == r.Key && p.ModuleKey == mod.ModuleKey);
                                bool isAllowed = perm?.IsAllowed ?? false;
                                bool isAdmin = r.Key == "Admin";
                                <td>
                                    <input type="checkbox"
                                           class="perm-check"
                                           data-role="@r.Key"
                                           data-module="@mod.ModuleKey"
                                           @(isAllowed ? "checked" : "")
                                           @(isAdmin ? "disabled" : "")
                                           title="@(isAdmin ? "Admin luôn có toàn quyền" : "Bấm để bật/tắt quyền này")" />
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- ========== AUDIT LOG ========== -->
    <div class="rbac-audit-card">
        <div class="audit-card-header">
            <h2><i class="bi bi-clock-history me-2" style="color: #1b75d0;"></i>Nhật ký thay đổi</h2>
            <a href="/RolePermission/ActivityLog" title="Xem toàn bộ nhật ký">Xem tất cả</a>
        </div>
        @if (auditLogs.Count == 0)
        {
            <ul class="audit-list">
                <li class="audit-item">
                    <div class="audit-dot"></div>
                    <div class="audit-content">
                        <strong>Hệ thống đã lưu dữ liệu phân quyền</strong>
                        <div class="action">Khởi tạo ban đầu</div>
                        <time>Hôm nay</time>
                    </div>
                </li>
            </ul>
        }
        else
        {
            <ul class="audit-list">
                @foreach (var log in auditLogs)
                {
                    bool isDanger = log.Details?.Contains("Thu hồi") == true || log.Details?.Contains("-") == true;
                    <li class="audit-item">
                        <div class="audit-dot @(isDanger ? "danger" : "")"></div>
                        <div class="audit-content">
                            <strong>@log.Username</strong>
                            <div class="action">@log.Action</div>
                            <div style="font-size: 0.75rem; color: #8898aa; margin: 4px 0;">
                                @(log.Details?.Length > 70 ? log.Details.Substring(0, 70) + "…" : log.Details)
                            </div>
                            <time>@log.Timestamp.ToString("HH:mm • dd/MM/yyyy")</time>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</div>

<!-- ========== CONFIRMATION MODAL ========== -->
<div class="modal-overlay" id="confirmModal">
    <div class="modal-box">
        <div class="modal-icon"><i class="bi bi-shield-lock"></i></div>
        <h3>Xác nhận cập nhật phân quyền</h3>
        <p>Các thay đổi quyền truy cập sẽ được áp dụng ngay lập tức.</p>

        <div class="modal-summary" id="modalSummary">
            <div class="role-label" id="modalRoleLabel"></div>
            <div id="modalAdded"></div>
            <div id="modalRemoved"></div>
        </div>

        <div class="modal-note">
            <i class="bi bi-info-circle"></i>
            <span>Hành động này sẽ được ghi lại trong nhật ký hệ thống.</span>
        </div>

        <div class="modal-actions">
            <button class="btn-cancel" onclick="closeModal()">Hủy</button>
            <button class="btn-confirm" onclick="confirmSave()">Xác nhận lưu</button>
        </div>
    </div>
</div>

<!-- Toast -->
<div class="toast-success" id="toastSuccess">
    <i class="bi bi-check-circle-fill"></i>
    <span id="toastMsg">Đã lưu phân quyền thành công!</span>
</div>

@section Scripts {
<script>
    let currentRole = 'Admin';
    let pendingChanges = {};   // { moduleKey: bool }
    let pendingRole = '';

    // ── Highlight active role column ──────────────────────────────
    function switchRole(role, btn) {
        currentRole = role;
        document.querySelectorAll('.role-tab').forEach(t => t.classList.remove('active'));
        btn.classList.add('active');
        // Scroll to first non-disabled checkbox of this role
        const firstCheck = document.querySelector(`.perm-check[data-role="${role}"]`);
        if (firstCheck) firstCheck.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    // ── Gather changes for the active role ───────────────────────
    function gatherChanges(role) {
        const checks = document.querySelectorAll(`.perm-check[data-role="${role}"]`);
        const perms = {};
        const added = [];
        const removed = [];

        checks.forEach(chk => {
            perms[chk.dataset.module] = chk.checked;
            // "original" state stored in data-original attribute
            const orig = chk.dataset.original === 'true';
            if (chk.checked && !orig) {
                added.push(chk.closest('tr').querySelector('.module-name')?.textContent.trim() ?? chk.dataset.module);
            } else if (!chk.checked && orig) {
                removed.push(chk.closest('tr').querySelector('.module-name')?.textContent.trim() ?? chk.dataset.module);
            }
        });
        return { perms, added, removed };
    }

    // ── Store original state on page load ────────────────────────
    document.querySelectorAll('.perm-check').forEach(chk => {
        chk.dataset.original = chk.checked.toString();
    });

    // ── Handle Save ──────────────────────────────────────────────
    function handleSave() {
        const role = currentRole;
        const { perms, added, removed } = gatherChanges(role);

        if (added.length === 0 && removed.length === 0) {
            showToast('Không có thay đổi nào để lưu.', false);
            return;
        }

        pendingChanges = perms;
        pendingRole = role;

        // Build modal content
        const roleLabels = { Admin: 'Admin', Doctor: 'Bác sĩ', Receptionist: 'Lễ tân' };
        document.getElementById('modalRoleLabel').innerHTML =
            `<i class="bi bi-person-badge me-1"></i> Vai trò: <span style="color:#1b75d0">${roleLabels[role]}</span>`;

        const addedHtml = added.length
            ? `<div style="margin-bottom:6px;font-size:0.8rem;font-weight:700;color:#2e7d32;">ĐƯỢC THÊM MỚI</div>`
              + added.map(n => `<span class="change-tag added">+ ${n}</span>`).join('')
            : '';
        const removedHtml = removed.length
            ? `<div style="margin-top:8px;margin-bottom:6px;font-size:0.8rem;font-weight:700;color:#c62828;">THU HỒI QUYỀN</div>`
              + removed.map(n => `<span class="change-tag removed">- ${n}</span>`).join('')
            : '';

        document.getElementById('modalAdded').innerHTML = addedHtml;
        document.getElementById('modalRemoved').innerHTML = removedHtml;
        document.getElementById('confirmModal').classList.add('show');
    }

    function closeModal() {
        document.getElementById('confirmModal').classList.remove('show');
    }

    async function confirmSave() {
        closeModal();
        try {
            const res = await fetch('/RolePermission/Save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ role: pendingRole, permissions: pendingChanges })
            });
            const data = await res.json();
            if (data.success) {
                // Update original state
                document.querySelectorAll(`.perm-check[data-role="${pendingRole}"]`).forEach(chk => {
                    chk.dataset.original = chk.checked.toString();
                });
                showToast(`Đã lưu phân quyền vai trò [${pendingRole}] thành công!`, true);
            }
        } catch (e) {
            showToast('Lỗi khi lưu dữ liệu!', false);
        }
    }

    // ── Handle Reset ─────────────────────────────────────────────
    async function handleReset() {
        if (!confirm(`Khôi phục phân quyền mặc định cho vai trò "${currentRole}"?`)) return;
        try {
            const res = await fetch('/RolePermission/Reset', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ role: currentRole })
            });
            const data = await res.json();
            if (data.success) {
                showToast('Đã khôi phục phân quyền mặc định!', true);
                setTimeout(() => location.reload(), 1200);
            }
        } catch (e) {
            showToast('Lỗi khi khôi phục!', false);
        }
    }

    // ── Toast helper ─────────────────────────────────────────────
    function showToast(msg, success) {
        const t = document.getElementById('toastSuccess');
        const m = document.getElementById('toastMsg');
        t.style.background = success ? '#1b75d0' : '#e53935';
        m.textContent = msg;
        t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 3000);
    }

    // Close modal on overlay click
    document.getElementById('confirmModal').addEventListener('click', function(e) {
        if (e.target === this) closeModal();
    });
</script>
}
