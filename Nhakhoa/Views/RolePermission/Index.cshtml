        font-weight: 700;
        font-size: 0.75rem;
        color: #6c757d;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        background: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
        text-align: left;
    }
    .perm-table thead th:not(:first-child) {
        text-align: center;
        width: 100px;
    }
    .perm-table tbody tr {
        border-bottom: 1px solid #e9ecef;
    }
    .perm-table tbody tr:last-child {
