@{
    ViewData["Title"] = "Phân quyền hệ thống";
    var allPerms = ViewBag.Permissions as List<Nhakhoa.Models.RolePermission> ?? new();
    var auditLogs = ViewBag.AuditLogs as List<Nhakhoa.Models.ActivityLog> ?? new();

    var roles = new[] {
        new { Key = "Admin",        Label = "Admin",   Icon = "bi-shield-lock" },
        new { Key = "Doctor",       Label = "Bác sĩ",  Icon = "bi-heart-pulse" },
        new { Key = "Receptionist", Label = "Lễ tân",  Icon = "bi-person-badge" },
    };

    // Get distinct modules ordered by SortOrder
    var modules = allPerms
        .GroupBy(p => p.ModuleKey)
        .Select(g => g.First())
        .OrderBy(p => p.SortOrder)
        .ToList();

    // Calculate statistics
    var totalModules = modules.Count;
    var totalRoles = roles.Length;
}

<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    /* ──── MAIN LAYOUT WITH SIDEBAR ──── */
    .rbac-page-wrapper {
        display: flex;
        gap: 0;
        min-height: 100vh;
        margin: -24px;
    }
    
    .rbac-sidebar-nav {
        width: 250px;
        background: #fff;
        border-right: 1px solid #dee2e6;
        padding: 20px 16px;
        flex-shrink: 0;
    }
    
    .rbac-main-content {
        flex: 1;
        overflow-y: auto;
        background-color: #f8f9fa;
        padding: 24px;
    }
    
    /* ──── HEADER SECTION ──── */
    .rbac-header-section {
        display: flex; 
        justify-content: space-between; 
        align-items: flex-start; 
        margin-bottom: 24px; 
        gap: 20px;
    }
    .rbac-header-left h1 {
        font-size: 1.6rem; 
