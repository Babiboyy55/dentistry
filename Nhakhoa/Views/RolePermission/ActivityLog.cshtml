@model List<Nhakhoa.Models.ActivityLog>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Nhật ký hoạt động";
    
    // Stats calculation
    var totalLogs = Model.Count;
    var todayLogs = Model.Count(l => l.Timestamp.Date == DateTime.Today);
    var securityLogs = Model.Count(l => l.Action.Contains("quyền") || l.Action.Contains("Khóa") || l.Action.Contains("Cấp lại mật khẩu"));
}

<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    /* ──── MAIN LAYOUT WITH SIDEBAR ──── */
    .rbac-page-wrapper {
        display: flex;
        gap: 0;
        min-height: 100vh;
        margin: -24px;
    }
    
    .rbac-sidebar-nav {
        width: 250px;
        background: #fff;
        border-right: 1px solid #dee2e6;
        padding: 20px 16px;
        flex-shrink: 0;
    }
    
    .rbac-main-content {
        flex: 1;
        overflow-y: auto;
        background-color: #f8f9fa;
        padding: 24px;
    }
    
    /* ──── HEADER SECTION ──── */
    .rbac-header-section {
        display: flex; 
        justify-content: space-between; 
        align-items: flex-start; 
        margin-bottom: 24px; 
        gap: 20px;
    }
    .rbac-header-left h1 {
        font-size: 1.6rem; 
        font-weight: 700; 
        color: #212529;
        margin-bottom: 4px;
    }
    .rbac-header-left p {
        font-size: 0.9rem; 
        color: #6c757d; 
        line-height: 1.4;
    }

    /* ──── STATISTICS CARDS ──── */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 24px;
    }
    .stat-card {
        background: #fff;
        border-radius: 4px;
        border: 1px solid #dee2e6;
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .stat-icon {
        width: 42px;
        height: 42px;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
    }
    .stat-icon.blue { background: #edf4ff; color: #0d6efd; }
    .stat-icon.green { background: #d4edda; color: #155724; }
    .stat-icon.orange { background: #fff3cd; color: #856404; }
    
    .stat-content h3 {
        font-size: 0.72rem;
        color: #6c757d;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 2px;
    }
    .stat-content .value {
        font-size: 1.4rem;
        font-weight: 700;
        color: #212529;
    }

    /* ──── FILTER BAR ──── */
    .filter-bar {
        display: flex;
        gap: 12px;
        margin-bottom: 20px;
        background: #fff;
        padding: 12px 16px;
        border-radius: 4px;
        border: 1px solid #dee2e6;
        align-items: center;
    }
    .filter-input-wrapper {
        position: relative;
        flex: 1;
    }
    .filter-input-wrapper i {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #6c757d;
    }
    .filter-input-wrapper input {
        width: 100%;
        padding: 8px 12px 8px 34px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        outline: none;
        font-size: 0.88rem;
    }
    .filter-input-wrapper input:focus {
        border-color: #86b7fe;
    }
    .filter-select {
        padding: 8px 12px;
        border: 1px solid #ced4da;
        border-radius: 4px;
        outline: none;
        font-size: 0.88rem;
        background: #fff;
        cursor: pointer;
        min-width: 200px;
        color: #495057;
    }
    .filter-select:focus {
        border-color: #86b7fe;
    }

    /* ──── TABLE CARD ──── */
    .rbac-main-card {
        background: #fff;
        border-radius: 4px;
        border: 1px solid #dee2e6;
        overflow: hidden;
        margin-bottom: 24px;
    }
    .rbac-main-card-header {
        padding: 16px 20px;
        border-bottom: 1px solid #dee2e6;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .rbac-main-card-header h2 {
        font-size: 1rem;
        font-weight: 700;
        color: #212529;
    }

    .perm-table-wrapper {
        padding: 20px;
        overflow-x: auto;
    }
    .perm-table {
        width: 100%;
        border-collapse: collapse;
    }
    .perm-table thead th {
        padding: 10px 14px;
        font-weight: 700;
        font-size: 0.75rem;
        color: #6c757d;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        background: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
        text-align: left;
    }
    .perm-table tbody tr {
        border-bottom: 1px solid #e9ecef;
    }
    .perm-table tbody tr:last-child {
        border-bottom: none;
    }
    .perm-table tbody tr:hover {
        background: #f8f9fa;
    }
    .perm-table td {
        padding: 12px 14px;
        vertical-align: middle;
        font-size: 0.88rem;
    }
    
    .badge-wrap {
        font-size: 0.78rem;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 4px;
        display: inline-block;
    }
    
    .badge-success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
    .badge-primary { background: #edf4ff; color: #0d6efd; border: 1px solid #b3d7ff; }
    .badge-warning { background: #fff3cd; color: #856404; border: 1px solid #ffeeba; }
    .badge-danger { background: #fde8e8; color: #dc3545; border: 1px solid #f8b4b4; }
    .badge-secondary { background: #e2e3e5; color: #383d41; border: 1px solid #d6d8db; }
    .badge-indigo { background: #ede7f6; color: #512da8; border: 1px solid #d1c4e9; }

    .sidebar-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        border-radius: 4px;
        color: #495057;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.9rem;
        margin-top: 4px;
    }
    .sidebar-link:hover {
        background: #f1f3f5;
        color: #212529;
    }
    .sidebar-link.active {
        background: #edf4ff;
        color: #0d6efd;
        font-weight: 600;
    }

    @@media (max-width: 768px) {
        .rbac-container { padding: 20px 16px; }
        .rbac-header-section { flex-direction: column; }
        .stats-grid { grid-template-columns: 1fr; }
        .filter-bar { flex-direction: column; align-items: stretch; gap: 12px; }
        .filter-select { width: 100%; }
    }
</style>

<div class="rbac-page-wrapper">
    <!-- ========== LEFT SIDEBAR ========== -->
    <aside class="rbac-sidebar-nav">
        <div style="margin-bottom: 16px;">
            <a href="/RolePermission" class="sidebar-link" style="color: #0d6efd; font-weight: 600;">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
        </div>
        
        <nav>
            <div style="font-size: 0.72rem; font-weight: 700; color: #6c757d; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px; padding: 0 8px;">Quản lý hệ thống</div>
            <a href="/RolePermission" class="sidebar-link">
                <i class="bi bi-shield-check"></i> Phân quyền
            </a>
            <a href="/RolePermission/ActivityLog" class="sidebar-link active">
                <i class="bi bi-clock-history"></i> Nhật ký hoạt động
            </a>
            <a href="/RolePermission/SecurityAlerts" class="sidebar-link">
                <i class="bi bi-shield-exclamation"></i> Cảnh báo bảo mật
            </a>
        </nav>
    </aside>

    <!-- ========== MAIN CONTENT ========== -->
    <main class="rbac-main-content">
        <div class="rbac-container">
            <div class="rbac-header-section">
                <div class="rbac-header-left">
                    <h1><i class="bi bi-clock-history me-2 text-primary"></i>Nhật ký hoạt động</h1>
                    <p>Theo dõi toàn bộ các thao tác đăng nhập, phân quyền, thay đổi thông tin nhân sự và cấu hình hệ thống.</p>
                </div>
            </div>

            <!-- ========== STATISTICS CARDS ========== -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon blue">
                        <i class="bi bi-list-check"></i>
                    </div>
                    <div class="stat-content">
                        <h3>Tổng số hoạt động</h3>
                        <div class="value" id="statTotal">@totalLogs</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon green">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <div class="stat-content">
                        <h3>Hoạt động hôm nay</h3>
                        <div class="value">@todayLogs</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon orange">
                        <i class="bi bi-shield-exclamation"></i>
                    </div>
                    <div class="stat-content">
                        <h3>Cảnh báo & Bảo mật</h3>
                        <div class="value">@securityLogs</div>
                    </div>
                </div>
            </div>

            <!-- ========== FILTER BAR ========== -->
            <div class="filter-bar">
                <div class="filter-input-wrapper">
                    <i class="bi bi-search"></i>
                    <input type="text" id="logSearch" placeholder="Tìm kiếm theo tài khoản hoặc chi tiết hoạt động..." />
                </div>
                <select id="actionFilter" class="filter-select">
                    <option value="">Tất cả hành động</option>
                    <option value="Đăng nhập">Đăng nhập</option>
                    <option value="Cập nhật phân quyền">Cập nhật phân quyền</option>
                    <option value="Khôi phục phân quyền mặc định">Khôi phục phân quyền</option>
                    <option value="Tạo tài khoản">Tạo tài khoản</option>
                    <option value="Cập nhật thông tin">Cập nhật thông tin</option>
                    <option value="Khóa tài khoản">Khóa tài khoản</option>
                    <option value="Mở khóa tài khoản">Mở khóa tài khoản</option>
                    <option value="Cấp lại mật khẩu">Cấp lại mật khẩu</option>
                    <option value="Đổi mật khẩu">Đổi mật khẩu</option>
                </select>
            </div>

            <!-- ========== LOGS DATAGRID ========== -->
            <div class="rbac-main-card">
                <div class="rbac-main-card-header">
                    <h2><i class="bi bi-list-ul me-2" style="color: #1b75d0;"></i>Lịch sử hoạt động</h2>
                </div>
                <div class="perm-table-wrapper">
                    <table class="perm-table" id="logsTable">
                        <thead>
                            <tr>
                                <th style="width: 180px;">Thời gian</th>
                                <th style="width: 200px;">Tài khoản thực hiện</th>
                                <th style="width: 220px;">Hành động</th>
                                <th>Chi tiết hoạt động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Count == 0)
                            {
                                <tr class="no-records">
                                    <td colspan="4" class="text-center text-muted py-4">Chưa có hoạt động nào được ghi nhận</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var log in Model)
                                {
                                    var actionBadge = log.Action switch
                                    {
                                        "Đăng nhập" => "badge-success",
                                        "Mở khóa tài khoản" => "badge-success",
                                        "Cập nhật phân quyền" => "badge-indigo",
                                        "Khôi phục phân quyền mặc định" => "badge-indigo",
                                        "Tạo tài khoản" => "badge-primary",
                                        "Cập nhật thông tin" => "badge-primary",
                                        "Khóa tài khoản" => "badge-danger",
                                        "Cấp lại mật khẩu" => "badge-warning",
                                        "Đổi mật khẩu" => "badge-warning",
                                        _ => "badge-secondary"
                                    };

                                    <tr class="log-row" data-username="@log.Username.ToLower()" data-action="@log.Action">
                                        <td class="text-muted">@log.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                        <td class="fw-semibold text-dark">@log.Username</td>
                                        <td><span class="badge-wrap @actionBadge">@log.Action</span></td>
                                        <td class="text-secondary log-details">@log.Details</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("logSearch");
        const actionFilter = document.getElementById("actionFilter");
        const tableRows = document.querySelectorAll(".log-row");
        const statTotal = document.getElementById("statTotal");

        function filterLogs() {
            const searchText = searchInput.value.toLowerCase().trim();
            const selectedAction = actionFilter.value;
            let visibleCount = 0;

            tableRows.forEach(row => {
                const username = row.dataset.username || "";
                const action = row.dataset.action || "";
                const details = row.querySelector(".log-details").textContent.toLowerCase();

                const matchesSearch = username.includes(searchText) || details.includes(searchText);
                const matchesAction = !selectedAction || action === selectedAction;

                if (matchesSearch && matchesAction) {
                    row.style.display = "";
                    visibleCount++;
                } else {
                    row.style.display = "none";
                }
            });

            // Handle no records row visibility
            let noRecordsRow = document.querySelector(".no-records-filtered");
            if (visibleCount === 0 && tableRows.length > 0) {
                if (!noRecordsRow) {
                    noRecordsRow = document.createElement("tr");
                    noRecordsRow.className = "no-records-filtered";
                    noRecordsRow.innerHTML = `<td colspan="4" class="text-center text-muted py-4">Không tìm thấy nhật ký phù hợp</td>`;
                    document.querySelector("#logsTable tbody").appendChild(noRecordsRow);
                }
            } else if (noRecordsRow) {
                noRecordsRow.remove();
            }

            statTotal.textContent = visibleCount;
        }

        searchInput.addEventListener("input", filterLogs);
        actionFilter.addEventListener("change", filterLogs);
    });
</script>
}
