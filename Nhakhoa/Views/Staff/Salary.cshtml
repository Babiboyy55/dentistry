@model Nhakhoa.ViewModels.StaffProfileViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thông tin lương - " + Model.FullName;

    string FormatMoney(decimal amount) =>
        amount == 0 ? "—" : amount.ToString("N0") + " ₫";

    string Fallback(string? val) =>
        string.IsNullOrWhiteSpace(val) ? "Chưa cập nhật" : val;

    string GetNamePrefix(string? degree, string? rank)
    {
        if (!string.IsNullOrEmpty(rank))
        {
            if (rank.Contains("Giáo sư") && !rank.Contains("Phó")) return "GS. ";
            if (rank.Contains("Phó Giáo sư")) return "PGS. ";
        }
        if (!string.IsNullOrEmpty(degree))
        {
            if (degree.Contains("Tiến sĩ")) return "TS. ";
            if (degree.Contains("Thạc sĩ")) return "ThS. ";
            if (degree.Contains("Cử nhân")) return "CN. ";
            if (degree.Contains("Bác sĩ")) return "BS. ";
        }
        return "";
    }

    // Standard Vietnamese payroll deduction rates (based on base salary)
    decimal personalTaxDeduction = 11000000m; // 11,000,000 ₫ personal deduction

    decimal baseSalary = Model.Salary.BaseSalary;
    decimal grossMultiplier = Model.Salary.DegreeMultiplier * Model.Salary.RankMultiplier;
    decimal baseWithMult = baseSalary * grossMultiplier;
    
    decimal grossSalary = baseWithMult 
                        + Model.Salary.SpecializationAllowance 
                        + Model.Salary.SeniorityAllowance 
                        + Model.Salary.MonthlyBonus;

    decimal bhxh = baseSalary * 0.08m;
    decimal bhyt = baseSalary * 0.015m;
    decimal bhtn = baseSalary * 0.01m;
    decimal unionFee = baseSalary * 0.01m;
    decimal mandatoryIns = bhxh + bhyt + bhtn + unionFee;

    decimal taxableIncome = grossSalary - mandatoryIns - personalTaxDeduction;
    decimal pit = 0;
    if (taxableIncome > 0)
    {
        if (taxableIncome <= 5000000m) pit = taxableIncome * 0.05m;
        else if (taxableIncome <= 10000000m) pit = taxableIncome * 0.10m - 250000m;
        else if (taxableIncome <= 18000000m) pit = taxableIncome * 0.15m - 750000m;
        else if (taxableIncome <= 32000000m) pit = taxableIncome * 0.20m - 1650000m;
        else if (taxableIncome <= 52000000m) pit = taxableIncome * 0.25m - 3250000m;
        else if (taxableIncome <= 80000000m) pit = taxableIncome * 0.30m - 5850000m;
        else pit = taxableIncome * 0.35m - 9850000m;
    }

    decimal totalDeductions = mandatoryIns + pit + Model.Salary.OtherDeductions;
    decimal netSalary = grossSalary - totalDeductions;
}

<!-- Page Header -->
<div class="d-flex align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-0">
            <i class="bi bi-cash-stack text-primary me-2"></i>Bảng lương nhân sự
        </h4>
        <div class="text-muted small mt-1">Chi tiết tính toán lương của @GetNamePrefix(Model.Salary.DegreeTitle, Model.Salary.RankTitle)@Model.FullName</div>
    </div>
    <div class="d-flex gap-2">
        <a href="/Staff/Details/@Model.Id" class="btn btn-outline-secondary btn-sm px-3 rounded-pill d-inline-flex align-items-center gap-1">
            <i class="bi bi-person-vcard"></i> Hồ sơ
        </a>
        <a href="/Staff/SalaryList" class="btn btn-outline-secondary btn-sm px-3 rounded-pill d-inline-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
        <a href="/Staff/Edit/@Model.Id" class="btn btn-primary btn-sm px-3 rounded-pill d-inline-flex align-items-center gap-1" style="background:#1b75d0; border-color:#1b75d0;">
            <i class="bi bi-pencil-square"></i> Cập nhật lương
        </a>
    </div>
</div>

<!-- Employee Identity Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4" style="background: linear-gradient(135deg, #1b75d0 0%, #0d4fa0 100%); padding: 28px;">
    <div class="d-flex align-items-center gap-4">
        <div class="rounded-4 d-flex align-items-center justify-content-center text-white fw-bold"
             style="width: 72px; height: 72px; background: rgba(255,255,255,0.2); font-size: 1.8rem; flex-shrink: 0;">
            @(Model.FullName?.Substring(0, 1).ToUpper() ?? "?")
        </div>
        <div class="flex-grow-1">
            <h4 class="fw-bold text-white mb-1">@GetNamePrefix(Model.Salary.DegreeTitle, Model.Salary.RankTitle)@Model.FullName</h4>
            <div class="d-flex flex-wrap gap-2">
                <span class="badge rounded-pill px-3 py-1 fw-medium" style="background: rgba(255,255,255,0.2); color:#fff; font-size:0.8rem;">
                    <i class="bi bi-briefcase me-1"></i>@Fallback(Model.PositionTitle)
                </span>
                <span class="badge rounded-pill px-3 py-1 fw-medium" style="background: rgba(255,255,255,0.2); color:#fff; font-size:0.8rem;">
                    <i class="bi bi-building me-1"></i>@Fallback(Model.Department)
                </span>
                <span class="badge rounded-pill px-3 py-1 fw-medium" style="background: rgba(255,255,255,0.2); color:#fff; font-size:0.8rem;">
                    ID: @Fallback(Model.StaffCode)
                </span>
            </div>
        </div>
        <div class="text-end">
            <div class="text-white-50 small mb-1">Thực lĩnh nhận về</div>
            <div class="fw-bold text-white" style="font-size: 2rem; letter-spacing: -0.5px;">@FormatMoney(netSalary)</div>
            <div class="text-white-50 small">Đã khấu trừ bảo hiểm & thuế TNCN</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Left: Salary Breakdown -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 h-100" style="padding: 28px;">
            <h5 class="fw-bold mb-4 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-calculator-fill text-primary"></i> Chi tiết tính toán lương & giảm trừ
            </h5>

            <!-- Section 1: Earnings -->
            <div class="fw-bold text-success border-bottom pb-1 mb-2 small uppercase">Các khoản thu nhập (+)</div>

            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                <div class="ps-2">
                    <div class="fw-semibold text-dark small">Lương cơ bản</div>
                </div>
                <span class="fw-bold text-dark">@FormatMoney(Model.Salary.BaseSalary)</span>
            </div>

            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                <div class="ps-2">
                    <div class="fw-semibold text-dark small">Hệ số học vị</div>
                    <div class="text-muted" style="font-size:0.75rem;">@Fallback(Model.Salary.DegreeTitle)</div>
                </div>
                <span class="badge bg-primary-subtle text-primary px-3 py-1 fw-bold rounded-pill">
                    × @Model.Salary.DegreeMultiplier.ToString("0.00")
                </span>
            </div>

            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                <div class="ps-2">
                    <div class="fw-semibold text-dark small">Hệ số học hàm</div>
                    <div class="text-muted" style="font-size:0.75rem;">@Fallback(Model.Salary.RankTitle)</div>
                </div>
                <span class="badge bg-success-subtle text-success px-3 py-1 fw-bold rounded-pill">
                    × @Model.Salary.RankMultiplier.ToString("0.00")
                </span>
            </div>

            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                <div class="ps-2">
                    <div class="fw-semibold text-dark small">Phụ cấp chuyên môn</div>
                </div>
                <span class="fw-semibold text-success">+@FormatMoney(Model.Salary.SpecializationAllowance)</span>
            </div>
            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                <div class="ps-2">
                    <div class="fw-semibold text-dark small">Phụ cấp thâm niên</div>
                </div>
                <span class="fw-semibold text-success">+@FormatMoney(Model.Salary.SeniorityAllowance)</span>
            </div>
            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                <div class="ps-2">
                    <div class="fw-semibold text-dark small">Thưởng KPI tháng</div>
                </div>
                <span class="fw-semibold text-success">+@FormatMoney(Model.Salary.MonthlyBonus)</span>
            </div>

            <div class="d-flex justify-content-between align-items-center py-2 border-bottom bg-light rounded-3 px-3 my-2 fw-bold">
                <span>Tổng thu nhập chịu thuế (Gross)</span>
                <span class="text-success">@FormatMoney(grossSalary)</span>
            </div>

            <!-- Section 2: Deductions -->
            <div class="fw-bold text-danger border-bottom pb-1 mt-4 mb-2 small uppercase">Các khoản giảm trừ / khấu trừ (-)</div>

            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                <div class="ps-2">
                    <div class="fw-semibold text-dark small">Bảo hiểm bắt buộc (BHXH 8%, BHYT 1.5%, BHTN 1%)</div>
                    <div class="text-muted" style="font-size:0.75rem;">Tính trên lương cơ bản</div>
                </div>
                <span class="fw-semibold text-danger">-@FormatMoney(mandatoryIns)</span>
            </div>

            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                <div class="ps-2">
                    <div class="fw-semibold text-dark small">Phí công đoàn (1%)</div>
                </div>
                <span class="fw-semibold text-danger">-@FormatMoney(unionFee)</span>
            </div>

            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                <div class="ps-2">
                    <div class="fw-semibold text-dark small">Thuế TNCN (Tạm tính)</div>
                    <div class="text-muted" style="font-size:0.75rem;">Biểu lũy tiến từng phần, giảm trừ gia cảnh 11 triệu đồng</div>
                </div>
                <span class="fw-semibold text-danger">-@FormatMoney(pit)</span>
            </div>

            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                <div class="ps-2">
                    <div class="fw-semibold text-dark small">Khấu trừ khác (Phạt đi muộn/Kỷ luật)</div>
                </div>
                <span class="fw-semibold text-danger">-@FormatMoney(Model.Salary.OtherDeductions)</span>
            </div>

            <div class="d-flex justify-content-between align-items-center py-2 border-bottom bg-light rounded-3 px-3 my-2 fw-bold">
                <span>Tổng cộng giảm trừ</span>
                <span class="text-danger">@FormatMoney(totalDeductions)</span>
            </div>

            <!-- Net Total -->
            <div class="d-flex justify-content-between align-items-center pt-4 mt-2">
                <div>
                    <div class="fw-bold text-dark fs-6">THỰC LĨNH CHUYỂN KHOẢN (NET)</div>
                    <div class="text-muted" style="font-size: 0.7rem;">= Gross - Khấu trừ bảo hiểm, thuế, kỷ luật</div>
                </div>
                <span class="fw-bold text-primary" style="font-size: 1.8rem;">@FormatMoney(netSalary)</span>
            </div>
        </div>
    </div>

    <!-- Right: Summary Cards -->
    <div class="col-lg-5">
        <!-- Formula Card -->
        <div class="card border-0 shadow-sm rounded-4 mb-4" style="padding: 24px; background: #f8fbff;">
            <h6 class="fw-bold text-primary mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-info-circle-fill"></i> Công thức thực lĩnh mới
            </h6>
            <div class="bg-white rounded-3 p-3 border" style="font-family: monospace; font-size: 0.82rem; line-height: 1.8; color: #1a2332;">
                <div><span class="text-success fw-bold">Gross Salary</span> = @FormatMoney(grossSalary)</div>
                <div><span class="text-danger fw-bold">- Bảo hiểm (10.5%)</span> = @FormatMoney(mandatoryIns)</div>
                <div><span class="text-danger fw-bold">- Thuế TNCN</span> = @FormatMoney(pit)</div>
                <div><span class="text-danger fw-bold">- Khấu trừ khác</span> = @FormatMoney(Model.Salary.OtherDeductions)</div>
                <div class="border-top mt-2 pt-2 fw-bold text-primary">= Thực lĩnh: @FormatMoney(netSalary)</div>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="row g-3">
            <div class="col-6">
                <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                    <div class="text-muted small mb-1">Hệ số học hàm/vị</div>
                    <div class="fw-bold text-primary fs-4">@grossMultiplier.ToString("0.00")</div>
                    <div class="text-muted" style="font-size: 0.72rem;">Tổng hợp hệ số</div>
                </div>
            </div>
            <div class="col-6">
                <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                    <div class="text-muted small mb-1">Thuế TNCN</div>
                    <div class="fw-bold text-danger fs-4">@FormatMoney(pit)</div>
                    <div class="text-muted" style="font-size: 0.72rem;">Tạm nộp nhà nước</div>
                </div>
            </div>
            <div class="col-6">
                <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                    <div class="text-muted small mb-1">Tổng phụ cấp & thưởng</div>
                    <div class="fw-bold text-warning fs-5">@FormatMoney(Model.Salary.SpecializationAllowance + Model.Salary.SeniorityAllowance + Model.Salary.MonthlyBonus)</div>
                </div>
            </div>
            <div class="col-6">
                <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                    <div class="text-muted small mb-1">Giảm trừ khác</div>
                    <div class="fw-bold text-danger fs-5">@FormatMoney(Model.Salary.OtherDeductions)</div>
                </div>
            </div>
        </div>

        <!-- Note -->
        <div class="alert alert-info border-0 rounded-4 mt-3 d-flex gap-2 align-items-start py-3 px-3" style="background:#e8f4ff;">
            <i class="bi bi-shield-lock-fill text-primary mt-1 flex-shrink-0"></i>
            <div class="small text-secondary">
                Thông tin lương được bảo mật và chỉ hiển thị cho <strong>Quản trị viên</strong>. Mọi thay đổi đều được ghi vào nhật ký hệ thống.
            </div>
        </div>
    </div>
</div>
