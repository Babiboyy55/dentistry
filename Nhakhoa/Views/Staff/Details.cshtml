@model Nhakhoa.ViewModels.StaffProfileViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Hồ sơ nhân sự";
}

@functions {
    string FormatMoney(decimal value) => value.ToString("N0") + " đ";
    string Fallback(string value) => string.IsNullOrWhiteSpace(value) ? "Chưa cập nhật" : value;
    string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        return name.Trim().Substring(0, 1).ToUpperInvariant();
    }
}

<div class="d-flex align-items-center gap-2 mb-3">
    <a class="text-decoration-none" href="/Staff">
        <i class="bi bi-arrow-left"></i>
        <span>Quay lại danh sách</span>
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4" style="background-color: #fff; padding: 24px;">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-4" style="width: 80px; height: 80px; background: #e8f1ff; display: grid; place-items: center; color: #1b75d0; font-size: 1.5rem; font-weight: 700;">
                @Initials(Model.FullName)
            </div>
            <div>
                <div class="text-muted small">@Fallback(Model.Role)</div>
                <h3 class="fw-bold mb-1">@Model.FullName</h3>
                <div class="text-muted small">Mã nhân sự: @Fallback(Model.StaffCode)</div>
                <div class="text-muted small">@Fallback(Model.PositionTitle) • @Fallback(Model.Department)</div>
            </div>
        </div>
        <div class="text-end d-flex flex-column align-items-end gap-2">
            <span class="badge @(Model.IsActive ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                @(Model.IsActive ? "Đang hoạt động" : "Đã khóa")
            </span>
            <a href="/Staff/Edit/@Model.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                <i class="bi bi-pencil me-1"></i> Chỉnh sửa
            </a>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4" style="background-color: #fff; padding: 24px;">
            <h5 class="fw-bold mb-3">Thông tin cá nhân</h5>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="text-muted small">Họ và tên</div>
                    <div class="fw-semibold">@Model.FullName</div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="text-muted small">Giới tính</div>
                    <div class="fw-semibold">@Fallback(Model.Gender)</div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="text-muted small">Email liên hệ</div>
                    <div class="fw-semibold">@Fallback(Model.Email)</div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="text-muted small">Số điện thoại</div>
                    <div class="fw-semibold">@Fallback(Model.PhoneNumber)</div>
                </div>
                <div class="col-12 mb-3">
                    <div class="text-muted small">Địa chỉ thường trú</div>
                    <div class="fw-semibold">@Fallback(Model.Address)</div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="text-muted small">Ngày gia nhập</div>
                    <div class="fw-semibold">@(Model.JoinDate?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="text-muted small">Cơ sở làm việc chính</div>
                    <div class="fw-semibold">@Fallback(Model.PrimaryClinic)</div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 mt-4" style="background-color: #fff; padding: 24px;">
            <h5 class="fw-bold mb-3">Bằng cấp &amp; Chứng chỉ</h5>
            @if (Model.Qualifications.Count == 0)
            {
                <div class="text-muted">Chưa có dữ liệu bằng cấp hoặc chứng chỉ.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="text-muted small">
                            <tr>
                                <th>Cấp bậc / Bằng cấp</th>
                                <th>Chuyên ngành</th>
                                <th>Tổ chức cấp</th>
                                <th class="text-end">Năm cấp</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Qualifications)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.Title</td>
                                    <td>@Fallback(item.Major)</td>
                                    <td>@Fallback(item.Institution)</td>
                                    <td class="text-end">@(item.Year?.ToString() ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4" style="background-color: #fff; padding: 24px;">
            <h5 class="fw-bold mb-3">Tính toán lương</h5>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Lương cơ bản</span>
                <span class="fw-semibold">@FormatMoney(Model.Salary.BaseSalary)</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Hệ số bằng cấp</span>
                <span class="fw-semibold">@Fallback(Model.Salary.DegreeTitle) x @Model.Salary.DegreeMultiplier</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Phụ cấp chuyên môn</span>
                <span class="fw-semibold">@FormatMoney(Model.Salary.SpecializationAllowance)</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Phụ cấp thâm niên</span>
                <span class="fw-semibold">@FormatMoney(Model.Salary.SeniorityAllowance)</span>
            </div>
            <div class="d-flex justify-content-between mb-3">
                <span class="text-muted">Thưởng KPI</span>
                <span class="fw-semibold">@FormatMoney(Model.Salary.MonthlyBonus)</span>
            </div>

            <div class="border-top pt-3 d-flex justify-content-between">
                <span class="text-muted">Tổng lương dự kiến (tháng)</span>
                <span class="fw-bold text-primary">@FormatMoney(Model.Salary.MonthlyTotal)</span>
            </div>
        </div>
    </div>
</div>
