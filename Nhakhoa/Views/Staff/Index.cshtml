@model IReadOnlyList<Nhakhoa.ViewModels.StaffListItemViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Danh sách nhân sự";
}

<div class="card border-0 shadow-sm rounded-4" style="background-color: #fff; padding: 32px;">
    <div class="d-flex flex-wrap align-items-start justify-content-between mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1" style="color: #0b1f35;">Quản lý tài khoản nhân sự</h2>
            <p class="text-muted mb-0">Quản lý quyền truy cập và thông tin nhân sự</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary px-4 py-2 fw-semibold" href="/Staff/ActivityLog">
                <i class="bi bi-clock-history me-1"></i>
                Lịch sử hoạt động
            </a>
            <a class="btn btn-primary px-4 py-2 fw-semibold" style="background-color: #1b75d0; border-color: #1b75d0;" href="/Staff/Create">
                <i class="bi bi-plus-circle me-1"></i>
                Thêm tài khoản mới
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <div>@Html.Raw(TempData["SuccessMessage"])</div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <div>@TempData["ErrorMessage"]</div>
        </div>
    }

    <div class="d-flex flex-wrap gap-3 mb-4">
        <div class="flex-grow-1">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" placeholder="Tìm kiếm theo tên hoặc email..." />
            </div>
        </div>
        <div style="min-width: 220px;">
            <select class="form-select">
                <option selected>Tất cả vai trò</option>
                <option>Quản trị viên</option>
                <option>Bác sĩ</option>
                <option>Lễ tân</option>
            </select>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead class="text-muted small">
                <tr>
                    <th style="width: 90px;">ID</th>
                    <th>Họ và tên</th>
                    <th>Email</th>
                    <th>Vai trò</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Chưa có nhân sự nào</td>
                    </tr>
                }
                else
                {
                    foreach (var staff in Model)
                    {
                        var roleBadge = staff.Role switch
                        {
                            "Admin" => "bg-primary-subtle text-primary",
                            "Doctor" => "bg-info-subtle text-info",
                            "Receptionist" => "bg-warning-subtle text-warning",
                            _ => "bg-secondary-subtle text-secondary"
                        };

                        var roleLabel = staff.Role switch
                        {
                            "Admin" => "Admin",
                            "Doctor" => "Bác sĩ",
                            "Receptionist" => "Lễ tân",
                            _ => staff.Role
                        };

                        <tr>
                            <td class="text-muted">NV@staff.Id</td>
                            <td class="fw-semibold">@staff.FullName</td>
                            <td>@staff.Email</td>
                            <td><span class="badge @roleBadge">@roleLabel</span></td>
                            <td>
                                @if (staff.IsActive)
                                {
                                    <span class="text-success"><i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i> Hoạt động</span>
                                }
                                else
                                {
                                    <span class="text-danger"><i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i> Đã khóa</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    <a class="btn btn-outline-primary btn-sm" href="/Staff/Details/@staff.Id" title="Xem hồ sơ">
                                        <i class="bi bi-person-vcard"></i>
                                    </a>
                                    <form asp-controller="Staff" asp-action="ResetPassword" asp-route-id="@staff.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn cấp lại mật khẩu mặc định (123456) cho nhân sự này?')">
                                        <button type="submit" class="btn btn-outline-warning btn-sm" title="Cấp lại mật khẩu (mặc định: 123456)">
                                            <i class="bi bi-key"></i>
                                        </button>
                                    </form>

                                    @if (User.Identity?.Name != staff.Username)
                                    {
                                        <form asp-controller="Staff" asp-action="ToggleStatus" asp-route-id="@staff.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-outline-@(staff.IsActive ? "danger" : "success") btn-sm" title="@(staff.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")">
                                                <i class="bi bi-@(staff.IsActive ? "lock" : "unlock")"></i>
                                            </button>
                                        </form>
                                    }

                                    <a class="btn btn-light btn-sm" href="/Staff/Edit/@staff.Id" title="Sửa thông tin">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
