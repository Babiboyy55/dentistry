@model Nhakhoa.ViewModels.EditStaffViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Cập nhật nhân sự";
}

<div class="card border-0 shadow-sm rounded-4" style="background-color: #fff; padding: 32px;">
    <div class="mb-4">
        <h2 class="fw-bold mb-1" style="color: #0b1f35;">Cập nhật hồ sơ nhân sự</h2>
        <p class="text-muted">Chỉnh sửa thông tin cơ bản, hồ sơ cá nhân và lương thưởng</p>
    </div>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <h5 class="fw-bold text-primary mb-3"><i class="bi bi-person-badge me-2"></i>Thông tin cơ bản</h5>
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="form-group mb-4">
                    <label class="form-label fw-semibold text-dark small mb-2" asp-for="FullName">Họ tên</label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="form-group">
                    <label class="form-label fw-semibold text-dark small mb-2" asp-for="Email">Email</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group mb-4">
                    <label class="form-label fw-semibold text-dark small mb-2" asp-for="Username">Tên đăng nhập</label>
                    <input asp-for="Username" class="form-control" readonly />
                </div>
                <div class="form-group">
                    <label class="form-label fw-semibold text-dark small mb-2" asp-for="PhoneNumber">Số điện thoại</label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>
            </div>
        </div>
        <div class="row mb-4">
            <div class="col-md-6">
                <label class="form-label fw-semibold text-dark small mb-2" asp-for="Role">Vai trò</label>
                <select asp-for="Role" class="form-select">
                    <option value="Admin">Quản trị viên</option>
                    <option value="Doctor">Bác sĩ</option>
                    <option value="Receptionist">Lễ tân</option>
                </select>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold text-dark small mb-2" asp-for="IsActive">Trạng thái</label>
                <select asp-for="IsActive" class="form-select">
                    <option value="true">Đang hoạt động</option>
                    <option value="false">Tạm khóa</option>
                </select>
            </div>
        </div>

        <hr class="text-muted my-4" />
        <h5 class="fw-bold text-primary mb-3"><i class="bi bi-file-earmark-person me-2"></i>Hồ sơ cá nhân</h5>
        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <label class="form-label fw-semibold text-dark small mb-2">Mã nhân sự</label>
                <input asp-for="StaffCode" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold text-dark small mb-2">Chức danh</label>
                <input asp-for="PositionTitle" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold text-dark small mb-2">Phòng ban</label>
                <input asp-for="Department" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold text-dark small mb-2">Giới tính</label>
                <select asp-for="Gender" class="form-select">
                    <option value="">-- Chọn --</option>
                    <option value="Nam">Nam</option>
                    <option value="Nữ">Nữ</option>
                    <option value="Khác">Khác</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold text-dark small mb-2">Ngày gia nhập</label>
                <input asp-for="JoinDate" type="date" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold text-dark small mb-2">Cơ sở chính</label>
                <input asp-for="PrimaryClinic" class="form-control" />
            </div>
            <div class="col-12">
                <label class="form-label fw-semibold text-dark small mb-2">Địa chỉ</label>
                <input asp-for="Address" class="form-control" />
            </div>
        </div>

        <hr class="text-muted my-4" />
        <h5 class="fw-bold text-primary mb-3"><i class="bi bi-cash-coin me-2"></i>Tính toán lương</h5>
        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <label class="form-label fw-semibold text-dark small mb-2">Lương cơ bản (đ)</label>
                <input asp-for="BaseSalary" type="number" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold text-dark small mb-2">Hệ số bằng cấp</label>
                <input asp-for="DegreeMultiplier" type="number" step="0.1" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold text-dark small mb-2">Tên bằng cấp xét lương</label>
                <input asp-for="DegreeTitle" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold text-dark small mb-2">Phụ cấp chuyên môn (đ)</label>
                <input asp-for="SpecializationAllowance" type="number" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold text-dark small mb-2">Phụ cấp thâm niên (đ)</label>
                <input asp-for="SeniorityAllowance" type="number" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold text-dark small mb-2">Thưởng KPI tháng (đ)</label>
                <input asp-for="MonthlyBonus" type="number" class="form-control" />
            </div>
        </div>

        <div class="d-flex justify-content-end gap-3 mt-4">
            <a href="/Staff/Details/@Model.Id" class="btn btn-light px-4 py-2 fw-semibold" style="border: 1px solid #dee2e6; color: #5b6b7a;">Hủy</a>
            <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold" style="background-color: #1b75d0; border-color: #1b75d0;">
                Lưu thay đổi
            </button>
        </div>
    </form>
</div>
