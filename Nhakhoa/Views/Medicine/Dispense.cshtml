@model List<Nhakhoa.Models.Prescription>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Xuất thuốc - Kho thuốc";
    string dateFilter = ViewBag.DateFilter ?? "today";
}

<div class="d-flex align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-0" style="color:#0b1f35">
            <i class="bi bi-box-arrow-up text-success me-2"></i>Xuất thuốc theo đơn
        </h4>
        <div class="text-muted small mt-1">Phát thuốc cho bệnh nhân theo đơn bác sĩ kê. Tồn kho tự động cập nhật sau khi xuất.</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Medicine" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 d-flex align-items-center gap-2">
            <i class="bi bi-box-seam"></i> Quản lý kho
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 rounded-4 py-2 px-4 mb-4 shadow-sm d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill fs-5 text-success"></i>
        <div class="fw-semibold">@TempData["SuccessMessage"]</div>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger border-0 rounded-4 py-2 px-4 mb-4 shadow-sm d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
        <div class="fw-semibold">@TempData["ErrorMessage"]</div>
    </div>
}

<!-- Toast notification -->
<div id="dispense-toast" class="position-fixed bottom-0 end-0 p-3" style="z-index:9999">
    <div id="dispense-toast-el" class="toast align-items-center text-white border-0 rounded-4 shadow" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body fw-semibold" id="dispense-toast-msg"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-4 d-flex align-items-center gap-3">
                <div class="rounded-4 d-grid place-items-center" style="width:54px;height:54px;flex-shrink:0;background-color:#fff7ed;">
                    <i class="bi bi-clock-history fs-3" style="color:#ea580c;"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold" style="font-size:0.75rem;letter-spacing:0.05em;">Chờ phát hôm nay</div>
                    <h3 class="fw-bold mb-0 text-dark mt-1">@ViewBag.TodayPending</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-4 d-flex align-items-center gap-3">
                <div class="rounded-4 d-grid place-items-center" style="width:54px;height:54px;flex-shrink:0;background-color:#fef2f2;">
                    <i class="bi bi-exclamation-circle fs-3" style="color:#dc2626;"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold" style="font-size:0.75rem;letter-spacing:0.05em;">Tổng chờ phát</div>
                    <h3 class="fw-bold mb-0 text-danger mt-1">@ViewBag.TotalPending</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-4 d-flex align-items-center gap-3">
                <div class="rounded-4 d-grid place-items-center" style="width:54px;height:54px;flex-shrink:0;background-color:#dcfce7;">
                    <i class="bi bi-check2-circle fs-3" style="color:#16a34a;"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold" style="font-size:0.75rem;letter-spacing:0.05em;">Đã phát hôm nay</div>
                    <h3 class="fw-bold mb-0 text-success mt-1">@ViewBag.DispensedToday</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 rounded-start-pill"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control bg-light border-start-0 rounded-end-pill"
                           placeholder="Tìm tên bệnh nhân, mã BN, bác sĩ..." />
                </div>
            </div>
            <div class="col-md-4">
                <div class="btn-group w-100" role="group">
                    <a asp-action="Dispense" asp-route-search="@ViewBag.Search" asp-route-dateFilter="today"
                       class="btn @(dateFilter == "today" ? "btn-primary" : "btn-outline-primary") rounded-start-pill">
                        Hôm nay
                    </a>
                    <a asp-action="Dispense" asp-route-search="@ViewBag.Search" asp-route-dateFilter="week"
                       class="btn @(dateFilter == "week" ? "btn-primary" : "btn-outline-primary")">
                        7 ngày
                    </a>
                    <a asp-action="Dispense" asp-route-search="@ViewBag.Search" asp-route-dateFilter="month"
                       class="btn @(dateFilter == "month" ? "btn-primary" : "btn-outline-primary") rounded-end-pill">
                        30 ngày
                    </a>
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2 justify-content-md-end">
                <button type="submit" class="btn btn-primary rounded-pill px-4" style="background:#1b75d0;border-color:#1b75d0;">Tìm kiếm</button>
                <a asp-action="Dispense" class="btn btn-outline-secondary rounded-pill px-3">Đặt lại</a>
            </div>
        </form>
    </div>
</div>

<!-- Prescriptions Table -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox display-4 opacity-25 d-block mb-3"></i>
                <div class="fw-semibold">Không có đơn thuốc nào đang chờ phát trong khoảng thời gian này.</div>
                <div class="small mt-1">Thử chọn khoảng thời gian rộng hơn hoặc xóa bộ lọc tìm kiếm.</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0" style="font-size:0.92rem;">
                    <thead style="background:#f8faff;border-bottom:2px solid #e8edf5;">
                        <tr>
                            <th class="px-4 py-3 text-muted fw-semibold">Bệnh nhân</th>
                            <th class="py-3 text-muted fw-semibold">Bác sĩ kê đơn</th>
                            <th class="py-3 text-muted fw-semibold">Thời gian kê</th>
                            <th class="py-3 text-muted fw-semibold">Số loại thuốc</th>
                            <th class="py-3 text-muted fw-semibold">Chi tiết đơn</th>
                            <th class="py-3 text-muted fw-semibold text-center pe-4" style="width:160px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rx in Model)
                        {
                            bool hasStockIssue = rx.Items.Any(i => i.Medicine == null || i.Medicine.StockQuantity < i.Quantity);

                            <tr class="border-bottom" id="rx-row-@rx.Id">
                                <td class="px-4 py-3">
                                    <div class="fw-bold text-dark">@rx.Patient?.FullName</div>
                                    <div class="text-muted small">Mã BN: @rx.Patient?.PatientCode</div>
                                </td>
                                <td>
                                    <div class="fw-semibold">@(rx.Doctor?.User?.FullName ?? "—")</div>
                                    <div class="text-muted small">@rx.Doctor?.PositionTitle</div>
                                </td>
                                <td>
                                    <div class="fw-semibold">@rx.CreatedAt.ToString("HH:mm")</div>
                                    <div class="text-muted small">@rx.CreatedAt.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td>
                                    <span class="badge rounded-pill fw-semibold px-3 py-1" style="background:#e0f2fe;color:#0369a1;">
                                        @rx.Items.Count loại
                                    </span>
                                </td>
                                <td>
                                    <button class="btn btn-outline-secondary btn-sm rounded-pill px-3"
                                            data-bs-toggle="collapse" data-bs-target="#items-@rx.Id"
                                            aria-expanded="false">
                                        <i class="bi bi-list-ul me-1"></i>Xem chi tiết
                                    </button>
                                </td>
                                <td class="text-center pe-4">
                                    @if (hasStockIssue)
                                    {
                                        <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background:#fee2e2;color:#b91c1c;">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>Hết hàng
                                        </span>
                                    }
                                    else
                                    {
                                        <button class="btn btn-success btn-sm rounded-pill px-3 fw-semibold btn-dispense"
                                                id="btn-dispense-@rx.Id"
                                                data-id="@rx.Id"
                                                data-patient="@rx.Patient?.FullName">
                                            <i class="bi bi-box-arrow-up me-1"></i>Xuất thuốc
                                        </button>
                                    }
                                </td>
                            </tr>
                            <!-- Collapsible item detail row -->
                            <tr class="collapse" id="items-@rx.Id">
                                <td colspan="6" class="px-4 pb-3 pt-0">
                                    <div class="rounded-3 p-3" style="background:#f8faff;border:1px solid #e8edf5;">
                                        <div class="fw-semibold text-muted small text-uppercase mb-2" style="letter-spacing:.05em;">
                                            <i class="bi bi-capsule me-1"></i>Chi tiết đơn thuốc #@rx.Id
                                        </div>
                                        <table class="table table-sm mb-0" style="font-size:0.88rem;">
                                            <thead>
                                                <tr class="text-muted">
                                                    <th>Tên thuốc</th>
                                                    <th>Số lượng kê</th>
                                                    <th>Tồn kho</th>
                                                    <th>Liều dùng</th>
                                                    <th>Số ngày</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in rx.Items)
                                                {
                                                    bool outOfStock = item.Medicine == null || item.Medicine.StockQuantity < item.Quantity;
                                                    <tr class="@(outOfStock ? "table-danger" : "")">
                                                        <td class="fw-semibold">
                                                            @(item.Medicine?.MedicineName ?? "Thuốc không xác định")
                                                            @if (outOfStock)
                                                            {
                                                                <span class="badge ms-1" style="background:#fee2e2;color:#b91c1c;font-size:.75rem;">Hết hàng</span>
                                                            }
                                                        </td>
                                                        <td>@item.Quantity @(item.Medicine?.Unit ?? "")</td>
                                                        <td>
                                                            <span class="fw-bold @(outOfStock ? "text-danger" : "text-success")">
                                                                @(item.Medicine?.StockQuantity.ToString() ?? "—")
                                                            </span>
                                                        </td>
                                                        <td class="text-muted">@item.Dosage</td>
                                                        <td>@item.DurationDays ngày</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    function showToast(msg, type) {
        const toastEl = document.getElementById('dispense-toast-el');
        const toastMsg = document.getElementById('dispense-toast-msg');
        toastEl.className = `toast align-items-center text-white border-0 rounded-4 shadow bg-${type}`;
        toastMsg.textContent = msg;
        const toast = new bootstrap.Toast(toastEl, { delay: 3500 });
        toast.show();
    }

    document.querySelectorAll('.btn-dispense').forEach(btn => {
        btn.addEventListener('click', async function () {
            const rxId = this.dataset.id;
            const patientName = this.dataset.patient;

            const ok = await window.showConfirmModal(
                `Xác nhận xuất thuốc cho bệnh nhân "${patientName}"?\nThao tác này sẽ trừ tồn kho ngay lập tức.`,
                { theme: 'success', title: 'Xuất thuốc', confirmLabel: 'Xuất thuốc', confirmIcon: 'bi-box-arrow-up' }
            );
            if (!ok) return;

            const original = this.innerHTML;
            this.disabled = true;
            this.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span>Đang xuất...`;

            fetch('/Patient/DispensePrescription', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ prescriptionId: parseInt(rxId) })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast(`✅ Xuất thuốc thành công cho bệnh nhân "${patientName}"! Tồn kho đã được cập nhật.`, 'success');
                    // Remove the row smoothly
                    const row = document.getElementById(`rx-row-${rxId}`);
                    const detailRow = document.getElementById(`items-${rxId}`);
                    if (row) { row.style.opacity = '0'; row.style.transition = 'opacity 0.5s'; setTimeout(() => row.remove(), 500); }
                    if (detailRow) setTimeout(() => detailRow.remove(), 500);
                    // Update stats
                    setTimeout(() => location.reload(), 2000);
                } else {
                    showToast('❌ ' + data.message, 'danger');
                    this.disabled = false;
                    this.innerHTML = original;
                }
            })
            .catch(() => {
                showToast('❌ Lỗi kết nối. Vui lòng thử lại.', 'danger');
                this.disabled = false;
                this.innerHTML = original;
            });
        });
    });
</script>
}
