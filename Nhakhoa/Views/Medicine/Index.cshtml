@model List<Nhakhoa.Models.MedicineInventory>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Kho thuốc";
}

<div class="d-flex align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-0" style="color:#0b1f35">
            <i class="bi bi-capsule-capsules text-primary me-2"></i>Quản lý kho thuốc
        </h4>
        <div class="text-muted small mt-1">Quản lý danh mục thuốc, cập nhật đơn giá và kiểm soát tồn kho thuốc thực tế.</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Medicine" asp-action="History" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold d-flex align-items-center gap-2">
            <i class="bi bi-clock-history"></i> Lịch sử kho
        </a>
        <a asp-controller="Medicine" asp-action="Dispense" class="btn btn-success rounded-pill px-4 fw-semibold d-flex align-items-center gap-2">
            <i class="bi bi-box-arrow-up"></i> Xuất thuốc
            @if (ViewBag.PendingDispenseCount != null && (int)ViewBag.PendingDispenseCount > 0)
            {
                <span class="badge bg-white text-success rounded-pill ms-1">@ViewBag.PendingDispenseCount</span>
            }
        </a>
        <a asp-controller="Medicine" asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-semibold d-flex align-items-center gap-2" style="background:#1b75d0; border-color:#1b75d0;">
            <i class="bi bi-plus-circle-fill"></i> Thêm thuốc mới
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 rounded-4 py-2.5 px-4 mb-4 shadow-sm d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill fs-5 text-success"></i>
        <div class="fw-semibold">@TempData["SuccessMessage"]</div>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger border-0 rounded-4 py-2.5 px-4 mb-4 shadow-sm d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
        <div class="fw-semibold">@TempData["ErrorMessage"]</div>
    </div>
}

<!-- Inventory Stats Dashboard -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-4 d-flex align-items-center gap-3">
                <div class="text-primary" style="font-size: 2.2rem; flex-shrink: 0; line-height: 1;">
                    <i class="bi bi-capsule"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold" style="font-size:0.75rem; letter-spacing: 0.05em;">Tổng số loại thuốc</div>
                    <h3 class="fw-bold mb-0 text-primary mt-1">@ViewBag.TotalMedicines</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-4 d-flex align-items-center gap-3">
                <div class="text-success" style="font-size: 2.2rem; flex-shrink: 0; line-height: 1;">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold" style="font-size:0.75rem; letter-spacing: 0.05em;">Tổng tồn kho</div>
                    <h3 class="fw-bold mb-0 text-success mt-1">@ViewBag.TotalStock</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-4 d-flex align-items-center gap-3">
                <div class="@(ViewBag.LowStockCount > 0 ? "text-danger" : "text-secondary")" style="font-size: 2.2rem; flex-shrink: 0; line-height: 1;">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold" style="font-size:0.75rem; letter-spacing: 0.05em;">Thuốc sắp hết hàng (tồn < 10)</div>
                    <h3 class="fw-bold mb-0 mt-1 @(ViewBag.LowStockCount > 0 ? "text-danger" : "text-dark")">@ViewBag.LowStockCount</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters & Search -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 rounded-start-pill"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control bg-light border-start-0 rounded-end-pill" placeholder="Nhập tên thuốc cần tìm..." />
                </div>
            </div>
            <div class="col-md-6 d-flex gap-2 justify-content-md-end">
                <button type="submit" class="btn btn-primary rounded-pill px-4" style="background:#1b75d0; border-color:#1b75d0;">Tìm kiếm</button>
                <a asp-controller="Medicine" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">Xóa bộ lọc</a>
            </div>
        </form>
    </div>
</div>

<!-- Medicine Grid/Table Card -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-info-circle display-4 opacity-25 d-block mb-3"></i>
                Không tìm thấy thuốc nào khớp với từ khóa tìm kiếm.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0" style="font-size:0.92rem;">
                    <thead style="background:#f8faff; border-bottom:2px solid #e8edf5;">
                        <tr>
                            <th class="px-4 py-3 text-muted fw-semibold">Tên thuốc</th>
                            <th class="py-3 text-muted fw-semibold">Đơn vị tính</th>
                            <th class="py-3 text-muted fw-semibold text-end" style="width: 150px;">Số lượng tồn</th>
                            <th class="py-3 text-muted fw-semibold text-end" style="width: 200px;">Đơn giá</th>
                            <th class="py-3 text-muted fw-semibold text-center" style="width: 150px;">Trạng thái kho</th>
                            <th class="py-3 text-muted fw-semibold pe-4 text-center" style="width: 200px;">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var med in Model)
                        {
                            <tr class="border-bottom">
                                <td class="px-4 py-3">
                                    <div class="fw-bold text-dark">@med.MedicineName</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border rounded-pill px-2.5 py-1">@med.Unit</span>
                                </td>
                                <td class="text-end fw-semibold">@med.StockQuantity</td>
                                <td class="text-end fw-bold text-primary">@med.PricePerUnit.ToString("N0") đ</td>
                                <td class="text-center">
                                    @if (med.StockQuantity >= 50)
                                    {
                                        <span class="badge rounded-pill px-2.5 py-1.5 fw-semibold" style="background-color: #dcfce7; color: #15803d;"><i class="bi bi-shield-check me-1"></i>Đủ hàng</span>
                                    }
                                    else if (med.StockQuantity >= 10)
                                    {
                                        <span class="badge rounded-pill px-2.5 py-1.5 fw-semibold" style="background-color: #fef9c3; color: #a16207;"><i class="bi bi-exclamation-circle me-1"></i>Bình thường</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill px-2.5 py-1.5 fw-semibold" style="background-color: #fee2e2; color: #b91c1c;"><i class="bi bi-exclamation-triangle-fill me-1"></i>Sắp hết</span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <div class="d-flex gap-2 justify-content-center">
                                        <a asp-controller="Medicine" asp-action="Edit" asp-route-id="@med.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3" title="Chỉnh sửa thông tin thuốc">
                                            <i class="bi bi-pencil"></i> Sửa
                                        </a>
                                        <form asp-controller="Medicine" asp-action="Delete" asp-route-id="@med.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Bạn có chắc chắn muốn xóa thuốc @med.MedicineName ra khỏi danh mục kho?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3" title="Xóa thuốc khỏi kho">
                                                <i class="bi bi-trash"></i> Xóa
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
