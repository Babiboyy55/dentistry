@model List<Nhakhoa.Models.MedicineTransaction>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Lịch sử nhập/xuất kho";
    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int total = ViewBag.Total ?? 0;
    var medicines = ViewBag.Medicines as List<Nhakhoa.Models.MedicineInventory> ?? new();
}

<div class="d-flex align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-0" style="color:#0b1f35">
            <i class="bi bi-clock-history text-primary me-2"></i>Lịch sử nhập/xuất kho
        </h4>
        <div class="text-muted small mt-1">Theo dõi toàn bộ hoạt động nhập và xuất thuốc trong kho.</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Medicine" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 d-flex align-items-center gap-2">
            <i class="bi bi-box-seam"></i> Quản lý kho
        </a>
        <a asp-controller="Medicine" asp-action="Dispense" class="btn btn-success rounded-pill px-4 d-flex align-items-center gap-2">
            <i class="bi bi-box-arrow-up"></i> Xuất thuốc
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 rounded-4 py-2 px-4 mb-4 shadow-sm d-flex align-items-center gap-2">
        <i class="bi bi-check-circle-fill fs-5 text-success"></i>
        <div class="fw-semibold">@TempData["SuccessMessage"]</div>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger border-0 rounded-4 py-2 px-4 mb-4 shadow-sm d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
        <div class="fw-semibold">@TempData["ErrorMessage"]</div>
    </div>
}

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="card-body p-4 d-flex align-items-center gap-3">
                <div class="text-success" style="font-size: 2.2rem; flex-shrink: 0; line-height: 1;">
                    <i class="bi bi-arrow-down-circle"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold" style="font-size:.72rem;letter-spacing:.05em;">Tổng nhập kho</div>
                    <h3 class="fw-bold mb-0 text-success mt-1">+@ViewBag.TotalIn</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="card-body p-4 d-flex align-items-center gap-3">
                <div class="text-danger" style="font-size: 2.2rem; flex-shrink: 0; line-height: 1;">
                    <i class="bi bi-arrow-up-circle"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold" style="font-size:.72rem;letter-spacing:.05em;">Tổng xuất kho</div>
                    <h3 class="fw-bold mb-0 text-danger mt-1">-@ViewBag.TotalOut</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="card-body p-4 d-flex align-items-center gap-3">
                <div class="text-warning" style="font-size: 2.2rem; flex-shrink: 0; line-height: 1;">
                    <i class="bi bi-sliders"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold" style="font-size:.72rem;letter-spacing:.05em;">Điều chỉnh</div>
                    <h3 class="fw-bold mb-0 text-warning mt-1">@ViewBag.TotalAdjust</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="card-body p-4 d-flex align-items-center gap-3">
                <div class="text-primary" style="font-size: 2.2rem; flex-shrink: 0; line-height: 1;">
                    <i class="bi bi-calendar4-event"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold" style="font-size:.72rem;letter-spacing:.05em;">GD hôm nay</div>
                    <h3 class="fw-bold mb-0 text-primary mt-1">@ViewBag.TodayTransactions</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Nhập kho nhanh -->
<div class="card border-0 shadow-sm rounded-4 mb-4" style="border-left:4px solid #16a34a !important;">
    <div class="card-body p-4">
        <div class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
            <i class="bi bi-plus-circle-fill text-success fs-5"></i>
            Nhập kho nhanh
        </div>
        <form asp-action="StockIn" method="post" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-4">
                <label class="form-label fw-semibold small text-muted text-uppercase" style="font-size:.75rem;letter-spacing:.05em;">Chọn thuốc</label>
                <select name="medicineId" class="form-select rounded-pill" required id="stockin-medicine">
                    <option value="">— Chọn thuốc cần nhập —</option>
                    @foreach (var m in medicines)
                    {
                        <option value="@m.Id">@m.MedicineName (@m.StockQuantity @m.Unit)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold small text-muted text-uppercase" style="font-size:.75rem;letter-spacing:.05em;">Số lượng nhập</label>
                <input type="number" name="quantity" min="1" class="form-control rounded-pill" placeholder="VD: 100" required id="stockin-qty" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold small text-muted text-uppercase" style="font-size:.75rem;letter-spacing:.05em;">Lý do / Ghi chú</label>
                <input type="text" name="note" class="form-control rounded-pill" placeholder="VD: Nhập hàng tháng 6, Mua bổ sung..." id="stockin-note" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-success rounded-pill px-4 w-100 fw-semibold">
                    <i class="bi bi-arrow-down-circle-fill me-1"></i>Nhập kho
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-md-3">
                <select name="medicineId" class="form-select rounded-pill">
                    <option value="">Tất cả thuốc</option>
                    @foreach (var m in medicines)
                    {
                        <option value="@m.Id" selected="@(ViewBag.SelectedMedicine?.ToString() == m.Id.ToString() ? "selected" : null)">
                            @m.MedicineName
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="type" class="form-select rounded-pill">
                    <option value="">Tất cả loại GD</option>
                    @foreach (var t in new[] { "Nhập kho", "Xuất kho", "Điều chỉnh" })
                    {
                        <option value="@t" selected="@(ViewBag.Type == t ? "selected" : null)">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <input type="date" name="dateFrom" value="@ViewBag.DateFrom" class="form-control rounded-pill" placeholder="Từ ngày" />
            </div>
            <div class="col-md-2">
                <input type="date" name="dateTo" value="@ViewBag.DateTo" class="form-control rounded-pill" placeholder="Đến ngày" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill px-4 flex-grow-1" style="background:#1b75d0;border-color:#1b75d0;">
                    <i class="bi bi-funnel-fill me-1"></i>Lọc
                </button>
                <a asp-action="History" class="btn btn-outline-secondary rounded-pill px-3">Đặt lại</a>
            </div>
        </form>
    </div>
</div>

<!-- Transaction Table -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-bottom px-4 py-3 d-flex align-items-center justify-content-between rounded-top-4">
        <span class="fw-semibold text-dark">Danh sách giao dịch</span>
        <span class="badge bg-light text-muted border rounded-pill">@total bản ghi</span>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox display-4 opacity-25 d-block mb-3"></i>
                <div class="fw-semibold">Chưa có lịch sử giao dịch nào.</div>
                <div class="small mt-1">Các giao dịch nhập/xuất kho sẽ được ghi tự động tại đây.</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0" style="font-size:.9rem;">
                    <thead style="background:#f8faff;border-bottom:2px solid #e8edf5;">
                        <tr>
                            <th class="px-4 py-3 text-muted fw-semibold" style="width:160px;">Thời gian</th>
                            <th class="py-3 text-muted fw-semibold">Tên thuốc</th>
                            <th class="py-3 text-muted fw-semibold text-center" style="width:130px;">Loại GD</th>
                            <th class="py-3 text-muted fw-semibold text-center" style="width:90px;">Số lượng</th>
                            <th class="py-3 text-muted fw-semibold text-center" style="width:90px;">Trước</th>
                            <th class="py-3 text-muted fw-semibold text-center" style="width:90px;">Sau</th>
                            <th class="py-3 text-muted fw-semibold">Ghi chú</th>
                            <th class="py-3 text-muted fw-semibold pe-4" style="width:130px;">Người thực hiện</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tx in Model)
                        {
                            bool isIn = tx.TransactionType == "Nhập kho";
                            bool isOut = tx.TransactionType == "Xuất kho";

                            <tr class="border-bottom">
                                <td class="px-4 py-3">
                                    <div class="fw-semibold text-dark">@tx.CreatedAt.ToString("HH:mm")</div>
                                    <div class="text-muted small">@tx.CreatedAt.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@tx.Medicine?.MedicineName</div>
                                    <div class="text-muted small">Tồn hiện tại: <strong>@tx.Medicine?.StockQuantity</strong> @tx.Medicine?.Unit</div>
                                </td>
                                <td class="text-center">
                                    @if (isIn)
                                    {
                                        <span class="badge rounded-pill fw-semibold px-3 py-1" style="background:#dcfce7;color:#15803d;">
                                            <i class="bi bi-arrow-down-circle-fill me-1"></i>Nhập kho
                                        </span>
                                    }
                                    else if (isOut)
                                    {
                                        <span class="badge rounded-pill fw-semibold px-3 py-1" style="background:#fee2e2;color:#b91c1c;">
                                            <i class="bi bi-arrow-up-circle-fill me-1"></i>Xuất kho
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill fw-semibold px-3 py-1" style="background:#fef3c7;color:#92400e;">
                                            <i class="bi bi-sliders me-1"></i>Điều chỉnh
                                        </span>
                                    }
                                </td>
                                <td class="text-center fw-bold @(isIn ? "text-success" : isOut ? "text-danger" : "text-warning")">
                                    @(isIn ? "+" : isOut ? "-" : "±")@tx.Quantity
                                </td>
                                <td class="text-center text-muted fw-semibold">@tx.StockBefore</td>
                                <td class="text-center fw-bold text-dark">@tx.StockAfter</td>
                                <td>
                                    <div class="text-muted small">@(tx.Note ?? "—")</div>
                                    @if (tx.PrescriptionId.HasValue)
                                    {
                                        <a href="/Patient/ClinicalRecord?prescriptionId=@tx.PrescriptionId" class="badge bg-light border text-muted rounded-pill mt-1 text-decoration-none" style="font-size:.75rem;">
                                            <i class="bi bi-file-medical me-1"></i>Đơn #@tx.PrescriptionId
                                        </a>
                                    }
                                </td>
                                <td class="pe-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary-subtle d-grid place-items-center" style="width:28px;height:28px;flex-shrink:0;">
                                            <i class="bi bi-person-fill text-primary" style="font-size:.75rem;"></i>
                                        </div>
                                        <span class="text-dark small fw-semibold">@(tx.CreatedBy ?? "—")</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="d-flex justify-content-center py-3 gap-2">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <a href="?medicineId=@ViewBag.SelectedMedicine&type=@ViewBag.Type&dateFrom=@ViewBag.DateFrom&dateTo=@ViewBag.DateTo&page=@i"
                           class="btn btn-sm @(i == page ? "btn-primary" : "btn-outline-secondary") rounded-pill px-3">@i</a>
                    }
                </div>
            }
        }
    </div>
</div>
