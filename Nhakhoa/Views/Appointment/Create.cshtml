@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Đặt lịch hẹn mới";
    var selectedPatient = ViewBag.SelectedPatient as Nhakhoa.Models.Patient;
    var doctors = ViewBag.Doctors as List<Nhakhoa.Models.StaffProfile> ?? new();
    var clinics = ViewBag.Clinics as List<Nhakhoa.Models.Clinic> ?? new();
    var specialties = ViewBag.Specialties as List<Nhakhoa.Models.Specialty> ?? new();
}

<div class="mb-4">
    <a href="/Appointment" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
    <h4 class="fw-bold mt-2" style="color:#0b1f35">Đặt lịch hẹn mới</h4>
    <div class="text-muted small">Lên lịch khám, chọn bác sĩ và khung giờ phù hợp cho bệnh nhân.</div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger border-0 rounded-4 py-2 px-3 mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        Vui lòng sửa các lỗi bên dưới hoặc chọn một khung giờ khác.
    </div>
}

<form method="post" id="appointmentForm">
    @Html.AntiForgeryToken()
    <div class="row g-4">
        <!-- Form main -->
        <div class="col-lg-8">
            <!-- Bước 1: Chọn bệnh nhân -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 p-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge bg-primary rounded-circle d-inline-flex align-items-center justify-content-center" style="width:24px; height:24px;">1</span>
                    <h5 class="fw-bold text-dark mb-0">Hồ sơ bệnh nhân</h5>
                </div>
                
                @if (selectedPatient != null)
                {
                    <input type="hidden" name="PatientId" value="@selectedPatient.Id" />
                    <div class="p-3 rounded-4 d-flex align-items-center justify-content-between" style="background:#e8f4fd; border: 1px solid #b3d7f7;">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-primary text-white rounded-circle d-grid place-items-center" style="width:42px; height:42px;">
                                <i class="bi bi-person-check-fill fs-5"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold text-primary mb-0">@selectedPatient.FullName</h6>
                                <span class="text-muted small">SĐT: @selectedPatient.PhoneNumber &middot; Mã HS: @selectedPatient.PatientCode</span>
                            </div>
                        </div>
                        <a href="/Appointment/Create" class="btn btn-sm btn-outline-primary rounded-pill px-3">Đổi bệnh nhân</a>
                    </div>
                }
                else
                {
                    <input type="hidden" name="PatientId" id="selectedPatientId" />
                    <div class="position-relative">
                        <div class="input-group mb-2">
                            <span class="input-group-text bg-light border-end-0 rounded-start-3">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" id="patientSearch" class="form-control bg-light border-start-0 rounded-end-3" placeholder="Tìm theo tên, số điện thoại hoặc mã hồ sơ..." />
                        </div>
                        <div id="patientSearchResults" class="list-group position-absolute w-100 shadow-sm rounded-3 mt-1 bg-white border" style="z-index: 100; max-height:250px; overflow-y:auto;"></div>
                    </div>
                    
                    <div id="selectedPatientDisplay" class="p-3 rounded-4 align-items-center justify-content-between mt-3" style="display:none; background:#e8f4fd; border: 1px solid #b3d7f7;">
                        <!-- JS injected content -->
                    </div>
                    <div class="mt-2 small text-muted">
                        Bệnh nhân mới? <a href="/Patient/Create" target="_blank" class="text-primary fw-semibold text-decoration-none"><i class="bi bi-person-plus"></i> Tạo hồ sơ ngay</a>
                    </div>
                }
            </div>

            <!-- Bước 2: Lịch bác sĩ theo ngày -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 p-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge bg-primary rounded-circle d-inline-flex align-items-center justify-content-center" style="width:24px; height:24px;">2</span>
                    <h5 class="fw-bold text-dark mb-0">Lịch bác sĩ theo ngày</h5>
                </div>
                <div class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-secondary small">Chọn ngày</label>
                        <input type="date" id="doctorDate" class="form-control rounded-3" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-12">
                        <div id="doctorDayList" class="row g-2">
                            <div class="col-12 text-muted small">Chọn ngày để xem bác sĩ đang có ca trực.</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bước 3: Chọn bác sĩ & dịch vụ -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 p-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge bg-primary rounded-circle d-inline-flex align-items-center justify-content-center" style="width:24px; height:24px;">3</span>
                    <h5 class="fw-bold text-dark mb-0">Bác sĩ & Dịch vụ</h5>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-secondary small">Bác sĩ điều trị <span class="text-danger">*</span></label>
                        <select name="StaffProfileId" id="doctorSelect" class="form-select rounded-3" required>
                            <option value="">-- Chọn bác sĩ --</option>
                            @foreach (var doc in doctors)
                            {
                                <option value="@doc.Id">@doc.User?.FullName (@doc.PositionTitle)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-secondary small">Chuyên khoa</label>
                        <select name="SpecialtyId" class="form-select rounded-3">
                            <option value="">-- Không chọn --</option>
                            @foreach (var sp in specialties)
                            {
                                <option value="@sp.Id">@sp.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-semibold text-secondary small">Phòng khám</label>
                        <select name="ClinicId" class="form-select rounded-3">
                            <option value="">-- Chưa phân công --</option>
                            @foreach (var c in clinics)
                            {
                                <option value="@c.Id">@c.Name (@c.Location)</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- Bước 4: Chọn ngày giờ -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 p-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge bg-primary rounded-circle d-inline-flex align-items-center justify-content-center" style="width:24px; height:24px;">4</span>
                    <h5 class="fw-bold text-dark mb-0">Ngày khám & Giờ hẹn</h5>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-secondary small">Ngày khám <span class="text-danger">*</span></label>
                        <input type="date" name="AppointmentDate" id="apptDate" class="form-control rounded-3" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-secondary small">Ca làm việc <span class="text-danger">*</span></label>
                        <select name="Session" id="sessionSelect" class="form-select rounded-3" required>
                            <option value="">-- Chọn bác sĩ & ngày khám trước --</option>
                        </select>
                    </div>
                </div>

                <div class="mt-4">
                    <label class="form-label fw-semibold text-secondary small mb-2">Khung giờ hẹn <span class="text-danger">*</span></label>
                    <input type="hidden" name="TimeSlot" id="timeSlotInput" required />
                    <div id="timeSlotsGrid" class="row g-2">
                        <!-- Clickable grid elements will be loaded here via JS -->
                        <div class="col-12 text-muted small">Vui lòng chọn ngày khám và ca trực để hiển thị các khung giờ trống.</div>
                    </div>
                    <div id="slotStatus" class="mt-3"></div>
                </div>
            </div>

            <!-- Bước 5: Ghi chú thêm -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 p-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="badge bg-primary rounded-circle d-inline-flex align-items-center justify-content-center" style="width:24px; height:24px;">5</span>
                    <h5 class="fw-bold text-dark mb-0">Ghi chú & Yêu cầu thêm</h5>
                </div>
                <textarea name="Notes" class="form-control rounded-3" rows="3" placeholder="Ví dụ: Đau răng cấp tính, kiểm tra định kỳ, yêu cầu đặc biệt..."></textarea>
            </div>

            <!-- Buttons -->
            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <a href="/Appointment" class="btn btn-outline-secondary rounded-pill px-4">Hủy bỏ</a>
                <button type="submit" class="btn btn-primary rounded-pill px-5" style="background:#1b75d0; border-color:#1b75d0;">
                    <i class="bi bi-check2-circle me-1"></i> Xác nhận đặt lịch
                </button>
            </div>
        </div>

        <!-- Sidebar guides -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="background:#f8fbff; border: 1px solid #e2effe;">
                <h6 class="fw-bold text-primary mb-3"><i class="bi bi-info-circle-fill me-2"></i>Quy tắc đặt lịch</h6>
                <ul class="small text-secondary ps-3 d-flex flex-column gap-2 mb-0">
                    <li>Chỉ được phép đặt lịch hẹn vào các ngày bác sĩ có đăng ký ca trực hoạt động.</li>
                    <li>Hệ thống tự động loại trừ các ngày lễ chính thức trong năm.</li>
                    <li>Mỗi khung giờ chỉ cho phép tối đa 1 lịch hẹn hoạt động đối với mỗi bác sĩ để tránh chồng chéo ca khám.</li>
                </ul>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4" style="background:#fffcf6; border: 1px solid #fef3d6;">
                <h6 class="fw-bold text-warning-emphasis mb-3"><i class="bi bi-bell-fill me-2"></i>Thông báo tự động</h6>
                <p class="small text-secondary mb-0">Sau khi xác nhận thành công, hệ thống sẽ gửi tin nhắn SMS & Email tự động thông báo thông tin chi tiết phòng khám, bác sĩ điều trị và khung giờ tới bệnh nhân.</p>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script>
    let timer;
    const pInput = document.getElementById('patientSearch');
    if (pInput) {
        pInput.addEventListener('input', function () {
            clearTimeout(timer);
            timer = setTimeout(async () => {
                const q = this.value.trim();
                if (!q) return;
                const res = await fetch(`/Patient/Search?q=${encodeURIComponent(q)}`);
                const data = await res.json();
                const container = document.getElementById('patientSearchResults');
                container.innerHTML = '';
                if (!data.length) { 
                    container.innerHTML = '<div class="list-group-item text-muted small">Không tìm thấy bệnh nhân. <a href="/Patient/Create" target="_blank">Tạo mới</a></div>'; 
                    return; 
                }
                data.forEach(p => {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'list-group-item list-group-item-action border-0 py-2';
                    btn.innerHTML = `<div class="d-flex justify-content-between align-items-center">
                        <div>
                            <strong class="text-dark">${p.fullName}</strong>
                            <div class="text-muted small">${p.phoneNumber}</div>
                        </div>
                        <span class="badge bg-primary-subtle text-primary rounded-pill">${p.patientCode}</span>
                    </div>`;
                    btn.onclick = () => {
                        document.getElementById('selectedPatientId').value = p.id;
                        document.getElementById('selectedPatientDisplay').innerHTML = `
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-primary text-white rounded-circle d-grid place-items-center" style="width:42px; height:42px;">
                                    <i class="bi bi-person-check-fill fs-5"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold text-primary mb-0">${p.fullName}</h6>
                                    <span class="text-muted small">SĐT: ${p.phoneNumber} &middot; Mã HS: ${p.patientCode}</span>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="resetPt()">Đổi</button>
                        `;
                        document.getElementById('selectedPatientDisplay').className = 'p-3 rounded-4 d-flex align-items-center justify-content-between mt-3';
                        document.getElementById('selectedPatientDisplay').style.display = 'flex';
                        container.innerHTML = '';
                        pInput.value = p.fullName;
                        pInput.style.display = 'none';
                    };
                    container.appendChild(btn);
                });
            }, 300);
        });
    }

    function resetPt() {
        document.getElementById('selectedPatientId').value = '';
        document.getElementById('selectedPatientDisplay').style.display = 'none';
        pInput.value = '';
        pInput.style.display = 'block';
        pInput.focus();
    }

    async function loadDoctorShifts() {
        const dr = document.getElementById('doctorSelect')?.value;
        const dt = document.getElementById('apptDate')?.value;
        const ss = document.getElementById('sessionSelect');
        const grid = document.getElementById('timeSlotsGrid');
        const st = document.getElementById('slotStatus');

        if (!dr || !dt) return;

        ss.innerHTML = '<option value="">Đang kiểm tra ca trực...</option>';
        grid.innerHTML = '<div class="col-12 text-muted small">Vui lòng chọn ca trực.</div>';
        st.innerHTML = '';

        const res = await fetch(`/Appointment/GetDoctorShifts?staffProfileId=${dr}&date=${dt}`);
        const shifts = await res.json();

        if (!shifts.length) {
            ss.innerHTML = '<option value="">Bác sĩ không có ca trực</option>';
            st.innerHTML = '<div class="alert alert-danger border-0 rounded-3 py-2 small"><i class="bi bi-x-circle-fill me-2"></i>Bác sĩ không có ca trực nào trong ngày đã chọn. Vui lòng chọn ngày khác.</div>';
        } else {
            ss.innerHTML = '<option value="">-- Chọn ca trực --</option>' +
                shifts.map(s => `<option value="${s}">${s}</option>`).join('');
            st.innerHTML = '<div class="alert alert-success border-0 rounded-3 py-2 small"><i class="bi bi-check-circle-fill me-2"></i>Bác sĩ có ca trực phù hợp. Hãy chọn ca khám dưới đây.</div>';
        }
    }

    async function loadSlots() {
        const dr = document.getElementById('doctorSelect')?.value;
        const dt = document.getElementById('apptDate')?.value;
        const ss = document.getElementById('sessionSelect')?.value;
        const grid = document.getElementById('timeSlotsGrid');
        const st = document.getElementById('slotStatus');
        const timeSlotInput = document.getElementById('timeSlotInput');

        if (!dr || !dt || !ss) return;

        grid.innerHTML = '<div class="col-12 text-muted small">Đang tải các khung giờ trống...</div>';
        timeSlotInput.value = '';

        const res = await fetch(`/Appointment/AvailableSlots?staffProfileId=${dr}&date=${dt}&session=${encodeURIComponent(ss)}`);
        const slots = await res.json();

        grid.innerHTML = '';
        if (!slots.length) {
            grid.innerHTML = '<div class="col-12 text-danger small">Hết khung giờ trống trong ca trực này. Vui lòng chọn ca trực hoặc bác sĩ khác.</div>';
            st.innerHTML = '';
        } else {
            slots.forEach(s => {
                const col = document.createElement('div');
                col.className = 'col-6 col-sm-4 col-md-3';
                col.innerHTML = `<button type="button" class="btn btn-outline-primary w-100 rounded-3 py-2 small text-nowrap slot-btn">${s}</button>`;
                
                const btn = col.querySelector('.slot-btn');
                btn.onclick = () => {
                    document.querySelectorAll('.slot-btn').forEach(b => b.classList.remove('active', 'btn-primary'));
                    document.querySelectorAll('.slot-btn').forEach(b => b.classList.add('btn-outline-primary'));
                    
                    btn.classList.remove('btn-outline-primary');
                    btn.classList.add('active', 'btn-primary');
                    
                    timeSlotInput.value = s;
                };
                grid.appendChild(col);
            });
            st.innerHTML = `<div class="text-success small"><i class="bi bi-clock-history me-1"></i>Còn lại ${slots.length} khung giờ trống.</div>`;
        }
    }

    document.getElementById('doctorSelect')?.addEventListener('change', loadDoctorShifts);
    document.getElementById('apptDate')?.addEventListener('change', () => {
        const doctorDate = document.getElementById('doctorDate');
        if (doctorDate && doctorDate.value !== document.getElementById('apptDate').value) {
            doctorDate.value = document.getElementById('apptDate').value;
        }
        loadDoctorShifts();
        loadDoctorsOnDate();
    });
    document.getElementById('sessionSelect')?.addEventListener('change', loadSlots);

    async function loadDoctorsOnDate() {
        const doctorDate = document.getElementById('doctorDate');
        const list = document.getElementById('doctorDayList');
        const dt = doctorDate?.value || document.getElementById('apptDate')?.value;
        if (!list || !dt) return;

        list.innerHTML = '<div class="col-12 text-muted small">Đang tải danh sách bác sĩ...</div>';
        const res = await fetch(`/Appointment/DoctorsOnDate?date=${encodeURIComponent(dt)}`);
        const data = await res.json();

        if (!data.length) {
            list.innerHTML = '<div class="col-12 text-danger small">Không có bác sĩ có ca trực trong ngày này.</div>';
            return;
        }

        list.innerHTML = '';
        data.forEach(d => {
            const shifts = (d.shifts || []).join(', ');
            const clinics = (d.clinics || []).join(', ');
            const col = document.createElement('div');
            col.className = 'col-12 col-md-6';
            col.innerHTML = `
                <div class="border rounded-4 p-3 h-100 d-flex flex-column gap-2" style="background:#f8fbff; border-color:#e2effe;">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="fw-semibold text-dark">${d.fullName}</div>
                            <div class="small text-muted">${d.positionTitle || ''}</div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3">Chọn</button>
                    </div>
                    <div class="small text-secondary">Ca trực: <span class="text-dark">${shifts || 'Chưa rõ'}</span></div>
                    <div class="small text-secondary">Phòng khám: <span class="text-dark">${clinics || 'Chưa phân công'}</span></div>
                </div>
            `;

            const btn = col.querySelector('button');
            btn.onclick = () => {
                const doctorSelect = document.getElementById('doctorSelect');
                const apptDate = document.getElementById('apptDate');
                if (doctorSelect) doctorSelect.value = d.staffProfileId;
                if (apptDate && doctorDate && apptDate.value !== doctorDate.value) {
                    apptDate.value = doctorDate.value;
                }
                loadDoctorShifts();
            };

            list.appendChild(col);
        });
    }

    document.getElementById('doctorDate')?.addEventListener('change', () => {
        const apptDate = document.getElementById('apptDate');
        const doctorDate = document.getElementById('doctorDate');
        if (apptDate && doctorDate && apptDate.value !== doctorDate.value) {
            apptDate.value = doctorDate.value;
        }
        loadDoctorsOnDate();
        loadDoctorShifts();
    });

    loadDoctorsOnDate();
</script>
}
