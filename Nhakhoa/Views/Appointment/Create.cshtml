@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Đặt lịch hẹn mới";
    var selectedPatient = ViewBag.SelectedPatient as Nhakhoa.Models.Patient;
    var doctors = ViewBag.Doctors as List<Nhakhoa.Models.StaffProfile> ?? new();
    var clinics = ViewBag.Clinics as List<Nhakhoa.Models.Clinic> ?? new();
    var specialties = ViewBag.Specialties as List<Nhakhoa.Models.Specialty> ?? new();
}
<div class="d-flex align-items-center gap-3 mb-4">
    <a href="/Appointment" class="btn btn-outline-secondary btn-sm rounded-pill px-3"><i class="bi bi-arrow-left"></i> Quay lại</a>
    <div>
        <h4 class="fw-bold mb-0" style="color:#0b1f35"><i class="bi bi-calendar-plus text-primary me-2"></i>Đặt lịch hẹn mới</h4>
    </div>
</div>
<div class="row g-4">
    <div class="col-lg-8">
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-danger border-0 rounded-4 py-2 mb-3"></div>
            <!-- Patient -->
            <div class="card border-0 shadow-sm rounded-4 mb-3 p-4">
                <h6 class="fw-bold mb-3">Bước 1 — Bệnh nhân</h6>
                @if (selectedPatient != null)
                {
                    <input type="hidden" name="PatientId" value="@selectedPatient.Id" />
                    <div class="alert alert-success border-0 rounded-3 py-2">
                        <strong>@selectedPatient.FullName</strong> &mdash; @selectedPatient.PhoneNumber &middot; @selectedPatient.PatientCode
                        <a href="/Appointment/Create" class="btn btn-sm btn-outline-secondary rounded-pill ms-3">Đổi</a>
                    </div>
                }
                else
                {
                    <input type="hidden" name="PatientId" id="selectedPatientId" />
                    <input type="text" id="patientSearch" class="form-control rounded-3 mb-2" placeholder="Tìm tên, SĐT hoặc mã bệnh nhân..." />
                    <div id="patientSearchResults"></div>
                    <div id="selectedPatientDisplay" class="alert alert-success border-0 rounded-3 py-2" style="display:none;"></div>
                    <a href="/Patient/Create" target="_blank" class="small text-primary"><i class="bi bi-plus-circle me-1"></i>Thêm bệnh nhân mới</a>
                }
            </div>
            <!-- Doctor -->
            <div class="card border-0 shadow-sm rounded-4 mb-3 p-4">
                <h6 class="fw-bold mb-3">Bước 2 — Bác sĩ & Phòng</h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Bác sĩ <span class="text-danger">*</span></label>
                        <select name="StaffProfileId" id="doctorSelect" class="form-select rounded-3" required>
                            <option value="">-- Chọn bác sĩ --</option>
                            @foreach (var doc in doctors)
                            {
                                <option value="@doc.Id">@doc.User?.FullName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Phòng khám</label>
                        <select name="ClinicId" class="form-select rounded-3">
                            <option value="">-- Chưa phân công --</option>
                            @foreach (var c in clinics) { <option value="@c.Id">@c.Name</option> }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Chuyên khoa</label>
                        <select name="SpecialtyId" class="form-select rounded-3">
                            <option value="">-- Không chọn --</option>
                            @foreach (var sp in specialties) { <option value="@sp.Id">@sp.Name</option> }
                        </select>
                    </div>
                </div>
            </div>
            <!-- Date & Time -->
            <div class="card border-0 shadow-sm rounded-4 mb-3 p-4">
                <h6 class="fw-bold mb-3">Bước 3 — Ngày & Giờ hẹn</h6>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Ngày khám <span class="text-danger">*</span></label>
                        <input type="date" name="AppointmentDate" id="apptDate" class="form-control rounded-3"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Ca trực <span class="text-danger">*</span></label>
                        <select name="Session" id="sessionSelect" class="form-select rounded-3" required>
                            <option value="">-- Chọn bác sĩ & ngày --</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Giờ hẹn <span class="text-danger">*</span></label>
                        <select name="TimeSlot" id="timeSlotSelect" class="form-select rounded-3" required>
                            <option value="">-- Chọn ngày trước --</option>
                        </select>
                    </div>
                </div>
                <div id="slotStatus" class="text-muted small mt-2"></div>
            </div>
            <div class="card border-0 shadow-sm rounded-4 mb-3 p-4">
                <h6 class="fw-bold mb-3">Ghi chú</h6>
                <textarea name="Notes" class="form-control rounded-3" rows="2" placeholder="Lý do khám, yêu cầu đặc biệt..."></textarea>
            </div>
            <div class="d-flex gap-3">
                <button type="submit" class="btn btn-primary fw-semibold rounded-pill px-5 py-2" style="background:#1b75d0;border-color:#1b75d0;">
                    <i class="bi bi-calendar-check me-2"></i>Xác nhận đặt lịch
                </button>
                <a href="/Appointment" class="btn btn-light rounded-pill px-4 py-2 border">Hủy</a>
            </div>
        </form>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4" style="background:#f8fbff;">
            <h6 class="fw-bold text-primary mb-3"><i class="bi bi-info-circle me-2"></i>Lưu ý</h6>
            <ul class="small text-secondary ps-3 d-flex flex-column gap-2 mb-0">
                <li>Chỉ đặt vào giờ bác sĩ <strong>có ca trực</strong>.</li>
                <li>Không đặt vào <strong>ngày nghỉ lễ</strong>.</li>
                <li>Mỗi slot giờ: <strong>1 lịch/bác sĩ</strong>.</li>
            </ul>
        </div>
    </div>
</div>
@section Scripts {
<script>
    let timer;
    const pInput = document.getElementById('patientSearch');
    if (pInput) {
        pInput.addEventListener('input', function () {
            clearTimeout(timer);
            timer = setTimeout(async () => {
                const q = this.value.trim();
                if (!q) return;
                const res = await fetch(`/Patient/Search?q=${encodeURIComponent(q)}`);
                const data = await res.json();
                const container = document.getElementById('patientSearchResults');
                if (!data.length) { container.innerHTML = '<div class="text-muted small">Không tìm thấy. <a href="/Patient/Create" target="_blank">Tạo mới</a></div>'; return; }
                container.innerHTML = data.map(p =>
                    `<div class="border rounded-3 p-2 mb-1" style="cursor:pointer;" onclick="selectPt(this)"
                          data-id="${p.id}" data-name="${p.fullName}" data-phone="${p.phoneNumber}" data-code="${p.patientCode}">
                        <span class="fw-semibold">${p.fullName}</span> <span class="text-muted ms-2">${p.phoneNumber}</span>
                        <span class="badge bg-light text-dark ms-1">${p.patientCode}</span>
                     </div>`).join('');
            }, 300);
        });
    }
    function selectPt(el) {
        document.getElementById('selectedPatientId').value = el.dataset.id;
        document.getElementById('selectedPatientDisplay').innerHTML =
            `<i class="bi bi-person-check-fill me-2"></i><strong>${el.dataset.name}</strong> &mdash; ${el.dataset.phone}`;
        document.getElementById('selectedPatientDisplay').style.display = 'block';
        document.getElementById('patientSearchResults').innerHTML = '';
        pInput.value = el.dataset.name;
    }
    async function loadDoctorShifts() {
        const dr = document.getElementById('doctorSelect')?.value;
        const dt = document.getElementById('apptDate')?.value;
        const ss = document.getElementById('sessionSelect');
        const sl = document.getElementById('timeSlotSelect');
        const st = document.getElementById('slotStatus');

        if (!dr || !dt) return;

        ss.innerHTML = '<option value="">Đang kiểm tra ca trực...</option>';
        sl.innerHTML = '<option value="">-- Chọn ca trước --</option>';
        st.textContent = '';

        const res = await fetch(`/Appointment/GetDoctorShifts?staffProfileId=${dr}&date=${dt}`);
        const shifts = await res.json();

        if (!shifts.length) {
            ss.innerHTML = '<option value="">Bác sĩ không có ca trực</option>';
            st.textContent = '⚠ Bác sĩ không có lịch trực vào ngày này.';
            st.className = 'text-danger small mt-2';
        } else {
            ss.innerHTML = '<option value="">-- Chọn ca trực --</option>' +
                shifts.map(s => `<option value="${s}">${s}</option>`).join('');
            st.textContent = `✓ Tìm thấy ${shifts.length} ca trực của bác sĩ`;
            st.className = 'text-success small mt-2';
        }
    }

    async function loadSlots() {
        const dr = document.getElementById('doctorSelect')?.value;
        const dt = document.getElementById('apptDate')?.value;
        const ss = document.getElementById('sessionSelect')?.value;
        const sl = document.getElementById('timeSlotSelect');
        const st = document.getElementById('slotStatus');

        if (!dr || !dt || !ss) return;

        sl.innerHTML = '<option>Đang tải giờ trống...</option>';
        const res = await fetch(`/Appointment/AvailableSlots?staffProfileId=${dr}&date=${dt}&session=${encodeURIComponent(ss)}`);
        const slots = await res.json();

        if (!slots.length) {
            sl.innerHTML = '<option value="">Không có giờ trống</option>';
            st.textContent = '⚠ Hết giờ trống trong ca trực này.';
            st.className = 'text-warning small mt-2';
        } else {
            sl.innerHTML = '<option value="">-- Chọn giờ --</option>' + slots.map(s => `<option value="${s}">${s}</option>`).join('');
            st.textContent = `✓ Còn ${slots.length} khung giờ trống`;
            st.className = 'text-success small mt-2';
        }
    }

    document.getElementById('doctorSelect')?.addEventListener('change', loadDoctorShifts);
    document.getElementById('apptDate')?.addEventListener('change', loadDoctorShifts);
    document.getElementById('sessionSelect')?.addEventListener('change', loadSlots);
</script>
}
