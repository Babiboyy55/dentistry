@model List<Nhakhoa.Models.Appointment>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý lịch hẹn";
    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int total = ViewBag.Total ?? 0;
    var statusColors = new Dictionary<string, string>
    {
        ["Đã xác nhận"] = "bg-primary-subtle text-primary",
        ["Đang chờ"] = "bg-warning-subtle text-warning",
        ["Đang khám"] = "bg-info-subtle text-info",
        ["Đã khám xong"] = "bg-success-subtle text-success",
        ["Đã hủy"] = "bg-danger-subtle text-danger",
        ["Vắng mặt"] = "bg-secondary-subtle text-secondary"
    };
}

<div class="d-flex align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-0" style="color:#0b1f35">
            <i class="bi bi-calendar-check text-primary me-2"></i>Quản lý lịch hẹn khám
        </h4>
        <div class="text-muted small mt-1">Hệ thống lên lịch hẹn và phân phối ca trực của phòng khám.</div>
    </div>
    <div class="d-flex gap-2">
        <a href="/Appointment/Create" class="btn btn-primary rounded-pill px-4 fw-semibold d-flex align-items-center gap-2" style="background:#1b75d0; border-color:#1b75d0;">
            <i class="bi bi-calendar-plus-fill"></i> Đặt lịch mới
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 rounded-4 py-2 px-3 mb-3"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]</div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning border-0 rounded-4 py-2 px-3 mb-3"><i class="bi bi-exclamation-circle me-2"></i>@TempData["Warning"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 rounded-4 py-2 px-3 mb-3"><i class="bi bi-x-circle me-2"></i>@TempData["Error"]</div>
}

<!-- Statistics Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="bg-primary-subtle text-primary rounded-4 d-grid place-items-center" style="width: 48px; height: 48px; flex-shrink: 0;">
                    <i class="bi bi-calendar2-check-fill fs-5"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold" style="font-size:0.75rem;">Lịch xác nhận</div>
                    <h4 class="fw-bold mb-0 text-dark">@ViewBag.StatConfirmed</h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="bg-info-subtle text-info rounded-4 d-grid place-items-center" style="width: 48px; height: 48px; flex-shrink: 0;">
                    <i class="bi bi-person-workspace fs-5"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold" style="font-size:0.75rem;">Đang khám</div>
                    <h4 class="fw-bold mb-0 text-dark">@ViewBag.StatInSession</h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="bg-success-subtle text-success rounded-4 d-grid place-items-center" style="width: 48px; height: 48px; flex-shrink: 0;">
                    <i class="bi bi-check-circle-fill fs-5"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold" style="font-size:0.75rem;">Khám xong</div>
                    <h4 class="fw-bold mb-0 text-dark">@ViewBag.StatCompleted</h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="bg-danger-subtle text-danger rounded-4 d-grid place-items-center" style="width: 48px; height: 48px; flex-shrink: 0;">
                    <i class="bi bi-x-circle-fill fs-5"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold" style="font-size:0.75rem;">Lịch hủy</div>
                    <h4 class="fw-bold mb-0 text-dark">@ViewBag.StatCancelled</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 rounded-start-pill"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control bg-light border-start-0 rounded-end-pill" placeholder="Tên, SĐT hoặc mã BN..." />
                </div>
            </div>
            
            <div class="col-md-3">
                <input type="date" name="date" value="@ViewBag.Date" class="form-control rounded-pill" />
            </div>

            <div class="col-md-3">
                <select name="status" class="form-select rounded-pill">
                    <option value="">Tất cả trạng thái</option>
                    @foreach (var s in new[] { "Đã xác nhận", "Đang chờ", "Đang khám", "Đã khám xong", "Đã hủy", "Vắng mặt" })
                    {
                        <option value="@s" selected="@(ViewBag.Status == s ? "selected" : null)">@s</option>
                    }
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2 justify-content-end">
                <button type="submit" class="btn btn-primary rounded-pill px-4" style="background:#1b75d0; border-color:#1b75d0;">Lọc</button>
                <a href="/Appointment" class="btn btn-outline-secondary rounded-pill px-3">Xóa lọc</a>
            </div>
        </form>
    </div>
</div>

<!-- Appointment List Table -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-calendar-x display-4 opacity-25 d-block mb-3"></i>
                Không tìm thấy lịch hẹn nào khớp với bộ lọc.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0" style="font-size:0.9rem;">
                    <thead style="background:#f8faff; border-bottom:2px solid #e8edf5;">
                        <tr>
                            <th class="px-4 py-3 text-muted fw-semibold">Bệnh nhân</th>
                            <th class="py-3 text-muted fw-semibold">Bác sĩ khám</th>
                            <th class="py-3 text-muted fw-semibold">Phòng / Chuyên khoa</th>
                            <th class="py-3 text-muted fw-semibold text-center">Ngày hẹn</th>
                            <th class="py-3 text-muted fw-semibold text-center">Khung giờ</th>
                            <th class="py-3 text-muted fw-semibold text-center">Trạng thái</th>
                            <th class="py-3 text-muted fw-semibold pe-4 text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model)
                        {
                            <tr class="border-bottom">
                                <td class="px-4 py-3">
                                    @if (appt.PatientId > 0)
                                    {
                                        <a href="/Patient/Details/@appt.PatientId" class="fw-semibold text-dark text-decoration-none patient-link" title="Xem hồ sơ bệnh nhân">
                                            @appt.Patient?.FullName
                                            <i class="bi bi-box-arrow-up-right ms-1 text-muted" style="font-size:0.75rem;"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="fw-semibold text-dark">@appt.Patient?.FullName</div>
                                    }
                                    <div class="text-muted small">@appt.Patient?.PhoneNumber · <span class="badge bg-light text-dark">@appt.Patient?.PatientCode</span></div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@(appt.StaffProfile?.User?.FullName ?? "—")</div>
                                    <div class="text-muted small">@(appt.StaffProfile?.PositionTitle ?? "Nha sĩ")</div>
                                </td>
                                <td>
                                    <div class="text-dark fw-semibold">@(appt.Clinic?.Name ?? "—")</div>
                                    <div class="text-muted small">@(appt.Specialty?.Name ?? "—")</div>
                                </td>
                                <td class="text-center fw-semibold text-dark">@appt.AppointmentDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <span class="badge bg-light text-primary border border-primary-subtle rounded-pill px-3">@appt.TimeSlot</span>
                                    <div class="text-muted small mt-1">@appt.Session</div>
                                </td>
                                <td class="text-center">
                                    @{
                                        var cls = statusColors.GetValueOrDefault(appt.Status, "bg-light text-dark");
                                    }
                                    <span class="badge @cls rounded-pill px-3 py-1 fw-semibold">@appt.Status</span>
                                    @if (appt.IsWalkIn)
                                    {
                                        <div><span class="badge bg-warning-subtle text-warning rounded-pill px-2 mt-1" style="font-size:0.7rem;">Vãng lai</span></div>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <div class="d-flex gap-1 justify-content-center flex-wrap">
                                        @* Nút xem hồ sơ bệnh nhân - luôn hiển thị *@
                                        @if (appt.PatientId > 0)
                                        {
                                            <a href="/Patient/Details/@appt.PatientId"
                                               class="btn btn-outline-info btn-sm rounded-pill px-3"
                                               title="Xem hồ sơ & lịch sử bệnh nhân">
                                                <i class="bi bi-person-lines-fill me-1"></i>Hồ sơ
                                            </a>
                                        }

                                        @if (appt.Status == "Đã xác nhận")
                                        {
                                            @if (appt.AppointmentDate.Date == DateTime.Today)
                                            {
                                                <form action="/Appointment/CheckIn/@appt.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button class="btn btn-success btn-sm rounded-pill px-3" title="Tiếp nhận bệnh nhân">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Tiếp nhận
                                                    </button>
                                                </form>
                                            }
                                            <a href="/Appointment/Edit/@appt.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3" title="Dời lịch">
                                                <i class="bi bi-clock-history"></i> Dời
                                            </a>
                                            <form action="/Appointment/Cancel/@appt.Id" method="post" class="d-inline"
                                                  onsubmit="return confirm('Bạn có chắc chắn muốn hủy lịch hẹn này?')">
                                                @Html.AntiForgeryToken()
                                                <button class="btn btn-outline-danger btn-sm rounded-pill px-3" title="Hủy lịch">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                        else if (appt.Status == "Đang chờ")
                                        {
                                            <span class="badge bg-warning-subtle text-warning rounded-pill px-2 py-1"><i class="bi bi-hourglass-split"></i> Chờ</span>
                                            <form action="/Appointment/Cancel/@appt.Id" method="post" class="d-inline"
                                                  onsubmit="return confirm('Bạn có chắc chắn muốn hủy lịch hẹn này?')">
                                                @Html.AntiForgeryToken()
                                                <button class="btn btn-outline-danger btn-sm rounded-pill px-3" title="Hủy lịch">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="d-flex justify-content-center py-3 gap-2">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <a href="?search=@ViewBag.Search&status=@ViewBag.Status&date=@ViewBag.Date&page=@i"
                           class="btn btn-sm @(i == page ? "btn-primary" : "btn-outline-secondary") rounded-pill px-3">@i</a>
                    }
                </div>
            }
        }
    </div>
</div>

@section Scripts {
<style>
    .patient-link:hover {
        color: #1b75d0 !important;
        text-decoration: underline !important;
    }
    .patient-link:hover .bi-box-arrow-up-right {
        color: #1b75d0 !important;
    }
</style>
}
