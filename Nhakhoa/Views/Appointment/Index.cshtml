@model List<Nhakhoa.Models.Appointment>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý lịch hẹn";
    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int total = ViewBag.Total ?? 0;
    var statusColors = new Dictionary<string, string>
    {
        ["Đã xác nhận"] = "bg-primary-subtle text-primary",
        ["Đang chờ"] = "bg-warning-subtle text-warning",
        ["Đang khám"] = "bg-info-subtle text-info",
        ["Đã khám xong"] = "bg-success-subtle text-success",
        ["Đã hủy"] = "bg-danger-subtle text-danger",
        ["Vắng mặt"] = "bg-secondary-subtle text-secondary"
    };
}

<div class="d-flex align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-0" style="color:#0b1f35"><i class="bi bi-calendar-check text-primary me-2"></i>Lịch hẹn</h4>
        <div class="text-muted small mt-1">Quản lý toàn bộ lịch hẹn khám — @total lịch hẹn</div>
    </div>
    <div class="d-flex gap-2">
        <a href="/Appointment/Queue" class="btn btn-outline-warning btn-sm rounded-pill px-3 fw-semibold d-flex align-items-center gap-1">
            <i class="bi bi-clock-history"></i> Hàng chờ hôm nay
        </a>
        <a href="/Appointment/Create" class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold d-flex align-items-center gap-1" style="background:#1b75d0; border-color:#1b75d0;">
            <i class="bi bi-calendar-plus-fill"></i> Đặt lịch mới
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 rounded-4 py-2 px-3 mb-3"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 rounded-4 py-2 px-3 mb-3"><i class="bi bi-x-circle me-2"></i>@TempData["Error"]</div>
}

<!-- Filters -->
<form method="get" class="d-flex flex-wrap gap-2 mb-4 align-items-center">
    <div class="input-group" style="max-width:300px;">
        <span class="input-group-text bg-white border-end-0 rounded-start-pill"><i class="bi bi-search text-muted"></i></span>
        <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0 rounded-end-pill" placeholder="Tên, SĐT hoặc mã BN..." />
    </div>
    <input type="date" name="date" value="@ViewBag.Date" class="form-control rounded-pill" style="width:175px;" />
    <select name="status" class="form-select rounded-pill" style="width:180px;">
        <option value="">Tất cả trạng thái</option>
        @foreach (var s in new[] { "Đã xác nhận", "Đang chờ", "Đang khám", "Đã khám xong", "Đã hủy", "Vắng mặt" })
        {
            <option value="@s" selected="@(ViewBag.Status == s)">@s</option>
        }
    </select>
    <button type="submit" class="btn btn-outline-primary rounded-pill px-4">Lọc</button>
    <a href="/Appointment" class="btn btn-outline-secondary rounded-pill px-3">Xóa lọc</a>
</form>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-calendar-x display-4 opacity-25 d-block mb-3"></i>
                Không tìm thấy lịch hẹn nào.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0" style="font-size:0.9rem;">
                    <thead style="background:#f8faff; border-bottom:2px solid #e8edf5;">
                        <tr>
                            <th class="px-4 py-3 text-muted fw-semibold">Bệnh nhân</th>
                            <th class="py-3 text-muted fw-semibold">Bác sĩ</th>
                            <th class="py-3 text-muted fw-semibold">Phòng / Chuyên khoa</th>
                            <th class="py-3 text-muted fw-semibold text-center">Ngày hẹn</th>
                            <th class="py-3 text-muted fw-semibold text-center">Giờ / Buổi</th>
                            <th class="py-3 text-muted fw-semibold text-center">Trạng thái</th>
                            <th class="py-3 text-muted fw-semibold pe-4 text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model)
                        {
                            <tr class="border-bottom">
                                <td class="px-4">
                                    <div class="fw-semibold text-dark">@appt.Patient?.FullName</div>
                                    <div class="text-muted small">@appt.Patient?.PhoneNumber · @appt.Patient?.PatientCode</div>
                                </td>
                                <td>
                                    <div class="fw-semibold small text-dark">@(appt.StaffProfile?.User?.FullName ?? "—")</div>
                                </td>
                                <td>
                                    <div class="small text-dark">@(appt.Clinic?.Name ?? "—")</div>
                                    <div class="text-muted" style="font-size:0.75rem;">@(appt.Specialty?.Name ?? "—")</div>
                                </td>
                                <td class="text-center fw-semibold">@appt.AppointmentDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border rounded-pill px-2">@appt.TimeSlot</span>
                                    <div class="text-muted" style="font-size:0.72rem;">@appt.Session</div>
                                </td>
                                <td class="text-center">
                                    @{
                                        var cls = statusColors.GetValueOrDefault(appt.Status, "bg-light text-dark");
                                    }
                                    <span class="badge @cls rounded-pill px-3 py-1">@appt.Status</span>
                                    @if (appt.IsWalkIn)
                                    {
                                        <div><span class="badge bg-warning-subtle text-warning rounded-pill px-2 mt-1" style="font-size:0.7rem;">Walk-in</span></div>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <div class="d-flex gap-1 justify-content-center">
                                        @if (appt.Status != "Đang khám" && appt.Status != "Đã khám xong" && appt.Status != "Đã hủy")
                                        {
                                            <a href="/Appointment/Edit/@appt.Id" class="btn btn-outline-secondary btn-sm rounded-pill" title="Dời lịch">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form action="/Appointment/Cancel/@appt.Id" method="post" class="d-inline"
                                                  onsubmit="return confirm('Xác nhận hủy lịch hẹn này?')">
                                                @Html.AntiForgeryToken()
                                                <button class="btn btn-outline-danger btn-sm rounded-pill" title="Hủy lịch">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="d-flex justify-content-center py-3 gap-2">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <a href="?search=@ViewBag.Search&status=@ViewBag.Status&date=@ViewBag.Date&page=@i"
                           class="btn btn-sm @(i == page ? "btn-primary" : "btn-outline-secondary") rounded-pill px-3">@i</a>
                    }
                </div>
            }
        }
    </div>
</div>
