@model List<Nhakhoa.Models.Appointment>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Hàng chờ khám hôm nay";
    DateTime targetDate = ViewBag.TargetDate ?? DateTime.Today;
    string FormatTime(DateTime? dt) => dt?.ToString("HH:mm") ?? "—";
}

<!-- Custom Styles for Premium Experience -->
<style>
    .queue-card {
        border: none;
        border-radius: 16px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        background: #ffffff;
    }
    .queue-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 20px rgba(0, 0, 0, 0.05) !important;
    }
    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
    }
    .badge-pill-custom {
        font-weight: 600;
        font-size: 0.75rem;
        padding: 5px 12px;
        border-radius: 30px;
    }
    .table-hover tbody tr:hover {
        background-color: #fcfdfe;
    }
    .sound-btn {
        opacity: 0.6;
        transition: opacity 0.2s;
    }
    .sound-btn:hover {
        opacity: 1;
    }
    .column-header {
        font-weight: 700;
        font-size: 1.05rem;
        color: #1e293b;
        border-bottom: 3px solid #3b82f6;
        padding-bottom: 8px;
    }
</style>

<!-- Disconnect warning alert banner -->
<div id="reconnectBanner" class="alert alert-danger border-0 shadow rounded-4 py-2 px-3 mb-3 d-none align-items-center justify-content-between">
    <div class="d-flex align-items-center gap-2">
        <div class="spinner-border spinner-border-sm text-danger" role="status"></div>
        <span class="fw-semibold">Mất đồng bộ với máy chủ. Hệ thống đang tự động kết nối lại...</span>
    </div>
</div>

<div class="d-flex align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-0" style="color:#0b1f35">
            <i class="bi bi-clock-history text-primary me-2"></i>Hàng chờ khám
        </h4>
        <div class="text-muted small mt-1">
            Quản lý và điều phối bệnh nhân theo thời gian thực — 
            <span class="badge bg-light text-dark border rounded-pill px-2">@targetDate.ToString("dd/MM/yyyy")</span>
            <span id="connectionBadge" class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 ms-1">
                <span class="status-dot bg-success me-1"></span>Đã kết nối
            </span>
        </div>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <!-- Text-to-Speech Toggle -->
        <button id="toggleVoice" class="btn btn-outline-secondary btn-sm rounded-pill px-3 d-flex align-items-center gap-1">
            <i id="voiceIcon" class="bi bi-volume-up-fill text-primary"></i> <span id="voiceText">Loa: BẬT</span>
        </button>
        <form method="get" class="d-flex gap-2">
            <input type="date" name="date" value="@targetDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm rounded-pill px-3" style="width:170px;" />
            <button type="submit" class="btn btn-outline-primary btn-sm rounded-pill px-3">Xem</button>
        </form>
        <button class="btn btn-success btn-sm rounded-pill px-3 d-flex align-items-center gap-1 fw-semibold" data-bs-toggle="modal" data-bs-target="#walkInModal">
            <i class="bi bi-person-plus-fill"></i> Tiếp nhận Walk-in
        </button>
    </div>
</div>

<!-- Stats Dashboard -->
@{
    var waiting = Model.Count(a => a.Status == "Đang chờ");
    var examining = Model.Count(a => a.Status == "Đang khám");
    var done = Model.Count(a => a.Status == "Đã khám xong");
    var absent = Model.Count(a => a.Status == "Vắng mặt");
}
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card queue-card shadow-sm border-0">
            <div class="card-body py-3 px-4 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold d-block">ĐANG CHỜ</span>
                    <h3 class="fw-bold mb-0 text-warning mt-1" id="stat-waiting">@waiting</h3>
                </div>
                <div class="rounded-pill p-3 bg-warning-subtle text-warning">
                    <i class="bi bi-people fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card queue-card shadow-sm border-0">
            <div class="card-body py-3 px-4 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold d-block">ĐANG KHÁM</span>
                    <h3 class="fw-bold mb-0 text-primary mt-1" id="stat-examining">@examining</h3>
                </div>
                <div class="rounded-pill p-3 bg-primary-subtle text-primary">
                    <i class="bi bi-activity fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card queue-card shadow-sm border-0">
            <div class="card-body py-3 px-4 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold d-block">HOÀN THÀNH</span>
                    <h3 class="fw-bold mb-0 text-success mt-1" id="stat-completed">@done</h3>
                </div>
                <div class="rounded-pill p-3 bg-success-subtle text-success">
                    <i class="bi bi-check2-circle fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card queue-card shadow-sm border-0">
            <div class="card-body py-3 px-4 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold d-block">VẮNG MẶT</span>
                    <h3 class="fw-bold mb-0 text-secondary mt-1" id="stat-absent">@absent</h3>
                </div>
                <div class="rounded-pill p-3 bg-secondary-subtle text-secondary">
                    <i class="bi bi-person-dash fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Three Column Layout -->
<div class="row g-4" id="queueColumns">
    <!-- COLUMN 1: Waiting List -->
    <div class="col-12 col-lg-4">
        <div class="card queue-card shadow-sm border-0 h-100">
            <div class="card-body p-3">
                <div class="column-header mb-3 d-flex justify-content-between align-items-center" style="border-color: #f59e0b;">
                    <span><i class="bi bi-people-fill text-warning me-2"></i>Đang chờ khám</span>
                    <span class="badge bg-warning text-white rounded-pill px-2" id="badge-waiting-count">@waiting</span>
                </div>
                <div id="waitingListContainer" class="d-flex flex-column gap-2" style="max-height: 550px; overflow-y: auto;">
                    @foreach (var appt in Model.Where(a => a.Status == "Đang chờ"))
                    {
                        <div class="border rounded-4 p-3 shadow-2xs hover-bg queue-item-card" data-id="@appt.Id">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <div class="fw-bold text-dark fs-5">#@(appt.QueueNumber ?? 0)</div>
                                    <div class="fw-semibold text-dark">@appt.Patient?.FullName</div>
                                    <div class="text-muted small">SĐT: @appt.Patient?.PhoneNumber</div>
                                </div>
                                @if (appt.IsWalkIn)
                                {
                                    <span class="badge bg-warning-subtle text-warning badge-pill-custom">Walk-in</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary badge-pill-custom">@appt.TimeSlot</span>
                                }
                            </div>
                            <div class="text-muted small mb-3">
                                <div><i class="bi bi-person-badge-fill me-1"></i>Bác sĩ: <strong>@(appt.StaffProfile?.User?.FullName ?? "—")</strong></div>
                                <div><i class="bi bi-geo-alt-fill me-1"></i>Phòng: @(appt.Clinic?.Name ?? "Chưa phân công")</div>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-primary btn-sm rounded-pill flex-grow-1 btn-call" data-id="@appt.Id">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Gọi khám
                                </button>
                                <button class="btn btn-outline-secondary btn-sm rounded-pill btn-absent" data-id="@appt.Id" title="Đánh dấu vắng mặt">
                                    <i class="bi bi-person-dash"></i>
                                </button>
                            </div>
                        </div>
                    }
                    @if (waiting == 0)
                    {
                        <div class="text-center py-5 text-muted empty-state-msg">Không có bệnh nhân chờ.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- COLUMN 2: Examining List -->
    <div class="col-12 col-lg-4">
        <div class="card queue-card shadow-sm border-0 h-100">
            <div class="card-body p-3">
                <div class="column-header mb-3 d-flex justify-content-between align-items-center" style="border-color: #3b82f6;">
                    <span><i class="bi bi-activity text-primary me-2"></i>Đang trong ca khám</span>
                    <span class="badge bg-primary text-white rounded-pill px-2" id="badge-examining-count">@examining</span>
                </div>
                <div id="examiningListContainer" class="d-flex flex-column gap-2" style="max-height: 550px; overflow-y: auto;">
                    @foreach (var appt in Model.Where(a => a.Status == "Đang khám"))
                    {
                        <div class="border rounded-4 p-3 bg-light-subtle shadow-2xs queue-item-card" data-id="@appt.Id" style="border-left: 4px solid #3b82f6 !important;">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <div class="fw-bold text-primary fs-5">#@(appt.QueueNumber ?? 0)</div>
                                    <div class="fw-semibold text-dark">@appt.Patient?.FullName</div>
                                    <div class="text-muted small">SĐT: @appt.Patient?.PhoneNumber</div>
                                </div>
                                <span class="badge bg-primary text-white badge-pill-custom">Đang khám</span>
                            </div>
                            <div class="text-muted small mb-3">
                                <div><i class="bi bi-person-badge-fill me-1"></i>Bác sĩ: <strong>@(appt.StaffProfile?.User?.FullName ?? "—")</strong></div>
                                <div><i class="bi bi-geo-alt-fill me-1"></i>Phòng: @(appt.Clinic?.Name ?? "Chưa phân công")</div>
                                <div><i class="bi bi-clock-history me-1"></i>Vào phòng: @FormatTime(appt.CheckedInAt)</div>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-success btn-sm rounded-pill flex-grow-1 btn-done" data-id="@appt.Id">
                                    <i class="bi bi-check2-circle me-1"></i> Hoàn thành khám
                                </button>
                                <button class="btn btn-outline-primary btn-sm rounded-pill btn-recall-notify" data-id="@appt.Id" 
                                        data-name="@appt.Patient?.FullName" data-doc="@appt.StaffProfile?.User?.FullName" data-clinic="@appt.Clinic?.Name"
                                        title="Phát loa thông báo lại">
                                    <i class="bi bi-volume-up-fill"></i> Gọi lại
                                </button>
                            </div>
                        </div>
                    }
                    @if (examining == 0)
                    {
                        <div class="text-center py-5 text-muted empty-state-msg">Không có ca khám đang diễn ra.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- COLUMN 3: Completed / Absent History -->
    <div class="col-12 col-lg-4">
        <div class="card queue-card shadow-sm border-0 h-100">
            <div class="card-body p-3">
                <div class="column-header mb-3 d-flex justify-content-between align-items-center" style="border-color: #10b981;">
                    <span><i class="bi bi-journal-check text-success me-2"></i>Lịch sử ca khám hôm nay</span>
                    <span class="badge bg-success text-white rounded-pill px-2" id="badge-completed-count">@(done + absent)</span>
                </div>
                <div id="historyListContainer" class="d-flex flex-column gap-2" style="max-height: 550px; overflow-y: auto;">
                    @foreach (var appt in Model.Where(a => a.Status == "Đã khám xong" || a.Status == "Vắng mặt"))
                    {
                        string borderCol = appt.Status == "Đã khám xong" ? "#10b981" : "#64748b";
                        string bgB = appt.Status == "Đã khám xong" ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary";
                        <div class="border rounded-4 p-3 shadow-2xs queue-item-card" data-id="@appt.Id" style="border-left: 4px solid @borderCol !important; opacity:0.85;">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <div class="fw-bold text-muted fs-5">#@(appt.QueueNumber ?? 0)</div>
                                    <div class="fw-semibold text-dark">@appt.Patient?.FullName</div>
                                    <div class="text-muted small">SĐT: @appt.Patient?.PhoneNumber</div>
                                </div>
                                <span class="badge @bgB badge-pill-custom">@appt.Status</span>
                            </div>
                            <div class="text-muted small">
                                <div><i class="bi bi-person-badge-fill me-1"></i>Bác sĩ: @(appt.StaffProfile?.User?.FullName ?? "—")</div>
                                @if (appt.CompletedAt.HasValue)
                                {
                                    <div><i class="bi bi-clock-history me-1"></i>Kết thúc: @FormatTime(appt.CompletedAt)</div>
                                }
                            </div>
                        </div>
                    }
                    @if (done + absent == 0)
                    {
                        <div class="text-center py-5 text-muted empty-state-msg">Chưa có lịch sử khám hôm nay.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Walk-in Modal -->
<div class="modal fade" id="walkInModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-person-plus-fill text-success me-2"></i>Tiếp nhận bệnh nhân vãng lai (Walk-in)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Tìm kiếm bệnh nhân nhanh</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" id="walkInSearch" class="form-control border-start-0 rounded-end-3" placeholder="Nhập tên, SĐT hoặc mã bệnh nhân..." />
                    </div>
                    <div id="walkInSearchResults" class="mt-2" style="max-height: 200px; overflow-y: auto;"></div>
                </div>
                <div id="walkInPatientInfo" style="display:none;" class="alert alert-success border-0 rounded-4 py-2 px-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div id="walkInPatientName" class="fw-bold"></div>
                            <div id="walkInPatientPhone" class="text-muted small"></div>
                        </div>
                        <span class="badge bg-success text-white rounded-pill px-3 py-1">Đã chọn</span>
                    </div>
                </div>
                <input type="hidden" id="walkInPatientId" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Bác sĩ tiếp nhận <span class="text-danger">*</span></label>
                        <select id="walkInDoctor" class="form-select rounded-3">
                            <option value="">-- Chọn bác sĩ trực hôm nay --</option>
                            @foreach (var doc in (ViewBag.Doctors as List<Nhakhoa.Models.StaffProfile> ?? new()))
                            {
                                <option value="@doc.Id">@doc.User?.FullName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Buổi khám <span class="text-danger">*</span></label>
                        <select id="walkInSession" class="form-select rounded-3">
                            <option value="Sáng">Buổi Sáng (07:00–12:00)</option>
                            <option value="Chiều">Buổi Chiều (13:00–17:00)</option>
                        </select>
                    </div>
                </div>
                <div id="walkInError" class="alert alert-danger border-0 rounded-4 py-2 px-3 mt-3" style="display:none;"></div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-success rounded-pill px-4 fw-semibold" id="confirmWalkIn">
                    <i class="bi bi-check2 me-1"></i> Xác nhận vào hàng chờ
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<!-- Import SignalR client from CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
    // State management for Voice notifications
    let voiceEnabled = true;

    document.getElementById('toggleVoice').addEventListener('click', function() {
        voiceEnabled = !voiceEnabled;
        const icon = document.getElementById('voiceIcon');
        const text = document.getElementById('voiceText');
        if (voiceEnabled) {
            icon.className = "bi bi-volume-up-fill text-primary";
            text.textContent = "Loa: BẬT";
            this.className = "btn btn-outline-secondary btn-sm rounded-pill px-3 d-flex align-items-center gap-1";
        } else {
            icon.className = "bi bi-volume-mute-fill text-muted";
            text.textContent = "Loa: TẮT";
            this.className = "btn btn-outline-secondary btn-sm rounded-pill px-3 d-flex align-items-center gap-1 opacity-50";
        }
    });

    // Voice call announcement using SpeechSynthesis
    function speakCallNotification(patientName, docName, clinicName) {
        if (!voiceEnabled) return;
        try {
            window.speechSynthesis.cancel(); // Cancel any ongoing speech
            const cleanDoc = docName.replace(/^BS\.\s*/i, 'Bác sĩ ');
            const sentence = `Mời bệnh nhân ${patientName} vào phòng khám của ${cleanDoc} tại ${clinicName}`;
            const utterance = new SpeechSynthesisUtterance(sentence);
            utterance.lang = 'vi-VN';
            utterance.rate = 0.95;
            window.speechSynthesis.speak(utterance);
        } catch (e) {
            console.error("Text to speech failed: ", e);
        }
    }

    // SignalR Real-time Setup
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/queueHub")
        .withAutomaticReconnect([0, 2000, 5000, 10000, 20000]) // auto-reconnect strategy (EX-3.3.4)
        .build();

    connection.on("QueueUpdated", function () {
        console.log("Queue update signal received, refreshing dashboard data...");
        // Re-load the content via page refresh to get correct server status
        location.reload();
    });

    connection.on("PatientCalled", function (apptId, patientName, docName, clinicName) {
        console.log(`PatientCalled: ${patientName} by ${docName} at ${clinicName}`);
        // Visual indicator/alert if on same page
        speakCallNotification(patientName, docName, clinicName);

        // Flash called card
        const card = document.querySelector(`.queue-item-card[data-id="${apptId}"]`);
        if (card) {
            card.classList.add('bg-warning-subtle');
            setTimeout(() => {
                card.classList.remove('bg-warning-subtle');
            }, 3000);
        }
    });

    async function startConnection() {
        try {
            await connection.start();
            console.log("SignalR Connected.");
            document.getElementById('connectionBadge').className = "badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 ms-1";
            document.getElementById('connectionBadge').innerHTML = '<span class="status-dot bg-success me-1"></span>Đã kết nối';
            document.getElementById('reconnectBanner').classList.add('d-none');
        } catch (err) {
            console.error("SignalR connection failed: ", err);
            document.getElementById('connectionBadge').className = "badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 ms-1";
            document.getElementById('connectionBadge').innerHTML = '<span class="status-dot bg-danger me-1"></span>Mất kết nối';
            document.getElementById('reconnectBanner').classList.remove('d-none');
            setTimeout(startConnection, 5000);
        }
    }

    connection.onreconnecting((error) => {
        console.warn("SignalR Reconnecting: ", error);
        document.getElementById('connectionBadge').className = "badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2 ms-1";
        document.getElementById('connectionBadge').innerHTML = '<span class="status-dot bg-warning me-1"></span>Đang kết nối lại';
        document.getElementById('reconnectBanner').classList.remove('d-none');
    });

    connection.onreconnected((connectionId) => {
        console.log("SignalR Reconnected: ", connectionId);
        document.getElementById('connectionBadge').className = "badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 ms-1";
        document.getElementById('connectionBadge').innerHTML = '<span class="status-dot bg-success me-1"></span>Đã kết nối';
        document.getElementById('reconnectBanner').classList.add('d-none');
        location.reload(); // Refresh to catch missed updates
    });

    connection.onclose((error) => {
        console.error("SignalR Connection closed: ", error);
        startConnection();
    });

    startConnection();

    // REST call handling
    async function postStatusUpdate(id, status) {
        try {
            const response = await fetch('/Appointment/UpdateStatus', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ id, status })
            });
            if (!response.ok) {
                const data = await response.json();
                alert(data.error || "Có lỗi xảy ra khi cập nhật trạng thái.");
                location.reload();
            }
        } catch (e) {
            console.error(e);
            alert("Không thể gửi yêu cầu đến máy chủ.");
        }
    }

    // Bind event handlers
    function bindActionButtons() {
        document.querySelectorAll('.btn-call').forEach(btn => {
            btn.onclick = function() {
                const id = this.dataset.id;
                postStatusUpdate(id, 'Đang khám');
            };
        });
        document.querySelectorAll('.btn-done').forEach(btn => {
            btn.onclick = function() {
                const id = this.dataset.id;
                postStatusUpdate(id, 'Đã khám xong');
            };
        });
        document.querySelectorAll('.btn-absent').forEach(btn => {
            btn.onclick = function() {
                if (confirm("Xác nhận đánh dấu vắng mặt cho bệnh nhân này?")) {
                    const id = this.dataset.id;
                    postStatusUpdate(id, 'Vắng mặt');
                }
            };
        });
        document.querySelectorAll('.btn-recall-notify').forEach(btn => {
            btn.onclick = function() {
                const name = this.dataset.name;
                const doc = this.dataset.doc;
                const clinic = this.dataset.clinic;
                speakCallNotification(name, doc, clinic);
            };
        });
    }

    bindActionButtons();

    // Walk-in Quick Search
    let searchTimer;
    document.getElementById('walkInSearch').addEventListener('input', function () {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(async () => {
            const q = this.value.trim();
            const results = document.getElementById('walkInSearchResults');
            if (!q) {
                results.innerHTML = '';
                return;
            }
            try {
                const res = await fetch(`/Patient/Search?q=${encodeURIComponent(q)}`);
                const data = await res.json();
                if (!data.length) {
                    results.innerHTML = '<div class="text-muted small p-2">Không tìm thấy bệnh nhân nào. <a href="/Patient/Create" target="_blank" class="fw-bold">Tạo hồ sơ mới <i class="bi bi-box-arrow-up-right"></i></a></div>';
                    return;
                }
                results.innerHTML = data.map(p => `
                    <div class="border rounded-3 p-2 mb-1 hover-bg walk-patient"
                          data-id="${p.id}" data-name="${p.fullName}" data-phone="${p.phoneNumber}"
                          style="cursor:pointer; background:#f8faff;" onclick="selectWalkPatient(this)">
                        <div class="d-flex justify-content-between">
                            <span class="fw-bold text-dark">${p.fullName}</span>
                            <span class="badge bg-light text-dark">${p.patientCode}</span>
                        </div>
                        <span class="text-muted small">${p.phoneNumber} · NS: ${p.dob ? p.dob.substring(0,10) : ''}</span>
                    </div>
                `).join('');
            } catch (e) {
                console.error(e);
            }
        }, 300);
    });

    window.selectWalkPatient = function(el) {
        document.getElementById('walkInPatientId').value = el.dataset.id;
        document.getElementById('walkInPatientName').textContent = el.dataset.name;
        document.getElementById('walkInPatientPhone').textContent = el.dataset.phone;
        document.getElementById('walkInPatientInfo').style.display = 'block';
        document.getElementById('walkInSearchResults').innerHTML = '';
        document.getElementById('walkInSearch').value = el.dataset.name;
    };

    document.getElementById('confirmWalkIn').addEventListener('click', async function () {
        const patientId = document.getElementById('walkInPatientId').value;
        const doctorId = document.getElementById('walkInDoctor').value;
        const session = document.getElementById('walkInSession').value;
        const errEl = document.getElementById('walkInError');
        errEl.style.display = 'none';

        if (!patientId || !doctorId) {
            errEl.textContent = 'Vui lòng chọn đầy đủ bệnh nhân và bác sĩ tiếp nhận.';
            errEl.style.display = 'block';
            return;
        }

        try {
            const res = await fetch('/Appointment/WalkIn', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ patientId, staffProfileId: doctorId, session })
            });

            if (res.ok) {
                bootstrap.Modal.getInstance(document.getElementById('walkInModal')).hide();
                // SignalR will trigger reload automatically, but call location.reload() as fallback
                location.reload();
            } else {
                const data = await res.json();
                errEl.textContent = data.error || 'Có lỗi xảy ra khi đăng ký walk-in.';
                errEl.style.display = 'block';
            }
        } catch (e) {
            console.error(e);
            errEl.textContent = 'Không kết nối được với máy chủ.';
            errEl.style.display = 'block';
        }
    });
</script>
}
