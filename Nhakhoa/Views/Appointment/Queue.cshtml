@model List<Nhakhoa.Models.Appointment>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Hàng chờ khám hôm nay";
    DateTime targetDate = ViewBag.TargetDate ?? DateTime.Today;
    string FormatTime(DateTime? dt) => dt?.ToString("HH:mm") ?? "—";
}

<div class="d-flex align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-0" style="color:#0b1f35"><i class="bi bi-clock-history text-primary me-2"></i>Hàng chờ khám</h4>
        <div class="text-muted small mt-1">Quản lý danh sách bệnh nhân chờ khám theo thời gian thực — @targetDate.ToString("dd/MM/yyyy")</div>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <form method="get" class="d-flex gap-2">
            <input type="date" name="date" value="@targetDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm rounded-pill px-3" style="width:175px;" />
            <button type="submit" class="btn btn-outline-primary btn-sm rounded-pill px-3">Xem</button>
        </form>
        <button class="btn btn-success btn-sm rounded-pill px-3 d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#walkInModal">
            <i class="bi bi-person-plus-fill"></i> Walk-in
        </button>
        <a href="/Appointment" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-calendar3"></i> Lịch hẹn
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 rounded-4 py-2 px-3 mb-3"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 rounded-4 py-2 px-3 mb-3"><i class="bi bi-x-circle me-2"></i>@TempData["Error"]</div>
}

<!-- Summary Stats -->
@{
    var waiting = Model.Count(a => a.Status == "Đang chờ");
    var examining = Model.Count(a => a.Status == "Đang khám");
    var done = Model.Count(a => a.Status == "Đã khám xong");
    var absent = Model.Count(a => a.Status == "Vắng mặt");
}
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 rounded-4 text-center py-3 px-2 shadow-sm">
            <div class="fs-2 fw-bold text-warning">@waiting</div>
            <div class="text-muted small">Đang chờ</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 rounded-4 text-center py-3 px-2 shadow-sm">
            <div class="fs-2 fw-bold text-primary">@examining</div>
            <div class="text-muted small">Đang khám</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 rounded-4 text-center py-3 px-2 shadow-sm">
            <div class="fs-2 fw-bold text-success">@done</div>
            <div class="text-muted small">Đã hoàn thành</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 rounded-4 text-center py-3 px-2 shadow-sm">
            <div class="fs-2 fw-bold text-secondary">@absent</div>
            <div class="text-muted small">Vắng mặt</div>
        </div>
    </div>
</div>

<!-- Queue Table -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-calendar-x display-4 opacity-25 d-block mb-3"></i>
                Không có bệnh nhân nào trong hàng chờ hôm nay.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0" style="font-size:0.9rem;">
                    <thead style="background:#f8faff; border-bottom:2px solid #e8edf5;">
                        <tr>
                            <th class="px-4 py-3 text-muted fw-semibold" style="width:60px;">STT</th>
                            <th class="py-3 text-muted fw-semibold">Bệnh nhân</th>
                            <th class="py-3 text-muted fw-semibold">Bác sĩ / Phòng</th>
                            <th class="py-3 text-muted fw-semibold text-center">Giờ hẹn</th>
                            <th class="py-3 text-muted fw-semibold text-center">Loại</th>
                            <th class="py-3 text-muted fw-semibold text-center">Trạng thái</th>
                            <th class="py-3 text-muted fw-semibold text-center">Tiếp nhận</th>
                            <th class="py-3 text-muted fw-semibold pe-4 text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model)
                        {
                            <tr class="border-bottom queue-row" data-id="@appt.Id" data-status="@appt.Status">
                                <td class="px-4">
                                    <span class="fw-bold text-primary fs-5">#@(appt.QueueNumber ?? 0)</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@appt.Patient?.FullName</div>
                                    <div class="text-muted small">@appt.Patient?.PhoneNumber · @appt.Patient?.PatientCode</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark small">@(appt.StaffProfile?.User?.FullName ?? "—")</div>
                                    <div class="text-muted" style="font-size:0.75rem;">@(appt.Clinic?.Name ?? "Chưa phân công")</div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark px-3 py-1 rounded-pill border">@appt.TimeSlot · @appt.Session</span>
                                </td>
                                <td class="text-center">
                                    @if (appt.IsWalkIn)
                                    {
                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-2">Walk-in</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary-subtle text-primary rounded-pill px-2">Lịch hẹn</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @{
                                        string badgeClass = appt.Status switch
                                        {
                                            "Đang chờ" => "bg-warning-subtle text-warning",
                                            "Đang khám" => "bg-primary-subtle text-primary",
                                            "Đã khám xong" => "bg-success-subtle text-success",
                                            "Vắng mặt" => "bg-secondary-subtle text-secondary",
                                            _ => "bg-light text-dark"
                                        };
                                    }
                                    <span class="badge @badgeClass rounded-pill px-3 py-1 status-badge" id="badge-@appt.Id">@appt.Status</span>
                                </td>
                                <td class="text-center">
                                    <div class="text-muted small">
                                        @if (appt.CheckedInAt.HasValue)
                                        {
                                            <span><i class="bi bi-door-open me-1 text-primary"></i>@FormatTime(appt.CheckedInAt)</span>
                                        }
                                        @if (appt.CompletedAt.HasValue)
                                        {
                                            <br /><span><i class="bi bi-check2-circle me-1 text-success"></i>@FormatTime(appt.CompletedAt)</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-center pe-4">
                                    <div class="d-flex gap-1 justify-content-center">
                                        @if (appt.Status == "Đang chờ" || appt.Status == "Đã xác nhận")
                                        {
                                            <button class="btn btn-primary btn-sm rounded-pill px-3 btn-call"
                                                    data-id="@appt.Id" title="Gọi vào khám">
                                                <i class="bi bi-box-arrow-in-right"></i> Gọi
                                            </button>
                                            <button class="btn btn-outline-secondary btn-sm rounded-pill btn-absent"
                                                    data-id="@appt.Id" title="Đánh dấu vắng mặt">
                                                <i class="bi bi-person-dash"></i>
                                            </button>
                                        }
                                        @if (appt.Status == "Đang khám")
                                        {
                                            <button class="btn btn-success btn-sm rounded-pill px-3 btn-done"
                                                    data-id="@appt.Id" title="Hoàn thành khám">
                                                <i class="bi bi-check2-circle"></i> Xong
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Walk-in Modal -->
<div class="modal fade" id="walkInModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content rounded-4 border-0">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-person-plus-fill text-success me-2"></i>Tiếp nhận Walk-in</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Tìm kiếm bệnh nhân</label>
                    <input type="text" id="walkInSearch" class="form-control rounded-3" placeholder="Nhập tên, SĐT hoặc mã bệnh nhân..." />
                    <div id="walkInSearchResults" class="mt-2"></div>
                </div>
                <div id="walkInPatientInfo" style="display:none;" class="alert alert-success border-0 rounded-3 py-2">
                    <div id="walkInPatientName" class="fw-semibold"></div>
                    <div id="walkInPatientPhone" class="text-muted small"></div>
                </div>
                <input type="hidden" id="walkInPatientId" />
                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Bác sĩ <span class="text-danger">*</span></label>
                        <select id="walkInDoctor" class="form-select rounded-3">
                            <option value="">-- Chọn bác sĩ --</option>
                            @foreach (var doc in (ViewBag.Doctors as List<Nhakhoa.Models.StaffProfile> ?? new()))
                            {
                                <option value="@doc.Id">@doc.User?.FullName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Buổi khám <span class="text-danger">*</span></label>
                        <select id="walkInSession" class="form-select rounded-3">
                            <option value="Sáng">Buổi Sáng (07:00–12:00)</option>
                            <option value="Chiều">Buổi Chiều (13:00–17:00)</option>
                        </select>
                    </div>
                </div>
                <div id="walkInError" class="alert alert-danger border-0 rounded-3 py-2 mt-3" style="display:none;"></div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-success rounded-pill px-4 fw-semibold" id="confirmWalkIn">
                    <i class="bi bi-check2 me-1"></i> Xác nhận thêm vào hàng chờ
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Update appointment status via AJAX
    async function updateStatus(id, status) {
        const row = document.querySelector(`.queue-row[data-id="${id}"]`);
        const badge = document.getElementById(`badge-${id}`);
        try {
            const res = await fetch('/Appointment/UpdateStatus', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `id=${id}&status=${encodeURIComponent(status)}`
            });
            if (res.ok) {
                badge.textContent = status;
                const classMap = {
                    'Đang chờ': 'bg-warning-subtle text-warning',
                    'Đang khám': 'bg-primary-subtle text-primary',
                    'Đã khám xong': 'bg-success-subtle text-success',
                    'Vắng mặt': 'bg-secondary-subtle text-secondary'
                };
                badge.className = `badge rounded-pill px-3 py-1 status-badge ${classMap[status] || 'bg-light text-dark'}`;
                row.dataset.status = status;
                // Refresh action buttons
                const actionCell = row.querySelector('td:last-child div');
                if (status === 'Đang khám') {
                    actionCell.innerHTML = `<button class="btn btn-success btn-sm rounded-pill px-3 btn-done" data-id="${id}" title="Hoàn thành khám"><i class="bi bi-check2-circle"></i> Xong</button>`;
                    rebindButtons();
                } else {
                    actionCell.innerHTML = '';
                }
            }
        } catch (e) { console.error(e); }
    }

    function rebindButtons() {
        document.querySelectorAll('.btn-call').forEach(btn => btn.onclick = () => updateStatus(btn.dataset.id, 'Đang khám'));
        document.querySelectorAll('.btn-done').forEach(btn => btn.onclick = () => updateStatus(btn.dataset.id, 'Đã khám xong'));
        document.querySelectorAll('.btn-absent').forEach(btn => btn.onclick = () => updateStatus(btn.dataset.id, 'Vắng mặt'));
    }
    rebindButtons();

    // Walk-in patient search
    let walkInSearchTimer;
    document.getElementById('walkInSearch').addEventListener('input', function () {
        clearTimeout(walkInSearchTimer);
        walkInSearchTimer = setTimeout(async () => {
            const q = this.value.trim();
            if (!q) return;
            const res = await fetch(`/Patient/Search?q=${encodeURIComponent(q)}`);
            const data = await res.json();
            const container = document.getElementById('walkInSearchResults');
            if (!data.length) { container.innerHTML = '<div class="text-muted small">Không tìm thấy. <a href="/Patient/Create" target="_blank">Tạo hồ sơ mới</a></div>'; return; }
            container.innerHTML = data.map(p =>
                `<div class="border rounded-3 p-2 mb-1 cursor-pointer hover-bg walk-patient" 
                      data-id="${p.id}" data-name="${p.fullName}" data-phone="${p.phoneNumber}"
                      style="cursor:pointer; background:#f8faff;" onclick="selectWalkPatient(this)">
                    <span class="fw-semibold">${p.fullName}</span>
                    <span class="text-muted ms-2">${p.phoneNumber}</span>
                    <span class="badge bg-light text-dark ms-1">${p.patientCode}</span>
                 </div>`
            ).join('');
        }, 300);
    });

    function selectWalkPatient(el) {
        document.getElementById('walkInPatientId').value = el.dataset.id;
        document.getElementById('walkInPatientName').textContent = el.dataset.name;
        document.getElementById('walkInPatientPhone').textContent = el.dataset.phone;
        document.getElementById('walkInPatientInfo').style.display = 'block';
        document.getElementById('walkInSearchResults').innerHTML = '';
        document.getElementById('walkInSearch').value = el.dataset.name;
    }

    document.getElementById('confirmWalkIn').addEventListener('click', async function () {
        const patientId = document.getElementById('walkInPatientId').value;
        const doctorId = document.getElementById('walkInDoctor').value;
        const session = document.getElementById('walkInSession').value;
        const errEl = document.getElementById('walkInError');
        errEl.style.display = 'none';

        if (!patientId || !doctorId) { errEl.textContent = 'Vui lòng chọn bệnh nhân và bác sĩ.'; errEl.style.display = 'block'; return; }

        const formData = new URLSearchParams({ patientId, staffProfileId: doctorId, session });
        const res = await fetch('/Appointment/WalkIn', { method: 'POST', body: formData });
        if (res.ok) {
            const data = await res.json();
            bootstrap.Modal.getInstance(document.getElementById('walkInModal')).hide();
            location.reload();
        } else {
            const err = await res.json();
            errEl.textContent = err.error || 'Có lỗi xảy ra.';
            errEl.style.display = 'block';
        }
    });
</script>
}
