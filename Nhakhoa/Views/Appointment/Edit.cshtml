@model Nhakhoa.Models.Appointment
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dời lịch hẹn";
    var doctors = ViewBag.Doctors as List<Nhakhoa.Models.StaffProfile> ?? new();
    var clinics = ViewBag.Clinics as List<Nhakhoa.Models.Clinic> ?? new();
    var specialties = ViewBag.Specialties as List<Nhakhoa.Models.Specialty> ?? new();
}

<div class="mb-4">
    <a href="/Appointment" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách
    </a>
    <h4 class="fw-bold mt-2" style="color:#0b1f35">Dời lịch hẹn (Reschedule)</h4>
    <div class="text-muted small">Cập nhật ngày khám, bác sĩ hoặc khung giờ mới cho lịch hẹn của bệnh nhân.</div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger border-0 rounded-4 py-2 px-3 mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        Vui lòng sửa các lỗi bên dưới hoặc chọn một khung giờ khác.
    </div>
}

<form method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="PatientId" />
    <input type="hidden" asp-for="Status" />
    <input type="hidden" asp-for="QueueNumber" />
    <input type="hidden" asp-for="CreatedAt" />
    <input type="hidden" asp-for="CreatedBy" />
    <input type="hidden" asp-for="ConcurrencyStamp" />

    <div class="row g-4">
        <!-- Form main -->
        <div class="col-lg-8">
            <!-- Thông tin bệnh nhân (Cố định) -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 p-4">
                <h5 class="fw-bold text-dark mb-3">Thông tin bệnh nhân</h5>
                <div class="p-3 rounded-4 d-flex align-items-center justify-content-between" style="background:#f8f9fa; border: 1px solid #e9ecef;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-secondary text-white rounded-circle d-grid place-items-center" style="width:42px; height:42px;">
                            <i class="bi bi-person-fill fs-5"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold text-dark mb-0">@Model.Patient?.FullName</h6>
                            <span class="text-muted small">SĐT: @Model.Patient?.PhoneNumber &middot; Mã HS: @Model.Patient?.PatientCode</span>
                        </div>
                    </div>
                    <span class="badge bg-secondary rounded-pill px-3">Hồ sơ gốc</span>
                </div>
            </div>

            <!-- Bác sĩ & Dịch vụ -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 p-4">
                <h5 class="fw-bold text-dark mb-3">Bác sĩ & Dịch vụ khám</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-secondary small">Bác sĩ phụ trách <span class="text-danger">*</span></label>
                        <select name="StaffProfileId" id="doctorSelect" class="form-select rounded-3" required>
                            <option value="">-- Chọn bác sĩ --</option>
                            @foreach (var doc in doctors)
                            {
                                <!option value="@doc.Id" @(Model.StaffProfileId == doc.Id ? "selected" : "")>@doc.User?.FullName (@doc.PositionTitle)</!option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-secondary small">Chuyên khoa</label>
                        <select name="SpecialtyId" class="form-select rounded-3">
                            <option value="">-- Không chọn --</option>
                            @foreach (var sp in specialties)
                            {
                                <!option value="@sp.Id" @(Model.SpecialtyId == sp.Id ? "selected" : "")>@sp.Name</!option>
                            }
                        </select>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label fw-semibold text-secondary small">Phòng khám</label>
                        <select name="ClinicId" class="form-select rounded-3">
                            <option value="">-- Chưa phân công --</option>
                            @foreach (var c in clinics)
                            {
                                <!option value="@c.Id" @(Model.ClinicId == c.Id ? "selected" : "")>@c.Name (@c.Location)</!option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- Ngày khám & Giờ hẹn -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 p-4">
                <h5 class="fw-bold text-dark mb-3">Ngày khám & Giờ hẹn</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-secondary small">Ngày khám <span class="text-danger">*</span></label>
                        <input type="date" name="AppointmentDate" id="apptDate" class="form-control rounded-3" 
                               value="@Model.AppointmentDate.ToString("yyyy-MM-dd")"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-secondary small">Ca làm việc <span class="text-danger">*</span></label>
                        <select name="Session" id="sessionSelect" class="form-select rounded-3" required>
                            <option value="">-- Chọn bác sĩ & ngày khám trước --</option>
                        </select>
                    </div>
                </div>

                <div class="mt-4">
                    <label class="form-label fw-semibold text-secondary small mb-2">Khung giờ hẹn <span class="text-danger">*</span></label>
                    <input type="hidden" name="TimeSlot" id="timeSlotInput" value="@Model.TimeSlot" required />
                    <div id="timeSlotsGrid" class="row g-2">
                        <!-- Loaded dynamically -->
                    </div>
                    <div id="slotStatus" class="mt-3"></div>
                </div>
            </div>

            <!-- Ghi chú -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 p-4">
                <h5 class="fw-bold text-dark mb-3">Ghi chú & Lý do dời lịch</h5>
                <textarea name="Notes" class="form-control rounded-3" rows="3" placeholder="Nhập lý do dời lịch hoặc ghi chú thêm cho bác sĩ...">@Model.Notes</textarea>
            </div>

            <!-- Buttons -->
            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <a href="/Appointment" class="btn btn-outline-secondary rounded-pill px-4">Hủy bỏ</a>
                <button type="submit" class="btn btn-primary rounded-pill px-5" style="background:#1b75d0; border-color:#1b75d0;">
                    <i class="bi bi-save me-1"></i> Lưu thay đổi (Dời lịch)
                </button>
            </div>
        </div>

        <!-- Sidebar guides -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="background:#f8fbff; border: 1px solid #e2effe;">
                <h6 class="fw-bold text-primary mb-3"><i class="bi bi-info-circle-fill me-2"></i>Quy tắc dời lịch</h6>
                <ul class="small text-secondary ps-3 d-flex flex-column gap-2 mb-0">
                    <li>Chỉ dời lịch sang khung giờ bác sĩ có ca trực và còn trống.</li>
                    <li>Lịch hẹn đang diễn ra hoặc đã hoàn tất khám <strong>không được phép</strong> dời lịch.</li>
                </ul>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4" style="background:#fffcf6; border: 1px solid #fef3d6;">
                <h6 class="fw-bold text-warning-emphasis mb-3"><i class="bi bi-bell-fill me-2"></i>Thông báo dời lịch</h6>
                <p class="small text-secondary mb-0">Hệ thống sẽ gửi lại tin nhắn SMS/Email thông báo ca trực và khung giờ mới tới bệnh nhân ngay sau khi thay đổi được ghi nhận.</p>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script>
    const initialSession = "@Model.Session";
    const initialTimeSlot = "@Model.TimeSlot";

    async function loadDoctorShifts() {
        const dr = document.getElementById('doctorSelect')?.value;
        const dt = document.getElementById('apptDate')?.value;
        const ss = document.getElementById('sessionSelect');
        const grid = document.getElementById('timeSlotsGrid');
        const st = document.getElementById('slotStatus');

        if (!dr || !dt) return;

        ss.innerHTML = '<option value="">Đang kiểm tra ca trực...</option>';
        grid.innerHTML = '<div class="col-12 text-muted small">Vui lòng chọn ca trực.</div>';
        st.innerHTML = '';

        const res = await fetch(`/Appointment/GetDoctorShifts?staffProfileId=${dr}&date=${dt}`);
        const shifts = await res.json();

        if (!shifts.length) {
            ss.innerHTML = '<option value="">Bác sĩ không có ca trực</option>';
            st.innerHTML = '<div class="alert alert-danger border-0 rounded-3 py-2 small"><i class="bi bi-x-circle-fill me-2"></i>Bác sĩ không có ca trực nào trong ngày đã chọn. Vui lòng chọn ngày khác.</div>';
        } else {
            ss.innerHTML = '<option value="">-- Chọn ca trực --</option>' +
                shifts.map(s => `<option value="${s}" ${s === initialSession ? "selected" : ""}>${s}</option>`).join('');
            
            // Trigger load slots immediately if initial session is selected
            await loadSlots();
        }
    }

    async function loadSlots() {
        const dr = document.getElementById('doctorSelect')?.value;
        const dt = document.getElementById('apptDate')?.value;
        const ss = document.getElementById('sessionSelect')?.value;
        const grid = document.getElementById('timeSlotsGrid');
        const st = document.getElementById('slotStatus');
        const timeSlotInput = document.getElementById('timeSlotInput');

        if (!dr || !dt || !ss) return;

        grid.innerHTML = '<div class="col-12 text-muted small">Đang tải các khung giờ trống...</div>';

        const res = await fetch(`/Appointment/AvailableSlots?staffProfileId=${dr}&date=${dt}&session=${encodeURIComponent(ss)}`);
        let slots = await res.json();

        // If the selected day and session is the original one, make sure our current slot is listed even if database says it's booked
        if (dt === "@Model.AppointmentDate.ToString("yyyy-MM-dd")" && dr === "@Model.StaffProfileId" && ss === "@Model.Session") {
            if (!slots.includes(initialTimeSlot)) {
                slots.unshift(initialTimeSlot);
                slots.sort();
            }
        }

        grid.innerHTML = '';
        if (!slots.length) {
            grid.innerHTML = '<div class="col-12 text-danger small">Hết khung giờ trống trong ca trực này. Vui lòng chọn ca trực hoặc bác sĩ khác.</div>';
            st.innerHTML = '';
        } else {
            slots.forEach(s => {
                const col = document.createElement('div');
                col.className = 'col-6 col-sm-4 col-md-3';
                const isActive = (s === timeSlotInput.value);
                col.innerHTML = `<button type="button" class="btn ${isActive ? "btn-primary active" : "btn-outline-primary"} w-100 rounded-3 py-2 small text-nowrap slot-btn">${s}</button>`;
                
                const btn = col.querySelector('.slot-btn');
                btn.onclick = () => {
                    document.querySelectorAll('.slot-btn').forEach(b => b.classList.remove('active', 'btn-primary'));
                    document.querySelectorAll('.slot-btn').forEach(b => b.classList.add('btn-outline-primary'));
                    
                    btn.classList.remove('btn-outline-primary');
                    btn.classList.add('active', 'btn-primary');
                    
                    timeSlotInput.value = s;
                };
                grid.appendChild(col);
            });
            st.innerHTML = `<div class="text-success small"><i class="bi bi-clock-history me-1"></i>Còn lại ${slots.length} khung giờ trống.</div>`;
        }
    }

    document.getElementById('doctorSelect')?.addEventListener('change', loadDoctorShifts);
    document.getElementById('apptDate')?.addEventListener('change', loadDoctorShifts);
    document.getElementById('sessionSelect')?.addEventListener('change', loadSlots);

    // Initial triggers
    window.addEventListener('DOMContentLoaded', () => {
        loadDoctorShifts();
    });
</script>
}
