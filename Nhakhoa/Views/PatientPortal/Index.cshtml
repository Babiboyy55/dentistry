@using Nhakhoa.Models
@{
    ViewData["Title"] = "Cổng thông tin Bệnh nhân";
    var account = ViewBag.Account as PatientAccount;
    var appointments = ViewBag.Appointments as List<Appointment> ?? new List<Appointment>();
}

<div class="container py-4">
    <!-- Navigation Header -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.4);">
        <div class="card-body py-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-4 text-primary">🏥</span>
                <div>
                    <strong class="text-primary fs-5">Portal Bệnh Nhân</strong>
                    <span class="text-muted text-xs d-block" style="font-size: 0.75rem;">Hệ thống Nha Khoa</span>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <a asp-controller="PatientPortal" asp-action="Index" class="btn btn-primary rounded-pill px-3 py-1.5 fw-semibold text-white">
                    🏠 Lịch hẹn
                </a>
                <a asp-controller="PatientPortal" asp-action="HealthProfile" class="btn btn-light rounded-pill px-3 py-1.5 fw-semibold text-secondary">
                    🩺 Hồ sơ sức khỏe
                </a>
                <a asp-controller="PatientPortal" asp-action="Billing" class="btn btn-light rounded-pill px-3 py-1.5 fw-semibold text-secondary">
                    💳 Hóa đơn
                </a>
                <a asp-controller="PatientPortal" asp-action="ChangePassword" class="btn btn-light rounded-pill px-3 py-1.5 fw-semibold text-secondary">
                    🔑 Đổi mật khẩu
                </a>
                <a asp-controller="Auth" asp-action="Logout" class="btn btn-danger rounded-pill px-3 py-1.5 fw-semibold text-white">
                    🚪 Đăng xuất
                </a>
            </div>
        </div>
    </div>

    <!-- Header Summary -->
    <div class="row align-items-center mb-4 g-3">
        <div class="col-md-12">
            <h2 class="h4 fw-bold text-dark mb-1">Tổng quan tài khoản</h2>
            <p class="text-muted mb-0">Chào mừng quay trở lại, <strong>@account?.FullName</strong>. Dưới đây là thông tin chi tiết và lịch hẹn của bạn.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 small mb-4" style="background-color: rgba(40, 167, 69, 0.1); color: #1e7e34;">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="row g-4">
        <!-- Profile details -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden position-relative" style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.4);">
                <div class="p-4 bg-primary text-white text-center position-relative">
                    <div class="avatar-wrapper mx-auto mb-3" style="width: 100px; height: 100px; border-radius: 50%; border: 4px solid rgba(255,255,255,0.2); background-color: #fff; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                        <span class="fs-1">👤</span>
                    </div>
                    <h3 class="fw-bold mb-1">@account?.FullName</h3>
                    <span class="badge bg-white text-primary rounded-pill px-3 py-2 fw-semibold">
                        @(account?.Patient != null ? account.Patient.PatientCode : "Chưa liên kết EMR")
                    </span>
                </div>

                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark mb-3">Thông tin cá nhân</h5>
                    <div class="d-flex flex-column gap-3">
                        <div class="d-flex align-items-center border-bottom pb-2">
                            <span class="fs-5 me-3">📞</span>
                            <div>
                                <small class="text-muted d-block">Số điện thoại</small>
                                <strong class="text-dark">@account?.PhoneNumber</strong>
                            </div>
                        </div>
                        <div class="d-flex align-items-center border-bottom pb-2">
                            <span class="fs-5 me-3">✉</span>
                            <div>
                                <small class="text-muted d-block">Email</small>
                                <strong class="text-dark">@(string.IsNullOrEmpty(account?.Email) ? "Chưa cung cấp" : account.Email)</strong>
                            </div>
                        </div>
                        <div class="d-flex align-items-center border-bottom pb-2">
                            <span class="fs-5 me-3">📅</span>
                            <div>
                                <small class="text-muted d-block">Ngày sinh</small>
                                <strong class="text-dark">@(account?.Patient?.DateOfBirth?.ToString("dd/MM/yyyy") ?? "Chưa đồng bộ")</strong>
                            </div>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="fs-5 me-3">🚻</span>
                            <div>
                                <small class="text-muted d-block">Giới tính</small>
                                <strong class="text-dark">@(account?.Patient?.Gender ?? "Chưa đồng bộ")</strong>
                            </div>
                        </div>
                    </div>

                    @if (account?.Patient == null)
                    {
                        <div class="alert alert-warning border-0 rounded-3 mt-4 small p-3 mb-0" style="background-color: rgba(255, 193, 7, 0.1); color: #856404;">
                            ⚠️ <strong>Hồ sơ chưa đồng bộ:</strong> Tài khoản này chưa được liên kết với hồ sơ bệnh án nội bộ. Hãy liên hệ với phòng khám để cập nhật số điện thoại đồng bộ.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success border-0 rounded-3 mt-4 small p-3 mb-0" style="background-color: rgba(40, 167, 69, 0.08); color: #155724;">
                            ✅ <strong>Đồng bộ thành công:</strong> Tài khoản đã liên kết với hồ sơ bệnh án mã <strong>@account.Patient.PatientCode</strong>.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Appointments & Medical records list -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4" style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.4);">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold text-dark mb-0">Lịch sử và Lịch hẹn khám</h5>
                    <span class="badge bg-light text-dark rounded-pill px-3 py-2 border">Tổng số: @appointments.Count</span>
                </div>

                @if (!appointments.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <span class="fs-1 d-block mb-3">📅</span>
                        <p class="mb-0">Bạn chưa có lịch hẹn khám nào trên hệ thống.</p>
                        <small class="text-muted">Vui lòng liên hệ quầy tiếp đón để tạo lịch hẹn khám đầu tiên.</small>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle border-0">
                            <thead>
                                <tr class="text-secondary small" style="border-bottom: 2px solid #f1f3f5;">
                                    <th class="border-0 pb-3">Ngày & Giờ</th>
                                    <th class="border-0 pb-3">Phòng khám</th>
                                    <th class="border-0 pb-3">Dịch vụ / Chuyên khoa</th>
                                    <th class="border-0 pb-3">Bác sĩ phụ trách</th>
                                    <th class="border-0 pb-3 text-end">Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var app in appointments)
                                {
                                    var statusClass = app.Status switch
                                    {
                                        "Đang khám" => "bg-warning text-dark",
                                        "Đã hoàn thành" => "bg-success text-white",
                                        "Đã hủy" => "bg-danger text-white",
                                        _ => "bg-primary text-white"
                                    };

                                    <tr style="border-bottom: 1px solid #f8f9fa;">
                                        <td class="py-3">
                                            <strong class="text-dark d-block">@app.AppointmentDate.ToString("dd/MM/yyyy")</strong>
                                            <span class="small text-muted">Slot: @app.TimeSlot</span>
                                        </td>
                                        <td>
                                            <span class="text-dark">@(app.Clinic?.Name ?? "Chưa phân phòng")</span>
                                        </td>
                                        <td>
                                            <span class="text-dark fw-semibold">@(app.Specialty?.Name ?? "Khám tổng quát")</span>
                                        </td>
                                        <td>
                                            <span class="text-secondary">@(app.StaffProfile?.User?.FullName ?? "Đang phân bổ")</span>
                                        </td>
                                        <td class="text-end">
                                            <span class="badge @statusClass px-3 py-2 rounded-pill font-monospace" style="font-size: 0.8rem;">
                                                @app.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-wrapper {
        transition: transform 0.3s ease;
    }
    .avatar-wrapper:hover {
        transform: scale(1.05);
    }
    .table-hover tbody tr {
        transition: background-color 0.2s ease;
    }
    .table-hover tbody tr:hover {
        background-color: rgba(27, 117, 208, 0.02);
    }
</style>
