@model Nhakhoa.Models.Invoice
@using Nhakhoa.Models
@{
    Layout = null; // Blank layout to look like an external payment gateway
    var account = ViewBag.Account as PatientAccount;
    var method = ViewBag.MethodCode as string;
    var isVNPay = method == "VNPAY";
    var gatewayName = isVNPay ? "VNPAY SANDBOX MERCHANT" : "MOMO SANDBOX MERCHANT";
    var primaryColor = isVNPay ? "#005baa" : "#a50064";
    var logoUrl = isVNPay 
        ? "https://cdn.icon-icons.com/icons2/3911/PNG/512/vnpay_logo_icon_247402.png" 
        : "https://upload.wikimedia.org/wikipedia/vi/f/fe/MoMo_Logo.png";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cổng Thanh Toán Mock - @method</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f4f6fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .gateway-card {
            max-width: 500px;
            margin: 40px auto;
            border: none;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            background: white;
            overflow: hidden;
        }
        .gateway-header {
            background-color: @primaryColor;
            color: white;
            padding: 30px 20px;
            text-align: center;
            position: relative;
        }
        .gateway-logo {
            max-height: 50px;
            margin-bottom: 15px;
            background: white;
            padding: 8px 15px;
            border-radius: 10px;
        }
        .qr-wrapper {
            background: white;
            padding: 15px;
            border-radius: 15px;
            display: inline-block;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            margin: 20px 0;
        }
        .qr-code {
            display: grid;
            grid-template-columns: repeat(8, 20px);
            grid-gap: 3px;
            background: white;
        }
        .qr-code div {
            width: 20px;
            height: 20px;
        }
        .qr-black { background-color: #000; }
        .qr-white { background-color: #fff; }
    </style>
</head>
<body>
    <div class="container px-3">
        <div class="gateway-card">
            <!-- Header -->
            <div class="gateway-header">
                <img src="@logoUrl" alt="@method" class="gateway-logo img-fluid" />
                <h4 class="fw-bold mb-1">@gatewayName</h4>
                <div class="badge bg-white text-dark rounded-pill px-3 py-1.5 mt-2 font-monospace small">
                    <i class="bi bi-clock me-1 text-danger"></i> Giao dịch hết hạn trong <span id="timer">15:00</span>
                </div>
            </div>

            <!-- Body -->
            <div class="card-body p-4 text-center">
                <span class="text-muted text-xs uppercase d-block mb-1">Mã hóa đơn dịch vụ</span>
                <strong class="text-dark fs-5 font-monospace">@Model.InvoiceCode</strong>

                <hr class="my-3 opacity-50" />

                <span class="text-muted text-xs d-block mb-1">Tổng tiền thanh toán</span>
                <h2 class="fw-bold text-dark font-monospace mb-3" style="color: @primaryColor !important;">
                    @Model.TotalAmount.ToString("N0") VNĐ
                </h2>

                <div class="p-3 bg-light rounded-4 text-xs text-start mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Khách hàng:</span>
                        <span class="fw-semibold text-dark">@Model.Patient?.FullName</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-secondary">Nhà cung cấp:</span>
                        <span class="fw-semibold text-dark">Smart Dental Clinic</span>
                    </div>
                </div>

                <!-- QR code simulation -->
                <p class="text-muted text-xs mb-1">Mã QR quét thanh toán tự động</p>
                <div class="qr-wrapper">
                    <div class="qr-code">
                        <div class="qr-black"></div><div class="qr-black"></div><div class="qr-black"></div><div class="qr-white"></div><div class="qr-black"></div><div class="qr-white"></div><div class="qr-black"></div><div class="qr-black"></div>
                        <div class="qr-black"></div><div class="qr-white"></div><div class="qr-white"></div><div class="qr-black"></div><div class="qr-white"></div><div class="qr-black"></div><div class="qr-white"></div><div class="qr-black"></div>
                        <div class="qr-black"></div><div class="qr-white"></div><div class="qr-black"></div><div class="qr-white"></div><div class="qr-black"></div><div class="qr-white"></div><div class="qr-black"></div><div class="qr-black"></div>
                        <div class="qr-white"></div><div class="qr-white"></div><div class="qr-white"></div><div class="qr-black"></div><div class="qr-black"></div><div class="qr-white"></div><div class="qr-white"></div><div class="qr-white"></div>
                        <div class="qr-black"></div><div class="qr-black"></div><div class="qr-white"></div><div class="qr-white"></div><div class="qr-black"></div><div class="qr-white"></div><div class="qr-black"></div><div class="qr-white"></div>
                        <div class="qr-white"></div><div class="qr-black"></div><div class="qr-black"></div><div class="qr-white"></div><div class="qr-white"></div><div class="qr-black"></div><div class="qr-black"></div><div class="qr-black"></div>
                        <div class="qr-black"></div><div class="qr-white"></div><div class="qr-white"></div><div class="qr-black"></div><div class="qr-white"></div><div class="qr-white"></div><div class="qr-white"></div><div class="qr-black"></div>
                        <div class="qr-black"></div><div class="qr-black"></div><div class="qr-black"></div><div class="qr-white"></div><div class="qr-black"></div><div class="qr-black"></div><div class="qr-black"></div><div class="qr-black"></div>
                    </div>
                </div>

                <p class="text-danger small fw-semibold mb-4">
                    <i class="bi bi-info-circle-fill me-1"></i> Đây là môi trường thử nghiệm (Sandbox). Vui lòng chọn kết quả giao dịch:
                </p>

                <!-- Actions Form -->
                <div class="d-flex flex-column gap-2.5">
                    <form asp-action="PaymentCallback" method="post" id="successForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="method" value="@method" />
                        <input type="hidden" name="status" value="success" />
                        <button type="submit" class="btn btn-success w-100 py-2.5 rounded-pill fw-bold shadow-sm">
                            <i class="bi bi-check-circle me-1"></i> Xác nhận Thanh toán Thành công
                        </button>
                    </form>

                    <form asp-action="PaymentCallback" method="post" id="failureForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="method" value="@method" />
                        <input type="hidden" name="status" value="failure" />
                        <input type="hidden" name="error" value="Nguoi dung chu dong huy thanh toan hoac giao dich het han." />
                        <button type="submit" class="btn btn-outline-danger w-100 py-2.5 rounded-pill fw-bold">
                            <i class="bi bi-x-circle me-1"></i> Mô phỏng Thanh toán Thất bại / Hủy
                        </button>
                    </form>

                    <a asp-action="Checkout" asp-route-id="@Model.Id" class="btn btn-link text-decoration-none text-muted small mt-2">
                        <i class="bi bi-arrow-left"></i> Quay lại trang thanh toán
                    </a>
                </div>
            </div>

            <!-- Footer -->
            <div class="bg-light p-3 text-center text-muted small border-top">
                &copy; 2026 @(isVNPay ? "VNPay" : "MoMo") Payment Gateway. Secured & Encrypted.
            </div>
        </div>
    </div>

    <script>
        // Simple countdown timer
        let timeLeft = 900; // 15 minutes
        const timerElement = document.getElementById('timer');
        setInterval(() => {
            if (timeLeft <= 0) {
                document.getElementById('failureForm').submit();
            } else {
                timeLeft--;
                const minutes = Math.floor(timeLeft / 60);
                const seconds = timeLeft % 60;
                timerElement.innerText = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
            }
        }, 1000);
    </script>
</body>
</html>
