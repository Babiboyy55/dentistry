@model Nhakhoa.Models.Invoice
@using Nhakhoa.Models
@{
    ViewData["Title"] = "Thanh toán hóa đơn";
    var account = ViewBag.Account as PatientAccount;
    var paymentMethods = ViewBag.PaymentMethods as List<PaymentMethod> ?? new List<PaymentMethod>();
}

<div class="container py-4" style="max-width: 1000px;">
    <!-- Navigation Header -->
    <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.4);">
        <div class="card-body py-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-4 text-primary">🏥</span>
                <div>
                    <strong class="text-primary fs-5">Portal Bệnh Nhân</strong>
                    <span class="text-muted text-xs d-block" style="font-size: 0.75rem;">Hệ thống Nha Khoa</span>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <a asp-controller="PatientPortal" asp-action="Index" class="btn btn-light rounded-pill px-3 py-1.5 fw-semibold text-secondary">
                    🏠 Lịch hẹn
                </a>
                <a asp-controller="PatientPortal" asp-action="HealthProfile" class="btn btn-light rounded-pill px-3 py-1.5 fw-semibold text-secondary">
                    🩺 Hồ sơ sức khỏe
                </a>
                <a asp-controller="PatientPortal" asp-action="Billing" class="btn btn-primary rounded-pill px-3 py-1.5 fw-semibold text-white">
                    💳 Hóa đơn
                </a>
                <a asp-controller="PatientPortal" asp-action="ChangePassword" class="btn btn-light rounded-pill px-3 py-1.5 fw-semibold text-secondary">
                    🔑 Đổi mật khẩu
                </a>
                <a asp-controller="Auth" asp-action="Logout" class="btn btn-danger rounded-pill px-3 py-1.5 fw-semibold text-white">
                    🚪 Đăng xuất
                </a>
            </div>
        </div>
    </div>

    <!-- Breadcrumbs -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-action="Billing" class="text-decoration-none">Hóa đơn</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thanh toán</li>
        </ol>
    </nav>

    <!-- Page Title -->
    <div class="mb-4">
        <h2 class="h4 fw-bold text-dark mb-1">Thanh toán hóa đơn</h2>
        <p class="text-muted mb-0">Hoàn tất thanh toán an toàn cho dịch vụ nha khoa của bạn.</p>
    </div>

    <div class="row g-4">
        <!-- Left Column: Invoice Details -->
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                    <h5 class="fw-bold text-dark mb-0">📄 Chi tiết hóa đơn</h5>
                    <span class="badge bg-primary rounded-pill px-3 py-2 font-monospace">MÃ: @Model.InvoiceCode</span>
                </div>

                <div class="row mb-4 text-xs">
                    <div class="col-6">
                        <span class="text-muted d-block uppercase fw-semibold mb-1">NGÀY HÓA ĐƠN</span>
                        <strong class="text-dark fs-6">@Model.IssuedAt.ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>
                    <div class="col-6">
                        <span class="text-muted d-block uppercase fw-semibold mb-1">BÁC SĨ PHỤ TRÁCH</span>
                        <strong class="text-dark fs-6">@Model.ExaminationSession?.Doctor?.User?.FullName</strong>
                    </div>
                </div>

                <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">DỊCH VỤ THỰC HIỆN</h6>
                <div class="table-responsive mb-4">
                    <table class="table align-middle mb-0 text-sm">
                        <thead>
                            <tr class="text-secondary text-xs">
                                <th class="border-0 ps-0">Tên dịch vụ</th>
                                <th class="border-0 text-center">Số lượng</th>
                                <th class="border-0 text-end pe-0">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.InvoiceDetails != null && Model.InvoiceDetails.Any())
                            {
                                foreach (var d in Model.InvoiceDetails)
                                {
                                    <tr>
                                        <td class="ps-0 border-bottom-0">
                                            <div class="fw-bold text-dark">@d.MedicalService?.Name</div>
                                            <small class="text-muted">@d.MedicalService?.Department</small>
                                        </td>
                                        <td class="text-center border-bottom-0">@d.Quantity</td>
                                        <td class="text-end pe-0 border-bottom-0 fw-semibold text-dark">@d.Amount.ToString("N0")đ</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Price Breakdown -->
                <div class="p-3 bg-light rounded-4 mb-3">
                    <div class="d-flex justify-content-between mb-2 text-xs text-secondary">
                        <span>Tạm tính:</span>
                        <span class="fw-semibold">@Model.SubTotal.ToString("N0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 text-xs text-secondary">
                        <span>VAT (10%):</span>
                        <span class="fw-semibold">@Model.VATAmount.ToString("N0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 text-xs text-secondary">
                        <span>Giảm giá khách hàng thân thiết:</span>
                        <span class="fw-semibold text-success">-@Model.DiscountAmount.ToString("N0") đ</span>
                    </div>
                    <hr class="my-2 border-secondary-subtle" />
                    <div class="d-flex justify-content-between text-dark">
                        <span class="fw-bold text-sm">TỔNG CỘNG THANH TOÁN:</span>
                        <span class="fw-bold fs-4 text-primary">@Model.TotalAmount.ToString("N0") VNĐ</span>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-4 text-muted text-xxs mt-3 pt-3 border-top">
                    <span>🛡️ SSL SECURE</span>
                    <span>🔒 AES-256 BIT</span>
                    <span>💳 PCI DSS COMPLIANT</span>
                </div>
            </div>
        </div>

        <!-- Right Column: Payment Methods Selection -->
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100 d-flex flex-column">
                <h5 class="fw-bold text-dark mb-4 border-bottom pb-3">💳 Phương thức thanh toán</h5>

                <form asp-action="ProcessOnlinePayment" method="post" class="d-flex flex-column flex-grow-1">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="d-flex flex-column gap-3 mb-4">
                        @foreach (var pm in paymentMethods)
                        {
                            var isVNPay = pm.Code == "VNPAY";
                            var logoUrl = isVNPay 
                                ? "https://cdn.icon-icons.com/icons2/3911/PNG/512/vnpay_logo_icon_247402.png"
                                : "https://upload.wikimedia.org/wikipedia/vi/f/fe/MoMo_Logo.png";
                            var detailsText = isVNPay 
                                ? "Hỗ trợ ngân hàng & Thẻ quốc tế" 
                                : "Thanh toán nhanh qua ứng dụng MoMo";

                            <label class="payment-option-card border rounded-4 p-3 d-flex align-items-center justify-content-between cursor-pointer shadow-sm position-relative">
                                <div class="d-flex align-items-center gap-3">
                                    <input type="radio" name="paymentMethodCode" value="@pm.Code" class="form-check-input flex-shrink-0" @(pm == paymentMethods.First() ? "checked" : "") required />
                                    <div>
                                        <strong class="text-dark d-block">@pm.Name</strong>
                                        <span class="text-muted text-xs">@detailsText</span>
                                    </div>
                                </div>
                                <img src="@logoUrl" alt="@pm.Name" class="img-fluid rounded-3" style="max-height: 40px; width: 40px; object-fit: contain;" />
                            </label>
                        }
                    </div>

                    <div class="p-3 bg-light rounded-4 text-xxs text-muted mb-4">
                        Bằng việc nhấn <strong>"Thanh toán ngay"</strong>, bạn đồng ý với <a href="#" class="text-decoration-none text-primary">Điều khoản dịch vụ</a> và <a href="#" class="text-decoration-none text-primary">Chính sách bảo mật</a> của Smart Dental.
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold fs-6 mt-auto shadow-sm">
                        Thanh toán ngay <i class="bi bi-arrow-right-short ms-1"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .payment-option-card {
        transition: all 0.2s ease-in-out;
        cursor: pointer;
    }
    .payment-option-card:hover {
        border-color: #0d6efd !important;
        background-color: rgba(13, 110, 253, 0.02);
    }
    .payment-option-card input[type="radio"]:checked + div {
        color: #0d6efd;
    }
    .cursor-pointer {
        cursor: pointer;
    }
    .text-xxs {
        font-size: 0.75rem;
    }
</style>
