@model IEnumerable<Nhakhoa.Models.Clinic>
@{
    ViewData["Title"] = "Quản lý phòng khám";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-0">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1">Quản lý phòng khám</h1>
            <p class="text-secondary mb-0">Thiết lập và cấu hình không gian khám bệnh vật lý trong hệ thống phòng khám</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <button class="btn btn-primary px-4 py-2.5 fw-semibold d-flex align-items-center gap-2 shadow-sm rounded-3" onclick="openCreatePanel()">
                <i class="bi bi-plus-lg"></i> Thêm phòng khám mới
            </button>
        }
    </div>

    <!-- Error/Success Alert Banners -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 rounded-4 p-3 mb-4 d-flex align-items-center gap-3">
            <div class="alert-icon bg-danger text-white rounded-circle d-grid place-items-center flex-shrink-0">
                <i class="bi bi-exclamation-triangle fs-5"></i>
            </div>
            <div>
                <span class="fw-semibold text-danger-emphasis">Lỗi hệ thống:</span>
                <span class="text-secondary-emphasis small mt-0.5 d-block">@TempData["ErrorMessage"]</span>
            </div>
        </div>
    }

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <!-- Card 1 -->
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 position-relative overflow-hidden stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-secondary fw-semibold text-uppercase tracking-wider small">Tổng phòng khám</span>
                        <h2 class="display-6 fw-bold text-dark mt-2 mb-0">@ViewBag.TotalClinics</h2>
                    </div>
                    <div class="stat-icon-wrapper bg-primary-subtle text-primary">
                        <i class="bi bi-building fs-4"></i>
                    </div>
                </div>
                <div class="mt-3 d-flex align-items-center gap-2">
                    <span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1 fw-semibold small">Hoạt động</span>
                    <span class="text-muted small">Cung cấp ca trực</span>
                </div>
            </div>
        </div>
        <!-- Card 2 -->
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 position-relative overflow-hidden stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-secondary fw-semibold text-uppercase tracking-wider small">Đang hoạt động</span>
                        <h2 class="display-6 fw-bold text-dark mt-2 mb-0">@ViewBag.ActiveClinics</h2>
                    </div>
                    <div class="stat-icon-wrapper bg-success-subtle text-success">
                        <i class="bi bi-check-circle fs-4"></i>
                    </div>
                </div>
                <div class="mt-3 d-flex align-items-center gap-2">
                    <span class="badge bg-info-subtle text-info rounded-pill px-2.5 py-1 fw-semibold small">Khả dụng</span>
                    <span class="text-muted small">Cho các cuộc hẹn</span>
                </div>
            </div>
        </div>
        <!-- Card 3 -->
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 position-relative overflow-hidden stat-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="text-secondary fw-semibold text-uppercase tracking-wider small">Tổng sức chứa (Lượt)</span>
                        <h2 class="display-6 fw-bold text-dark mt-2 mb-0">@ViewBag.TotalCapacity người</h2>
                    </div>
                    <div class="stat-icon-wrapper bg-warning-subtle text-warning">
                        <i class="bi bi-people fs-4"></i>
                    </div>
                </div>
                <div class="mt-3 d-flex align-items-center gap-2">
                    <span class="badge bg-warning-subtle text-warning rounded-pill px-2.5 py-1 fw-semibold small">Tối đa</span>
                    <span class="text-muted small">Đồng thời cùng lúc</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Section -->
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
        <form method="get" asp-action="Index" class="row g-3 align-items-center">
            <!-- Search -->
            <div class="col-12 col-md-6 col-lg-8">
                <div class="input-group search-input-group">
                    <span class="input-group-text bg-light border-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control bg-light border-0" placeholder="Tìm kiếm phòng khám, vị trí..." value="@ViewBag.CurrentSearch" />
                </div>
            </div>
            <!-- Buttons -->
            <div class="col-12 col-md-6 col-lg-4 d-flex gap-2 justify-content-md-end">
                <button type="submit" class="btn btn-outline-primary btn-sm px-4 py-2.5 fw-semibold d-flex align-items-center gap-1.5 rounded-3">
                    <i class="bi bi-funnel"></i> Lọc kết quả
                </button>
                @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch))
                {
                    <a href="/Clinic" class="btn btn-outline-secondary btn-sm px-3 py-2.5 rounded-3 d-flex align-items-center">Xóa bộ lọc</a>
                }
            </div>
        </form>
    </div>

    <!-- Warning Info Banner -->
    <div class="alert alert-info border-0 rounded-4 p-3 mb-4 d-flex align-items-start gap-3" style="background-color: #f0f7ff !important;">
        <div class="alert-icon bg-info text-white rounded-circle d-grid place-items-center flex-shrink-0" style="width: 32px; height: 32px;">
            <i class="bi bi-info-lg fs-5"></i>
        </div>
        <div>
            <span class="fw-semibold text-info-emphasis">Quy tắc điều phối ca trực:</span>
            <p class="mb-0 text-secondary-emphasis small mt-0.5">
                Các phòng khám được tạo mới sẽ ngay lập tức hiển thị trong danh sách phân lịch của điều dưỡng và lễ tân. Việc sửa thông tin hoặc xóa phòng cần kiểm tra các ca trực tương lai để tránh gián đoạn khám bệnh.
            </p>
        </div>
    </div>

    <!-- Data Grid Layout for Clinics -->
    <div class="row g-4 mb-5">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4 p-5 bg-white text-center text-secondary">
                    <i class="bi bi-building-fill-x fs-1 d-block mb-2 text-muted"></i>
                    Không tìm thấy phòng khám nào phù hợp.
                </div>
            </div>
        }
        @foreach (var clinic in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden h-100 d-flex flex-column" style="transition: all 0.2s; border: 1px solid #f0f2f5 !important;">
                    <div class="p-4 flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <span class="badge bg-light text-dark border px-2.5 py-1.5 fw-semibold rounded">
                                <i class="bi bi-compass me-1"></i> @clinic.Location
                            </span>
                            
                            @if (clinic.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success px-2.5 py-1.5 rounded-pill fw-semibold small d-inline-flex align-items-center gap-1">
                                    <span class="status-indicator bg-success" style="width:7px; height:7px; border-radius:50%; display:inline-block;"></span> Hoạt động
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary px-2.5 py-1.5 rounded-pill fw-semibold small d-inline-flex align-items-center gap-1">
                                    <span class="status-indicator bg-secondary" style="width:7px; height:7px; border-radius:50%; display:inline-block;"></span> Bảo trì/Ẩn
                                </span>
                            }
                        </div>

                        <h5 class="fw-bold text-dark fs-5 mb-2">@clinic.Name</h5>
                        
                        <div class="d-flex align-items-center gap-2 mb-3.5">
                            <span class="text-secondary small">Chuyên khoa mặc định:</span>
                            <span class="badge bg-primary-subtle text-primary fw-semibold small rounded">
                                @(clinic.DefaultSpecialty?.Name ?? "Tất cả")
                            </span>
                        </div>

                        <hr class="my-3 text-light-subtle" />

                        <div class="row g-2">
                            <div class="col-6">
                                <div class="p-2 bg-light rounded-3 text-center">
                                    <span class="text-secondary small d-block" style="font-size:0.75rem;">Sức chứa</span>
                                    <strong class="text-dark fs-6">@clinic.Capacity người</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 bg-light rounded-3 text-center">
                                    <span class="text-secondary small d-block" style="font-size:0.75rem;">Ca trực lên lịch</span>
                                    <strong class="text-primary fs-6">@clinic.Shifts.Count ca</strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-light-subtle border-top py-3 px-4 d-flex justify-content-between align-items-center">
                        <span class="text-secondary small" style="font-size: 0.75rem;">Cập nhật: @clinic.UpdatedAt.ToString("dd/MM/yyyy")</span>
                        <div class="d-inline-flex gap-1.5">
                            <button class="btn btn-icon btn-white border rounded-circle" onclick="viewDetails(@clinic.Id)" title="Xem chi tiết">
                                <i class="bi bi-eye text-primary"></i>
                            </button>
                            @if (User.IsInRole("Admin"))
                            {
                                <button class="btn btn-icon btn-white border rounded-circle" onclick="openEditPanel(@clinic.Id)" title="Chỉnh sửa">
                                    <i class="bi bi-pencil text-warning"></i>
                                </button>
                                <button class="btn btn-icon btn-white border rounded-circle" onclick="confirmDelete(@clinic.Id)" title="Xóa">
                                    <i class="bi bi-trash text-danger"></i>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Audit logs widget -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-clock-history text-primary"></i> Nhật ký hoạt động phòng khám
            </h5>
            <span class="text-muted small">Cập nhật thời gian thực</span>
        </div>

        <div class="timeline-wrapper">
            @if (ViewBag.AuditLogs == null || !((List<Nhakhoa.Models.ActivityLog>)ViewBag.AuditLogs).Any())
            {
                <p class="text-secondary small py-2 mb-0">Không có nhật ký hoạt động nào gần đây về phòng khám.</p>
            }
            else
            {
                <div class="position-relative ps-4 border-start border-light-subtle d-flex flex-column gap-4 py-2">
                    @foreach (var log in (List<Nhakhoa.Models.ActivityLog>)ViewBag.AuditLogs)
                    {
                        var iconClass = "bi-plus-circle-fill text-primary bg-primary-subtle";
                        if (log.Action.Contains("Cập nhật"))
                            iconClass = "bi-pencil-square text-info bg-info-subtle";
                        else if (log.Action.Contains("Xóa"))
                            iconClass = "bi-trash-fill text-danger bg-danger-subtle";

                        <div class="timeline-item position-relative">
                            <div class="timeline-dot position-absolute @iconClass rounded-circle d-grid place-items-center" style="left: -33px; top: 0px; width: 26px; height: 26px; font-size: 0.8rem; border: 4px solid #fff; box-shadow: 0 0 0 1px #eef0f7;">
                                <i class="bi @iconClass.Split(' ')[0]"></i>
                            </div>
                            
                            <div>
                                <div class="small fw-semibold text-dark">
                                    Admin <span class="text-primary">@log.Username</span> @log.Details
                                </div>
                                <div class="text-secondary small mt-0.5" style="font-size: 0.75rem;">
                                    @log.Timestamp.ToString("dd/MM/yyyy HH:mm") • Hệ thống phòng vật lý
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Slide-over Offcanvas (Edit/Create Panel - matching the 4th screenshot) -->
<div class="offcanvas offcanvas-end offcanvas-custom" tabindex="-1" id="clinicEditOffcanvas" aria-labelledby="clinicEditOffcanvasLabel">
    <div class="offcanvas-header border-bottom py-3.5 px-4 bg-light-subtle d-flex align-items-center justify-content-between">
        <div>
            <h5 class="offcanvas-title fw-bold text-dark" id="offcanvasTitle">Thêm phòng khám mới</h5>
            <p class="text-secondary small mb-0 mt-0.5">Thiết lập không gian khám bệnh vật lý trong hệ thống</p>
        </div>
        <button type="button" class="btn-close text-secondary" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    
    <div class="offcanvas-body p-4">
        <div class="row g-3">
            <!-- Left inputs (Form) -->
            <div class="col-12 col-md-7">
                <form id="clinicForm" method="post" asp-action="Save">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="clinicId" name="id" value="0" />

                    <!-- Input Name -->
                    <div class="mb-3">
                        <label for="inputName" class="form-label small fw-bold text-dark">Tên phòng khám</label>
                        <input type="text" class="form-control border-light-subtle fs-6 rounded-3" id="inputName" name="name" required placeholder="Ví dụ: Phòng Nội soi A1" />
                    </div>

                    <!-- Row Vị trí & Sức chứa -->
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label for="inputLocation" class="form-label small fw-bold text-dark">Vị trí</label>
                            <select class="form-select border-light-subtle fs-6 rounded-3" id="inputLocation" name="location" required>
                                <option value="Tầng 1 - Khu A">Tầng 1 - Khu A</option>
                                <option value="Tầng 2 - Khu B">Tầng 2 - Khu B</option>
                                <option value="Tầng 1 - Khu C">Tầng 1 - Khu C</option>
                                <option value="Tầng 3 - Khu D">Tầng 3 - Khu D</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label for="inputCapacity" class="form-label small fw-bold text-dark">Sức chứa tối đa</label>
                            <div class="input-group">
                                <input type="number" class="form-control border-light-subtle fs-6 rounded-start-3" id="inputCapacity" name="capacity" required min="1" placeholder="0" />
                                <span class="input-group-text bg-light border-light-subtle rounded-end-3 text-secondary small">người</span>
                            </div>
                        </div>
                    </div>

                    <!-- Input Specialty -->
                    <div class="mb-3.5">
                        <label for="inputDefaultSpecialtyId" class="form-label small fw-bold text-dark">Chuyên khoa mặc định</label>
                        <select class="form-select border-light-subtle fs-6 rounded-3" id="inputDefaultSpecialtyId" name="defaultSpecialtyId">
                            <option value="">Chọn chuyên khoa...</option>
                            @foreach (var spec in ViewBag.Specialties)
                            {
                                <option value="@spec.Id">@spec.Name - @spec.Code</option>
                            }
                        </select>
                    </div>

                    <!-- Active Toggle -->
                    <div class="card border-light-subtle rounded-3 p-3 mb-4 bg-light bg-opacity-25">
                        <div class="form-check form-switch d-flex justify-content-between align-items-center ps-0 mb-0">
                            <div>
                                <label class="form-check-label fw-bold text-dark small d-block" for="inputIsActive">Trạng thái hoạt động</label>
                                <span class="text-secondary small" style="font-size: 0.72rem;">Phòng có thể tiếp nhận ca trực</span>
                            </div>
                            <input class="form-check-input form-switch-lg cursor-pointer" type="checkbox" id="inputIsActive" name="isActive" value="true" checked />
                        </div>
                    </div>

                    <!-- Action buttons -->
                    <div class="d-flex gap-2.5 justify-content-end pt-2">
                        <button type="button" class="btn btn-light border px-3.5 py-2.5 fw-semibold rounded-3" data-bs-dismiss="offcanvas">Hủy</button>
                        <button type="submit" class="btn btn-primary px-4 py-2.5 fw-semibold rounded-3 shadow-sm">Lưu phòng khám</button>
                    </div>
                </form>
            </div>

            <!-- Right layout details (Blueprints Preview - matching the 4th screenshot) -->
            <div class="col-12 col-md-5 d-flex flex-column gap-3">
                <!-- Info block -->
                <div class="alert alert-info border-0 rounded-4 p-3 d-flex align-items-start gap-2.5" style="background-color: #f0f7ff !important;">
                    <i class="bi bi-info-circle-fill text-info fs-5 flex-shrink-0"></i>
                    <div class="small text-info-emphasis">
                        Phòng khám sẽ xuất hiện ngay trong hệ thống điều phối ca khám và lịch hẹn.
                    </div>
                </div>

                <!-- Blueprints blueprint mock -->
                <div class="card border border-light-subtle rounded-4 p-4 bg-light bg-opacity-25 text-center d-grid place-items-center flex-grow-1" style="min-height: 200px;">
                    <div>
                        <i class="bi bi-building fs-1 d-block mb-3 text-secondary opacity-50"></i>
                        <span class="text-secondary small fw-medium d-block">Sơ đồ phòng khám sẽ được tạo tự động dựa trên vị trí thiết lập.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Constraint Error Modal (Không thể xóa phòng khám - ALT-5) -->
<div class="modal fade" id="constraintModal" tabindex="-1" aria-labelledby="constraintModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-custom">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-body p-4.5">
                <!-- Header Icon & Title -->
                <div class="d-flex align-items-start gap-3.5">
                    <div class="modal-warning-icon bg-danger-subtle text-danger rounded-circle d-grid place-items-center flex-shrink-0" style="width: 50px; height: 50px;">
                        <i class="bi bi-exclamation-triangle fs-4"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-dark mb-1">Không thể xóa phòng khám</h4>
                        <p class="text-secondary mb-0 mt-0.5">Phòng khám <strong class="text-dark" id="constraintClinicName">"Phòng khám Tim mạch A1"</strong> hiện đang có lịch làm việc trong tương lai.</p>
                    </div>
                </div>

                <!-- Constraint Details Cards -->
                <div class="mt-4 border border-warning-subtle bg-warning-subtle bg-opacity-10 rounded-4 p-3">
                    <span class="text-warning-emphasis fw-bold text-uppercase small tracking-wider">Lịch làm việc tương lai</span>
                    <div class="row g-3 mt-1.5 justify-content-center">
                        <div class="col-8">
                            <div class="bg-white rounded-3 p-3 border border-light-subtle shadow-xs text-center">
                                <span class="text-secondary small d-block">Số ca trực bị ràng buộc</span>
                                <span class="h3 fw-bold text-dark d-block mt-1" id="countShifts">0</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Suggestion Box -->
                <div class="mt-4 p-3 bg-light rounded-4 small text-secondary-emphasis d-flex gap-2">
                    <i class="bi bi-lightbulb text-warning fs-5 flex-shrink-0"></i>
                    <div>
                        <strong>Giải pháp:</strong> Bạn vui lòng hủy hoặc chuyển tất cả các ca trực tương lai thuộc phòng khám này sang không gian thực tế khác trước khi thực hiện xóa vĩnh viễn phòng.
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="mt-4.5 d-flex gap-2.5 justify-content-end">
                    <button type="button" class="btn btn-outline-secondary px-4 py-2.5 fw-semibold rounded-3" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Standard Confirm Delete Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-custom">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-body p-4.5">
                <div class="d-flex align-items-start gap-3.5">
                    <div class="modal-warning-icon bg-warning-subtle text-warning rounded-circle d-grid place-items-center flex-shrink-0" style="width:50px; height:50px;">
                        <i class="bi bi-trash fs-4"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-dark mb-1">Xác nhận xóa phòng khám</h4>
                        <p class="text-secondary mb-0 mt-0.5">Bạn có chắc chắn muốn xóa phòng khám <strong class="text-dark" id="deleteClinicName">"Phòng khám C1"</strong>?</p>
                    </div>
                </div>
                <p class="text-danger small mt-3 mb-0">Hành động này không thể hoàn tác và sẽ xóa vĩnh viễn thực thể phòng khám vật lý khỏi sơ đồ.</p>
                <div class="mt-4.5 d-flex gap-2.5 justify-content-end">
                    <button type="button" class="btn btn-outline-secondary px-4 py-2.5 fw-semibold rounded-3" data-bs-dismiss="modal">Hủy</button>
                    <form id="deleteClinicForm" method="post" asp-action="Delete" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="deleteClinicId" name="id" value="0" />
                        <button type="submit" class="btn btn-danger px-4 py-2.5 fw-semibold rounded-3 shadow-sm">
                            Đồng ý xóa
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: View Details Modal -->
<div class="modal fade" id="viewDetailsModal" tabindex="-1" aria-labelledby="viewDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom py-3.5 px-4">
                <h5 class="modal-title fw-bold text-dark" id="viewDetailsModalLabel">Chi tiết phòng khám</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3.5">
                    <span class="text-secondary small fw-bold text-uppercase tracking-wider">Tên phòng khám</span>
                    <h5 class="text-dark fw-bold mt-1" id="detailName">-</h5>
                </div>
                <div class="row g-3 mb-3.5">
                    <div class="col-6">
                        <span class="text-secondary small fw-bold text-uppercase tracking-wider">Vị trí vật lý</span>
                        <div class="text-dark mt-1 fs-6" id="detailLocation">-</div>
                    </div>
                    <div class="col-6">
                        <span class="text-secondary small fw-bold text-uppercase tracking-wider">Chuyên khoa mặc định</span>
                        <div><span class="badge bg-primary-subtle text-primary px-2 py-1.5 fw-semibold mt-1" id="detailSpecialty">-</span></div>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-6">
                        <span class="text-secondary small fw-bold text-uppercase tracking-wider">Sức chứa tối đa</span>
                        <h5 class="text-dark fw-bold mt-1" id="detailCapacity">-</h5>
                    </div>
                    <div class="col-6">
                        <span class="text-secondary small fw-bold text-uppercase tracking-wider">Cập nhật lần cuối</span>
                        <div class="text-dark mt-1 small" id="detailUpdatedAt">-</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top py-3 px-4">
                <button type="button" class="btn btn-secondary px-4 py-2 fw-semibold rounded-3" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<style>
    .stat-card {
        transition: transform 0.25s, box-shadow 0.25s;
    }
    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.04) !important;
    }
    
    .stat-icon-wrapper {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: grid;
        place-items: center;
    }
    
    .search-input-group {
        border-radius: 99px;
        overflow: hidden;
    }
    .search-input-group .form-control {
        border: none;
        padding-left: 0;
    }
    .search-input-group .form-control:focus {
        box-shadow: none;
    }
    
    .btn-icon {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
    }
    .btn-icon:hover {
        background-color: #eef2f6 !important;
    }
    
    /* Offcanvas Width adjustments for Clinic layout (wider since it has side by side layout) */
    .offcanvas-custom {
        width: 720px !important;
    }
    .offcanvas-title {
        font-size: 1.15rem;
    }
    .form-switch-lg {
        width: 2.8em !important;
        height: 1.5em !important;
    }
    .cursor-pointer {
        cursor: pointer;
    }
    
    .timeline-dot {
        border: 4px solid #fff;
        box-shadow: 0 0 0 1px #eef0f7;
    }
</style>

@section Scripts {
    <script>
        var offcanvasInstance;
        var constraintModalInstance;
        var deleteConfirmModalInstance;
        var viewDetailsModalInstance;

        $(document).ready(function () {
            offcanvasInstance = new bootstrap.Offcanvas(document.getElementById('clinicEditOffcanvas'));
            constraintModalInstance = new bootstrap.Modal(document.getElementById('constraintModal'));
            deleteConfirmModalInstance = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
            viewDetailsModalInstance = new bootstrap.Modal(document.getElementById('viewDetailsModal'));
        });

        function openCreatePanel() {
            $('#offcanvasTitle').text('Thêm phòng khám mới');
            $('#clinicId').val(0);
            $('#inputName').val('');
            $('#inputLocation').val('Tầng 1 - Khu A');
            $('#inputCapacity').val('');
            $('#inputDefaultSpecialtyId').val('');
            $('#inputIsActive').prop('checked', true);
            
            offcanvasInstance.show();
        }

        function openEditPanel(id) {
            $('#offcanvasTitle').text('Chỉnh sửa phòng khám');
            
            $.get('/Clinic/DetailsJson/' + id, function (data) {
                $('#clinicId').val(data.id);
                $('#inputName').val(data.name);
                $('#inputLocation').val(data.location);
                $('#inputCapacity').val(data.capacity);
                $('#inputDefaultSpecialtyId').val(data.defaultSpecialtyId || '');
                $('#inputIsActive').prop('checked', data.isActive);

                offcanvasInstance.show();
            }).fail(function() {
                alert('Có lỗi xảy ra khi lấy thông tin phòng khám.');
            });
        }

        function viewDetails(id) {
            $.get('/Clinic/DetailsJson/' + id, function (data) {
                $('#detailName').text(data.name);
                $('#detailLocation').text(data.location);
                
                var specText = $('#inputDefaultSpecialtyId option[value="' + (data.defaultSpecialtyId || '') + '"]').text() || "Tất cả chuyên khoa";
                $('#detailSpecialty').text(specText);
                $('#detailCapacity').text(data.capacity + ' người tối đa');
                $('#detailUpdatedAt').text(data.updatedAt);
                
                viewDetailsModalInstance.show();
            }).fail(function() {
                alert('Có lỗi xảy ra khi lấy thông tin phòng khám.');
            });
        }

        function confirmDelete(id) {
            $.get('/Clinic/GetDeleteConstraints/' + id, function (data) {
                if (data.hasConstraints) {
                    // Show blocker modal for future shifts
                    $('#constraintClinicName').text('"' + data.clinicName + '"');
                    $('#countShifts').text(String(data.futureShifts).padStart(2, '0'));
                    
                    constraintModalInstance.show();
                } else {
                    // Show confirm modal
                    $('#deleteClinicName').text('"' + data.clinicName + '"');
                    $('#deleteClinicId').val(id);
                    
                    deleteConfirmModalInstance.show();
                }
            }).fail(function() {
                alert('Có lỗi xảy ra khi kiểm tra ca trực.');
            });
        }
    </script>
}
