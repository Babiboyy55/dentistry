        transition: transform 0.25s, box-shadow 0.25s;
    }
    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.04) !important;
    }
    
    .stat-icon-wrapper {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: grid;
        place-items: center;
    }
    
    .search-input-group {
        border-radius: 99px;
        overflow: hidden;
    }
    .search-input-group .form-control {
        border: none;
        padding-left: 0;
    }
    .search-input-group .form-control:focus {
        box-shadow: none;
    }
    
    .btn-icon {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
    }
    .btn-icon:hover {
        background-color: #eef2f6 !important;
    }
    
    /* Offcanvas Width adjustments for Clinic layout (wider since it has side by side layout) */
    .offcanvas-custom {
        width: 720px !important;
    }
    .offcanvas-title {
        font-size: 1.15rem;
    }
    .form-switch-lg {
        width: 2.8em !important;
        height: 1.5em !important;
    }
    .cursor-pointer {
        cursor: pointer;
    }
    
    .timeline-dot {
        border: 4px solid #fff;
        box-shadow: 0 0 0 1px #eef0f7;
    }
</style>

@section Scripts {
    <script>
        var offcanvasInstance;
        var constraintModalInstance;
        var deleteConfirmModalInstance;
        var viewDetailsModalInstance;
        var chairFormModalInstance;
        var currentSelectedClinicId = 0;

        $(document).ready(function () {
            offcanvasInstance = new bootstrap.Offcanvas(document.getElementById('clinicEditOffcanvas'));
            constraintModalInstance = new bootstrap.Modal(document.getElementById('constraintModal'));
            deleteConfirmModalInstance = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
            viewDetailsModalInstance = new bootstrap.Modal(document.getElementById('viewDetailsModal'));
            chairFormModalInstance = new bootstrap.Modal(document.getElementById('chairFormModal'));

            // Set up AJAX submission for Chair Form
            $('#chairForm').on('submit', function (e) {
                e.preventDefault();
                saveDentalChair(false);
            });

            // Reset tab to General when details modal is closed
            $('#viewDetailsModal').on('hidden.bs.modal', function () {
                var firstTabEl = document.querySelector('#clinicDetailTabs li:first-child button');
                var tab = new bootstrap.Tab(firstTabEl);
                tab.show();
            });
        });

        function openCreatePanel() {
            $('#offcanvasTitle').text('Thêm phòng khám mới');
            $('#clinicId').val(0);
            $('#inputName').val('');
            $('#inputLocation').val('Tầng 1 - Khu A');
            $('#inputCapacity').val('');
            $('#inputDefaultSpecialtyId').val('');
            $('#inputIsActive').prop('checked', true);
            
            offcanvasInstance.show();
        }

        function openEditPanel(id) {
            $('#offcanvasTitle').text('Chỉnh sửa phòng khám');
            
            $.get('/Clinic/DetailsJson/' + id, function (data) {
                $('#clinicId').val(data.id);
                $('#inputName').val(data.name);
                $('#inputLocation').val(data.location);
                $('#inputCapacity').val(data.capacity);
                $('#inputDefaultSpecialtyId').val(data.defaultSpecialtyId || '');
                $('#inputIsActive').prop('checked', data.isActive);

                offcanvasInstance.show();
            }).fail(function() {
                alert('Có lỗi xảy ra khi lấy thông tin phòng khám.');
            });
        }

        function viewDetails(id) {
            currentSelectedClinicId = id;
            $.get('/Clinic/DetailsJson/' + id, function (data) {
                $('#detailName').text(data.name);
                $('#detailLocation').text(data.location);
                
                var specText = $('#inputDefaultSpecialtyId option[value="' + (data.defaultSpecialtyId || '') + '"]').text() || "Tất cả chuyên khoa";
                $('#detailSpecialty').text(specText);
                $('#detailCapacity').text(data.capacity + ' người tối đa');
                $('#detailUpdatedAt').text(data.updatedAt);
                
                loadDentalChairs(id);
                
                viewDetailsModalInstance.show();
            }).fail(function() {
                alert('Có lỗi xảy ra khi lấy thông tin phòng khám.');
            });
        }

        function loadDentalChairs(clinicId) {
            $('#chairErrorAlert').addClass('d-none');
            $('#chairsTableBody').html('<tr><td colspan="4" class="text-center py-3 text-secondary"><div class="spinner-border spinner-border-sm me-2 text-primary" role="status"></div> Đang tải danh sách...</td></tr>');
            
            $.get('/Clinic/GetChairsJson?clinicId=' + clinicId, function (data) {
                $('#chairsCountBadge').text(data.length);
                if (data.length === 0) {
                    $('#chairsTableBody').html('<tr><td colspan="4" class="text-center py-4 text-secondary"><i class="bi bi-info-circle me-1"></i> Chưa có ghế nha khoa nào trong phòng này.</td></tr>');
                    return;
                }

                var html = '';
                $.each(data, function (index, chair) {
                    var statusBadge = chair.status === 'Hoạt động' 
                        ? '<span class="badge bg-success-subtle text-success px-2.5 py-1.5 rounded-pill fw-semibold small d-inline-flex align-items-center gap-1"><span class="bg-success" style="width:6px; height:6px; border-radius:50%; display:inline-block;"></span> Hoạt động</span>'
                        : '<span class="badge bg-warning-subtle text-warning px-2.5 py-1.5 rounded-pill fw-semibold small d-inline-flex align-items-center gap-1"><span class="bg-warning" style="width:6px; height:6px; border-radius:50%; display:inline-block;"></span> Bảo trì</span>';
                    
                    var actions = '@(User.IsInRole("Admin") ? "true" : "false")' === 'true'
                        ? '<div class="d-inline-flex gap-1.5">' +
                          '<button class="btn btn-icon btn-white border rounded-circle" onclick="openEditChairForm(' + chair.id + ', \'' + chair.chairCode + '\', \'' + chair.name + '\', \'' + chair.status + '\')" title="Sửa">' +
                          '<i class="bi bi-pencil text-warning"></i></button>' +
                          '<button class="btn btn-icon btn-white border rounded-circle" onclick="deleteDentalChair(' + chair.id + ', \'' + chair.name + '\')" title="Xóa">' +
                          '<i class="bi bi-trash text-danger"></i></button>' +
                          '</div>'
                        : '<span class="text-muted small">Không có quyền</span>';

                    html += '<tr>' +
                            '<td class="px-3 py-2.5 fw-semibold text-dark">' + chair.chairCode + '</td>' +
                            '<td class="px-3 py-2.5 text-secondary">' + chair.name + '</td>' +
                            '<td class="px-3 py-2.5">' + statusBadge + '</td>' +
                            '<td class="px-3 py-2.5 text-end">' + actions + '</td>' +
                            '</tr>';
                });
                $('#chairsTableBody').html(html);
            }).fail(function() {
                $('#chairsTableBody').html('<tr><td colspan="4" class="text-center py-3 text-danger"><i class="bi bi-exclamation-circle me-1"></i> Không thể tải danh sách ghế nha.</td></tr>');
            });
        }

        function openCreateChairForm() {
            $('#chairFormTitle').text('Thêm ghế nha mới');
            $('#chairId').val(0);
            $('#chairClinicId').val(currentSelectedClinicId);
            $('#chairCode').val('').prop('disabled', false).prop('readonly', false);
            $('#chairName').val('');
            $('#chairStatus').val('Hoạt động');
            $('#chairErrorAlert').addClass('d-none');
            
            chairFormModalInstance.show();
        }

        function openEditChairForm(id, code, name, status) {
            $('#chairFormTitle').text('Chỉnh sửa ghế nha');
            $('#chairId').val(id);
            $('#chairClinicId').val(currentSelectedClinicId);
            $('#chairCode').val(code).prop('disabled', true).prop('readonly', true);
            $('#chairName').val(name);
            $('#chairStatus').val(status);
            $('#chairErrorAlert').addClass('d-none');

            chairFormModalInstance.show();
        }

        function saveDentalChair(bypassWarning) {
            var id = $('#chairId').val();
            var clinicId = $('#chairClinicId').val();
            var code = $('#chairCode').val();
            var name = $('#chairName').val();
            var status = $('#chairStatus').val();

            $.post('/Clinic/SaveChair', {
                id: id,
                clinicId: clinicId,
                chairCode: code,
                name: name,
                status: status,
                bypassWarning: bypassWarning
            }, function (res) {
                if (res.success) {
                    chairFormModalInstance.hide();
                    loadDentalChairs(currentSelectedClinicId);
                } else {
                    if (res.requireConfirm) {
                        if (confirm(res.message)) {
                            saveDentalChair(true);
                        }
                    } else {
                        alert(res.message);
                    }
                }
            }).fail(function () {
                alert('Có lỗi xảy ra khi lưu thông tin ghế nha.');
            });
        }

        function deleteDentalChair(id, name) {
            if (confirm('Bạn có chắc chắn muốn xóa vĩnh viễn ghế nha "' + name + '"?')) {
                $.post('/Clinic/DeleteChair', { id: id }, function (res) {
                    if (res.success) {
                        loadDentalChairs(currentSelectedClinicId);
                    } else {
                        alert(res.message);
                    }
                }).fail(function () {
                    alert('Có lỗi xảy ra khi xóa ghế nha.');
                });
            }
        }

        function confirmDelete(id) {
            $.get('/Clinic/GetDeleteConstraints/' + id, function (data) {
                if (data.hasConstraints) {
                    $('#constraintClinicName').text('"' + data.clinicName + '"');
                    
                    // Display appointments constraint (ALT-2)
                    if (data.incompleteAppointments > 0) {
                        $('#countAppts').text(data.incompleteAppointments);
                        $('#constraintApptsContainer').removeClass('d-none');
                    } else {
                        $('#constraintApptsContainer').addClass('d-none');
                    }

                    // Display shifts constraint (ALT-3)
                    if (data.futureShifts > 0) {
                        $('#countShifts').text(data.futureShifts);
                        $('#constraintShiftsContainer').removeClass('d-none');
                    } else {
                        $('#constraintShiftsContainer').addClass('d-none');
                    }
                    
                    constraintModalInstance.show();
                } else {
                    // Show confirm modal
                    $('#deleteClinicName').text('"' + data.clinicName + '"');
                    $('#deleteClinicId').val(id);
                    
                    deleteConfirmModalInstance.show();
                }
            }).fail(function() {
                alert('Có lỗi xảy ra khi kiểm tra ràng buộc.');
            });
        }
    </script>
}
